GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "803F9D18E2D48C4A"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aMissionEvents + {
    GC_Event "{E1C68D3FC21638EE}" {
     m_sName "timelimit (event 5, 3600s)"
     m_Advanced GC_EventOptions "{EE7AEB73C5D7A193}" {
      m_fDelay 3600
     }
     m_aActions {
      GC_MessageAction "{925FC0D17B0EFC40}" {
       m_sTitle "Timelimit Reached"
       m_sMessage ""
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{CC4362F125BA493A}" {
     m_iOrder 0
     m_sTitle "Scenario Overview"
     m_sContent "A downed pilot must link up with the local civilian population and West German Militia units to recover intelligence from his copilot and escape and evade a soviet platoon."
     m_eAudience 1
    }
    GC_Briefing "{8D10C49DBCC1C31A}" {
     m_iOrder 1
     m_sTitle "Situation "
     m_sContent "You are civilian residents of recently occupied West Germany. Last week Soviet forces came across the border and pushed NATO forces back. Until now, your homes have been unaffected by the war. "\
     ""\
     "Unfortunately, some local kids have reported that two NATO pilots have ejected right over your home town of Montignac. One is confirmed dead, and was reportedly in possession of some very important looking intel documents that are bright red."\
     ""\
     "The other survived the landing, and is somewhere nearby."\
     ""\
     "Your friend who was totally going to join the army but didn't has also said he thinks there will probably be some local militia units trying to find the pilot and get him out of dodge before the Soviets arrive."
     m_aFactionKeys {
      "CIV"
     }
    }
    GC_Briefing "{983AA3BB00D344B7}" {
     m_iOrder 2
     m_sTitle "Situation"
     m_sContent "You are a West German Militia unit behind enemy lines in recently occupied West Germany. Last week Soviet forces came across the border and pushed NATO forces back. Until now, your task has been to lay low and wait for orders."\
     ""\
     "Moments ago, a NATO twin seater jet crashed and burned on it's way to a target somewhere east of here. Both pilots ejected over the town of Montignac."\
     ""\
     "Your cell leader has decided to find those pilots before the Soviets do. "
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{06390D5D3974CEDE}" {
     m_iOrder 3
     m_sTitle "Situation "
     m_sContent "Your platoon has been on R&R after being heavily attritted during the regiment's successful advance into West Germany. You are stationed temporarily in Villeneuve in a secure area where little to no fighting took place. "\
     "Moments ago an America jet was shot down and two chutes were deployed over Montignac. As the only mobile platoon not currently tasked with local security, you've been tasked with the immediate capture of the downed pilots and any intelligence you can find."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{9DA23944974231B4}" {
     m_iOrder 4
     m_sTitle "Mission Notes"
     m_sContent "Time Limit: 60min"\
     ""\
     "Slot Pilot and 1 Civilian minimum."\
     "3:1 OPFOR:INDFOR"\
     ""\
     "OPFOR Victory: US Pilot is killed and Soviets extract with intel OR"\
     "US Pilot and 100% of West German Militia are killed."\
     ""\
     "Blufor/Indfor Victory: US Pilot extracts WITH intel OR"\
     "90% of Soviets are killed."\
     ""\
     "If neither victory condition is met, winner is the faction holding the intel."\
     "(Blu, Civ and Ind are aligned)"\
     ""
     m_eAudience 1
    }
    GC_Briefing "{629318847AB1AE02}" {
     m_iOrder 5
     m_sTitle "Mission"
     m_sContent "Your first priority is to survive."\
     ""\
     "If safe to do so, you should covertly try to help link the downed pilot with any West German Militia units that arrive in town. The sooner the pilot is gone, the sooner you can return to avoiding the attention of Soviet forces."\
     ""
     m_aFactionKeys {
      "CIV"
     }
    }
    GC_Briefing "{498893CAF4AB77B5}" {
     m_iOrder 6
     m_sTitle "Situation Enemy"
     m_sContent "There is a smashed up motor rifle battalion stationed in Villeneuve for repairs, among other rear echelon units."\
     "It's likely they have at least one platoon to spare and it's probably on it's way to Montignac as we speak."\
     ""\
     "Expect BTR mounted troops with AK-74s, RPGs and RPKs."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{56E28B45F3A9A823}" {
     m_iOrder 7
     m_sTitle "Situation "
     m_sContent "You are Major Pilote, J., Callsign 'Eggman'. Your F4-G two seater aircraft has just been shot down while conducting a strike on a soviet radar site over newly occupied West Germany. You are deep behind enemy lines and you don't know if your weapon system operator survived his ejection or not. "\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{5EA23EE591F30C93}" {
     m_iOrder 8
     m_sTitle "Situation Enemy"
     m_sContent "This area is secure. There is the potential for stay behind troops, saboteurs or local militia to be operating in our AO and they may be as interested in recovering these pilots as we are."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{D11567C7544E30C8}" {
     m_iOrder 9
     m_sTitle "Execution"
     m_sContent "Whatever you do, do not be caught helping the pilot or overtly obstructing the Soviets, or you may be shot."
     m_aFactionKeys {
      "CIV"
     }
    }
    GC_Briefing "{B0C01AF1F83D5D57}" {
     m_iOrder 10
     m_sTitle "Situation Friendly"
     m_sContent "You have 10 men, lightly armed with mismatched small arms including one LMG and one GPMG. "\
     "You have no anti-armor capability. You are at Grid 051 070."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{6E979BC7C18C8055}" {
     m_iOrder 11
     m_sTitle "Situation Enemy"
     m_sContent "There is no telling where they will come from, but the Soviets likely have troops en route to your position now."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{CE91D669BBF08203}" {
     m_iOrder 12
     m_sTitle "Situation Friendly"
     m_sContent "You have a full strength motor rifle platoon with small arms including RPGs and RPKs."\
     "Due to your current tasking, your platoon only has one BTR available."\
     "You are at Villeneuve at grid 027 063."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{2760CF8BA250A5E8}" {
     m_iOrder 13
     m_sTitle "Service and Support"
     m_sContent "You have local vehicles and that is all."\
     ""\
     "You may choose to arm yourself for the purpose of self defense IF and only IF you witness soviet forces executing civilians and believe your life to be in imminent danger."\
     ""
     m_aFactionKeys {
      "CIV"
     }
    }
    GC_Briefing "{7E522D04CE4877B5}" {
     m_iOrder 14
     m_sTitle "Situation Civilian"
     m_sContent "The town of Montignac has been largely bypassed and untouched during the opening phases of the war so civilian activity will be high."\
     "They hate the Soviets as much as we do, so we don't expect collaborators or sympathizers, but we can't rule it out either."\
     ""\
     "You should seek out anyone who may have information about the pilot's whereabouts."\
     ""\
     "Under no circumstances should you give them any weapons or military materiel. Doing so could turn the entire town into a target for Soviet reprisals."\
     ""
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{C56323EC3E298E34}" {
     m_iOrder 15
     m_sTitle "Situation Friendly"
     m_sContent "Your WSO landed nearby but you aren't sure if he survived or not. You will need to confirm, but aside from that your best bet is getting picked up by stay behind troops or West German Militia. "\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{6926AE8F29034D7F}" {
     m_iOrder 16
     m_sTitle "Situation Civilian"
     m_sContent "Local civilian population is highly active, having been relatively unscathed by the fighting. "\
     "We expect saboteurs and collaborators will be common among them, but they have quietly accepted their liberation so far."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{5D88D2D90BCB8591}" {
     m_iOrder 17
     m_sTitle "Mission Maker's Intent"
     m_sContent "Civilians are meant to secretly help Blufor and Indfor find each other and complete their objectives since they can blend in with local population."\
     ""\
     "If Soviets get trigger happy, civilians can arm themselves BUT they will become valid targets for Soviets at that point and won't be able to help Blufor or Indfor complete their objectives."
     m_aFactionKeys {
      "CIV"
     }
    }
    GC_Briefing "{BA05DC7CF6F7AC8C}" {
     m_iOrder 18
     m_sTitle "Mission"
     m_sContent "You need to find the downed pilot, identify yourselves as an allied unit, and extract them to the safehouse at grid 057 070."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{4F6797E39D593015}" {
     m_iOrder 19
     m_sTitle "Situation Civilian"
     m_sContent "Civilians should be willing to help you, but they will be putting their lives at risk if the Soviets find out."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{C4EEC11947C16177}" {
     m_iOrder 20
     m_sTitle "Mission"
     m_sContent "Your mission is in two parts."\
     ""\
     "You must rapidly secure Montignac in order to locate and kill both downed pilots, AND"\
     "You must search the town in order to secure any intelligence from the pilots and bring it back to Coy Headquarters at Grid 028 066 in Villeneuve."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{8CCA2FB442B02E3D}" {
     m_iOrder 21
     m_sTitle "Execution"
     m_sContent "Execution is as per the CO's discretion and the situation on the ground."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{9F8DC20292114FF5}" {
     m_iOrder 22
     m_sTitle "Mission"
     m_sContent "Your mission has two parts:"\
     ""\
     "Find your WSO, whether alive or dead, and recover the sensitive targeting information he kept on his person in a bright red folder."\
     ""\
     "Once you've secured the intelligence folder, you will need to convince local civilians and/or militia to enact your escape and evasion plan."\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{1C426F16F51AD65A}" {
     m_iOrder 23
     m_sTitle "Execution"
     m_sContent "Execution is as per the CO's discretion."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{753BE3CF05057F7F}" {
     m_iOrder 24
     m_sTitle "Service and Support"
     m_sContent "You have 4x C4 Blocks with detonator per Sapper. Team Leaders have radios."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{6E681F7E07476D97}" {
     m_iOrder 25
     m_sTitle "Service and Support"
     m_sContent "Transport:"\
     "1x Uaz (seats 5)"\
     "1x Ural (seats 15)"\
     "1x BTR-70 (seats 19 + 3 crew) (Also holds the radio for it's respective squad)"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{1CC3BE27B3FD52A4}" {
     m_iOrder 26
     m_sTitle "Mission Notes"
     m_sContent "The intel you are looking for is a red intel folder. Look for it near another parachute canopy"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{A5EB0E444E92A0FA}" {
     m_iOrder 27
     m_sTitle "Command and Signals"
     m_sContent "Succession of Command:"\
     ""\
     "Spatel HQ"\
     "Spatel 1"\
     "Spatel 2"\
     ""\
     "Codewords:"\
     ""\
     "Pilot Recovered: Brot"\
     "Pilot Killed: Milch"\
     "Pilot Extracted: Frühstück"\
     ""\
     "Challenge:"\
     "Pass:"\
     "Running Password:"\
     ""\
     ""
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{1AA8C288BD08D5D0}" {
     m_iOrder 28
     m_sTitle "Command and Signal"
     m_sContent "Succession of Command:"\
     ""\
     "221 HQ"\
     "221"\
     "222"\
     "223"\
     ""\
     "Codewords:"\
     ""\
     "1 Pilot Killed: Maslo"\
     "Both Pilots Killed: Smetana"\
     "Intelligence Found: Zavtrak"\
     ""\
     ""\
     "Challenge:"\
     "Pass:"\
     "Running Password:"\
     ""\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{4B5F663719C32EBF}" {
     m_iOrder 29
     m_sTitle "ROE"
     m_sContent "Unarmed civilians are not to be engaged under any circumstances. However, if they are carrying a weapon, they are officially combatants and may be fired upon."\
     ""\
     "The Platoon Leader alone has been given special authority to make an example out of civilians found to be assisting the Americans. Use this authority as a last resort, lest we turn the civilian population against us."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
   }
  }
 }
}
