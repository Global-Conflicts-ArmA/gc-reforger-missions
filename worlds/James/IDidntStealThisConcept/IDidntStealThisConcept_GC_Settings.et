   m_aBriefings {
    GC_Briefing "{A7F8BDCAA769B218}" {
     m_iOrder 0
     m_sTitle "Situation"
     m_sContent "a. Enemy Forces:"\
     "G2 indicates enemy consists of a VDV recce platoon in a defensive position around the village of Stary Yar. G2 has advised that they are equipped with small-arms such as AK-74s, RPKs, RPGs, PKM and SVD. G2 believes they will dig in and put up a strong defence of the village."\
     ""\
     "b. Friendly Forces:"\
     "Our platoon is located east of Stary Yar. We are reinforced by the Coy GPMG section. Coy HQ has issued an order to advance through the woods and secure Stary Yar. There are no known friendly forces to the immediate north or south. There are no reinforcements expected."\
     ""\
     "c. Terrain:"\
     "The terrain between our position and Stary Yar consists of wooded areas and patches of open fields. Elevation is relatively level across the AO. To the south is a rock cliff, and to the north is THE VOID."\
     ""\
     "d. Weather:"\
     "Weather is rainy and lightly cloudy. Winds mild. Ground is soft and muddy but should not impede movement."\
     ""\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{ADD9CB42444F399B}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "a. Enemy Forces:"\
     "G2 advises that a reinforced British platoon is forming up to our east. They have been attached a GPMG section. G2 has advised that they are equipped with small-arms such as L85s, L7s and M72s. G2 expects that they will attack our position at Stary Yar."\
     ""\
     "b. Friendly Forces:"\
     "Our platoon is located at Stary Yar. Coy HQ has issued an order to defend and hold the village of Stary Yar. There are no known friendly forces to the immediate north or south. There are no reinforcements expected."\
     ""\
     "c. Terrain:"\
     "The terrain between our position and enemy forces consists of wooded areas and patches of open fields. Elevation is relatively level across the AO. To the south is a rock cliff, and to the north is THE VOID."\
     ""\
     "d. Weather:"\
     "Weather is rainy and lightly cloudy. Winds mild. Ground is soft and muddy but should not impede movement."\
     ""\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{F6E343A2296F7FDB}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "The mission of 1 Platoon is to conduct an attack on Stary Yar located to our west. The objective is to neutralise the enemy force, secure the village, and hold the position until relieved."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{FF7AF75244022C8D}" {
     m_iOrder 3
     m_sTitle "Mission"
     m_sContent "The mission of our platoon is to defend Stary Yar from an attack from our east. The objective is to delay the enemy, neutralise them if possible, and stop thme from taking the village."
     m_aFactionKeys {
      "USSR"
     }
    }
