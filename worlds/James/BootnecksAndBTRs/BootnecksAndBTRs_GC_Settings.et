GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "CA3256C9638B2372"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{7F0231EE80BFE223}" {
     m_iOrder 0
     m_sTitle "Scenario Summary"
     m_sContent "A Royal Marine troop with mortar and recce support attacks understength Soviet Naval Infantry platoon with BTRs in order to seize crossroads at Etoupe."\
     ""\
     "2:1 ratio."\
     "Time Limit - 75 mins."\
     "Setup - 5 mins."\
     ""\
     "Radios:"\
     "	Only the CO, RTOs and MFC have radios on UK side."\
     "	Only the CO, Deputy and BTRs have radios on USSR 		side."\
     ""\
     ""
    }
    GC_Briefing "{65F20C78781D0E3E}" {
     m_iOrder 1
     m_sTitle "PRELIMS"
     m_sContent "a. Current time 0615."\
     ""\
     "b. C Coy advance elements (YOU) loc grid (057,107). OBJ loc grid (053,099)."\
     ""\
     "c. Weather - Overcast with heavy rain. Fog reducing visiblity."\
     ""\
     "d. First light 0545."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{94DC038CAEFAE5A4}" {
     m_iOrder 2
     m_sTitle "ENEMY"
     m_sContent "A coy of marines, equipped with mortars, succesfully landed at Maidens Bay to our NE."\
     "Their current forward line is the beachead."\
     ""\
     "The rest of their bn landed further north at the North Shoals."\
     ""\
     "Further landings were reported to our SE beyond Andres Beacon and the rest of our bn is in heavy contact or are still mobilising."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{D094B07A73482D5C}" {
     m_iOrder 3
     m_sTitle "TASK ORG"
     m_sContent "a. See slot screen."\
     "Recce Tp det OPCON to 2 Tp CO."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{82B679AC0B06F025}" {
     m_iOrder 4
     m_sTitle "HIGHER AND ADJACENT UNITS"
     m_sContent "Artillery fires of the bn are occupied with the contact to the SE and the Airfield north."\
     ""\
     "1st Marine Coy (1.MPR / 875 OBMP) is to def airfield and St Phillipe against attack from NE."\
     ""\
     "2nd Marine Coy (YOU) (2.MPR / 875 OBMP) is to estb def posns south of airfield and keep MSR open. "\
     ""\
     "3rd Mne Coy (3.MPR / 875 OBMP) is to def posns area ident Andres Beacon."\
     ""\
     "4th Res Coy (1.MPR / 883 OBMP) is to mobilise reserve and reinforce."\
     ""\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{544DF24D0F88A5FD}" {
     m_iOrder 5
     m_sTitle "SITUATION"
     m_sContent "a. Enemy Forces."\
     "	(1) Coy (-) setting up def positions around Tyrone."\
     "	(2) Pl sized advance element identfied in area of intersection at Etoupe."\
     "	(3) No known en fires or air threat."\
     "	(4) MLCOA en coy spreads elements to cover approach to Tyrone."\
     ""\
     "b. Friendly Forces."\
     "	(1) Bde Concept. Bde to seize Everon with 40 cdo north and 42 cdo south. 45 in reserve. 40 to land and seize north peninsula to enable use of airfield for follow on elms. "\
     "	(2) Cdo Concept. Cdo to seize north peninsula. A Coy main effort on airfield with B Coy in support. C Coy to move south and establish blocking position south."\
     ""\
     "c. Atts and Dets. See Task Org."\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{41145EF5DB88671D}" {
     m_iOrder 6
     m_sTitle "MISSION"
     m_sContent "2nd Marine Coy defends area around Tyrone, with task to repel enemy attack forward of Tyrone, and to keep the road open to the airfield for reinforcement."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{A47595E98D4DB75D}" {
     m_iOrder 7
     m_sTitle "MISSION"
     m_sContent "C Coy is to attack south of airfield, establish blocking positions in area near Tyrone in order to deny en reinforcements to airfield."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{74E1149CDBCD6D07}" {
     m_iOrder 8
     m_sTitle "ORDER"
     m_sContent "a) Tasks to sub-units."\
     "	The 1st Pl (YOU) is to defend the crossroads at Etoupe against enemy attack and delay the enemy so that the rest of the coy can form defence at Tyrone."\
     ""\
     "	The rest of coy will establish defensive positions to the south of 1st Pl near Tyrone."\
     ""\
     "b. Readiness Times."\
     "	Attack is expected to commence 12/03, 06.20 h. (Five mins from start)"\
     "	Rest of coy established defence vicinity Tyrone 12/03 07.30. (Your time limit)"\
     ""\
     "c. Signals"\
     "	46MHz."\
     "	1st BTR - 221"\
     "	2nd BTR - 222"\
     "	(BTRs, the PL, and Deputy have radios. BTR radios are a stand-in for vehicle rack radios and thus no radios should leave the BTRs)"\
     ""\
     "5. Loc of CO."\
     "	Coy HQ location is with rest of coy near Tyrone, coordinating main defence."\
     ""\
     "6. Succession"\
     "	Coy CO successor: Deputy/2 Pl CO."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{7F4A1413A0B1AB92}" {
     m_iOrder 9
     m_sTitle "EXECUTION"
     m_sContent "a. Concept of Ops. C Coy will establish blocking positions south of airfield by deploying 2 Tp (YOU) forward to seize intersection at Etoupe to block MSR and support main effort. Main effort will be 1 and 3 Tps conducting forward passage of lines and attacking Tyrone. C Coy will regroup and establish final blocking positions at Tyrone."\
     ""\
     "b. 2 Tp (YOU) Mission. Secure the intersection at Etoupe."\
     "	(1) Eliminate advance elements of en coy to our south."\
     "	(2) Establish defensive positions at intersection and support forward passage of lines of 1 and 3 Tps. "\
     ""\
     "c. Fires."\
     "	(1) To support close battle, priority to 1 and 3 Tps attack on Tryone."\
     "	(2) 1 tube is tasked to 2 Tp. (YOU)"\
     ""\
     "g. Coord Instrs."\
     "	(1) Timings. "\
     "		(a) H Hour 2 Tp - 120620. (Five mins from start)"\
     "		(b) Crossroads secure by 120730. (Your time limit)"\
     ""\
     "	(2) Fire Plan. 1 mortar to support 2 Tp, remaining mortars assigned to rest of coy."\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{08FB6F95AD09452F}" {
     m_iOrder 10
     m_sTitle "SERVICE SUPPORT"
     m_sContent "a. No resup available until after Tyrone secured."\
     "b. A medic is attached to 2 Tp to support their attack, and the recce tp det has their own."\
     "c. No transport available."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{B35D5AB99C770459}" {
     m_iOrder 11
     m_sTitle "COMMAND AND SIGNAL"
     m_sContent "a. Locs."\
     "	(1) Main HQ C Coy. Loc with 1 and 3 Tps for main effort."\
     "	(2) Rear HQ C Coy. At trail of coy. Will locate with 2 Tp once Etoupe secure."\
     ""\
     "b. Signal."\
     "	(1) SOI in effect. See slot screen for c/s."\
     "	Additional - MFC c/s is 51B."\
     "	(2) Freqs. "\
     "		46 MHz for Coy Main. "\
     "		45 MHz - Coy Alt."\
     "		44 MHz - MFC"\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{6CBE11B5B68BAA06}" {
     m_iOrder 12
     m_sTitle "End Conditions"
     m_sContent "Win conditions:"\
     ""\
     "	UK:"\
     "		1. OBJ area is held for five minutes with 			no Soviets inside."\
     "		2. Soviet forces have been eliminated."\
     ""\
     "	USSR:"\
     "		1. British forces have been eliminated."\
     "		2. Time limit reached. (75 mins)"\
     ""\
     "GMs feel free to use your judgement and end mission sooner if required."
    }
   }
  }
 }
}
