GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "CF58763D8CA43347"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{AD6F970C9F77242D}" {
     m_iOrder 0
     m_sTitle "Scenario"
     m_sContent "Bradley inf platoon reinforced with cav scout section attacks BMP platoon reinforced with tank."\
     ""\
     "Note: "\
     "I have filled in a lot of sections of the ditches in the open fields to make crossing the terrain easier for vehicles. The forests are still rough terrain for vehicles. The swamp is shallow and traversible by vehicles. You've been warned."\
     ""
    }
    GC_Briefing "{036E307BC1FCE996}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "Enemy:"\
     "Motorised rifle platoon with BMP-1s and a T-72B vicinity Kelloja."\
     "Expected to defend in and around the farmstead."\
     "They may also have use of a dismounted ATGM."\
     ""\
     "Friendly:"\
     "Mechanised infantry platoon with attached cav scout section."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{0F1B33AF196AD55A}" {
     m_iOrder 2
     m_sTitle "Enemy"
     m_sContent "Bradley inf platoon reinforced with scout Bradleys, to our west preparing to attack our position."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{5A691A6836296D0A}" {
     m_iOrder 3
     m_sTitle "Mission"
     m_sContent "Attack and secure the farmstead marked Kelloja."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{C4D5059FF04047D8}" {
     m_iOrder 4
     m_sTitle "Mission"
     m_sContent "Prevent US forces crossing the Ruha river."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{BDEF6A0F56D1C2DA}" {
     m_iOrder 5
     m_sTitle "Sustainment"
     m_sContent "Additional small arms ammo in the vehicles."\
     "M2 Bradleys also have additional dismounted AT and 4x extra TOWs."\
     "'M3' Bradleys have 10x extra TOWs."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{9FA6A22D5556D01A}" {
     m_iOrder 6
     m_sTitle "Orders"
     m_sContent "Defend the farmstead at Kelloja. Prevent US mech platoon from taking the marked area."\
     ""\
     "You have additional ammo and AT in your vehicles."\
     ""\
     "Platoon net 42MHz."\
     "1st BMP - 431"\
     "2nd BMP - 432"\
     "3rd BMP - 433"\
     "T-72 - 553"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{8C0445C22839B91A}" {
     m_iOrder 7
     m_sTitle "Command and Signal"
     m_sContent "Inf platoon net 48MHz"\
     "Scout net 47Mhz (Optional)"\
     ""\
     "Inf platoon HQ - D16"\
     "Inf platoon PSG - D17"\
     "Inf plt 1st Squad - D11"\
     "Inf plt 2nd Squad - D12"\
     "Inf plt 3rd Squad - D13"\
     ""\
     "Scout section lead - K13"\
     "Scout sect wingman - K14"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{8E30CBF3A06E4563}" {
     m_iOrder 8
     m_sTitle "Whats a Master Gunner?"
     m_sContent "PL commands HQ BFV when mounted with master gunner in gunner seat."\
     "Upon dismount master gunner takes over HQ vic and the spare gunner takes the gunner seat."\
     ""\
     "PSG commands from the last BFV and leads the mounted element. "\
     "That BFV's SL & Asst SL dismounts."
     m_aFactionKeys {
      "US"
     }
     m_eAudience 1
    }
    GC_Briefing "{BFBF7953CEAE9A15}" {
     m_iOrder 9
     m_sTitle "Scouts?"
     m_sContent "When mounted, scouts act as loaders for the CFVs. "\
     "For most of the mission they are likely to be riding in back of a CFV, hence the slot last instruction."\
     "If people want to vibe in the back and load TOWs then be my guest. "\
     "They are NOT rambo slots."\
     ""
     m_aFactionKeys {
      "US"
     }
     m_eAudience 1
    }
    GC_Briefing "{6E98EB881D8EC721}" {
     m_iOrder 10
     m_sTitle "Why dont my Soviet SLs have radios?"
     m_sContent "The SL commands the BMP when mounted. If he wants to mount he can take a radio from the driver."\
     ""\
     "When dismounted he has no radio, and the BMP can relay orders."\
     ""\
     "If/when the infantry is seperated from their BMPs the PL is expected to lead the dismounted force and communicate to the vehicles over the radio. Use runners if you need."
     m_aFactionKeys {
      "USSR"
     }
     m_eAudience 1
    }
    GC_Briefing "{5093611BE9138055}" {
     m_iOrder 11
     m_sTitle "How to use ATGMs"
     m_sContent "All vehicles can cycle to their ATGM by pressing V."\
     ""\
     "To reload, look at rear of ATGM launcher and hold interact."\
     ""\
     "Mounted infantry in back of Bradleys can reload the TOW if you open the hatch and angle the turret correctly."\
     ""\
     "BMP Gunner can reload Konkurs by looking toward back of turret."
    }
    GC_Briefing "{5F20CED1AE1E51AD}" {
     m_iOrder 12
     m_sTitle "End Conditions"
     m_sContent "Time limit 65 mins, inclusive of 5 min setup."\
     ""\
     "BLU wins when OPF mostly dead (hint appears at 85% casualties)"\
     "BLU wins when cap zone held by BLU with no OPF."\
     "OPF wins when BLU mostly dead (hint appears at 85% casualties)"\
     "OPF wins when time limit reached and cap zone not held by BLU."\
     ""
    }
   }
  }
 }
}
