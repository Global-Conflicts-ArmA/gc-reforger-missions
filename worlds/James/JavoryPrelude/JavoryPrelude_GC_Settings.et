     m_eAudience 1
    }
    GC_Briefing "{13CBEAE2BAF1D63F}" {
     m_iOrder 1
     m_sTitle "Prelims"
     m_sContent "Objective is farmstead grid [047,094]."\
     "Our location: West of OBJ grid [035,089]."\
     "Weather: Overcast with heavy rain."\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{B0F8D6063DF85C24}" {
     m_iOrder 2
     m_sTitle "Enemy"
     m_sContent "British infantry in Land Rovers moving East. Estimated 8 vehicles. Current position grid [036,088]. Expected contact at your front within 10 minutes"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{41C88D2456657CFA}" {
     m_iOrder 3
     m_sTitle "Situation"
     m_sContent "Enemy:"\
     "One NVA platoon. Going firm in and around the farmstead. They have no artillery support, but expect heavy MG fire from the BTRs."\
     ""\
     "Friendly:"\
     "You are the lead element. Attached is the recce platoon with 4x land rovers with .50 cals and GPMGs for fire support."\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{AF48E80FFE3FBD8D}" {
     m_iOrder 4
     m_sTitle "Mission"
     m_sContent "1st Platoon is to occupy and defend the farmstead at grid [047,094]. You are the forward strong point. Task is to delay the enemy and prevent a breakthrough toward the village Javory."
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{231EABCE1F1641B9}" {
     m_iOrder 5
     m_sTitle "Mission"
     m_sContent "Seize and hold the farmstead to secure the route for the main assault on the village Javory."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{BC6CF431D5FE4FBC}" {
     m_iOrder 6
     m_sTitle "Execution & Coordination"
     m_sContent "Sector of Defense: From the airfield perimeter to your north, to the treeline 600-700m south. Front line is treelines approx 300-400m forward."\
     ""\
     "Main Effort: Block the primary East-West road into Javory."\
     ""\
     "Constraint: You have no external fire support. Use organic weapons to engage the enemy."\
     ""\
     "Readiness: Full combat readiness in 5 minutes."
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{4A6DADFB877B43C9}" {
     m_iOrder 7
     m_sTitle "Sustainment"
     m_sContent "4x MG Land Rovers with .50 cals and GPMGs."\
     "3x long wheelbase Land Rovers, 2x short wheelbase Land Rover as transport."\
     "1 SWB Rover has a mounted GPMG and explosives for Pioneer Section."\
     "Each LWB Land Rover has extra 556, frags, smoke and 2x LAWs."\
     "MG Land Rovers have 1 LAW each."
     m_aFactionKeys {
      "UK"
     }
    }
