   m_aBriefings {
    GC_Briefing "{A6F162C1FD78EF25}" {
     m_iOrder 0
     m_sTitle "Scenario"
     m_sContent "US mechanised infantry platoon with Bradleys reinforced with cav scout attacks position on edge of Torske held by motorised rifle platoon with BMPs."\
     ""\
     "Weather: Overcast"\
     "H-hour: 0930"
    }
    GC_Briefing "{45D40FE8E8878A33}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "Enemy:"\
     "Motorised rifle platoon with BMPs vicinity SE Torske."\
     "Expected to defend approach to Torske."\
     ""\
     "Friendly:"\
     "Mechanised infantry platoon with M113s, reinforced with a Cav scout M3 Bradley section."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{70FCF8ED54C6478E}" {
     m_iOrder 2
     m_sTitle "Enemy"
     m_sContent "Mechanised infantry platoon with M113s and Bradley fighting vehicles forming up to our east. "\
     "Expect them to attack in the direction of Torske."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{013882851EFA02C4}" {
     m_iOrder 3
     m_sTitle "Mission"
     m_sContent "Attack and secure the marked area."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{FE16090739880DC1}" {
     m_iOrder 4
     m_sTitle "Mission"
     m_sContent "Defend Torske against enemy attack."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{6CD7447E2B2CD43E}" {
     m_iOrder 5
     m_sTitle "Sustainment"
     m_sContent "M113s have additional ammo, including extra disposable AT."\
     ""\
     "'M3' Bradley has 10x TOW reloads."\
     ""\
     ""\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{7DFF6D4F58EAD4BF}" {
     m_iOrder 6
     m_sTitle "Orders"
     m_sContent "331 Plt is to defend the approach to Torske on the SE side of town against enemy attack in the direction of Torske."\
     ""\
     "You have been given an additional PKM MG, stored in the BMP, alongside additional ammo and disposable AT."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{D23AA76410C1ACDF}" {
     m_iOrder 7
     m_sTitle "Command and Signal"
     m_sContent "Platoon net 48MHz"\
     ""\
     "1st Plt HQ - A16"\
     "1st Plt PSG - A17"\
     "1st Plt 1st Sqd - A11"\
     "1st Plt 2nd Sqd - A12"\
     "1st Plt 3rd Sqd - A13"\
     ""\
     "Cav scouts - G25, G26"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{989A1396CDBE2E4D}" {
     m_iOrder 8
     m_sTitle "Timings"
     m_sContent "Hold off the attack for 65 minutes."\
     "You have approx 5 mins to setup before the US attack."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{05E008D5260337E2}" {
     m_iOrder 9
     m_sTitle "How to use ATGMs"
     m_sContent "Hold V to cycle weapons to select ATGM."\
     ""\
     "To reload, look at rear of ATGM launcher and hold interact."\
     "Mounted inf in back can reload the Bradleys if you open the hatch and angle the turret correctly."
     m_eAudience 2
    }
    GC_Briefing "{89E0BADE42B93E18}" {
     m_iOrder 10
     m_sTitle "Scouts?"
     m_sContent "When mounted, scouts act as loaders for the CFVs."\
     "For most of the mission they are likely to be riding in back of a CFV, hence the slot last instruction."\
     "If people want to vibe in the back and load TOWs then be my guest."\
     "They are NOT rambo slots."
     m_aFactionKeys {
      "US"
     }
     m_eAudience 1
    }
    GC_Briefing "{E3CCFDC1D7870ED1}" {
     m_iOrder 11
     m_sTitle "Why dont Soviet SLs have radios?"
     m_sContent "The SL commands the BMP when mounted. If he wants to stay mounted he can take a radio from the driver."\
     ""\
     "When dismounted he has no radio, and the BMP can relay orders."\
     ""\
     "If/when the infantry is seperated from their BMPs the PL is expected to lead the dismounted force and communicate to the vehicles over the radio. Use runners if you need."\
     ""
     m_aFactionKeys {
      "USSR"
     }
     m_eAudience 1
    }
    GC_Briefing "{27A87F0870509936}" {
     m_iOrder 12
     m_sTitle "Mission Notes"
     m_sContent "Time limit is 65 mins, inclusive of 5 min setup."\
     ""\
     "End conditions:"\
     "BLU wins when OPF combat ineffective (hint appears at 85% but GMs can use judgement)."\
     "OPF wins when BLU combat ineffective (hint appears at 85%)."\
     "BLU wins when OBJ secured with no OPF inside OBJ area."\
     "OPF wins when time limit reached and BLU not secured OBJ."\
     ""
    }
   }
  }
 }
}
