GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "9623BCD3A228F596"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{4DCEACEEDD255898}" {
     m_iOrder 0
     m_sTitle "Enemy"
     m_sContent "Two weeks ago mujahideen insurgents attacked and took over the town of Khandar Abad. They seized control of the local police station and are using it as their HQ."\
     ""\
     "We believe they have raided the police station for weapons, as well being supplied by the western capitalist pig dogs, thus we expect tthme to be well armed."\
     "We suspect they may also have access to heavy weapons such as AAA guns and HMGs."\
     ""\
     "We estimate the enemy is dispersed across three strongpoints, identified on your maps."\
     ""\
     "The first strong point, closest to your staging position, occupied by approx 15-20 fighters."\
     ""\
     "The second, the main element where the HQ is established, on the high ground, approx 20-25 fighters."\
     ""\
     "The third, furthest to the west, held by approx 10-15 fighters."\
     ""\
     "They may also call for reinforcements from the mountains."
    }
    GC_Briefing "{DA669969CB387121}" {
     m_iOrder 1
     m_sTitle "Higher Mission"
     m_sContent "The battalion mission is to clear the Pech Valley of mujahideen insurgents."
    }
    GC_Briefing "{AF133501CA39F660}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "Your mission is to conduct an attack on the insurgents at Khandar Abad, clear them out, in order to retake the town and reestablish communist control."
    }
    GC_Briefing "{3956F02A8103148B}" {
     m_iOrder 3
     m_sTitle "Orders"
     m_sContent "You are to attack and clear the town of insurgents."\
     ""\
     "You are to do this by seizing each of the marked strongpoints and clearing them of enemy fighters. "\
     ""\
     "HQ believes that seizing the high ground will drive any remaining rebels out of the area."\
     ""\
     "You have been reinforced with a tank (number 351), which will lead the first platoon's vehicles to form the bronegruppa."\
     ""\
     "Division artillery will conduct prepatory fires on the town. "\
     ""\
     "Once complete, use your bronegruppa, AGS', and MGs to establish fire superiority and attack the the strongpoints with your infantry."
    }
    GC_Briefing "{4317DC63567773BE}" {
     m_iOrder 4
     m_sTitle "Timings"
     m_sContent "You have 65 minutes to complete the mission."\
     ""\
     "At H-Hour +5 mins division artillery will fire on the town in advance of your attack."
    }
    GC_Briefing "{F5DB83E10C9CB3F2}" {
     m_iOrder 5
     m_sTitle "AGS Notes"
     m_sContent "The AGS is deployed by placing the AGS and tripod on the ground next to each other."\
     ""\
     "Then using your shovel you can interact with the tripod to create the AGS."\
     ""\
     "Additional AGS ammo is stored in the BMPs."\
     "VOG is HE."\
     "VUS is smoke."\
     ""\
     ""
    }
    GC_Briefing "{B26AD4C01DDD78B5}" {
     m_iOrder 6
     m_sTitle "Mission Notes"
     m_sContent "Time limit is 65 minutes."\
     "This is to give five minutes at start for company form up."\
     ""\
     "Scripted artillery will begin five minutes in."\
     ""\
     "USSR wins once all three strongpoints are cleared of enemy."\
     ""\
     "USSR loses when combat ineffective. A hint will appear at 85% casualties but GMs should use their best judgement to call when they deem the force to be ineffective."
    }
   }
  }
 }
}
