GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "050E50A64CBE4187"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{F252A253D47B7FAA}" {
     m_iOrder 0
     m_sTitle "Briefing: Situation."
     m_sContent "I. Situation:"\
     "Afghanistan, 1987."\
     "Local Time: 0800"\
     "Weather: Clear"\
     ""\
     "Our cell from Zavarak and our brothers in Karachinar are currently under attack. A Soviet Motor Rifle battalion is sweeping the towns and surrounding farmland for our weapons caches."\
     "We are moving to support the Karachinar cell in their defence."\
     "There are western supplied weapons in these caches and they must not fall into Soviet hands."\
     ""\
     "Ia. Friendly Forces:"\
     "PLAYER UNIT (East of the AO):"\
     "1x Light Infantry Cell."\
     "We have 2x captured Soviet trucks for transport."\
     ""\
     "Ib. Enemy Forces:"\
     "1x Company of Soviet Motor Rifles, a platoon of them are watching over the route from our start point to the caches."
     m_aFactionKeys {
      "GC_MUJ"
     }
    }
    GC_Briefing "{EC203830F7CEB27E}" {
     m_iOrder 1
     m_sTitle "Briefing: Situation."
     m_sContent "I. Situation:"\
     "Afghanistan, 1987."\
     "Local Time: 0800"\
     "Weather: Clear"\
     ""\
     "We are 2nd Battalion, 2nd Company under the 180th Motor Rifle Regiment, during Operation Magistral."\
     "Our company is conducting a sweep of the routes through the town of Karachinar and the surrounding area. Our 3rd platoon is providing security to the East."\
     "We have been tasked by the battalion with locating and securing Mujahideen ammunition caches in the farmland outside of Karachinar. "\
     ""\
     "Ia. Friendly Forces:"\
     "PLAYER UNIT:"\
     "1x company of Motor Rifles in BTR-70s."\
     "ADJACENT UNITS:"\
     "3rd platoon (217) are providing security to the East."\
     ""\
     "Ib. Enemy Forces:"\
     "1x Platoon sized force of Mujahideen fighters defending the weapons caches."\
     "They have 2x captured Ural trucks."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{46E7775A88F0F3D1}" {
     m_iOrder 2
     m_sTitle "Briefing: Mission."
     m_sContent "II. Mission:"\
     "Our Cell must DEFEND the marked caches by DESTROYING the attacking Soviet force."\
     ""\
     "III. Execution:"\
     "As Per CO's intent."\
     ""\
     "IV. Command/Signals:"\
     "Cell Command Group - 1"\
     "Fighting Groups - 2/3/4"\
     ""\
     "V. Service/Support:"\
     "No Fire Support."\
     "No Resupply."\
     "Both trucks contain 6 demo blocks."
     m_aFactionKeys {
      "GC_MUJ"
     }
    }
    GC_Briefing "{47819D23215333BB}" {
     m_iOrder 3
     m_sTitle "Briefing: Mission."
     m_sContent "II. Mission:"\
     "Our platoon is to SEIZE the 3x compounds in the farmland outside of Zavarak containing western supplied AT and AA weaponry to the Mujahideen."\
     ""\
     "III. Execution:"\
     "As Per CO's intent."\
     ""\
     "IV. Command/Signals:"\
     "Company HQ - 220"\
     "1st Platoon - 221/222/223"\
     "2nd Platoon - 224/225/226"\
     ""\
     "V. Service/Support:"\
     "No Fire Support."\
     "No Resupply."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{52E058AEBFF52350}" {
     m_iOrder 4
     m_sTitle "Briefing: Notes."
     m_sContent "VI. End Conditions:"\
     "Time Limit - Unlimited"\
     ""\
     "Soviet Win:"\
     "All 3 compounds seized. (captured once by the Soviets)"\
     "100% Mujahideen casualties inflicted."\
     ""\
     "Mujahideen Win:"\
     "90% Soviet casualties inflicted."
    }
   }
  }
 }
