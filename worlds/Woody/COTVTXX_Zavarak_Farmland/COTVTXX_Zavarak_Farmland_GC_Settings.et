   m_aBriefings {
    GC_Briefing "{A75F188CF1E0174B}" {
     m_iOrder 0
     m_sTitle "Briefing: Situation."
     m_sContent "I. Situation:"\
     "Afghanistan, 1987."\
     "Local Time: 0800"\
     "Weather: Clear"\
     ""\
     "We have ambushed and destroyed a platoon of Soviet Motor Rifles on the road to our West. This has spurred the rest of their company to conduct a sweep of our weapons caches in the farmland outside of Zavarak."\
     "There are western supplied weapons in these caches and they must not fall into Soviet hands."\
     ""\
     "Ia. Friendly Forces:"\
     "PLAYER UNIT (South of the AO):"\
     "1x Light Infantry Cell."\
     ""\
     "Ib. Enemy Forces:"\
     "1x Company(-) of Soviet Motor Rifles"
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{65C99E42FE2BBB25}" {
     m_iOrder 1
     m_sTitle "Briefing: Situation."
     m_sContent "I. Situation:"\
     "Afghanistan, 1987."\
     "Local Time: 0800"\
     "Weather: Clear"\
     ""\
     "We are 2nd Battalion, 2nd Company under the 180th Motor Rifle Regiment, during Operation Magistral."\
     "Our company is conducting a sweep of the routes through the town of Zavarak and the surrounding area. Our 3rd platoon and a vehicle from 2nd platoon were destroyed by enemy action during this mornings sweep."\
     "We have been tasked by the battalion with locating and securing Mujahideen ammunition caches in the farmland outside of Zavarak in reaction to these losses. "\
     ""\
     "Ia. Friendly Forces:"\
     "PLAYER UNIT:"\
     "1x reduced company of Motor Rifles in BTR-70s."\
     "ADJACENT UNITS:"\
     "3rd platoon (217) were ambushed and destroyed while scouting a route around the farmland."\
     ""\
     "Ib. Enemy Forces:"\
     "1x Platoon sized force of Mujahideen fighters defending the weapons caches."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{75763B7A475B7BB0}" {
     m_iOrder 2
     m_sTitle "Briefing: Mission."
     m_sContent "II. Mission:"\
     "Our Cell must DEFEND the marked caches by DESTROYING the attacking Soviet force."\
     ""\
     "III. Execution:"\
     "As Per CO's intent."\
     ""\
     "IV. Command/Signals:"\
     "Cell Command Group - 1"\
     "Fighting Groups - 2/3/4"\
     ""\
     "V. Service/Support:"\
     "No Fire Support."\
     "No Resupply."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
