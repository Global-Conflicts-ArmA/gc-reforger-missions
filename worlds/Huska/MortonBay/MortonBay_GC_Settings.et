GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "3AFF32FE7605E631"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{98E15D350E7E87EE}" {
     m_iOrder 0
     m_sTitle "Summary"
     m_sContent "US Army Mech. Platoon supported by a USMC LAR Platoon conduct an amphibious assault on Seagull Point and then seize Morton."
     m_eAudience 1
    }
    GC_Briefing "{7935E1A9C69F8FE2}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "September 1990"\
     ""\
     "Manuel Wade has declared himself President of Everon. The FIA under his command, supported and armed by the USSR, has siezed power on the island of Everon."\
     ""\
     ""\
     "Friendly"\
     "A US Army mechanized infantry platoon (1st Platoon) supported by a USMC LAR Platoon will sieze Seagull Point and Morton."\
     ""\
     "US Army 2nd and 3rd Platoon have taken heavy casualties to our north in an attempt to break through to Morton over land. Their attack has stalled out."\
     ""\
     ""\
     "Enemy"\
     "The enemy has setup a hastey defense at Seagull Point and Morton after learning of our planned attack. We expect them to reinforce Seagull Point after we land on the beach. They will also setup ambushes as we approach Morton and will attempt to hold the city at all costs."\
     ""\
     "The enemy force consists of regular and irregular FIA forces loyal to the president. They may have BTR70s, BRDMs, and UAZs from the nearby national guard base."
     m_eAudience 2
    }
    GC_Briefing "{556F7461B4605150}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "Conduct an amphibious assault on OBJ Seagull. Defeat the enemy and sieze OBJ Seagull."\
     ""\
     "Regroup and assault the city of Morton (OBJ Mike)."
     m_eAudience 2
    }
    GC_Briefing "{A841EFEF4CD3D5A5}" {
     m_iOrder 3
     m_sTitle "Signals"
     m_sContent "US Army 1st Platoon (Alpha 1): 48.0"\
     "USMC LAR Platoon (Echo 5): 49.0"\
     "Company Net: 50.0"\
     ""\
     ""\
     "Callsigns"\
     ""\
     "US Army 1st Platoon: Alpha 1"\
     "Platoon HQ: 1'6"\
     "1st Platoon Squad 1: 1'1"\
     "1st Platoon Squad 2: 1'2"\
     "1st Platoon Squad 3: 1'3"\
     "1st Platoon Squad 4: 1'4"\
     ""\
     "USMC LAR Platoon: Echo 5"\
     "USMC LAR 1 (HQ): 5'1"\
     "USMC LAR 2: 5'2"\
     "USMC LAR 3: 5'3"\
     "USMC LAR 4: 5'4"
     m_eAudience 2
    }
    GC_Briefing "{259CFFF88462B318}" {
     m_iOrder 4
     m_sTitle "Mission Notes"
     m_sContent "US Army Platoon Leader is overall CO."\
     ""\
     "OBJ Seagull must be attacked first."\
     ""\
     "LAVs and M113s are faster in the water to reduce swim time."\
     "Each USMC LAR squad has a LAV, each US Army squad has an M113. US Army Platoon section has an additional medical M113."\
     ""\
     "GM can fix AI and has choice on when to end the mission if required."\
     ""\
     "End conditions:"\
     "OBJ Seagull and then OBJ Mike secured by USA."\
     "USA 100% casualties."\
     ""\
     "Mission Maker: Huska"
     m_eAudience 2
    }
   }
  }
 }
}
