  m_sTextData "<h2>Situation</h2>"\
  "<b>Enemy forces</b>"\
  "Soviet infantry, platoon (+) strength, supported by BTRs"\
  "Located around 200m ahead of friendly positions and beyond."\
  "Strongpoints likely include Javory proper, the elevated ruins and the church on the hill."\
  "<b>Friendly forces</b>"\
  "One platoon of British Light infantry, located on the northern side of the creek."\
  ""\
  "<h2>Mission</h2>"\
  "Clear all 3 marked strongpoints of enemy forces (in order)."\
  ""\
  ""
  m_aVisibleForFactions {
