  }
 }
 brief_ussr {
  coords 0 0 0
  m_sTitle "Briefing"
  m_sTextData "<h2>Situation</h2>"\
  "<b>Enemy forces</b>"\
  "British light infantry, approaching from the northern side of the creek. Their goal is to destroy strongpoints around Javory and beyond."\
  ""\
  "<b>Friendly forces</b>"\
  "Overstrength platoon of motorized rifle troops. Strongpoints include the 3 marked areas: Javory proper, the elevated ruins and the church on the hill."\
  "You are manning of the BTRs."\
  ""\
  "<h2>Mission</h2>"\
  "Support the infantry by moving around the AO at your discretion and conducting ambushes on advancing enemy forces."
  m_aVisibleForFactions {
   "USSR"
  }
 }
 brief_overview {
  m_sTitle "Overview"
  m_sTextData "British light infantry assault on Soviet forces"\
  ""\
  "I recommend only slotting the Soviet BTR if more than 20 players are present (and play as COOP otherwise), but do as you like."
  m_bEmptyFactionVisibility 1
 }
 brief_notes {
  coords 0 0 0
  m_sTitle "Notes"
  m_sTextData "1 minute setup timer restricting UK"\
  ""\
  "End conditions:"\
  "- UK Victory: All 3 strongpoints cleared"\
