    GC_Briefing "{C00FE33998A78E16}" {
     m_iOrder 1
     m_sTitle "Briefing"
     m_sContent "<b>SITUATION</b>"\
     "a. Enemy Forces"\
     "British light infantry platoon (-) , defending Koskelankyla"\
     "b. Friendly Forces"\
     "NVA motorized rifle platoon at 028 004, equipped with SPW-70s"\
     "Mortar element at 029 005"\
     ""\
     "<b>MISSION</b>"\
     "You are to assault Koskelankyla and secure the area south east of the bridge within 40 minutes."\
     ""\
     "<b>EXECUTION</b>"\
     "-"\
     ""\
     "<b>SERVICE SUPPORT</b>"\
     "No resupply apart from the spare ammunition in the SPW-70s"\
     "Mortar fire support is available (unlimited HE+smoke)"\
     ""\
     "<b>COMMAND AND SIGNAL</b>"\
     "Callsigns: HQ, 241, 242, 243, Mortar"\
     "Platoon net: 42.0MHz"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{169B722AF64D4273}" {
     m_iOrder 2
     m_sTitle "Briefing"
     m_sContent "<b>SITUATION</b>"\
     "a. Enemy Forces"\
     "NVA motorized rifle platoon, equipped with BTR-70s"\
     "Most likely has mortar fire support available"\
     "b. Friendly Forces"\
     "HQ element and 2 squads of British light infantry (034 019)"\
     ""\
