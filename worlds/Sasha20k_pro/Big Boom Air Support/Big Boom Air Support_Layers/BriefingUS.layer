$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 {
  coords 558.728 138.135 4513.902
  m_sTitle "SITUATION"
  m_sTextData "<b>SITUATION</b>"\
  ""\
  "We have an armored Column consisting of 3 inoperable M2A3 BUSK Bradleys and 2 inoperable M1A2 Abrams which just went out of fuel in its emergency retreat and Separatists have been reported nearby, beacose of this we dismounted One Squad to Protect the Armored Column and one APACHE with Rockets and Stingers to Provide air support (and its crew)<b> 3mins after freeze time ends</b>."\
  ""\
  "The Separatist ground Forces Consist of one Platoon, Probably With some APC or Technical Transport."\
  ""\
  ""\
  "Friendlies can move in their AO anytime they want but when freeze time goes out Separatists will start moving"\
  ""\
  "<b>Friendlies and Enemy CANNOT Enter any vehicle in the Armored column</b>"
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 1
 }
 {
  coords 649.757 134.116 4314.264
  m_sTitle "FRIENDLY FORCES"
  m_sTextData "<b>FRIENDLY FORCES</b>"\
  ""\
  "Protect the Armored Column for 45 minutes or Kill all Separatists"
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 2
 }
 {
  coords 805.184 138.688 4069.067
  m_sTitle "ENEMY FORCES"
  m_sTextData "<b>ENEMY FORCES</b>"\
  ""\
  "US Defeat: Armored Column Fully Destroyed"\
  "US Victory: 45 Min Pass or All Separatists Killed"\
  ""\
  "APACHE: "\
  "Its Crew Can only start its Engine <b>3 mins after freeze time</b> which will be when <b>a text saying APACHEs Out pops up</b>."\
  ""\
  "COMMAND:"\
  "Rifle Squad SL Commands the Mission due to the PHQ being Busy rn"\
  ""\
  "Radio:"\
  "MHz 48: Command net"\
  "MHz 47: Rifle Squad net"
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 3
 }
