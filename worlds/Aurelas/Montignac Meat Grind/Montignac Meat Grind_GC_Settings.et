   m_aBriefings {
    GC_Briefing "{F3C0491D509D3909}" {
     m_iOrder 0
     m_sTitle "Description"
     m_sContent "Paratroopers from the US and the UK fight over the town of Montignac as part of a NATO training exercise."\
     ""\
     "Ratio:"\
     "1:1"\
     ""\
     "Weather: Random(Can be edited by GM if deemed necessary)"\
     ""
     m_eAudience 1
    }
    GC_Briefing "{E7C849434E70A829}" {
     m_iOrder 1
     m_sTitle "Notes"
     m_sContent "For balancing purposes the British troops are provided with body armor so they will have comprable weights and protective capabilities."\
     ""\
     "Special thanks to HotMic, Gabe, Wade, and AC337 for the help when creating this mission!"
     m_eAudience 1
    }
    GC_Briefing "{B2CBFA68E0CE697E}" {
     m_iOrder 2
     m_sTitle "1. SITUATION"
     m_sContent "15 minutes ago Airborne Elements from the United Kingdom and United States dropped across Everon as part of a Joint Nato training exercise. This exercise is intended to test the two countries against each other."\
     ""\
     "Your platoon has been assigned with securing the town of Montignac and deploying a radio relay from the roof of the church to establish a communication network across the island. To achieve this goal you must capture the city center of Montignac."\
     ""\
     "A. Enemy Forces"\
     "A platoon sized element of American paratroopers were spotted dropping East of Montignac as you were falling."\
     ""\
     "B. Friendly Forces"\
     ""\
     "You, a British Airborne platoon have landed West of Montignac and rallied near a Farmhouse about 1km West of Montignac."\
     "You are composed of a Platoon HQ, 3 Rifle Sections, and a MG Section."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{151B30CCC281B852}" {
     m_iOrder 3
     m_sTitle "1. SITUATION"
     m_sContent "15 minutes ago Airborne Elements from the United Kingdom and United States dropped across Everon as part of a Joint Nato training exercise. This exercise is intended to test the two countries against each other."\
     ""\
     "Your platoon has been assigned with securing the town of Montignac and deploying a radio relay from the roof of the church to establish a communication network across the island. To achieve this goal you must capture the city center of Montignac."\
     ""\
