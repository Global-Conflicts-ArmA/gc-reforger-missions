GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "82E475F2D080B9B5"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{7EB78BE44F1350FF}" {
     m_iOrder 0
     m_sTitle "Situation:"
     m_sContent "October 10, 2024"\
     "Time: 0100"\
     "Weather: Random"\
     ""\
     "Background:"\
     "On the one year anniversary of the deadly attack on Isreal, Bashar al-Assad launches a series of chemical attacks across Southern Greece, targeting highly Christian population and NATO infrastructures. This unprovoked aggression has forced NATO into a renewed Middle Eastern conflict, supporting Isreal against radical Islamic terrorism. "\
     ""\
     "Current:"\
     "NATO has since captured most of Syria in the 3 day operation and a USMC company has just taken Damascus airport denying Assad his desperate escape. Intelligence suggests that Assad and his sons have fortified themselves within two key locations in Southern Syria: a walled mosque compound and his private mansion estate on the outskirts near the boarder of Jordan. Both locations are believed to house key figures in Assad’s lineage and regime leadership. "\
     ""\
     "Task:"\
     "The USMC platoon is tasked with eliminating Assad and his sons, ending the conflict and finally bring peace to Syria."
     m_eAudience 2
    }
    GC_Briefing "{9EE97C37002B9AD2}" {
     m_iOrder 1
     m_sTitle "Mission:"
     m_sContent "The Mission is to find and neutralize Assad and his sons. This high-risk operation is a direct action mission aimed at terminating Assad’s leadership and eliminating any possibility of succession, while also extracting."
     m_eAudience 2
    }
    GC_Briefing "{0FDB01A81615A9DC}" {
     m_iOrder 2
     m_sTitle "Mission Notes:"
     m_sContent "⬤ Spawn Instructions ⬤"\
     "Upon mission start, each squad will spawn in front of a designated Blackhawk."\
     "Helicopters are arranged in ascending order (e.g., 1, 2, 3, & 4)."\
     "Infantry squads should board the Blackhawk directly in front of them."\
     "Pilots and Platoon HQ spawn together near the helicopter lineup for coordinated deployment."\
     ""\
     "⬤ Medical Support ⬤"\
     "Medics begin with a full medical loadout."\
     "Additional ACE medical supplies are available in the medical crate, located near spawn and marked by two floodlights for visibility in low-light conditions."\
     ""\
     "⬤ Night Vision Options ⬤"\
     "Players can change their NVG color variant at the equipment crate, also illuminated by two floodlights near the spawn point."\
     "Swap out the default model if the current tint is uncomfortable or obstructive."\
     ""\
     "⬤ Helicopter Service Pads ⬤"\
     "All helicopter pads provide full support:"\
     "- Repair"\
     "- Rearm"\
     "- Refuel"\
     "Pilots should use these pads to maintain airframe readiness between insertions and extractions."\
     ""\
     "⬤ Mission Maker ⬤ "\
     "Original: Reznov"\
     "Current: Hot Mic"
     m_eAudience 2
    }
    GC_Briefing "{6DADDA697FB2A11F}" {
     m_iOrder 3
     m_sTitle "Assads Last Stand"
     m_sContent "A USMC force is tasked with searching two compounds in Syria under the cover of darkness, neutralizing Assad and his two sons."
     m_eAudience 1
    }
    GC_Briefing "{DBFFCFB02BF34120}" {
     m_iOrder 4
     m_sTitle "Friendly & Enemy Forces:"
     m_sContent "-- Friendly Forces --"\
     "1x USMC Platoon."\
     ""\
     "x4 AH6M Littlebirds (Guns & Unguided Rockets)."\
     "x2 AH6M Transport."\
     "x4 UH-60 Black Hawk (Armed)."\
     ""\
     "-- Enemy Forces --"\
     "Unknown company size. Assad is at his end and will be heavily guarded. Expect HEAVY AA. Our preditor drone located mutiple AA in and around both objectives. "\
     ""\
     ""
     m_eAudience 2
    }
    GC_Briefing "{253D67AE04CC788D}" {
     m_iOrder 5
     m_sTitle "End Conditions:"
     m_sContent "Victory: Kill all three targets and extract back to the airport."\
     "Minor Defeat: Extracted after sustaining 75% casualties, or 90m time limit reached"\
     "Major Defeat: 90% casualties"
     m_eAudience 2
    }
    GC_Briefing "{6D2E609FA511A820}" {
     m_iOrder 6
     m_sTitle "GM Notes:"
     m_sContent "If players are clearing houses a bit too quickly amd QRF isn't reliable, feel free to spawn additional AI units."
     m_eAudience 2
    }
   }
  }
 }
}
