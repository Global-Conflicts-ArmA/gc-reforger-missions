GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "1C1FE3396CE7C0E2"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aMissionEvents + {
    GC_Event "{00F423F0071AD784}" {
     m_sName "Time Limit (event 16, 3600s)"
     m_Advanced GC_EventOptions "{0FB09C0A9E4C4DDC}" {
      m_fDelay 3600
     }
     m_aActions {
      GC_MessageAction "{030F65F650B62E89}" {
       m_sTitle "20 Minutes Left"
       m_sMessage ""
      }
     }
    }
    GC_Event "{9521566273BB150D}" {
     m_sName "Time Limit (event 16, 4800s)"
     m_Advanced GC_EventOptions "{C3345A5AFA78F66C}" {
      m_fDelay 4800
     }
     m_aActions {
      GC_MessageAction "{9ECCFA06D9A4BA42}" {
       m_sTitle "USMC Defeat!"
       m_sMessage "Time Limit Reach"
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{4602BC2FC4C191AA}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "Time: 1000 hours; June 27th, 202x"\
     "Location: Everon"\
     "Weather: Random, Morning"\
     ""\
     "US Marines utilize USS Concrete to kill the enemy commander."\
     ""\
     "-- Pre-Slotting -- "\
     "4 Pilots per full Rifle Platoon | No Attack Helicopters"\
     ""\
     "Time Limit: 80 min"\
     ""\
     "Mission by Hot Mic"\
     "Briefing Making Assistant: Haesten"\
     "Fun Fact: This was originally intended to be the debut mission for the USS Concrete, but the mission 'Fights for USS Concrete' was published first. As a result, this is the 6th mission."
     m_eAudience 1
    }
    GC_Briefing "{9593705833A76795}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Time: 1000 hours; June 27th, 202x"\
     "Location: Everon"\
     "Weather: Random, Morning"\
     ""\
     "The United States is launching a large-scale operation to seize control of the island of Everon. Intelligence has identified the presence of the Commander currently overseeing the defense of the island. This individual is currently overseeing the island’s defense. His leadership and coordination are critical to the enemy's ability to establish a resistance against NATO. "
     m_eAudience 2
    }
    GC_Briefing "{4CA12780C91EC8EC}" {
     m_iOrder 2
     m_sTitle "II. Friendly & Enemy Forces"
     m_sContent "⬤ Friendly Forces ⬤"\
     "USMC Company:"\
     "- 1st Platoon"\
     "--13 men per Squad"\
     "- 2nd Platoon"\
     "-- 9 men per Squad"\
     ""\
     "Respawn: 20 Tickets"\
     ""\
     "Transport Units:"\
     "6x UH-60 Armed Blackhawks (13 Passagers + 2 Side Gunners)"\
     "10x Armed RHIB (.50 Cal) (8 Passagers + 1 Gunner)"\
     ""\
     "⬤ Enemy Forces ⬤"\
     "Each site contains a platoon-strength infantry supported by a BTR. "\
     ""\
     "Additionally, each major urban area might have additional security. Unknown strength at this time, but estimated squads without mechanized forces due to intercepted radio transmissions."\
     ""
     m_eAudience 2
    }
    GC_Briefing "{5E659B253EE74E52}" {
     m_iOrder 3
     m_sTitle "III. Mission & Notes"
     m_sContent "⬤ Mission ⬤"\
     "Find and kill the Occupational Force Commander (Codename: Black Bird) and extract back to LHD by Noon"\
     ""\
     "Victory (Soft End): "\
     "- Confirmed elimination of the commander."\
     "- Safe extraction of at least 95% of remaining forces."\
     "Defeat (Hard End): "\
     "- 90% Casualties for USMC force."\
     ""\
     "⬤ Notes ⬤ "\
     "- Spawn Instructions -"\
     "Upon mission start, everyone spawns on the deck. Please look around before you start moving."\
     ""\
     "- Respawns -"\
     "20 Tickets"\
     "If one died during Phase 1 and respawned on deck. It's not allowed to be re-inserted until Phase 1 is concluded."\
     ""\
     "- Intel Gathering -"\
     "Each Command Post contain a large red folder that can be collected by holding the Interact button."\
     ""\
     "- Live Map Editing -"\
     "Live Map editing is allowed after Phase 1. In-game message will notify the COs. Only top 2 ground COs and 1 Flight Lead is allow to add/edit new markers. They have 5 mins."\
     ""\
     "- Post Phase 1 -"\
     "COs can plan for extraction back to LHD after completing Phase 1 if they so choose or refit. AO Limit is lifted as well."
     m_eAudience 2
    }
    GC_Briefing "{0BF644E943D76C2D}" {
     m_iOrder 4
     m_sTitle "IV. Execution"
     m_sContent "Up to CO's discretion, this mission accomplish with two phases in mind:"\
     ""\
     "- Phase 1 -"\
     "Assault and secure both enemy sites. Each site contains one intelligence fragment (in a form of Red Folder) that must be recovered."\
     "Recovering all fragments is necessary to triangulate and confirm the commander’s location. The Company CDR can order any element to reconvene back to the LHD at any time."\
     ""\
     "- Phase 2-"\
     "Once intel is confirmed, assault the enemy Battalion Commander’s position once identified, neutralize the target, and extract remaining forces to the LHD."\
     ""
     m_eAudience 2
    }
    GC_Briefing "{5C238F8E56B45A14}" {
     m_iOrder 5
     m_sTitle "V. Service & Support"
     m_sContent "⬤ Helicopter Service ⬤ "\
     "LHD provides repair and refuel services for all helicopters."\
     ""\
     "⬤ Medical Support ⬤"\
     "Medics carry full loadouts at mission start."\
     "Medical crate are available aboard the LHD."\
     ""\
     "⬤ Resupply ⬤"\
     "Arsenal box are available aboard the LHD."\
     "Supply drops can be coordinated via helicopter."\
     "For personal resupply and mission-essential equipment. Additional weapon systems may be equipped only with approval from your leadership."\
     ""
     m_eAudience 2
    }
    GC_Briefing "{1FC445088A0B957C}" {
     m_iOrder 6
     m_sTitle "VI. Command & Signal"
     m_sContent "⬤ Command & Callsigns ⬤"\
     "White 6 	 (Company HQ)"\
     "- Red 6 	  (Platoon HQ)"\
     "-- Red 1 	   (Rifle Squad)"\
     "-- Red 2 	   (Rifle Squad)"\
     "-- Red 3 	   (Rifle Squad)"\
     "- Blue 6  	 (Platoon HQ)"\
     "-- Blue 1 	  (Rifle Squad)"\
     "-- Blue 2 	  (Rifle Squad)"\
     "-- Blue 3 	  (Rifle Squad)"\
     ""\
     "The 2IC will use the same callsign as their CO, with the suffix \"7\"."\
     ""\
     "JTAC: Up to them"\
     "Aircrew: Up to them or keep 'Blazer'"\
     ""\
     "⬤ Succession ⬤"\
     "Ground Command Succession:"\
     "White -> Red -> Blue -> JTAC"\
     ""\
     "Flight Command Succession:"\
     "FAC (JTAC) -> Flight Lead Pilot -> Rest of Flights"\
     ""\
     "⬤ Signal ⬤"\
     "Company Net: 48 MHz (default)"\
     "Red Platoon: 47.5 MHz"\
     "Blue Platoon: 48.5 MHz"\
     "Air Net: 49 MHz"\
     ""
     m_eAudience 2
    }
    GC_Briefing "{CEBC55D8382ACA58}" {
     m_iOrder 7
     m_sTitle "Game Master Notes"
     m_sContent "If GM wants to end the mission asap, please have all remaining personnel in the helicopter(s) before switching to the new mission."\
     ""\
     "After Phase 1, if the players are mentally exhausted or low player count for Phase 2; feel free to end the mission and move on to the next mission,"
    }
   }
  }
 }
}
