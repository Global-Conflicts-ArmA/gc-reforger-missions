GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "426978DADE818A8C"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{2AAFB0D77957FFA4}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "Location: Ruha, Finland"\
     "Time & Date: 11:00 Hours; January 14, 1985"\
     "Weather: Cold, Clear Weather"\
     ""\
     "US Platoon conducting a delaying action to allow the rest of the company to retreat and fortify fallback positions further west. "\
     "Estimated required delay: 35 minutes."\
     ""\
     "Pre-Slotting: This team need a least 3 people in Construction/Logistics Squad and know how to build up the Sandbags walls and Tripod."\
     ""\
     "TL: 45 minutes"\
     "Mission by Hot Mic"\
     "Fun Fact: This is Hot Mic's 3rd Mission. Please thanks Haesten for an idea for the lore/settings and general assistant."
     m_aFactionKeys {
      "US"
     }
     m_eAudience 1
    }
    GC_Briefing "{62D4929F39E80B53}" {
     m_iOrder 2
     m_sTitle "Situation"
     m_sContent "Following a series of rapid NATO advances across Northern Finland, U.S. forces overextended their lines, pushing deeper than planned into Soviet-pressured territory. The momentum was encouraging; but unsustainable. Logistics were stretched, communication lines fragmented, and reserve elements lagged behind."\
     ""\
     "In an uncharacteristic but calculated move, Soviet forces identified the vulnerability and began massing mechanized troops for a breakthrough assault."\
     ""\
     "Now, the U.S. 1st Platoon of Alpha Company has been ordered to hold the line long enough for the rest of the company to withdraw and regroup. They are to delay the Soviet assault by any means necessary."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{7E54F2BE20159A91}" {
     m_iOrder 3
     m_sTitle "Enemy and Friendly Forces"
     m_sContent "  -- Enemy Forces --"\
     "Elements of the Soviet Army, composed of at least two mechanized companies, are conducting a rapid armored thrust through the region. Their forces include:"\
     "- Infantry squads transported via trucks"\
     "- Main battle tanks"\
     "- Integrated mortar teams providing indirect fire support (off map)"\
     ""\
     "Intel suggests the Soviets will change and capture those 3 intersections at all cost. Maintaining your position for more than 10 minutes will allow the Soviets to pinpoint your location with mortar fire."\
     ""\
     "  -- Friendly Forces --"\
     "One U.S. Infantry Platoon, including:"\
     "- 1 Platoon HQ"\
     "- 3 Rifle Squads"\
     "- 1 Weapons Squad"\
     "- 1 Construction/Logistics Squad, operating semi-independently"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{6FD283D7F2A4DB13}" {
     m_iOrder 4
     m_sTitle "Mission "
     m_sContent "We are executing a delaying action against advancing Soviet forces, with the objective of holding them off for 35 minutes. The plan is to defend each position for approximately 10 minutes before conducting a controlled fallback. Under no circumstances is Defense Point Charlie to be lost; its defense is critical to the success of the operation."\
     ""\
     "The final tiered outcome will depend on how many U.S. troops reach the Extraction Point alive."\
     ""\
     "End Condition:"\
     "Victory:"\
     "- Great: >50% troops remaining"\
     "- Regular: >25% troops remaining"\
     "- Minor: >10% troops remaining"\
     "Defeat"\
     "- >90% US Casualties"\
     "- Redfor reached Point Charlie before 35 minutes"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{9C4CA9DDFE672482}" {
     m_iOrder 5
     m_sTitle "Mission Notes"
     m_sContent "All combat units (excluding Construction/Logistics Squad:) will spawn at Defense Point Bravo."\
     ""\
     "Upon mission start, they will mount available vehicles positioned in front of them and head north to establish the first line of defense at Defense Point Alpha."\
     ""\
     "Construction/Logistics Squad:"\
     "- The Construction/Logistics squad spawns separately at the US Supply Point, on the Civilian Airfield. They were conducting an assessment to convert the Airfield into a FOB and must now regroup and support the main force."\
     "- Solely authorized to construct fortifications. Rifles squads aren't allowed to assist in building."\
     "- Coordinate with Platoon HQ for defense layout."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{4A25E8A95D978657}" {
     m_iOrder 6
     m_sTitle "Execution "
     m_sContent "Commander’s Intent:"\
     "Deny Soviet forces rapid movement through the AO by leveraging choke points and delaying actions at Defense Points Alpha, Bravo, and Charlie. Use terrain, and fortifications."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{28A05C020065F0B9}" {
     m_iOrder 8
     m_sTitle "Sustainment"
     m_sContent "  -- Resupply --"\
     "One mobile ammo Humvee is operated by the logistics team for platoon resupply."\
     "- 5 Boxes of 12.7x99mm (100 rounds)"\
     "- 15 Boxes of 7.62x51mm (100 rounds)"\
     "- 10 Boxes of M249 Belt (200 rounds)"\
     "- 4 Alice Median Backpacks"\
     "- 40 DPHE 40mm"\
     "- 15 LAWs"\
     "- 50 7.65mm Mags"\
     "- 10 Grenades"\
     ""\
     "No additional resupply is available beyond what is initially loaded."\
     ""\
     "--Fortifications --"\
     "All supplies for fortifications are provided in the trucks. Each truck has three pairs of M2 Browning Machine Guns + Tripod and 200 sandbags. Note: Each truck are overfilled. "\
     "Construction can only occur at any defense points."\
     "IMPORTANT: The Cost of sandbag types has the following information:"\
     "-- Small - 5 Sandbags"\
     "-- Small long - 7 Sandbags"\
     "-- Medium - 10 Sandbags"\
     "-- Large - 13 Sandbags"\
     ""\
     "-- Medical --"\
     "Platoon Humvee have additional ACE medical supplies. Medic should have everything on spawn + Humvee."\
     ""\
     "-- Transportation --"\
     "Each rifle squad has a truck."\
     "Platoon HQ has one Humvee."\
     "Construction squad has 2 trucks (construction) and 1 resupply Humvee."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{DE38581640634EDE}" {
     m_iOrder 10
     m_sTitle "Command and Signal"
     m_sContent "Signal:"\
     "Platoon Net: 48 MHz (default)"\
     ""\
     "Command Secession Order:"\
     "1'6 -> 1'4 -> 1'1 -> 1'2-> 1'3"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{1ACCF210408150E5}" {
     m_iOrder 12
     m_sTitle "GM Notes"
     m_sContent "If AI Vechicles is stuck. help them reposition on the road."\
     "There's a script that should delete the units on the previous phase. Some units might fall through the net so delete them manual when possible. Please let me know how many units are deleted."\
     "If there are too many AI, delete some units."
    }
   }
  }
 }
}
