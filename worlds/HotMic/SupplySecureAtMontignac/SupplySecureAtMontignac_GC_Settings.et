     }
    }
    GC_Briefing "{150AC2FEC89EAD75}" {
     m_iOrder 5
     m_sTitle "III. Enemy Forces"
     m_sContent "Platoon-strength Russian."\
     ""\
     "A third-party IFA, composed of local militia fighters."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{F9DE11CC58BB5D30}" {
     m_iOrder 6
     m_sTitle "III. Enemy Forces"
