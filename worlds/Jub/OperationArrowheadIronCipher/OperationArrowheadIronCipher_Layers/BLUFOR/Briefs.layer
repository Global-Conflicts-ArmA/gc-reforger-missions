$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 SIT {
  coords 3205.355 399.547 11725.5
  m_sTitle "Situation"
  m_sTextData "<h2>PRELIMS</h2>"\
  "<b>DTL:</b> 10/08/2009, 2200L, Takistan."\
  "<b>Weather:</b> Random"\
  "<h2>LORE</h2>"\
  "The country of Takistan has been invaded by coalition forces."\
  ""\
  "You are a part of a combined US/UK task force."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 1
 }
 EF {
  coords 3205.355 399.547 11725.5
  m_sTitle "Enemy Forces"
  m_sTextData "<h2>COMPOSITION & DISPOSITION</h2>"\
  "Enemy forces consist of approximately a SQD of TKA light infantry occupying the policestation. The position was previously cleared by GBUs from USN F/A-18s and is being harrased by blufor indirect fire."\
  ""\
  "<h2>STRENGTHS & CAPABILITIES</h2>"\
  "• Armed and armoured vehicles, static AAA have been spotted in the area."\
  "• The TKA have been losing this war and heavy armor is becoming rare."\
  "• Their familiarity with the location and surrounding terrain may allow them to effectively defend the position against our assault."\
  "•Once EN know we're in the area expect QRFs from the North and South."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 2
 }
 FF {
  coords 3205.355 399.547 11725.5
  m_sTitle "Friendly Forces"
  m_sTextData "<h2>COMPOSITION & DISPOSITION</h2>"\
  "We are <b>7th SFG GBs with 2nd RGR BTN and 160th SOAR</b>, consisting of 28 personnel. We are currently positioned at the southern airfield, preparing to conduct our mission."\
  ""\
  "<h2>STRENGTHS & CAPABILITIES</h2>"\
  "• Light infantry. We have x2 AH-6Ms in a CAS role."\
  "• We have x2 UH-60s with M134s and x2 MH-6s for transport."\
  ""\
  "<h2>SERVICE & SUPPORT</h2>"\
  "• No resupply or additional equipment is available for this operation."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 3
 }
 MIS {
  coords 3205.355 399.547 11725.5
  m_sTitle "Mission"
  m_sTextData "<h2>MISSION STATEMENT: Delta</h2>"\
  "Delta conduct a <b>RAID</b> to <b>SECURE</b> the intel at the police HQ."\
  ""\
  "<h2>MISSION STATEMENT: Rangers</h2>"\
  "Rangers conduct a <b>BLOCK</b> to <b>SUPPORT</b> the Delta at the police HQ."\
  ""\
  "<h2>MISSION DESCRIPTION</h2>"\
  "We have recieved a go order to secure intel at a TKA HQ that was a former police station. We don't have a description of the document."\
  ""\
  "We are to move quickly and assault the station before the TKA can react. <b>CLEAR</b> all hostile forces from the position and <b>SECURE</b> the intel, then extract all operators from the AO. Upon return to the souther airfield; bring the intel to the two story office building and debrief."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 4
 }
 CS {
  coords 3205.355 399.547 11725.5
  m_sTitle "Comsig"
  m_sTextData "<h2>CALLSIGNS</h2>"\
  "• RGR HQ Actual - 1'6 "\
  "• RGR HQ 2IC - 1'7"\
  "• RGR HQ FAC - GHOST"\
  "• WPN SQD - 1'4"\
  "• AT TEAM - 1'5"\
  "• DELTA - SPECTER"\
  "• UH-60 - VOODOO 1 and 2"\
  "• MH-6 - BAT 1 and 2"\
  "• AH-6 - KILLER 1 and 2"\
  ""\
  "<h2>CHANNELS</h2>"\
  "• GRND TF - 48hz"\
  "• AIR Coordination - 47.9hz"\
  "• CAS - 48.1hz"\
  ""\
  "<h2>PASSWORDS</h2>"\
  "• Challenge: Hot | Password: Dog"\
  "• Running password: 67"
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 5
 }
 FLGTPLN {
  coords 3205.355 399.547 11725.5
  m_sTitle "FLIGHT PLAN"
  m_sTextData "The flight plan has been chosen to give the EN no opportunity to track our ingress and egress."\
  ""\
  "We are to fly NOE.(NAP OF THE EARTH)"\
  ""\
  "<h2>Order of March: </h2>"\
  "Fly with the Blackhawks on point to make use of their GPS MFDs, followed by MH-6, and AH-6 in tow to perform SEAD/DEAD upon contact on route."\
  ""\
  "<h2>In AO:</h2>"\
  "CAS has free fire zones, type 3, outside the AO. Be prepared for direct talk ons from the Rangers."\
  ""\
  "Transports are to orbit, conduct ISR, and direct CAS. Don't allow your airframes to be put into danger as we won't have a timely QRF to extract us."
  m_aVisibleForFactions {
   "RHS_USAF"
  }
  m_iOrder 6
 }
}