 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{14959F4C60E3D599}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "A US Army Bradley Cav scout platoon with M3A3(BUSK) attempt to delay against an RU breakthrough."\
     ""\
     "2:1 RU : 5 minute setup, 60 minute TL after setup."\
     "RU restricted to their spawn during setup, US unrestricted during setup. "
    }
    GC_Briefing "{50E0215B3854DDDA}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "RU has launched a surprise offensive, catching NATO forces off guard."\
     ""\
     "Our element is tasked with pushing through to allow a breakthough NATO lines. A Bradley Cav scout platoon is located on the route according to ISR."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{99556FDBC5EA3848}" {
     m_iOrder 2
     m_sTitle "I. Situation"
     m_sContent "A significant, mechanized breakthrough attempt is underway by Russian (RU) forces, specifically elements of the 1st Guards Tank Army, spearheaded by a mixed T14-T72b company and supported by a motorized rifle company. The enemy objective is to exploit a perceived weakness in the FLOT. Intelligence reports indicate the enemy is attempting to bypass our forward security zones with speed and overwhelming firepower, aiming to seize a key crossroads to sever our logistical routes."\
     ""\
     "Our unit,1st Platoon, Charlie Troop, 2nd Cavalry Regiment, is currently positioned as the forward security element, operating in our assigned sector."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{C32E4F8872F56326}" {
     m_iOrder 3
     m_sTitle "II. Friendly Forces"
     m_sContent "Company(-) strength RU located north of Kelloja. x1 Scout platoon Mot; x2 Tank platoon; Co HQ with repair vic and AAA."\
     ""\
     "Wearing EMR, equipped with standard Russian weaponry such as AK-74s, PKMs and SVDs."\
     ""\
     ""\
     "The repair truck can be used to repair vehicles using supplies. By default, it has 40/340 supplies loaded - there is a container at the starting location with 500 supplies which can be loaded into the truck."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{8E7BB1AD0565B0E7}" {
     m_iOrder 4
     m_sTitle "II. Friendly Forces"
     m_sContent "1x  Cav Scout platoon with x6 M3A3 CFVs"\
     "Equipped with M4, M4A1, MAWs and wearing OCP."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{B3BAAC00DF9FF264}" {
     m_iOrder 5
     m_sTitle "III. Enemy Forces"
     m_sContent "1x Bradley Cav scout PLT spotted near Ruha."\
     ""\
     "Equipped with M4, M4A1, MAWs; wearing OCP."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{C2BAF0E7E4349915}" {
     m_iOrder 6
     m_sTitle "III. Enemy Forces"
     m_sContent "Company(-) strength RU located near Kelloja. x1 wheeled scout platoon and x2 tank platoons."\
     ""\
     "Vehicles include: T-14; T-72b; 30mm Typhoons"\
     ""\
     "Wearing a mostly EMR, equipped with Russian weaponry such as AK-74s, PKMs and SVDs."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{AC06F8F5AFA2DEF3}" {
     m_iOrder 7
     m_sTitle "IV. Mission"
     m_sContent "Push down the ASR and reach the end. Destroy anything that tries to stop you."\
     ""\
     "Complete this within 60 minutes after setup."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{072CE090C7CAD2CF}" {
     m_iOrder 8
     m_sTitle "IV. Mission"
     m_sContent "Delay and attrite the tank column for 60 minutes after setup."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{B4988890FAE1A253}" {
     m_iOrder 9
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     ""\
     "90% US casualties or RU reach the end of the AO (captured for 1 minute): RU victory"\
     ""\
     "90% RU casualties or 60 minutes pass: US victory"\
     ""\
     "Capzone is at the very end of the map, south of Martikkalankyla. It requires 75% RU control for 1 minute."\
     ""\
     "RU restricted to their spawn for 3 minutes, US unrestricted."\
     ""\
     "BLUFOR CO: Don't cheese it and camp the cap zone. GM MUST ENFORCE!!"
    }
   }
  }
 }
