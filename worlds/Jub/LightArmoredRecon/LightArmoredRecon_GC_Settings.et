 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{78AEBB662F19B2A7}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "USMC LAR move to support an infantry platoon in their assualt on RU positions."\
     ""\
     "60 minute TL"\
     ""
    }
    GC_Briefing "{85FA3E4EF53E692F}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "RU forces have launched a surprise offensive, catching NATO forces off guard."\
     ""\
     "Deployed as part of NATO's Enhanced Forward Presence, your platoon - has been tasked with assiting in an attack by an infantry platoon to the east."\
     ""\
     "They are stepping off after this briefing."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{89CB4F9D62482177}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "x1 LAR platoon, x4 LAV-25s:"\
     "	Organic to the platoon is a drone hunter/killer team, MAAWs team, "\
     "	Jav gunner, Marksman, and an MMG team."\
     "	Within the LAV that has a Jav gunner, there are x2 JAVs"\
     ""\
     ""\
     "To the East: The rifle platoon has x3 rifle squads, x1 MMG team, x1 HQ team"\
     ""\
     "Equipped with M27, M4A1, MAWs and wearing MARPAT."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{3FF414846D0D1B21}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Company strength RU located near Pihlajamaa. "\
     ""\
     "The enemy have Tigrs, BMP2s, and T90s. We know they are watching the routes into the hamlet. Expect contact prior to entering the town."\
     ""\
     "There are EN adjacent units nearby so expect counter attacks."\
     ""\
     "Wearing a mixture of camouflage patterns, equipped with Russian weaponry such as AK-74s, PKMs and SVDs."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{6C4C305EE3C18736}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "We are the supporting effort to the rifle platoon, we are to clear a route to the OBJ and destroy EN forces around with the LAVs. "\
     ""\
     "We are the heavy hitters, HQ expects us to deal with any EN armor."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{624B775A3EF1E977}" {
     m_iOrder 5
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     ""\
     "85% US casualties: RU Victory"\
     "90% RU casualties or zone captured: USMC victory"\
     ""\
     "Capzone is the circle, requires 90% US control for 5 minutes."
    }
