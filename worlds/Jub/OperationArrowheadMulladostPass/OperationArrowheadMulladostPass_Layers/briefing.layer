$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 Overview {
  coords 3291.947 47.151 2221.159
  m_sTitle "Overview"
  m_sTextData "A US Army SBCT Rifle platoon, and MGS conduct an advance to contact to Mulladost, to clear a route and sweep the village. They are supported by an AH-64."\
  ""\
  "<h2>Notes</h2>"\
  "• Rifle platoon CO is in overall command. FO required for CAS."\
  ""\
  "• Due to some faction stuff, you have to select the USAF faction then click the US faction to show all the slots"\
  ""\
  ""\
  "<i><h2>This one will be hard! Sorry not sorry</h2><i/>"
  m_bEmptyFactionVisibility 1
 }
 MissionNotes {
  coords 3291.92 46.64 2209.38
  m_sTitle "Mission Notes"
  m_sTextData "Mission by jubxxxjub"\
  ""\
  "AO limit in effect, AH-64 has an exception"\
  ""\
  "You have x20 respawns; don't leave without a full stryker! You will have a black screen for 60s to let you go pee or something. You will respawn at the SP."\
  ""\
  "JIP TP"\
  ""\
  "End conditions:"\
  ""\
  "80 Minutes pass: Mission failed"\
  ""\
  "80% US player causalties: Defeat"\
  ""\
  "Mulladost clear of TKA: Victory"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 10
 }
 "I.Situation" {
  coords 3277.077 50.22 2207.697
  m_sTitle "I. Situation"
  m_sTextData "The year is 2009, the country of Takistan has been invaided by coalition forces."\
  ""\
  "You are apart of a combined US, UK taskforce."\
  ""\
  "To the E UK forces are engaged in heavy fighting IVO Feruz Abad and USMC MEU forces further NE of them. HQ wants to open another route to Rasman. We have been diverted from our deployment on Sahrani to achieve this task."\
  ""\
  ""\
  "2'2 from our sister platoon has been tasked with doing dismounted route recon prior to our clearance. Expect updates from them on Company net."\
  ""
  m_bShowForAnyFaction 1
 }
 "II.FriendlyForces" {
  coords 3270.781 52.021 2208.541
  m_sTitle "II. Friendly Forces"
  m_sTextData "1x SBCT Rifle Platoon(+) with x3 M2HB, x1 MK19 M1126"\
  "1x SBCT MGS"\
  ""\
  "We have QRF from 2'1 and 2'3 (respawns:x20) they're back at our SP with x2 M2HB combat load strykers. See mission notes."\
  ""\
  "The aviation asset is located at a FARP to the SouthEast and are TYPE 2 to the PL FO."\
  "Aviation has x1 AH-64 with rockets and hellfires."
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 "III.EnemyForces" {
  coords 3267.547 51.84 2202.581
  m_sTitle "III. Enemy Forces"
  m_sTextData "ISR from a reaper spotted a Company sized group with a T72 and two platoons of BMP1s IVO Mulladost."\
  ""\
  "Static CSWs of AGS-17s, and NSVs are expected as well."\
  ""\
  "Along route to Mulladost ISR spotted EN setting up ambushes at the marked locations. They were actively placing AT mines on the road. With CSWs zeroed on sandbag positions."\
  ""\
  "Static AAA is in the area as a burst was heard before we lost contact with our MQ-9"\
  ""\
  "EN is likely to be reinforced by a third BMP1 platoon further down the route to Rasman."\
  ""\
  "Their weapons include AKs, M16s, FN-FALs, SVDs, RPKs, PKMs, RPGs."\
  ""\
  "They wear OD soviet style uniforms."
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 "IV.Mission" {
  coords 3264.814 53.251 2206.532
  m_sTitle "IV. Mission"
  m_sTextData "Mission: Clear the route to and town of Mulladost of TKA and hold it within 80min."
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
 "V.Sustainment" {
  coords 3266.036 53.313 2208.564
  m_sTitle "V. Sustainment"
  m_sTextData "Only whats on the vehicles:"\
  "(Check the vic inv in the lobby)"\
  "Extra mags, boxes, grenades, LAWs, and x2 Javs per vic."\
  ""\
  "Vehicles have no RRR."
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
 "VI.Comsig" {
  coords 3266.104 53.436 2209.668
  m_sTitle "VI. Comsig"
  m_sTextData "Gound Element stay on default FREQs"\
  "Air net: +0.1MHz"\
  ""\
  "Callsigns: "\
  "1'6 - Rifle Platoon HQ"\
  "1'1 - Rifle Squad"\
  "1'2 - Rifle Squad"\
  "1'3 - Rifle Squad"\
  "1'4 - MMG Squad"\
  "3'1 - MGS"\
  ""\
  "AH-64 - Gunfighter 6'7"
  m_bShowForAnyFaction 1
  m_iOrder 5
 }
}