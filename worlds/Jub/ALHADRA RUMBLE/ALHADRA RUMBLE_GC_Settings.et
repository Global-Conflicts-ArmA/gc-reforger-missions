GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "1F170CD359E9C9BA"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aMissionEvents + {
    GC_Event "{7A25F011535CF865}" {
     m_sName "TIME_LIMIT (event 5, 3600s)"
     m_Advanced GC_EventOptions "{1559F2B529D140BF}" {
      m_fDelay 3600
     }
     m_aActions {
      GC_MessageAction "{9648AD18783E981E}" {
       m_sTitle "USMC VICTORY"
       m_sMessage "Varan Group forces have been delayed for long enough."
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{9B448B573FBCB073}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "The year is 2025. In a remote desert sector, USMC forces have moved to secure a pair of critical transit bridges spanning a river. The sector is heavily occupied by the \"Varan Group,\" a heavily armed Russian Private Military Company operating under a shadow contract. "\
     ""\
     "Varan Group has deployed a full company-sized element, supported by localized Electronic Warfare (EW) and a dense swarm of FPV drones, to seize the crossings and crush the Marine presence."\
     ""\
     "5 minute setup, 60 minute TL after setup"\
     ""\
     "USMC mission CO is the LAR | Varan Group(AFRF) CO is Coy"\
     ""\
     "RU restricted to their spawn during setup."
    }
    GC_Briefing "{E94E88FA42E9C7E9}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "The local government has been having issues with the American forces in the area and have hired us to secure two bridges to the east of the town. "\
     ""\
     "They are hostile to the company."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{1F7B90A75E62F553}" {
     m_iOrder 2
     m_sTitle "I. Situation"
     m_sContent "We have been assigned to maintain closure of the two marked bridges and deny any crossing from the West. "\
     ""\
     "The local populous is hostile and they have been supported by RU Merc ExPATs. "
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{94BC678192EF92A9}" {
     m_iOrder 3
     m_sTitle "II. Friendly Forces"
     m_sContent "Company strength Varan Group located to the SW of the objectives."\
     ""\
     "We have x3 platoons. "\
     ""\
     "Our local suppliers were able to provide x2 BMP1Ps, x1 RWS PKM Tigr, x1 RWS KORD Tigr, x1 open top AGS, x1 open top KORD, x1 VDV Typhoon with 30mm RWS, and x2 BTR70s."\
     ""\
     "We also have x1 EW jammer bag, x2 ISR FPV quads, and x8 RPG FPV quads. Plus a command station with batteries and extra headsets/controller. "\
     ""\
     "The range is limited for the drones so it's advisable to load them into a vehicle."\
     ""\
     "Wearing a mixture of camouflage patterns, equipped with Russian weaponry such as AK-74s, PKMs and SVDs."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{6FBD56AE23D49256}" {
     m_iOrder 4
     m_sTitle "II. Friendly Forces"
     m_sContent "x1 LAR platoon with x4 LAVs plus scout teams."\
     "Attached: x1 Motorized rifle platoon(-)"\
     ""\
     "We have x1 M2 OGPK JLTV, x1 MK19 OGPK JLTV, x1 M2 CROWs JLTV, x1 M230/JAV CROWs, JLTV, and x1 truck for the rifle platoon to travel around in."\
     ""\
     "Equipped with M27, M4A1, MAAWs, Javelins and wearing desert MARPAT."\
     ""\
     "Near our SP in a box we have x2 drone jammer bags, x2 Hunter FPVs, x3 Killer FPVs, and x1 range extending antenna. Plus two javs in the crate for the jav gunners."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{751B690F8BD8AE7A}" {
     m_iOrder 5
     m_sTitle "III. Enemy Forces"
     m_sContent "1x USMC LAR platoon with LAV-25s and x1 motorized rifle platoon(-)."\
     ""\
     "Equipped with M27, M4A1, MAAWs, Javelins, and FPV drones. wearing desert MARPAT."\
     ""\
     "Their vehicles include LAV25s, JLTVs, and 5t trucks."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{01ED224EBD0581B7}" {
     m_iOrder 6
     m_sTitle "III. Enemy Forces"
     m_sContent "Company strength RU mercs calling themselves the Varan Group on social media located to the SW. Their vehicle convoy included GAZ Tigrs, VDV Typhoons, BMP1s, and BTR70s."\
     ""\
     "Wearing a mixture of camouflage patterns, equipped with Russian weaponry such as AK-74s, PKMs and SVDs. "\
     ""\
     "They're known to have FPV drones and use anti drone EW and shotguns."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{D606B126BE90BC8C}" {
     m_iOrder 7
     m_sTitle "IV. Mission"
     m_sContent "Seize the two marked bridges."\
     ""\
     "Complete this within 60 minutes after setup."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{DCD7AE4291284DF1}" {
     m_iOrder 8
     m_sTitle "V. Signals"
     m_sContent "The company and all sub units are to stay on the net they started on."\
     ""\
     "If required, use the starshina as and RTO."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{C0D15CFCF5685F6F}" {
     m_iOrder 9
     m_sTitle "IV. Mission"
     m_sContent "Maintain closure of the two bridges and deny any MAMs from crossing East, holding it for 60 minutes after setup."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{53FCDCF5B50620CC}" {
     m_iOrder 10
     m_sTitle "V. Signals"
     m_sContent "AO net: 48mhz"\
     "LAR Plt: 48.1"\
     "Rifle Plt: 47.9"\
     ""\
     "Squad nets: Per presets"
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{C37753EC77B35BD8}" {
     m_iOrder 11
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     ""\
     "90% USMC casualties or both bridges captured: Varan Group Victory"\
     "90% Varan Group(AFRF) casualties or 60 minutes pass: USMC victory"\
     ""\
     "Capzones around the two bridges marked with circles on the map, requires 90% Varan Group(AFRF) control for 1 minute. The radius is 500m."\
     ""\
     "Varan Group restricted to their spawn for 5 minutes"
    }
    GC_Briefing "{A85249DC8CA333CE}" {
     m_iOrder 12
     m_sTitle "Drone Notes"
     m_sContent "The drones/equipment are located inside a box near the starting point."\
     ""\
     "Setup & Deployment: Procure a drone, controller, FPV goggles, and batteries. Equip the controller in your hands and the goggles on your head. Deploy the drone to the ground and establish a connection."\
     "____________________________________________________________________________"\
     "Signal Management: Connection stability requires proximity and a clear line of sight. Physical obstructions or excessive distance will result in video degradation and severe input latency."\
     "____________________________________________________________________________"\
     "Electronic Warfare: Enemy jamming equipment (backpacks or vehicles) creates localized signal deadzones. Entering these zones or losing line of sight completely will sever your connection and eject you from the feed."\
     ""\
     "Man-Portable Jammers: While the mod developer has not published the exact hardcoded distances, backpack jammers typically create an interference bubble of roughly 100 to 300 meters. You will start seeing video degradation at the edge of this zone before experiencing a complete disconnect closer to the center."\
     ""\
     "Vehicle Jammers: Dedicated electronic warfare vehicles project a much stronger signal. You can expect these platforms to disrupt drone operations from 500 meters to 1,000 meters away."\
     ""\
     "Compounding Factors: The effective jamming distance is heavily influenced by your baseline connection. If you are already flying near your maximum operational range or navigating behind heavy terrain, the jammer will overpower your signal much earlier than if you had a strong, direct line of sight."\
     ""\
     "++++++NOTE: JAMMING WORKS ON YOUR OWN DRONES+++++++"\
     "____________________________________________________________________________"\
     "Combat Operations: For kamikaze strikes, arm the warhead (L3 on controller / Z on keyboard) prior to impact. Manually disconnect at any time using Backspace."\
     "____________________________________________________________________________"\
     "Hardware Upgrades: Utilize drone antennas to multiply operational range by 5x, or deploy command stations to operate up to three drones simultaneously."
    }
    GC_Briefing "{5EFE4DC02061D54B}" {
     m_iOrder 13
     m_sTitle "Jav Notes"
     m_sContent "My apologies to those who said they were broken the first playthrough and I disregarded it. There is a bug where you must drop the JAV and pick it back up prior to firing."\
     ""\
     "Unless it is placed in the world on spawn. Which the ones in this mission are. They are located inside the drone box."\
     ""\
     "The Jav was added by WCS_Armaments."\
     ""\
     "It's use is exactly like the stinger."\
     ""\
     "Get line of sight of a target, hold left ctrl until you hear a tone, then fire."\
     ""\
     "It is F&F and doesn't have a reload."\
     ""\
     "It will fire without a target lock so don't ND."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
   }
  }
 }
}
