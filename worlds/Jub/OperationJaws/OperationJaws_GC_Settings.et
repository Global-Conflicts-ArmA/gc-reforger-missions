GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "BD1CFA406C1951E8"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{A803D17F5B6C0428}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "The year is 2012, USMC forces in Hemland provence have started Op Jaws to destroy and demoralize Taliban forces prior to passing off combat ops to the ANA."\
     ""\
     "No setup, 60 minute TL after setup"\
     ""
    }
    GC_Briefing "{608B3FA70778BBDB}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "We heard the sound of American helicopters and child scouts advised us that their tanks are heading this way."\
     ""\
     "We mustered the cells and must plan a defense."\
     ""\
     ""
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{0C09681CC99CBC92}" {
     m_iOrder 2
     m_sTitle "I. Situation"
     m_sContent "USMC infantry elements have just conducted a pre-dawn insertion and are currently holding positions on the outskirts of "\
     "Zamindawar. "\
     ""\
     "Intelligence indicates the town is heavily fortified with IEDs and \"murder holes\". A section of M1A1 Abrams tanks is attached  to the us, to provide overwatch and heavy breaching capability."\
     ""\
     "Leaflets dropped prior to the operation should reduce civpop movement so any MAMs are open targets."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{41FD2D5A6F84E76B}" {
     m_iOrder 3
     m_sTitle "II. Friendly Forces"
     m_sContent "Company strength Taliban fighters located at our marked SPs"\
     ""\
     "There are unmarked and disorganized local fighters (AI) joining us,"\
     ""\
     "We have x40 respawns every 60s to simulate waves. We respawn at the RP."\
     ""\
     "We have also been given access to the local fighters weapons cache; they didn't give a list of items, we must check it for ourselves."\
     ""\
     "We have vehicles located at our RP:"\
     ""\
     "We have x13 motorbikes, x5 VBIEDs, x3 transport landrovers, x1 M2HB m151 jeep, x3 GPMG landrovers, x1 PKM UAZ at the respawn pos."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{8DB19A3A3DFD35E3}" {
     m_iOrder 4
     m_sTitle "II. Friendly Forces"
     m_sContent "x1 Rifle platoon with MMGs and SMAWs."\
     "Attached: x1 M1A1 section, x1 Resupply section (For the infantry) in M1151s"\
     ""\
     "Equipped with M16A4, M4A1, SMAWs, M249s, M240s and wearing desert MARPAT."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{CCA7200D8DD79643}" {
     m_iOrder 5
     m_sTitle "III. Enemy Forces"
     m_sContent "1x USMC rifle platoon with M1A1s tanks"\
     ""\
     "Equipped with M16A4s, M4A1, SMAWs, Javelins, M240s, M249s and LAWs. wearing desert MARPAT."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{D1E3BEBF4133DE91}" {
     m_iOrder 6
     m_sTitle "III. Enemy Forces"
     m_sContent "Company strength Taliban insurgents are expected in the area, CIVPOP is neutral but likely helping the INS. "\
     ""\
     "They will use civ vics to move around the AO or to use as VBIEDs."\
     ""\
     "Wearing a mixture of camouflage patterns or no uniforms at all, equipped with soviet bloc weaponry such as AK-74s, PKMs and SVDs. Expect fixed emplacements and low C2."\
     ""\
     "If they're a military aged male, and have a weapon, take them out."\
     ""
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{952B010A0C8F6057}" {
     m_iOrder 7
     m_sTitle "IV. Mission"
     m_sContent "Deny American forces from taking control of the area."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{013569C9E4E49AC3}" {
     m_iOrder 8
     m_sTitle "V. Signals"
     m_sContent "The company and all sub units are to stay on the net they started on."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{6D2E821DCFC41C00}" {
     m_iOrder 9
     m_sTitle "IV. Mission"
     m_sContent "Our platoon with attachments, clear out Taliban forces in marked area, NLT: 60min IOT complete RCT goals."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{3FF911D81C69F881}" {
     m_iOrder 10
     m_sTitle "V. Execution"
     m_sContent "Recommended Execution"\
     "Assign each subunit a defined lane — clear boundaries enforce dispersion, prevent fratricide, and keep momentum aligned along the platoon's axis of advance."\
     "Maneuver squads as mini-platoons in movement to contact, each task-organized for independent fires, security, and maneuver."\
     "Push the tanks forward as vanguard on the flanks. Their reach, optics, and survivability extend the platoon's zone of control and give the infantry freedom of maneuver across the entire frontage."\
     "Trail the Humvees behind the rifle squads. Resupply is their primary role, but don't sleep on their crew-served weapons — those CSWs are purpose-built for long-range suppression and make ideal base-of-fire elements when the lead squad gets pinned."\
     "Once lead elements close with the enemy at the objective area, consolidate, reorganize, and clear the village systematically — building by building, room by room."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{47A061E2426208D8}" {
     m_iOrder 11
     m_sTitle "VI. Signals"
     m_sContent "AO net: 48mhz"\
     "Armor Sec: 48.1"\
     "Rifle Plt: 47.9"\
     ""\
     "Squad nets: Per presets"
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{3AB777607FBD7803}" {
     m_iOrder 12
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     ""\
     "90% Taliban casualties or obj captured: USMC Victory"\
     "90% USMC casualties or 60 minutes pass: Taliban victory"\
     ""\
     "Capzone marked with polylines on the map, requires 90% USMC control for 1 minute."\
     ""\
     "No spawn restriction"\
     ""\
     "Fun fact: I made a mission with the same name back in A2 days on PR FATA, 'memba PR FATA? I 'memba"
    }
   }
  }
 }
}
