     }
    }
    GC_Briefing "{D9849191E6BC1219}" {
     m_iOrder 6
     m_sTitle "Command and Signals"
     m_sContent "Sparta Platoon HQ - Sparta"\
     "1 section - Somalia"\
     "2 Section - Strelkov"\
     ""\
