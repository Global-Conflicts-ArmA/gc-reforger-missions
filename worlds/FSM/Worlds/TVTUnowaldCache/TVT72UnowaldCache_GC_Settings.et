GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "AFC26A53EDE99E4D"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{BFCDD4F7F6FD82E4}" {
     m_iOrder 0
     m_sTitle "Situation"
     m_sContent "General:"\
     "Separatists have been more active in the area and have recently attacked CDF checkpoints in the area. Recce elements have spotted separatists around Orb and are suspecting this is where they are operating out of. "\
     ""\
     "Enemy: "\
     "Recce elements suspect around 20 fighters in the area using civilian vehicles for transport. They are suspected of having a cache with the bulk of their firepower for future operations. There are 3 suspected locations they are operating out of marked on the map. "\
     ""\
     "Friendly:"\
     "We are a motorized CDF platoon with 5 transport trucks full of ammo and a command UAZ at grid 012 049"
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{D1727D14BBC46124}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "General: "\
     "Our local attacks on CDF checkpoints have been successful. However, the CDF have finally tracked down our base of operation and are staging to our North to hunt us down. "\
     ""\
     "Enemy:"\
     "Locals have reported the CDF drove in on trucks with about 40-50 men. They were last spotted on the highway to our north. They know the general area we work out of but they probably don't know exactly which compund is ours. "\
     ""\
     "Friendly: "\
     "We are about 20 fighters at Ruckberg with plenty of fortifications ready to deploy. Spreading out will make it harder from them to pinpoint where our cache is located. "\
     ""\
     ""
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{ABA34A50903C3F7D}" {
     m_iOrder 2
     m_sTitle "Overview"
     m_sContent "CDF try to locate and destroy a separatist cache. Ratio roughly 2:1."
     m_eAudience 1
    }
    GC_Briefing "{AB972A45D34AD539}" {
     m_iOrder 3
     m_sTitle "Mission"
     m_sContent "Locate and destroy all separatists and caches in the area in order to prevent future separatist attacks in the area. "
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{1C73A1ADFFBB2E60}" {
     m_iOrder 4
     m_sTitle "Mission"
     m_sContent "We must stay alive and defend our cache in the compound at all cost."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{A40EC0BAEFC97592}" {
     m_iOrder 5
     m_sTitle "Command and Signals"
     m_sContent "Platoon Leader - 110"\
     "1st Squad - 111"\
