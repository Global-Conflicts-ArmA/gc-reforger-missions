     }
    }
    GC_Briefing "{EED8014FB4FEC864}" {
     m_iOrder 9
     m_sTitle "End Conditions"
     m_sContent "End Conditions:"\
     "CDF take 85% casualties, Separatists victory. Mission will end in 3 minutes or a GM can end it prior."\
     "Separatists take 85% Casualties, CDF Victory. Mission will end in 3 minutes or a GM can end it prior."\
     "CDF destory the cache, mission will end instantly."\
     ""\
     "Setup Timer: 4 minutes"\
     ""\
     "Note for people like BoomerX. If you are the defending team CO and you don't defend the objective, you are going against the mission statement. You don't need to be on the objective but the mission will end instantly if the CDF destroys the cache. If a GM or admin sees BoomerX about to do a BoomerX thing and waste an hour of everyones life, please take action within reason."
    }
   }
