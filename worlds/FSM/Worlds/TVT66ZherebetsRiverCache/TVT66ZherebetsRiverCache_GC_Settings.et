    GC_Briefing "{591ACDFEA13D1025}" {
     m_iOrder 11
     m_sTitle "Service and Support"
     m_sContent "There are 8 demo blocks, 8 clackers and 4 small packs located on a log on the dirt track. These are to destroy any caches that are found on the island. "
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{06C8BD33DBD0EC34}" {
     m_iOrder 12
