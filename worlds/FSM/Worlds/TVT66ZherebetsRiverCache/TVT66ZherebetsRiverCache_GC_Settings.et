     "1 Section - 11A"\
     "2 Section - 11B"\
     "3 Section - 11C"\
     "4 Section - 11D"\
     "Weapons Section - 11W"\
     ""\
     "Platoon Net - 48.00"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{B84F950969621F26}" {
     m_iOrder 10
