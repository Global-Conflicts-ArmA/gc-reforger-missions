    GC_Briefing "{ABA8AFB952190457}" {
     m_iOrder 11
     m_sTitle "Mission Notes"
     m_sContent "<h2>END CONDITIONS</h2>"\
     "<b>BLUFOR VICTORY:</b>"\
     "• Destroy the supply cache on the train and leave the AO."\
     "- Withdraw back towards spawn. We must cross the northen bridge to the northen side at a minimum."\
     "OR"\
     "• Kill 95% of OPFOR"\
     ""\
     "<b>OPFOR VICTORY:</b>"\
     "• Kill 75% of BLUFOR causing them to become combat ineffective and withdraw."\
     ""\
     "<h2>MISC</h2>"\
     "• Setup timer: Blufor = 6mins."\
     ""\
     "Mission made by TheLocalPub."\
     "Please use the #feedback channel on Discord to log issues, suggestions, reports. "
    }
    GC_Briefing "{B406C61718BCD461}" {
     m_iOrder 12
     m_sTitle "Changelog"
     m_sContent "<h2>Changed</h2>"\
     "• End conditons now reflect a raid and not an assualt for BLUFOR."\
     "• Updated OPFOR Russian units to use the new GC variants instead of the RHS ones."\
     "• Briefs for both teams have been updated to reflect the new end conditions."\
     ""\
     "<h2>Added</h2>"\
     "• A few new props, buildings, and decal;s around the place."
    }
