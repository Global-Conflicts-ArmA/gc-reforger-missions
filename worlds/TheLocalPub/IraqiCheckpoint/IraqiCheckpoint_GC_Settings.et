    GC_Briefing "{42A034BDDB579A11}" {
     m_iOrder 10
     m_sTitle "Comsig"
     m_sContent "<h2>CALLSIGNS</h2>"\
     "• HQ - Sharaf40"\
     "• 1st Squad - Sharaf41"\
     "• 2nd Squad - Sharaf42"\
