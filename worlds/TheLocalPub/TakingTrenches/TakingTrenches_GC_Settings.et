    GC_Briefing "{AA297B9B26E285FE}" {
     m_iOrder 11
     m_sTitle "Mission notes"
     m_sContent "<h2>END CONDITIONS</h2>"\
     "<b>CDF:</b>"\
     "Capture the Russian HQ."\
     ""\
     "<b>RUS:</b>"\
     "Destroy 85% of the CDF forces."\
     ""\
     "<h2>NOTES</h2>"\
     "JIP TP: Deny"\
     "AO limt: Global"\
     ""\
