    GC_Briefing "{B22E5A14B0F6539E}" {
     m_iOrder 11
     m_sTitle "Mission Notes"
     m_sContent "|END CONDITIONS|"\
     ""\
     "Blufor:"\
     "Capture the zone + 85% OPFOR dead (11/13)"\
     ""\
     "Opfor:"\
     "Kill 86% of BLUFOR (21/24)"\
     "OR"\
     "Defend for 30mins"\
     ""\
     "|MISC|"\
     "Timelimit: 30mins +4"\
     "Setup timer: 4min"\
     "Ratio: 1.4:1"\
     ""\
     "Made by TheLocalPub. "\
     "Use the #Feedback channel on Discord to suggest, complain, or whatever about this mission."
    }
   }
  }
 }
