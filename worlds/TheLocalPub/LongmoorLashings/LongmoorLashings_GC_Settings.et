    GC_Briefing "{C56987F7198AFF11}" {
     m_iOrder 11
     m_sTitle "Mission notes"
     m_sContent "<h2>End Conditions</h2>"\
     "<b>UK:</b>"\
     "Destroy the Insurgent ammo cache."\
     "Or"\
     "Kill 85% of the Insurgent team."\
     ""\
     "<b>Insurgents:</b>"\
     "Kill 80% of UK forces or hold out for 25mins."\
     ""\
     "<h2>MISC</h2>"\
     "• AO limit - Insurgents"\
     "• Setup timer - 5mins for UK"\
     "• Timelimt - Yes | 25mins playerable + 5mins for setup - Total 30mins."\
     ""\
     "Mission made by TheLocalPub."\
     "Use the #feedback channel on Discord to suggest, complain, and report."
    }
