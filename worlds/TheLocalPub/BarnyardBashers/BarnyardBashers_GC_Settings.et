    GC_Briefing "{961B7DA9A741904B}" {
     m_iOrder 11
     m_sTitle "Mission notes"
     m_sContent "<h2>End conditions</h2>  "\
     "<b>UK:</b>"\
     "- Sweep objectives Dog+Cat by passing through the barnyards and secure objective bird by clearing and holding."\
     ""\
     "<b>IRA victory:</b>"\
     "- Destroy 85% of UK forces."\
     ""\
     "<h2>Notes</h2>  "\
     "• UK 3minute setup timer."\
     "• JIP TP."\
     "• Global and team based AO limits."\
     ""\
     "Mission made by TheLocalPub - Submit reports, suggestions, and complaints to the Discord's #Feedback channel."
    }
