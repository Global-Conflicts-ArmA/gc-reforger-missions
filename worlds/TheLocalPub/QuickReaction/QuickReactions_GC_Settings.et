    GC_Briefing "{4A595B017A706024}" {
     m_iOrder 20
     m_sTitle "Mission notes"
     m_sContent "<h2>END CONDITIONS</h2>"\
     "<b>BLUFOR/INDFOR:</b>"\
     "• Major victory - Extract all three VIPs"\
     "• Regular victory - Extract two VIPs"\
     "• Minor victory - Extract one VIP"\
     ""\
     "<b>OPFOR:</b>"\
     "• Victory: Kill all VIPs <b>OR</b> kill all of BLUFOR + INDFOR."\
     ""\
     "<h2>MISC</h2>"\
     "• 5.25min US setup timer | 25sec Insurgent setup timer."\
     "• 7x Insurgent respawn tickets."\
     "• JIP TP disabled after 9mins."\
     ""\
     "Mission made by TheLocalPub."\
     "Please use the #feedback channel on Discord to log suggestions, bugs, and complaints."
    }
