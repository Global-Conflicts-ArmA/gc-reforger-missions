      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{36C2A90922754138}" {
     m_iOrder 0
     m_sTitle "Summary"
     m_sContent "In some alternate universe, during the 16th century, a time traveller came to us from the year 1994, bringing with him wonders we've never seen, but also completely fucking up the spacetime continuum."\
     ""\
     "Everyone lost their clothes due to large moths that roamed the land, killing off the human race, a true apex predator."\
     ""\
     "Now the final few humans also fight each other for the last scrapes of fibrous natural material."\
     "Today clan Blue comes head to head with clan Red, in a fight that'll become known in the history books as the \"Battle of the bulges\""\
     ""\
     "Who'll be the victor?"\
     ""\
     ""\
     "1:1 Ratio"
    }
    GC_Briefing "{65C7D723B94C759F}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "DTL: 25/05/1670, 0815hrs"\
     ""\
     "Weather: Heavy rain and thick overcast, potential for change, sightlines up to 1km."\
     ""\
     "Terrain: Sparse cover and concealment in the center of our AO, it's been marked by skulls as this is no mans land, a place nobody want's to be stuck in."\
     "On either side of no mans land, each team has dug their defences and sighted their lines."\
     ""\
     "While red clan has more cover and a proper trench network with better frontage, blue clan has fighting positions dug in with depth and much better lines of sight."\
     ""\
     "Dotted throughout are small treelines and woodlbocks with buildings to our south."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{0E37B57A4ADA4638}" {
     m_iOrder 2
     m_sTitle "Situation"
     m_sContent "DTL: 25/05/1670, 0815hrs"\
     ""\
     "Weather: Heavy rain and thick overcast, potential for change, sightlines up to 1km."\
     ""\
     "Terrain: Sparse cover and concealment in the center of our AO, it's been marked by skulls as this is no mans land, a place nobody want's to be stuck in."\
     "On either side of no mans land, each team has dug their defences and sighted their lines."\
     ""\
     "While red clan has more cover and a proper trench network with better frontage, blue clan has fighting positions dug in with depth and much better lines of sight."\
     ""\
     "Dotted throughout are small treelines and woodlbocks with buildings to our south."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{347FC222DDC98C21}" {
     m_iOrder 3
     m_sTitle "OPORD"
     m_sContent "MISSION STATEMENT:"\
     "We are to capture Red's forward operating base known as the \"Chuch of Ascension\" for our own clan at GRID 023021"\
     ""\
     "ENEMY:"\
     "Enemy forces are Red clan. "\
     "Armed with their AK74 muskets + bayonets and red coloured smoke grenades and clothes."\
     ""\
     "FRIENDLY:"\
     "Enemy forces are Blue clan. Starting+respawns at our POI marker."\
     "Armed with our M16 muskets + bayonets and blue (Violet) coloured smoke grenades and clothes."\
     ""\
     "SUPPLIES:"\
     "In our factory on the ground floor we can find a supply create with abit of gear which we should really only use to help us defend the strongpoint, althought commanders discretion."\
     ""\
     "COMSIG:"\
     "Commander + Group leaders have blue smoke, rifleman only have white."\
     ""\
     "Challenge: White"\
     "Password: Lightening"\
     "(Can change per commanders discretion)"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{23CBEC92BC6F4945}" {
     m_iOrder 4
     m_sTitle "Mission"
     m_sContent "MISSION STATEMENT:"\
     "We are to capture Blue's forward operating base known as the \"Concrete panel factory\" for our own clan at GRID 033026"\
     ""\
     "ENEMY:"\
     "Enemy forces are Blue clan. "\
     "Armed with their M16 muskets + bayonets and blue coloured smoke grenades and clothes."\
     ""\
     "FRIENDLY:"\
     "Friendly forces are Red clan. Starting+respawns at our POI marker."\
     "Armed with our AK74 muskets + bayonets and red coloured smoke grenades and clothes."\
     ""\
     "SUPPLIES:"\
     "In our church on the ground floor we can find a supply create with abit of gear which we should really only use to help us defend the strongpoint, althought commanders discretion."\
     ""\
     "COMSIG:"\
     "Commander + Group leaders have red smoke, rifleman only have white."\
     ""\
     "Challenge: Grey"\
     "Password: Skies"\
     "(Can change per commanders discretion)"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{C11B0149625ECED8}" {
     m_iOrder 5
     m_sTitle "Mission notes"
     m_sContent "Blufor victory conditions:"\
     "Capture Red's base (Hold equal or majority for 2mins)"\
     "or"\
     "kill 90% of the current alive team"\
     ""\
     "Opfor victory conditions:"\
     "Capture Blue's base (Hold equal or majority for 2mins)"\
     "or"\
     "kill 90% of the current alive team"\
     ""\
     "AO LIMIT: Yes | All teams - GM has authorisation to kill anyone outside the AO limit without warning."\
     "SETUP TIMER: Yes | All teams 45s"\
     "TIMELIMIT: 45mins"\
     "RESPAWNS: Yes | All teams"\
     "- 50x respawns per team, unlimited per player."\
     "- Respawn where you started."\
     "- Respawn tickets reduced to 0 if enemy are 75% majority within 150 meters of your base. | Granted 10 team tickets if you regain 75% majority within 150 meters of your base."\
     "- 16s respawn timer, spawn in waves."\
     ""\
     "This mission was not designed to be game mastered if. This is a work in progress concept mission, and our first LOLish mission."
    }
    GC_Briefing "{D9F41C7B49E25B2A}" {
     m_iOrder 6
     m_sTitle "Changelog"
     m_sContent "THIS RELEASE"\
     ""\
     "Fixed:"\
     "- Capzones being captured by the wrong teams resulting in mission ending very early."\
     "- Missing no mans land markers in middle of the AO."\
     ""\
     "Added:"\
     "- System to regain 10 tickets by recapping/gaining majority back of the capzone that takes your team's tickets if enemy team has a majority within it."
    }
   }
  }
 }
