     ""\
     "<h2>PASSWORDS</h2>"\
     "All can be changed at CO's discretion."\
     "• <b>Challenge:</b> Purple | <b>Password:</b> Burglar"\
     "• Running password: 88"
     m_aFactionKeys {
      "GC_IRAQ"
     }
    }
    GC_Briefing "{9BC23B5D016B4629}" {
     m_iOrder 10
     m_sTitle "Comsig"
     m_sContent "<h2>CALLSIGNS</h2>"\
     "• HQ - 41 | OC - 41A | PSG - 41B"\
     "• 1SEC - 41C"\
     "• 2SEC - 41D"\
     "• 3SEC - 41E"\
     "• 4SEC - 41F"\
     "• 5SEC (Sappers) - 41G"\
     ""\
