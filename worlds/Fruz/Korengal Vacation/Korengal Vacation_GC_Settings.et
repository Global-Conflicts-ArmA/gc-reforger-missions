GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "171F9ABBEBCA51AC"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{8379EE286A0CC0AB}" {
     m_iOrder 0
     m_sTitle "I. Situation"
     m_sContent "2nd Platoon, Battle Company, 2nd Battalion, 503rd Infantry Regiment (Airborne), 173rd Airborne Brigade Combat Team is tasked with stability operations inside the Korengal Valley. Battle Company has been receiving multiple \"TICs\" throughout their deployment. "\
     ""\
     "Intelligence indicates a large-scale mobilization of tribal fighters in the surrounding area which could potentially lead to an attack on the COP. The insurgents are known to possess a mortar that they are likely to use. It is recommended to gain hard cover immediately."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{E113C280088BC421}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Americans are still operating inside the Korengal Valley. They have set up multiple outposts throughout our tribal land and continue hindering our operations in our land."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{E0A4E9541BD66092}" {
     m_iOrder 2
     m_sTitle "II. Mission"
     m_sContent "2nd Platoon, Battle Company, is tasked with the defense of COP Korengal and the rendering of the tribal fighters combat ineffective."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{EEC83D9CAB6D79E4}" {
     m_iOrder 3
     m_sTitle "II. Mission"
     m_sContent "Conduct a deliberate attack and seize control of Combat Outpost Korengal as well as any coalition forces in the immediate surrounding areas."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{5DE1FEDF91259CD3}" {
     m_iOrder 4
     m_sTitle "III. Execution"
     m_sContent "2nd Platoon, Battle Company, is ordered to conduct an area defense of COP Korengal and immediate surrounding areas. "\
     ""\
     "Command has given a green light to continue with squad patrols to draw insurgent fighters into engagements."\
     ""\
     "The platoon leader can also send forces out to OP Restrepo and Firebase Vegas (Teleports are the American flags on the helipad) if deemed of benefit. Platoon leader should take into consideration the distance of the bases to COP Korengal, as this could lead to a potential overrun."\
     ""\
     "It is advised to keep at least 1/3 to 1/2 the manpower inside the COP to man defensive positions. "\
     ""\
     "MATVs are allowed to leave the COP, but the restricted terrain should be taken into consideration. Ground guiding is recommended on tight turns and uneven terrain."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{4A79D7F8E6E32C93}" {
     m_iOrder 5
     m_sTitle "III. Execution"
     m_sContent "Attack and destroy the coalition forces operating in the Korengal Valley and Combat Outpost. It is recommended to scout if the Americans are still conducting patrols in the AO, also if they are manning any positions in OP Restrepo and Firebase Vegas. It would be better to secure those positions first so we can fix the troops in COP Korengal, eliminating their ability to retreat."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{B1F579B9ABFC87E9}" {
     m_iOrder 6
     m_sTitle "IV. Sustainment"
     m_sContent "2nd Platoon, Battle Company is comprised of 2 squads and 1 weapons section."\
     ""\
     "3x M2 MATVs ( 1 is forward deployed to OP Restrepo)"\
     ""\
     ""\
     "2x Unarmed MATVs ( 1 is forward deployed to OP Restrepo)"
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{A5D78DB8739366F0}" {
     m_iOrder 7
     m_sTitle "IV. Sustainment"
     m_sContent "Vans are scattered around the map to help ease the burden of the large amounts of distance inside the AO. (Majority of the insertion points if it makes sense.)"\
     ""\
     "An Ammo Box in front of the pickup truck at the starting area contains 12x long range radios. Recommended to designate personnel to utilize those for the attack."\
     ""\
     "Another crate contains a NSV, NSV tripod, and boxes of ammo for the NSV."\
     ""\
     "The mortar section has enough rounds to last them the full operation. DO NOT START MORTARING UNTIL FREEZE TIME IS OVER."\
     ""\
     "Teleports to various locations in the AO to simulate the fighters familiarity and conditioning to the terrain."\
     ""\
     "Tora Outskirts Insertion = 010 017"\
     ""\
     "Son Tantil Insertion Point = 016 024"\
     ""\
     "Kunar Mosque Insertion Point= 033 027"\
     ""\
     "Salar Ban Insertion Point = 034 014"
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{F97EBA9603CC42D1}" {
     m_iOrder 8
     m_sTitle "V. Command and Signal"
     m_sContent "Command and Signal:"\
     ""\
     "PLT NET= 48.00"\
     "1st Squad= 44.00"\
     "2nd Squad=45.00"\
     "3rd Squad= 46.00"\
     "Wpns=47.00"\
     ""\
     ""
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{1085FF72CD921E6D}" {
     m_iOrder 9
     m_sTitle "V. Command and Signal"
     m_sContent "Radio frequency and callsigns are dictated by the Cell Leader. 12x LR radios in the ammo box in starting area."\
     ""
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{C8D78A01D398D1E3}" {
     m_iOrder 10
     m_sTitle "VI. Mission Intent (Mission Maker)"
     m_sContent "Mission intent is to loosely replicate the battles that took place in the Korengal Valley. "\
     ""\
     "Mission intent is not for Blufor to fight from the hills, villages, across the AO."\
     ""\
     "Blufor is permitted to leave the COP and patrol the area to scout. It is recommended not to commit too much manpower outside the COP. Blufor is also permitted to detach some of the platoon and have them take up fighting positions in OP Restrepo or Firebase Vegas."\
     ""\
     "You can teleport to the fighting positions, but you cannot teleport back. OP Restrepo has vehicles if falling back is needed. "\
     ""\
     "Blufor can use the MATVs to get around outside of the COP, however the terrain is extremely restrictive. If a vehicle rolls over due to basic physics and not an Arma-related issue, that is still in play and GMs should consider not rectifying it."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{A86215FB64DACC5B}" {
     m_iOrder 11
     m_sTitle "VI. Mission Intent (Mission Maker)"
     m_sContent "Mission intent is to loosely replicate the battles that took place in the Korengal Valley. "\
     ""\
     "Mission intent is for the teleports spread across the map to simulate the tribal fighters familiarity and conditioning to the terrain they grew up in. "\
     ""\
     "Mission intent is to both eliminate Blufor, as well as gain control of the COP. Firebase Vegas and OP Restrepo can be manned by Blufor if their Platoon Leader orders it but they must keep some forces in the immediate surrounding area of COP Korengal."\
     ""\
     "Blufor can send out a patrol to scout for your movements with no limit to how far they can go. However, they are not meant to have a meeting engagement with you nor are their vehicles capable of traversing the terrain in a fast manner without compromising safety."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{2E72D89818CFC634}" {
     m_iOrder 12
     m_sTitle "VII. Mission Notes"
     m_sContent "Mission Maker: Fruz"\
     ""\
     "All feedback should be directed directly to Fruz or the feedback channel in discord."\
     ""\
     "Thank you to everyone who came in and helped when I was stuck."\
     ""\
     "V2: tweaked ratios, reduced blufor's AO some, added more radios for insurgents"\
     ""\
     "End Conditions:"\
     ""\
     "1) Blufor Victory"\
     "   A) Held COP Korengal for 60 minutes."\
     "   B) Eliminated 90 percent of the insurgent forces"\
     ""\
     "2) OPFOR Victory"\
     "   A) Took COP Korengal within the 60 minute time limit."\
     "   B) Eliminated 90 percent of the BLUFOR forces"
    }
   }
  }
 }
}
