GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "155AF86917FF2578"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{663B5FBF5ADE948C}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "A United State Army Light Rifle Platoon conducts a movement to attack in order to render an insurgent cell combat ineffective along the MSR and West of Bastam."
     m_eAudience 1
    }
    GC_Briefing "{46AE2B0D96A3E25A}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "S2 has provided credible intelligence of the Sabir Terror cell operating on the western side of Bastam along the MSR. The Sabir Terror cell has been connected to 4 prior VBIED attacks against coalition forces."\
     ""\
     "Civilians still occupy the towns surrounding Bastam. Collateral damage should be avoided at all cost."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{0B6E9C487FD11713}" {
     m_iOrder 2
     m_sTitle "Situation"
     m_sContent "Our informants outside of Rasman have informed us that the Americans have been tipped off to our occupation of the main highway that runs west of Bastam. "\
     ""\
     "They have informed us that the Americans have begun loading their vehicles with gear and preparing for combat. We estimate that they will finish within the next 5 minutes."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{26819B23BE0F1033}" {
     m_iOrder 3
     m_sTitle "Mission"
     m_sContent "Kilo Platoon is tasked with the safe movement from Rasman Airbase to the town West of Bastam IOT close with and destroy militant fighters of the Sabir terror cell."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{AFF90F96712265C9}" {
     m_iOrder 4
     m_sTitle "Mission"
     m_sContent "Defense of our area near the main road is most vital. "\
     ""\
     "We should take this time to get into defensive positions around  their route in order to inflict massive casualties to their forces. However, we cannot push too far forward as we run the risk of losing our foothold near the Bastam hills."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{7C4BBABAFA3107BA}" {
     m_iOrder 5
     m_sTitle "Execution"
     m_sContent "Kilo 6 has been briefed on the mission from the company commander. "\
     ""\
     "Kilo 6 will provide a brief to the squadleads on the mission and best perceived plan to accomplish the mission."\
     ""\
     "Step off will be NET 5 minutes from briefing, ensure PCCs and PCIs are conducted during this time."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{8B0BCF27468C138F}" {
     m_iOrder 6
     m_sTitle "Execution"
     m_sContent "Our terror cells should conduct attacks against the American forces however the Cell leader sees fit in order to attrit their forces to combat ineffectiveness."\
     ""\
     "Our weapons have the range advantage against the Americans and can do some serious damage with their forces not being able to engage effectively in return."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{3E4D9B595D49FFD4}" {
     m_iOrder 7
     m_sTitle "Sustainment"
     m_sContent "7x  HMMWVs equipped with M2 .50cals"\
     ""\
     "1x Transport Truck"\
     ""\
     "1x Medic attached from COY HQ"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{4CE62805015573EF}" {
     m_iOrder 8
     m_sTitle "Sustainment"
     m_sContent "Our brotherhood has managed to provide us with 2 cars and 1 Ural Truck armed with IEDs and deadman switches for our brave Martyrs. "\
     ""\
     "We have also secured 3 transportations vans for movement of our brothers across the battlefield."\
     ""\
     "Mashallah"
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{F79FE624D5F6D54A}" {
     m_iOrder 9
     m_sTitle "Command Signal"
     m_sContent "PLT Net= 48.00"\
     ""\
     "1st Squad- Kilo 1"\
     ""\
     "2nd Squad- Kilo 2"\
     ""\
     "3rd Squad- Kilo 3"\
     ""\
     "Weapons- Kilo 4"\
     ""\
     "PLT HQ- Kilo 6"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{C27B504E59FB4D77}" {
     m_iOrder 10
     m_sTitle "Command and Signal"
     m_sContent "Cell leaders discretion"
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{3D401B408F4E6749}" {
     m_iOrder 11
     m_sTitle "Mission Notes"
     m_sContent "End Conditions: BLUFOR Victory when 90 percent of insurgent forces are eliminated."\
     ""\
     "OPFOR Victory when 90 percent of BLUFOR is eliminated."\
     ""\
     ""\
     "Missionmaker: Fruz"\
     ""\
     "V1: "\
     "Fixed Blufor Vehicles to spawn with M2."\
     "Tested VBIED's working on my side"\
     "Added Vehicle for Opfor"\
     "Slightly reduced AO size for Blufor and Opfor"\
     ""\
     "A special thanks to all those who have helped me create this mission; Wade, Hotmic, Blue, Perfk, Woody, Gabe."
    }
   }
  }
 }
}
