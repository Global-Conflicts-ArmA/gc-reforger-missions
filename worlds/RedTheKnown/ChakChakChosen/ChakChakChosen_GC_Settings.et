     m_aActions {
      GC_MessageAction "{D3ABD3427EBD97F9}" {
       m_sTitle "Takistan Army Victory!"
       m_sMessage "TKA forces have survived long enough to be rescued."
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{99CC718B0EC24F02}" {
     m_iOrder 0
     m_sTitle "I. Situation"
     m_sContent "As part of a larger offensive against the Takistan army a TKA infantry company has been encircled in the town of Chak Chak. They occupy a number of defensive positions in the town, and are now awaiting an extraction force which is expected to arrive in about 50 minuets. We have been tasked with eliminating this force before it can be withdrawn."\
     ""\
     ""
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{34A700C9FF3D2A71}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Our infantry company has become isolated in the town of Chak Chak after a massive rebel advance. We are now surrouned with limited means of transportation, and must survive until an extraction force arrive in about 50 minuets. Attackers are expected to come from any dirrection except the direct south."
     m_aFactionKeys {
      "GC_TKA"
     }
    }
    GC_Briefing "{3CF3D5B36168B0E7}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x infantry company augmented with unarmed motorized transport, crew served HMGs and VBIEDs. Currently located at a staging area in the north of the AO."\
     ""\
     "Wearing a wide range of camo patterns and colors, with head wraps and soft caps. Armed with AKs and other Soviet weapons."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{2A7C9AB8D16544A6}" {
     m_iOrder 3
     m_sTitle "II. Friendly Forces"
     m_sContent "1x reduced infantry company. Currently located on the east side of town near the east compound."\
     ""\
     "Wearing olive green fatigues with soviet helmets, armed with Soviet weapons."
     m_aFactionKeys {
      "GC_TKA"
     }
    }
    GC_Briefing "{F3E28F2F09029020}" {
     m_iOrder 4
     m_sTitle "III. Enemy Forces"
     m_sContent "1x reduced infantry company located in the fortified town of Chak Chak. With 2x M151A2 (Jeep) with M2HB."\
     ""\
     "Wearing olive green fatigues with soviet helmets, armed with Soviet weapons."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{3E6B3C03878DCCEC}" {
     m_iOrder 5
     m_sTitle "III. Enemy Forces"
     m_sContent "1x infantry company augmented with unarmed motorized transport, crew served HMGs and VBIEDs."\
     ""\
     "Wearing a wide range of camo patterns and colors, with head wraps and soft caps. Armed with AKs and other Soviet weapons."
     m_aFactionKeys {
      "GC_TKA"
     }
    }
    GC_Briefing "{BFEC44ED009624FA}" {
     m_iOrder 6
     m_sTitle "IV. Vehicles and Equipment"
     m_sContent "We have preppositioned a number of vehicles for the attack. Each start point has 4x UAZ vans, 4x Ural trucks, and 1x Ural VBIED"\
     ""\
     "We have a cache of extra supplies at our inital staging area. It is a stack of green crates located near the road."\
     ""\
     "We have a cache of NSV ammunition at each start point, each of these contain 12x 50rnd boxes, and 4x extra backpacks."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{F574A47599D4590A}" {
     m_iOrder 7
     m_sTitle "V. Forifications"
     m_sContent "Chak Chak has a number of defensive positions."\
     ""\
     "There is a set of fortifications consisting of sandbag bunkers and trenches on the high ground in the middle of town. Marked as \"Fort\"."\
     ""\
     "There is a fortified compound on the south east side of town. Marked as 'EastComp\"."\
     ""\
     "There is a smaller fortified compound on the south west side of town. Marked as \"WestComp\"."\
     ""\
     "There are two roadblocks made of barbed wire and dragonsteeth, which block the road at the east and west sides of town. Marked as \"RoadBlock\"."
     m_aFactionKeys {
      "GC_TKA" "GC_INSURGENT"
     }
    }
    GC_Briefing "{44F99EBF4F076AF5}" {
     m_iOrder 8
     m_sTitle "IV. Vehicles and Equipment"
     m_sContent "We have a small number of light vehicles, all of which are located at the east side of the main compound courtyard. "\
     ""\
     "2x M151A2 (Jeep) with M2HB, and 4x UAZ vans."\
     ""\
     "We have a cache of supplies in the east compound courtyard. It is a stack of green crates located on the east side of the shipping containers, next to a spool of wire with a radio."
     m_aFactionKeys {
      "GC_TKA"
     }
    }
    GC_Briefing "{46609924FCDF454F}" {
     m_iOrder 9
     m_sTitle "VI. Destroyed Structures"
     m_sContent "A number of structures in Chak Chak have been reduced to ruins via demolition by the TKA garrison. These buildings have been been marked with red shading."
     m_aFactionKeys {
      "GC_TKA" "GC_INSURGENT"
     }
    }
    GC_Briefing "{0510CA14A3AD3C5B}" {
     m_iOrder 10
     m_sTitle "VII. Deployment"
     m_sContent "After the setup timer has ended rebel forces will be able to teleport via the doors at their staging area to the north, east, or west start points. Vehicles are present at each start point, and any combination of start points can be used."\
     ""\
     ""
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{CD921F4061FAD1C4}" {
     m_iOrder 11
     m_sTitle "Overview"
     m_sContent "An Isolated Takistan Army infantry company defends a fortified town againts assaulting rebels while awaiting rescue."\
     ""\
     "50 minute TL after 4 minute setup. TKA AO limited to green area around Chak Chak, Rebel AO limited to map shape."\
     ""\
     "Ratio 1.5 Insurgents to 1.0 TKA"
    }
    GC_Briefing "{341A4E5465DBB55E}" {
     m_iOrder 12
