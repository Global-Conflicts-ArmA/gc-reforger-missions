    GC_Briefing "{12E83306C5429707}" {
     m_iOrder 13
     m_sTitle "VII. Deployment (READ)"
     m_sContent "In addition to walking and driving the Russian team has teleports for deployment at their staging area. The teleport actions are located at the metal barrels next to the supply cache. The destinations are marked on the map with red pin markers. 30 seconds after the set up timer ends the teleports will be disabled."\
     ""\
     "Teleport locations: Farm, Lighthouse, Shore, Timber North, Timber South, Front Center."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{FAA404E28EA07325}" {
     m_iOrder 14
     m_sTitle "VIII. Mine Threat (READ)"
     m_sContent "Intercepted Russian radio communications have alerted us to a potential anti-tank mine threat, estimated at 10 - 15 TM62M mines. While it is not guaranteed this supply of anti-tank mines will be utilized it is highly probable. "
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{0FCD254B6AA09DCC}" {
     m_iOrder 15
     m_sTitle "Overview"
     m_sContent "A British motorized force with local mortar support conducts an early morning attack on the Russian held town of Beauregard."\
     ""\
     "45 minute TL after 5 minute setup. Russian force AO limited to red area, Britsh AO limited to map cover shape."\
     ""\
     "Ratio 1.8 Britsh to 1.0 Russian"\
     ""\
     "Era: 1995"
    }
