GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "A850BB11154E6DC7"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aMissionEvents + {
    GC_Event "{C3E4382B708DD0CE}" {
     m_sName "RUS_Timer_Win (event 1, 3000s)"
     m_Advanced GC_EventOptions "{AF339C3CA50D7A07}" {
      m_fDelay 3000
     }
     m_aActions {
      GC_MessageAction "{9D0B7E41741E2C7B}" {
       m_sTitle "Russian Victory!"
       m_sMessage "Russian forces have held central Beauregard for at least 40 minuets."
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{3BF75EF1AE7F93BF}" {
     m_iOrder 0
     m_sTitle "I. Situation"
     m_sContent "Just under an hour ago the town of Beauregard and its vital dock were sized by a Russian motorized naval infantry force rapidly landed via hovercraft. Further Russian forces equiped with MBTs and IFVs are expect to be landed at their location within the next hour, the town must be captured before any such reinforcements can arrive."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{E2CFD65209B3AA63}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Just under an hour ago we sized the town of Beauregard and its vital dock after being rapidly landed via hovercraft. Further Russian forces equiped with MBTs and IFVs are to be landed within the next hour. We must hold the town until such reinforcements can arrive."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{B1474A32935C9D2E}" {
     m_iOrder 2
     m_sTitle "II. Mission"
     m_sContent "In order to achive victory we must either take control Beauregard or eleminate 95% of the defending Russian force before reinforcements arrive in roughly 45 minuets. The center of Beauregard must be captured and held for at least 5 minuets to take control of the town, it has been marked as \"Town Center\"."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{D283AACD18EEA537}" {
     m_iOrder 3
     m_sTitle "II. Mission"
     m_sContent "In order to achive victory we must defend Beauregard for 45 minuets or until 95% of the attacking British force has been eliminated. The center of Beauregard must be defended to ensure we maintain control of the town, it has been marked as \"Town Center\"."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{C5C4D79B570E5D4E}" {
     m_iOrder 4
     m_sTitle "III. Friendly Forces"
     m_sContent "1x British motorized light infantry company of reduced strength, with attched battery of 2x 81mm mortars. Currently located at the staging area near the town of Arleville."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{100174045D75394E}" {
     m_iOrder 5
     m_sTitle "III. Friendly Forces"
     m_sContent "1x Russian motorized naval infantry platoon. Augmented with 2x BRDMs, 2x dedicated recon teams, a suppy of anti-tank mines, and multiple light vehicles. Currently located in the staging area at the Beauregard docks."\
     ""\
     ""
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{60F73DE9E972A129}" {
     m_iOrder 6
     m_sTitle "IV. Enemy Forces"
     m_sContent "1x Russian motorized naval infantry platoon. Supported by 2x BRDMs and 2x dedicated recon teams. Currently located somewhere in the town of Beauregard to the north."\
     ""\
     "Vehicles:"\
     "	4x PKM armed UAZ469,"\
     "	6x unarmed open-top UAZ469,"\
     "	2x BRDMs"
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{B7B2B994FC6C1490}" {
     m_iOrder 7
     m_sTitle "IV. Enemy Forces"
     m_sContent "1x British motorized light infantry company of reduced strength. Currently located somewhere near the town of Arleville south of our position in Beauregard."\
     ""\
     "Vehicles: 2x armed land rover (M2HB, GPMG), 2x armed land rover (2xGPMG), 8x unarmed land rovers."\
     ""\
     "Fire support: Local battery of 2x 81mm mortars."\
     ""
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{F4AF5782CA15F49C}" {
     m_iOrder 8
     m_sTitle "V. Vics and Equipment"
     m_sContent "We have a number of vehicle at our staging area, these vehicle have already been loaded with additional ammunition and supplies."\
     "	8x unarmed camo-net land rovers,"\
     "	2x recce camo-net land rovers armed with 1x M2HB and 1x GPMG,"\
     "	2x recce camo-net land rovers armed 2x GPMG."\
     ""\
     "We have a cache of extra supplies at our inital staging area. It is a stack of green crates located next to the flag. This cache contains: hand flares, extra wrenches."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{5655F9274FCF49CC}" {
     m_iOrder 9
     m_sTitle "V. Vics and Equipment"
     m_sContent "We have a number of vehicle at our staging area. These vehicle have already been loaded with additional ammunition and supplies."\
     "	4x armed PKM UAZ469,"\
     "	6x unarmed UAZ469,"\
     "	2x BRDM"\
     ""\
     "We have a cache of extra supplies at our inital staging area. It is a stack of green crates located next to the concrete pipes. This cache contains: 12x TM62M anti-tank mines, hand flares, wrenches, backpacks, extra SVD ammunition, and 80x sand bags."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{718E8B910A3078FF}" {
     m_iOrder 10
     m_sTitle "VI. M252 Mortar Battery"
     m_sContent "We have a local mortar battery consisting of 2x M252 81mm mortars. They are located at a prepared firing position along with their supply of ammunition on Moss Hill to the south of the main staging area. This area has been marked with a blue circle labled \"Mortars\". This mark is located directly between the two mortars, and is a reliable targeting referance."\
     ""\
     "Battery ammuniton supply: 120x HE, 50x Illum, 50x Smoke"
     m_aFactionKeys {
      "UK"
     }
    }
