     }
    }
    GC_Briefing "{3CDD02B5B2BC464C}" {
     m_iOrder 10
     m_sTitle "Overview"
     m_sContent "US Army Stryker mechanized infantry platoon conducts an assault on the town of Hamertin which is held by Russian backed separatists."
     m_eAudience 1
    }
    GC_Briefing "{91F82B13602A1073}" {
     m_iOrder 11
     m_sTitle "Mission Notes"
     m_sContent "<h2>End conditions</h2>"\
     "<b>US Victory:</b>"\
     "• Clear and occupy Hamertin wthin 50 minuets of mission start (after setup timer)"\
     ""\
     "<b>Seperatist Victory:</b>"\
     "• Prevent the capture of Hamertin for at least 50 minuets"\
     "• Eliminate 80% of assaulting US forces."\
     "• Eliminate enough US forces for them to willingly retreat."\
     ""\
     "<h2>End conditions</h2>"\
     "• 50 min time limit. 3 min setup timer."\
     "• Ratio 6 US : 1 SEP"
    }
   }
  }
 }
}
