GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "D2C6FEAE0DC505D1"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aMissionEvents + {
    GC_Event "{EC9EA41E78E4545E}" {
     m_sName "reminder (event 4, 1800s)"
     m_Advanced GC_EventOptions "{3494D7992562B10F}" {
      m_fDelay 1800
     }
     m_aActions {
      GC_MessageAction "{FF34351AF2AFB4CF}" {
       m_sTitle "10 min left!!!"
       m_sMessage ""
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{F1868040EF841204}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "The revolution has begun! FIA rebels make their first move to attack a US military base to capture their equipment for future operations."\
     ""\
     "<h2>NOTES</h2>"\
     "• Setup timer: 3 min"\
     "• Ratio 1:2"\
     ""
     m_eAudience 1
    }
    GC_Briefing "{7A2F5765663729E7}" {
     m_iOrder 1
     m_sTitle "Mission overview"
     m_sContent "We are a brand new FIA platoon with the objective to capture the US military base in less than 40 min."
     m_aFactionKeys {
      "FIA"
     }
    }
    GC_Briefing "{2F7D254A696266FD}" {
     m_iOrder 2
     m_sTitle "Mission overview"
     m_sContent "We are a US Army squad with an HQ element tasked with defending the military base from the FIA rebels."\
     ""\
     "Setup time is 6 min."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{4EA05819B08E25D4}" {
     m_iOrder 3
     m_sTitle "Situation"
     m_sContent "The corrupt government of Everon has fallen! "\
     "While we have the spirit to fight, we don't have the modern weapons necessary to fight. With that said, we've gathered the local population with weapons and the will to fight. We will assault the US base and secure it by destroying any enemy forces protecting it. "\
     "This base will be used for future operations."
     m_aFactionKeys {
      "FIA"
     }
    }
    GC_Briefing "{C489298F569F537F}" {
     m_iOrder 4
     m_sTitle "Situation"
     m_sContent "The local government has collapsed, and the rebel forces are extremely hostile to us. We have been tasked to protect the military base until our main force arrives in 40 minutes."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{9C3C283677466DB8}" {
     m_iOrder 5
     m_sTitle "Friendly forces"
     m_sContent "A FIA platoon that consists of former civilians armed with bolt-actions, WW2 SMGs and shotguns. With that said, grabbing enemy weapons is encouraged."\
     ""\
     "We have access to:"\
     ""\
     "-3 UAZ452 (Capacity of 8)"\
     "-4 UAZ469 (Capacity of 5)"\
     ""\
     "And possibly a box of captured M67 grenades."
     m_aFactionKeys {
      "FIA"
     }
    }
    GC_Briefing "{307DB02F26CBE855}" {
     m_iOrder 6
     m_sTitle "Friendly forces"
     m_sContent "A US platoon(-) with 80s gear."\
     ""\
     "We have access to:"\
     "-100 sandbags"\
     "-An M2HB with 2 boxes of ammo"\
     "-2 medical Humvees"\
     "-1 transport Humvee"\
     "-3 Jeeps"\
     "-and any weapon and ammo (stored separately) currently located in the base."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{3321CBCA5AEFC800}" {
     m_iOrder 7
     m_sTitle "Enemy forces"
     m_sContent "A US platoon(-) with standard 80s gear."\
     ""\
     "Besides their assigned gear they also have access to weapons and vehicles currently stored in the base. Expect sandbags and an M2HB as well. "
     m_aFactionKeys {
      "FIA"
     }
    }
    GC_Briefing "{76F9FA480AEC7F25}" {
     m_iOrder 8
     m_sTitle "Enemy forces"
     m_sContent "A FIA platoon that consists of former civilians armed with bolt-actions, WW2 SMGs and shotguns. They are desperate, so they will most likely grab our guns from our bodies if able."\
     ""\
     "They have access to civilian vehicles, and they may have a box full of M67 frag grenades."\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{3C28617314F3D0D5}" {
     m_iOrder 9
     m_sTitle "How to use M2"
     m_sContent "To set up the M2 you need to drop the tripod and the gun part on the floor and have the shovel equipped. To reload the M2 you need to drop the ammo box first, then drag it into the gun."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{AC3ECDF385EAB8AF}" {
     m_iOrder 10
     m_sTitle "Mission notes"
     m_sContent "<h2>END CONDITIONS</h2>"\
     "<b>FIA victory:</b>"\
     "• Capture the US military base - FIA needs to have a 90% majority presence in the military site."\
     "or"\
     "• Destroy 90% of US forces."\
     ""\
     "<b>US victory:</b>"\
     "• Destroy 80% of FIA forces."\
     "or"\
     "• Hold out for 40 min"\
     ""\
     "<h2>NOTES</h2>"\
     "• Setup timer: 3 min"\
     "• JIP: Manual"\
     "• Usage of enemy equipment is permitted and encouraged."\
     ""
    }
   }
  }
 }
}
