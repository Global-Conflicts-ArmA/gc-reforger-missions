GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "87835E89ED62B3E8"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{513D688F7233FE3B}" {
     m_iOrder 0
     m_sTitle "Situation"
     m_sContent "I am a local shop owner who has gotten in too deep. For the past three months, I have been supplying Russian forces with information on the CDF. Unfortunately, it seems my involvement has finally caught up with me."\
     ""\
     "25 minutes ago, I received a phone call from Russian intelligence informing me that a CDF hit squad was on its way to eliminate me. Fortunately, they assured me that they were also dispatching 12 of their elite soldiers to secure my location and extract me to safety."\
     ""\
     "Both CDF and Russian forces will be arriving shortly. I must arm myself with the MP5 stored in the crate and hold out until friendly forces arrive."\
     ""\
     "<b>I MUST remain alive at all costs. If I am killed, all the intelligence I possess will be lost.</b>"
     m_aFactionKeys {
      "CIV"
     }
    }
    GC_Briefing "{68B8EC27FDBD7115}" {
     m_iOrder 1
     m_sTitle "Mission"
     m_sContent "Our mission is to extract the HVT at the marked building to the extraction area north of the AO."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{6290890788F2063C}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "Our mission is to eliminate the HVT located somewhere within the marked area."\
     ""
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{EED7704A3426E688}" {
     m_iOrder 3
     m_sTitle "Overview"
     m_sContent "Two squads from the CDF and the AFRF clash head to head in an attempt to rescue a HVT at Hietalanmaki."\
     ""\
     "• HVT must be slotted and cannot leave the marked area until he is resuced by the AFRF team."\
     ""
     m_eAudience 1
    }
    GC_Briefing "{4CC4724E60782448}" {
     m_iOrder 4
     m_sTitle "Friendly forces"
     m_sContent "A squad of Russians and the HVT"\
     ""
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{9F84A03BCE32AFB5}" {
     m_iOrder 5
     m_sTitle "Friendly forces"
     m_sContent "We are an elite team of CDF troops, consisting of 10x located due east of the AO."\
     ""\
     "• Almost everyone has optics, minus our machine gunner."\
     "• We have no medic."\
     ""
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{0747D91089E0C5B6}" {
     m_iOrder 6
     m_sTitle "Friendly forces"
     m_sContent "Two squads of elite Russian soldiers approaching from the west. They wear a mix of digital green and light multicam uniforms and body armour."\
     ""\
     "• Russian and CDF forces look very similar. However, CDF personnel primarily wear darker variants of multicam."
     m_aFactionKeys {
      "CIV"
     }
    }
    GC_Briefing "{04234B6C662E4882}" {
     m_iOrder 7
     m_sTitle "Enemy forces"
     m_sContent "A squad of CDF army using modern equipment."\
     "Almost all have optics."\
     ""
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{BC7DCA283FD17EB7}" {
     m_iOrder 8
     m_sTitle "Enemy forces"
     m_sContent "Expect Russian to send their elite troops to also match us."\
     "They will want to extract the HVT."
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{3384EA748C19D6EC}" {
     m_iOrder 9
     m_sTitle "HVT"
     m_sContent "The HVT is an owner of a local shop who have remained loyal to our cause. It is imperative that we reward their loyalty and maintain support within the area."\
     ""\
     "They are armed with an MP5, dressed in Western civilian clothing, and awaiting your arrival at the building."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{4B5B49F582364922}" {
     m_iOrder 10
     m_sTitle "HVT"
     m_sContent "A local shopkeeper has been supplying information to Russian forces and tracking our troop movements throughout the area. He must be eliminated to send a clear message to anyone else considering betraying our cause."\
     "His residence has been marked on the map."\
     ""\
     "The target holds a firearms licence and may be armed. Exercise caution when approaching the property."\
     "Anyone seen in the area armed and not part of us are to be destroyed."
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{86CBFD69CC8787AA}" {
     m_iOrder 11
     m_sTitle "Mission notes"
     m_sContent "<h2>End conditions</h2>"\
     "<b>CDF VICTORY:</b>"\
     "• Kill the HVT or make the AFRF team combat ineffective by destroying enough players."\
     ""\
     "<b>AFRF VICTORY:</b>"\
     "• Extract the HVT or make the CDF team combat ineffective by destroying enough players."\
     ""\
     "<h2>Notes</h2>"\
     "• HVT must be slotted and cannot leave the marked area until he is resuced by the AFRF team."\
     "• JIP: Deny"
    }
