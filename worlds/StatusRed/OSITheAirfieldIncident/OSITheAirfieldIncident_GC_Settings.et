GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "FA5A980CDFF23552"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{6BB3C11D67B67552}" {
     m_iOrder 0
     m_sTitle "Situation"
     m_sContent "=== 28th of September 2014 ==="\
     "It is 10 days since Scotland voted to remain part of the United Kingdom of Great Britain and Northern Ireland. Riots have broke out in the streets of Glasgow and other separatist stronghold cities and towns across the country."\
     ""\
     "With tensions running high, a highly motivated group of separatists are claiming that the vote was not fair and have taken up arms in the fight for Scotland's independence."\
     ""\
     "RAF Kirknewton (south west of Edinburgh) has been chosen as a target for one of their most brazen operations, to seize an RAF base and commandeer some military equipment."\
     ""\
     "Will this fizzle out? Or be a the start of a civil war?"\
     ""\
     "The fate of Scotland is in your hands! Which side will you choose?"
    }
    GC_Briefing "{5C97120EB917D62F}" {
     m_iOrder 1
     m_sTitle "Mission"
     m_sContent "Your mission is to take control of RAF Kirknewton (area centred around the airfield's hangar 048 118) and destroy 2 cargo helicopters on the ground which contain important documents which we cannot risk getting back to London."\
     ""\
     "We need 5 minutes to sort ourselves out before we can advance on the airfield."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{9DC63D022C67FF37}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "Your mission is to defend and hold RAF Kirknewton (048 118)."\
     ""\
     "You must also try to defend the 2 cargo helicopters from being destroyed, they contain paper based movement instructions confiscated from the Scottish National Party (SNP)."\
     ""\
     "We'll have 5 minutes to setup before the enemy starts approaching!"
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{3F9BCB93A38C6009}" {
     m_iOrder 3
     m_sTitle "Friendly Forces"
     m_sContent "A few sections and HQ  from the 51 Squadron RAF Regiment."\
     "We also have a few pilots who are based here."\
     "We are equipped with modern weaponry."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{B31B0D00122537B7}" {
     m_iOrder 4
     m_sTitle "Enemy Forces"
     m_sContent "Essentially a militia force of Scottish Separatists."\
     ""\
     "Expect irregular weapons and piss poor training."\
     ""\
     "We estimate approximately 60 of them have been spotted forming up to the south (043 095)."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{80EC752602221806}" {
     m_iOrder 5
     m_sTitle "Enemy Forces"
     m_sContent "Approximately 20 soldiers from an RAF Regiment Squadron."\
     "It's likely they have use of helicopters too."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{4E5F96E1BD7E9D7B}" {
     m_iOrder 6
     m_sTitle "Friendly Forces"
     m_sContent "We have a force of approximately 60 separatist fighters willing to die in the struggle for independence. We've setup a FOB in Crabapple Bay."\
     ""\
     "We are armed with whatever we can get our hands on. Some of us have some military training so may have access to better equipment but don't expect much."\
     ""
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{0AF23CADC6C1A523}" {
     m_iOrder 7
     m_sTitle "Service and Support"
     m_sContent "=== Vehicles ==="\
     "1x Tanker lorry (for refueling). [3 occupants]"\
     "1x UH60 (equipped with miniguns either side) [10 occupants]"\
     ""\
     "If we want to use this we'll need to make sure it's fueled and ready to go."\
     ""\
     "=== Resupply ==="\
     "There is no resupply for repairs or ammunition, only fuel."\
     ""\
     "=== Comms ==="\
     "Preset, pilots and leadership have radios."\
     "The pilots will find radios in the helicopter."\
     ""\
     "Platoon net: 46.0 MHz"\
     ""\
     "=== Other ==="\
     "We have sandbags in the crate and entrenching tools we can use to build defences."\
     ""\
     "=== (OOC) ==="\
     "You can use the tanker and fuel supply station inside the airfield to refuel the chopper (048 118)."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{A7A2ED842766CFE4}" {
     m_iOrder 8
     m_sTitle "Service and Support"
     m_sContent "=== Vehicles ==="\
     "We have access to several transport lorries. [13 occupants each]"\
     ""\
     "We also have an open top land rover. [4 occupants]"\
     ""\
     "If we want to use these we'll need to make they're fueled and ready to go."\
     ""\
     "=== Resupply ==="\
     "There is no resupply for repairs or ammunition, only fuel."\
     ""\
     "=== Comms ==="\
     "Leadership have radios, sort yourselves out."\
     ""\
     "=== (OOC) ==="\
     "You can use the jerry cans and port's fuel supply station to refuel the vehicles (043 095)."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{226411DF084E6AA2}" {
     m_iOrder 9
     m_sTitle "End Conditions"
     m_sContent "=== UK Win ==="\
     "The UK wins if one of the following is met:"\
     ""\
     "Time Limit Reached: 90 minutes of elapsed mission time."\
     "Separatists Decimated: Over 90% of all Separatist forces are eliminated"\
     ""\
     "=== Separatists Win ==="\
     "The Separatists win if one of the following is met:"\
     ""\
     "Objective Secured: ALL Cargo Helicopters are destroyed AND the Airfield is held and controlled for a continuous period of 10 minutes."\
     "UK Decimated: Over 90% of all UK forces are eliminated."\
     ""
     m_eAudience 2
    }
    GC_Briefing "{ECFBA5EB59423219}" {
     m_iOrder 10
     m_sTitle "Notes"
     m_sContent "UK's helicopter can go beyond the UK AO, but if unloading soldiers must not do this outside their AO."\
     ""\
     "Sandbags and tank traps can be destroyed using explosives, barbed wire can be disassembled using the entrenching tool."
    }
   }
  }
 }
}
