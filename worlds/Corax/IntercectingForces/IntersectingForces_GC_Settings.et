GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "58E7C9111891D99F"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{867C75BD976E5073}" {
     m_iOrder 0
     m_sTitle "Situation"
     m_sContent "a. Enemy Forces:"\
     "A VDV Brigade was Airlanded in the bad orb valley 5 days ago. G2 Believes there is a company sized force currently holding the intersection at the mouth of the valley preventing movement along the Main supply route and Bad orb proper. Route reconnaissance conducted by btn reports at least one known checkpoint at the interception on the road facing south along the highway  "\
     ""\
     "Btn engineers have identified and marked minefields overnight in preperation for the attack. Disposition of enemy force beyond the intersection is currently unknown."\
     ""\
     "Enemy ofrce are knwon to have long range IDF on call and is likely to have pre sighted killing areas established."\
     ""\
     "b. Friendly Forces:"\
     "B COY Mechanised infantry located North west of the intersection, A and C COY are standing by to exploit and attempt a breakthrough South 2km along the Highway once we complete our mission. "\
     ""\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{585163F67EA39C3E}" {
     m_iOrder 1
     m_sTitle "Terrain and Weather"
     m_sContent "c. Terrain:"\
     "Wide open fields SE leading to a river and intersection at the entrance to a vally. intersection is heavily wooded and valley beyond is broad and lightly wooded with wooded hilltops to either side."\
     ""\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{973CBF9029A25F2F}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "B COY:"\
     "Mission is to capture the intersection at the mouth of the bad orb valley and provide security while A and C COY conduct a passage through our lines to assault into the valley proper"\
     ""\
     " "
    }
    GC_Briefing "{54E7DA6997FA6EE5}" {
     m_iOrder 3
     m_sTitle "Execution"
     m_sContent "At CO discretion but M113's must remain organic to their squads as per US mechanised infantry (M113) doctrine"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{641B05FDAE6E1C35}" {
     m_iOrder 4
     m_sTitle "Sustainment"
     m_sContent "G4 has told us that we have no additional resupply, forces are to attack with what they have on themselves and in friendly vehicles."\
     ""
     m_aFactionKeys {
      "US"
     }
    }
