    GC_Briefing "{58F2CBE5BF4E08CD}" {
     m_iOrder 7
     m_sTitle "Notes"
     m_sContent "US Mechanised (M113) company assaults VDV forces to secure a key intersection."\
     ""\
     "No time limit, weather is random"\
     ""\
     "Setup timer is 2 minutes"\
     ""\
