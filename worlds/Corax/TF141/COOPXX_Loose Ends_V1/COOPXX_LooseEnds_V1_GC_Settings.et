    GC_Briefing "{C0485CCC5EE233D2}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "Delta Force:"\
     "Mission is to Wait for Rangers to secure the ingress route by capturing bridge 894 and then to Attack Lake Krolyk and retrieve the sensitive hardware (Computer Device) and extract back to the east bank of the river and hand over to an awating extraction force at grid 020 033."\
     ""\
     " "
    }
    GC_Briefing "{28D926F332BF5C59}" {
     m_iOrder 3
     m_sTitle "Execution"
     m_sContent "Delta Must Take the lake alone, Rangers must provide a blocking force for Bridge 894. Rangers are not allowed around the sensitive material being retrieved by delta force personel."\
     ""\
     "LOA for rangers is no more than 100 meters north of bridge 894."\
     ""\
     "How you achieve this is up to the CO within the above guidelines."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
