GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "F313A9B920C94874"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{4376ACCD15C6FA07}" {
     m_iOrder 0
     m_sTitle "Situation"
     m_sContent "a. Enemy Forces:"\
     "Enemy forces consist of a Soviet mechanized rifle battalion positioned to our south. It is assessed that they will deploy at least a company-sized element to intercept withdrawing friendly forces utilizing ASR CARBON. Enemy infantry are equipped with AK-pattern rifles, PK machine guns, and RPG anti-armor weapons. Mechanized support is expected to consist of BMP-2 infantry fighting vehicles."\
     ""\
     "b. Friendly Forces:"\
     "Our COY is covering the full AO with our sister platoons (AI) covering the forests of Eichenwald and Allenwald. We also have an LP/OP situated at Erstewald."\
     ""\
     "Our third squad 23 have suffered casualities from earlier recon probing attacks and are comabt inefective. We are located at Ruckberg and have an attached TOW Team (71A)."\
     ""\
     "Friendly convoy expects us to hold the ENY back for 45 mins."\
     ""\
     "c. Terrain"\
     "Terrain is open fields with small patches of dense foliage with a dominating ridge line to the south. We have very good sightlines of the whole AO from the ridgeline of Ruckberg."\
     ""\
     "d. Weather"\
     "Overcast."\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{4561595FFCCA135B}" {
     m_iOrder 1
     m_sTitle "Mission"
     m_sContent "Delay the ENY from advancing and destroying retreating friendly forces on ASR Carbon."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{2095CFF007B7525A}" {
     m_iOrder 2
     m_sTitle "ENEMY"
     m_sContent "This is day 3 of advancing into Germany. The Enemy is currently retreating East to form defensive lines. Early this morning our BTN Recon PLT have located a massive ENY Convoy to the North retreating eastward. Our recon PLT made contact with the Convoy flank security but found it to be lacking in size."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{6A62FB9DC57BD8AF}" {
     m_iOrder 3
     m_sTitle "Command and Signal"
     m_sContent "a. Command"\
     "Chain of command is: Plt Sjt > 1st Section > 2nd Section"\
     ""\
     "b. Signal"\
     "Platoon Net - 46MHz"\
     "Platoon HQ - 22"\
     "1st Section - 22 Alpha"\
     "2nd Section - 22 Bravo"\
     "TOW Team - 71 Alpha"\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{48D9918055F64671}" {
     m_iOrder 4
     m_sTitle "HIGHER AND ADJACENT UNITS"
     m_sContent "Artillery fires of the BTN are occupied with the contact to the SE."\
     ""\
     "No Adjacent units in your assigned AO."\
     ""\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{64374B67090728D4}" {
     m_iOrder 5
     m_sTitle "Sustainment"
     m_sContent "- MG Ammo is crossloaded."\
     "- 3x TOW Missiles in Tow Team Landie"\
     "- 2 Landies for Transport"\
     "- 1 Landie for Tow Team"
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{35CFA801F492E268}" {
     m_iOrder 6
     m_sTitle "MISSION"
     m_sContent "320 is to blockade ENY Convoy route and disrupt ENY movement NLT than 50 mins from mission start. "
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{E6405DF3F3C72D3F}" {
     m_iOrder 7
     m_sTitle "Tow Team"
     m_sContent "TOW Team you require the following items to assemble the TOW, they need to be placed on the ground close to the where the Tripod will be placed."\
     ""\
     "1.      Tripod (Backpack Slot)"\
     "2.      Launch Tube   (Backpack Slot)"\
     "3.      LBB (Backpack Slot)"\
     "4.      Aiming System (Goes into your backpack)"\
     "5.      FCS  (Goes into your backpack)"\
     "6.      TOW-2A RF  (Backpack Slot)"
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{7EA85699F995EC84}" {
     m_iOrder 8
     m_sTitle "ORDER"
     m_sContent "a) Tasks to sub-units."\
     "	The 4th COY (YOU) is to disrupt and blockade ENY route."\
     ""\
     ""\
     "b. Readiness Times."\
     "	Attack is expected to commence 12/03, 06.20 h. (Five mins from start)"\
     ""\
     "c. Signals"\
     "	48MHz. - COY NET (NO PLT NETS)"\
     ""\
     "5. Loc of CO."\
     "	Coy HQ located with the PLTs as marked on map."\
     ""\
     "6. Succession"\
     "	Coy CO successor: Deputy/2 Pl CO."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{497D85F8366F756B}" {
     m_iOrder 9
     m_sTitle "Description & Notes"
     m_sContent "British Infantry PLT try to buy time for BLUFOR forces to escape encriclement as USSR Mech COY try to cut off retreating units. 1980s scenarios. ATGMs, BMP2s etc. "\
     ""\
     "Mission Notes:"\
     ""\
     "BLUFOR Winning Conditons: "\
     "- Attrition of USSR Forces (85% Casualties)"\
     "- Delay USSR Forces (45 Min Time Limit)"\
     ""\
     "OPFOR Winning Conditons:"\
     "- Attrition of UK Forces (90% Casualties)"\
     "- Blockading MSR & holding ground for 10 mins. (Note that this condition is dependent on OPFOR destroying the AI Conovy that when the 10 min timer begins - If Convoy is bugged GM to judge.) "\
     ""
    }
   }
