GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "26EBEE8201944A4B"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aMissionEvents + {
    GC_Event "{0362F5F0C4035BB5}" {
     m_sName "Mission Start (event 2, 2700s)"
     m_Advanced GC_EventOptions "{5A1C12AD01116DE0}" {
      m_fDelay 2700
     }
     m_aActions {
      GC_MessageAction "{E9DDF7D6601AE04F}" {
       m_sTitle "TIME LIMIT REACHED"
       m_sMessage "US forces were unable to accomplish their objective in time."
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{C89FCFFF814CEE45}" {
     m_iOrder 0
     m_sTitle "1. SITUATION"
     m_sContent "a. Enemy Forces"\
     "A Russian artillery battery (up to three 2S1 Gvozdika SP guns) has recently arrived in the area and appears lightly prepared. Possible ENY Motorized QRF in the area ready to support."\
     ""\
     "b. Friendly Forces"\
     "White Platoon, White Company — conducting a night patrol. No higher echelon attachments or detachments for this mission. Neighboring friendly elements maintain sector security but cannot provide immediate direct fire support inside the objective area."\
     ""\
     "c. Attachments / Detachments"\
     "None."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{6F9AE3FF06911E59}" {
     m_iOrder 1
     m_sTitle "Mission Brief"
     m_sContent "US Forces on night patrol stumble upon a Russian Artillery battery. US intend to sieze the opportunity and destroy these assets! Remake of Opportunity Knocks from CMBS:BS."
     m_eAudience 1
    }
    GC_Briefing "{799DE7406C386DFE}" {
     m_iOrder 2
     m_sTitle "REFERENCE POINT"
     m_sContent "Assuming South East is Front"\
     ""\
     "RP100 - Wooden Bridge - Front 170 m "\
     "RP101 - Shallow River Crossing - Front Right 270 m"\
     "RP102 - Irrigation Ditch - Right 250m "\
     "RP103 - Wooded Area - Left 115m"\
     "RP104 - Hunting Lodge - Front 250m"\
     "RP105- Irrigation Ditch - Rear 160m"\
     "RP106 - Concrete Bridge - Right 445m"
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{E1C05F977F83B26E}" {
     m_iOrder 3
     m_sTitle "2. MISSION"
     m_sContent "White Platoon will seize the opportunity destroy as many 2S1 guns, neutralize enemy crews, and withdraw in good order to friendly lines."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{5EEBE3A3AA0A6A6E}" {
     m_iOrder 4
     m_sTitle "ENEMY"
     m_sContent "Enemy forces in the region consist of US motorized and mechanized troops. Yesterday, US forces launched several offensives into our lines in an attempt to force a break through, but were repelled after fierce fighting and the deployment of several reserve units. While the enemy advance was repelled, it is expected that the enemy will continue operations into the night to probe our lines and engage any targets of opportunity that they may come across."\
     ""\
     "Enemy forces are equipped with M4 Rifles, CGs, LMGs as well as wheeled and tracked vehicles. We can expect them to be dressed in standard American woodland OCP uniforms."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{9AE8B91B623EB557}" {
     m_iOrder 5
     m_sTitle "3. EXECUTION"
     m_sContent "Commander's Intent"\
     "Exploit surprise to eliminate the artillery threat with speed and violence of action, while preserving platoon combat power sufficient for withdrawal. "
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{C160617E3BF42B3A}" {
     m_iOrder 6
     m_sTitle "HIGHER AND ADJACNET"
     m_sContent "Anna 331 (1st Platoon) sustained several casualties throughout the day and has been assigned to battery security detail for Roman 351 and security patrols throughout the AO for the night behind the front. Anna 332 has been assigned the task of security for Roman 351; Anna 331 (Squad) however, they have temporarily relocated to Power Plant to scavenge for tools and equipment to repair field damage to their K4386."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{5C58519B78B81472}" {
     m_iOrder 7
     m_sTitle "4. SERVICE SUPPORT"
     m_sContent "a. Logistics"\
     ""\
     "Ammo: Platoon carries organic resupply only; no scheduled vehicle resupply inside the AO. 8x DEMO Blocks provided in crate infront of Platoon HQ"\
     ""\
     "Medical: On-site CLS."\
     ""\
     "Recovery: No vehicle recovery assets available inside AO."\
     ""\
     "b. Sustainment Notes"\
     ""\
     "Batteries for NVGs and comms to be checked before movement."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{A5BF16089ACF96B7}" {
     m_iOrder 8
     m_sTitle "MISSION"
     m_sContent "Anna 332 is tasked with overnight security for Roman 351 and their 2S1s against possible enemy nightime opeartions."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{F690F21FEA077AE0}" {
     m_iOrder 9
     m_sTitle "5. COMMAND & SIGNAL"
     m_sContent "a. Command"\
     ""\
     "Platoon Commander: CO - WHITE 6"\
     ""\
     "Succession: CO → Platoon Sergeant (1st XO) → Squad 1 Leader."\
     ""\
     "b. Signal"\
     ""\
     "Primary Net: CH48"\
     ""\
     "Tac Callsigns: "\
     "PL - WHITE 6"\
     "PSG - WHITE 7"\
     "1st/2nd/3rd/4th SQUAD - WHITE 1/2/3/4"\
     ""\
     "Pyro/IR: Use IR strobes for identification only when required to avoid alerting nearby enemy patrols."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{39CD7743E209815C}" {
     m_iOrder 10
     m_sTitle "ORDER"
     m_sContent "Combat Order: #364"\
     ""\
     "I order:"\
     "a) Tasks to subordinate units"\
     "Roman 351 has been tasked to hold along the river and await resupply of their 2S1 later this morning."\
     ""\
     "Anna 331 has been tasked with security for Roman 351 and nighttime patrols of nearby sectors."\
     ""\
     "Anna 332 is tasked with direct security for Roman 351."\
     ""\
     "b) Tasks to artillery and other units"\
     "All guns are currently resupplying, no fire support will be available."\
     ""\
     "c) Tasks to NBC Defense"\
     "No NBC weapons use is expected by the enemy. All elements shall report any observed use of NBC weapons via radio immediately."\
     ""\
     "d) Readiness times"\
     "Report of readiness by platoon leaders by 7/18, 21:00h"\
     "Patrol readiness: 7/18, 22:00h"\
     "Note: Anna 331 will be released if and when our forward sentries spot something (A notification will trigger)."\
     ""\
     "e) Signals"\
     "ZSU PLT, 'Roman 351', LR-1"\
     "2 SEC, 'Anna 332', SR-1 LR-1"\
     "1 PLT, 'Anna 331', LR-3"\
     "3 PLT LR-1 38Mhz"\
     ""\
     "f) Location of Commander"\
     "Commander will be located at 3 Battalion Command Post."\
     ""\
     "g) Succession of Command"\
     "Roman 351 - 2S1 PLT Leader"\
     "Anna 332 - 2 Section"\
     ""\
     "h) Weather"\
     "Early morning, night, clear."\
     ""\
     "i) Vehicle Kit"\
     "The Ural in the compound contains extra ammunition and supplies."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{F5B19FEC8E758E1E}" {
     m_iOrder 11
     m_sTitle "6. WARNING & NOTES"
     m_sContent "Night operations increase risk of fratricide — positive ID and clear fire sectors are mandatory."\
     ""\
     "Maintain noise and light discipline; NVGs only when required."\
     ""\
     "Speed and surprise are decisive — do not allow the enemy time to mass indirect fires."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{7A6912DF48479618}" {
     m_iOrder 12
     m_sTitle "End Conditions"
     m_sContent "Total US Victory"\
     "RU Forces have sustained 90% Casualities"\
     ""\
     "Major US Victory"\
     "All 2S1s are destroyed and US forces retain at least 60% strength. RU artillery is neutralized with limited American losses."\
     ""\
     "Tactical US Victory"\
     "2-3 2S1s are destroyed and US forces retain between 40% and 59% strength. Objective achieved, though the fight was costly."\
     ""\
     "Minor US Victory"\
     "Atleast 1 2S1s are destroyed but US forces retain less than 40% strength. The mission succeeded, but at an unsustainable cost."\
     ""\
     "Draw"\
     "Both forces suffer 85% or more casualties. Neither side has the strength to continue the engagement."\
     ""\
     " RU Victory"\
     "US Forces have sustain 85% or more casualities. The Russians hold their positions despite losses."
    }
   }
  }
 }
}
