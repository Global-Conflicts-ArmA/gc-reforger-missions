GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "E91570CA11A7C6E8"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{5830DAC447E74C37}" {
     m_iOrder 0
     m_sTitle "Scenario Overview"
     m_sContent "Date: 10 July 1981"\
     "Location: Fulda Gap"\
     "Situation"\
     "A remote signal retransmission site is tactically operational but has been triangulated by Soviet forces. A Soviet Airmobile unit has infiltrated the area with the intent to raid the site and obtain cryptographic equipment."
    }
    GC_Briefing "{DAD1CC0F0D8FF303}" {
     m_iOrder 1
     m_sTitle "1. SITUATION"
     m_sContent "A. Enemy Forces"\
     ""\
     "Composition, Disposition, and Strength:"\
     "Soviet Airmobile Platoon (unsupported) already Inserted via helicopter at a nearby Landing Zone"\
     ""\
     "Capabilities and Limitations:"\
     "Equipped with small arms and potential explosive devices, Lacks direct armored support."\
     ""\
     "Most Likely Course of Action (MLCOA):"\
     "Conduct a swift raid on the retransmission site and overwhelm defenses using speed and surprise. Exfiltrate with cryptographic equipment before reinforcements arrive."\
     ""\
     "Most Dangerous Course of Action (MDCOA):"\
     "Destroy site and eliminate all defenders to prevent counteraction"\
     ""\
     "B. Friendly Force"\
     "No immediate friendly units in the area; response force ETA unknown"\
     ""\
     "C. Attachments and Detachments"\
     "1x Mechanized Infantry Squad"\
     "1x HQ Team"\
     "1x M113 Armored Personnel Carrier"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{B8D197AA1D5C3022}" {
     m_iOrder 2
     m_sTitle "ORIENTATION POINTS"
     m_sContent "Assuming South West is Front."\
     "Distance from Landing Zone."\
     "Front-Left - 1200m - Road junction near objective (OP-100)"\
     "Front - 400 m - Road Junction on ASR (OP-101)"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{B64D7A83735C7331}" {
     m_iOrder 3
     m_sTitle "2. MISSION"
     m_sContent "Defend the signal retransmission site to prevent compromise of cryptographic equipment by Soviet forces. Engage and eliminate the attacking enemy force while maintaining control of the site until further orders."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{72F67827427BB00C}" {
     m_iOrder 4
     m_sTitle "ENEMY"
     m_sContent "Enemy forces consist of elements of the U.S. Army V Corps. Intelligence reports indicate a small defensive force at the radio retransmission site."\
     ""\
     "The enemy force is estimated to be:"\
     ""\
     "One mechanized infantry squad"\
     "One M113 armored personnel carrier"\
     ""\
     "They are equipped with:"\
     "M16 rifles, M60 machine guns, M203 grenade launchers, and possible anti-tank weapons wearing Woodland camouflage uniforms."\
     ""\
     "Electronic warfare units will jam enemy communications for approximately 30 minutes, preventing reinforcements."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{7A69D08ACE5DE654}" {
     m_iOrder 5
     m_sTitle "3. EXECUTION"
     m_sContent "A. Commander’s Intent"\
     "Maintain control of the retransmission site."\
     "Prevent enemy from capturing cryptographic equipment."\
     "Inflict significant casualties to neutralize the enemy force."\
     "B. Concept of Operations"\
     "As per CO"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{7A8794F7D36F30A3}" {
     m_iOrder 6
     m_sTitle "HIGHER AND ADJACENT UNITS"
     m_sContent "Higher command has issued orders to disrupt NATO communication infrastructure."\
     ""\
     "Main assault force is focused on neutralizing enemy positions deeper in the sector."\
     ""\
     "Additional Soviet forces are engaging enemy units to the West, ensuring no reinforcements arrive."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{20524A06AA7AAB97}" {
     m_iOrder 7
     m_sTitle "4. SUSTAINMENT"
     m_sContent "None."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{F09D91BBAF6432AF}" {
     m_iOrder 8
     m_sTitle "MISSION"
     m_sContent "Our objective is to infiltrate and assault the U.S. radio retransmission site. Sieze the retransmission site."\
     ""\
     "This will disrupt NATO’s ability to coordinate operations in the sector."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{E8D43AC691625A41}" {
     m_iOrder 9
     m_sTitle "5. COMMAND AND SIGNAL"
     m_sContent "Red 6 - PL (48.0 Mhz)"\
     "Red 7 - PSG"\
     "Red 1 - 1st Squad"\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{8B416FC1D2C6A973}" {
     m_iOrder 10
     m_sTitle "ORDER"
     m_sContent "I order:"\
     ""\
     "Tasks to Subordinate Units"\
     "Airmobile Assault Platoon will move from the Landing Zone and infiltrate towards the target."\
     ""\
     "Tasks to Supporting Units"\
     "Electronic Warfare Unit will initiate 30 minutes of signal jamming before contact. No artillery support available due to operational limitations."\
     ""\
     "Enemy Counteraction"\
     "Enemy may attempt to reposition and call for reinforcements after jamming ends. Expect light mechanized counterattacks if the mission is delayed."\
     ""\
     "Readiness Times"\
     "Report attack readiness: 10/06, 05:00h"\
     "Mission commencement: 10/06, 05:20h"\
     ""\
     "Weather"\
     "Dawn, Overcast"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{C423E85C2BF426F4}" {
     m_iOrder 11
     m_sTitle "COMMAND AND SIGNAL"
     m_sContent "Callsgns:"\
     "PL (42.0 Mhz) - 0"\
     "1 Squad - 1"\
     "2 Squad - 2"\
     "3 Squad - 3"\
     ""\
     "SLs DO NOT HAVE RADIOS, A Crate has been provided at spawn with Smokes, Flares for Signalling. This crate is intended only for SLs and PL."\
     ""\
     "Signals:"\
     "Red Smoke: Commander's Intent"\
     "Yellow Smoke: Commander's Intent"\
     "Violet Smoke: Commander's Intent"\
     ""\
     "Orange Flare: Commander's Intent"\
     "Green Flare: Commander's Intent"\
     "White Flare: Commander's Intent"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{4E6D0C7E0A82C1F4}" {
     m_iOrder 12
     m_sTitle "MIssion Notes"
     m_sContent "Time Limit: None"\
     "VDV Casuality Limit: 90%"\
     "US Casuality Limit: 90%"\
     "Capture time of Retransmission Site: 5 minutes"\
     "Both sides are free to manoeuvre within the full AO Limit."\
     "BLUFOR has 2 minute setup timer. "\
     "Created by Blue"\
     "Thanks Gkennny for help in creating the mission."\
     "Inspired by Combat Mission Cold War"
    }
    GC_Briefing "{53186ADC8CCFBC86}" {
     m_iOrder 13
     m_sTitle "Gamer Mastering"
     m_sContent "This mission is not designed for game mastering and should only be manipulated for technical, administrative or diagnostic purposes."
    }
   }
  }
 }
