GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "00E176D0D2EDEA8F"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{C59563A175FCBBC5}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "A US Army Ranger platoon conducts an air assault on to a staging area being used by USSR Motor rifles, in order to alleviate pressure on a nearby friendly unit."
    }
    GC_Briefing "{5BB868CD339319EF}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "USSR forces have seized the majority of Everon in a lightning offensive, leaving the surviving US forces that originally garrisonned the island falling back to the south to rally at St Pierre."\
     ""\
     "Your ranger platoon is about to be deployed to the island to reinforce the garrison and spearhead a counterattack against the Soviets. Our first stop is to blunt the enemy's attack before it can reach St Pierre."
    }
    GC_Briefing "{E23E0DB6ABF55587}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x Platoon of US Army Rangers, supported by 2x AH-1 Cobras and with 4x UH-60 Black Hawks for transport."
    }
    GC_Briefing "{D97AECC5043C5908}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "1x Platoon of Soviet motor rifles reinforced by 1x Motor recon platoon located at Regina, currently staging for an attack on Durras from the west."\
     ""\
     "An additional motor rifle platoon is located at the military facility north of Regina, preparing to also take part in this attack from the north. They may be diverted to Regina as a quick reaction force. This facility is defended by multiple ZU-23 anti-aircraft guns, suggest restricting sending aircraft north."
    }
    GC_Briefing "{E090AD63B6E90FFB}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Assault the town of Regina, destroying all enemies located there and denying its usage as a staging area to the Soviets. Complete the assault of the town within the next 60 minutes."\
     ""\
     "Once the town is secure, dig in and hold it for 15 minutes against any Soviet QRFs or counterattacks. This will divert pressure away from friendlies in Green Valley."
    }
    GC_Briefing "{AF7F443B77533979}" {
     m_iOrder 5
     m_sTitle "VI. Service & Support"
     m_sContent "Vehicles available:"\
     ""\
     "2x AH-1 Cobras"\
     "4x UH-60 Black Hawks"\
     ""\
     "Repair, refuel and rearm can be conducted when landed at our current position."\
     ""\
     "An ammo truck is available near the Black Hawks for Chariot flight to conduct resupply after insertion."
    }
    GC_Briefing "{E2382DEEFA76DD6A}" {
     m_iOrder 6
     m_sTitle "VII. Command & Signal"
     m_sContent "Ground net: 48.0 Mhz"\
     "Air net: 50.0 Mhz"\
     ""\
     "1-6: Platoon HQ"\
     "1-1: 1st Squad"\
     "1-2: 2nd Squad"\
     "1-3: 3rd Squad"\
     "1-4: Weapons Squad"\
     ""\
     "1-6A: Platoon CO"\
     "1-6B: Platoon Sergeant"\
     "1-6R: Platoon FAC"\
     ""\
     "Crossbow-61: First Cobra"\
     "Crossbow-62: Second Cobra"\
     ""\
     "Chariot-61: First Black Hawk (Flight Lead)"\
     "Chariot-62: Second Black Hawk"\
     "Chariot-63: Third Black Hawk"\
     "Chariot-64: Fourth Black Hawk"
    }
    GC_Briefing "{7363DFF464F72F9C}" {
     m_iOrder 7
     m_sTitle "Mission notes"
     m_sContent "Mission by arc"\
     ""\
     "End conditions:"\
     "Regina captured and held for 15 minutes: Victory"\
     "80% US Casualties or 75 minutes pass: Defeat"\
     ""\
     "The friendlies in Green Valley aren't real, you can't save them, I'm not Woody"
    }
   }
  }
 }
}
