GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "BB547C4B94000DFF"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{FCC1F9C34DE025D4}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "CDF Airborne troops reinforce a key MSR to blunt a neo-ChDKZ offensive."\
     ""\
     "Mi-8 air crew may be required to fly on infil at CO's discretion."\
     ""\
     "75 minute TL which is disabled when both objectives are captured."
    }
    GC_Briefing "{5C9E4A431B456B4C}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "The Chernarussian Movement of the Red Star (ChDKZ) has seen a resurgence in recent months and have gathered enough momentum to launch a full scale offensive in the north-western regions of Chernarus."\
     ""\
     "A significant assault is currently proceeding southward down a key MSR, currently defended by a CDF mechanized platoon at Kantola. This unit has come under mortar attack and believes an infantry push is imminent."\
     ""\
     "Your airborne unit is acting as a QRF and is being deployed to reinforce Kantola and stop this offensive in its tracks."
    }
    GC_Briefing "{4F67B9E3D6A45033}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "CDF regular infantry, wearing multicam with plain olive helmets and armour."\
     ""\
     "Equipped with mostly post-soviet weaponry such as AK-74s, PKMs."\
     ""\
     "1x Airborne company (you) at 2x platoon strength located at Metsala airfield. 2x Mi-24s and 4x Mi-8s available for transport and CAS."\
     ""\
     "1x M113-equipped Mechanized platoon (AI) located at Kantola taking up defensive positions."
    }
    GC_Briefing "{D05D561E16C78804}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Neo-ChDKZ separatist fighters."\
     ""\
     "Equipped mainly with post-soviet weaponry, wearing a mixture of camouflage patterns and civilian clothing."\
     ""\
     "Company-strength infantry reinforced by BTR-70s located at Jarvela. An unknown number of additional forces may be in reserve further north."
    }
    GC_Briefing "{D0AFD99869528A90}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "- Reinforce Kantola to prevent it falling to the incoming ChDKZ attack."\
     "- Move to secure Jarvela by taking and holding marked areas on the east and west sides of the settlement. Complete this within 75 minutes."\
     "- Once Jarvela is secure, hold out against further counterattacks for a minimum of 10 minutes, or eliminate 90% of ChDKZ forces in the area."
    }
    GC_Briefing "{17C7DA5B79636345}" {
     m_iOrder 5
     m_sTitle "V. Service & Support"
     m_sContent "Repair, refuel and resupply is available for helos landed in front of the hangars (where they spawned)."
    }
    GC_Briefing "{196B42E552D6BBD1}" {
     m_iOrder 6
     m_sTitle "VI. Command & Signal"
     m_sContent "1st Platoon (110) - 46.0 Mhz"\
     "2nd Platoon (120) - 47.0 Mhz"\
     "Company (100) - 48.0 Mhz"\
     "Air - 49.0 Mhz"\
     ""\
     "All CAS fires must be explicitly cleared by FAC. If FAC is unavailable/KIA, they must be cleared by current CO."\
     ""\
     "Mi-8 Air crews can optionally take one of the additional Mi-8s for insertion if required, otherwise opt for multiple lifts."
    }
    GC_Briefing "{1E673786F802A48C}" {
     m_iOrder 7
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     ""\
     "Victory:"\
     "- East and West Jarvela secure and either 10 minute pass or 90% separatist casualties"\
     ""\
     "Defeat:"\
     "- East and West Jarvela not secured within 75 minutes, or 80% CDF player casualties"
    }
   }
  }
 }
}
