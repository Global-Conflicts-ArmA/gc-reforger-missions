 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{96DBA7B42B0ECE27}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "Navy SEAL platoon attempts to hold a fortified police station against an insurgent attack aiming to free a HVT."\
     ""\
     "10 insurgent respawns, 30 minute time limit after 2 minute setup."
    }
    GC_Briefing "{35C2FE051B75156B}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "A SEAL platoon has been working to suppress our activity in Kunar province."\
     ""\
     "After successfully capturing an allied cell leader in the area, the SEALs have relocated him to the fortified Nangalam police station to await extraction."\
     ""\
     "Several minutes ago our VBIED detonated on the bridge to the North destroying a LAV, and we will now conduct an attack on the station to eliminate the SEALs and recover the VIP."\
     ""\
     "The SEALs' extraction arrives in 30 minutes."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{9FAE1F944BBA9F7A}" {
     m_iOrder 2
     m_sTitle "I. Situation"
     m_sContent "Our SEAL platoon has been working to suppress insurgent activity in Kunar province."\
     ""\
     "After successfully capturing an insurgent leader in the area, we have relocated him to the fortified Nangalam police station to await extraction."\
     ""\
     "Several minutes ago a VBIED detonated on the bridge to our North destroying a LAV deployed to support us, and we now believe an insurgent ground attack will follow on our location."\
     ""\
     "Extraction arrives in 30 minutes."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{CDB7DC36CB5DE999}" {
     m_iOrder 3
     m_sTitle "II. Friendly Forces"
     m_sContent "Platoon+ number of insurgent attackers, located to the south-east of the police station."\
     ""\
     "Wearing a mixture of civilian and military clothing, equipped with soviet-era equipment such as AK-47s, RPKs, RPGs."\
     ""\
     "1x UAZ armed with a PKM is available, in addition to a VBIED car. 1 respawn available to incentivize VBIED use."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{3C62D16D14C039F2}" {
     m_iOrder 4
     m_sTitle "II. Friendly Forces"
     m_sContent "1x SEAL Platoon located at the Nangalam police station."\
     ""\
     "Wearing UCP and coyote-coloured equipment, equipped with M4s, M249s."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{30DD43B4F57AF006}" {
     m_iOrder 5
     m_sTitle "III. Enemy Forces"
     m_sContent "1x SEAL Platoon located at the Nangalam police station."\
     ""\
     "Wearing UCP and coyote-coloured equipment, equipped with M4s, M249s."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{D6BF7753F15F7C2D}" {
     m_iOrder 6
     m_sTitle "III. Enemy Forces"
     m_sContent "Unknown number of insurgent attackers, believed to be approaching from the south-east."\
     ""\
     "Wearing a mixture of civilian and military clothing, equipped with soviet-era equipment such as AK-47s, RPKs, RPGs."\
     ""\
     "More VBIEDs or technicals may be in support."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{727A93A537814EEF}" {
     m_iOrder 7
     m_sTitle "IV. Mission"
     m_sContent "Assault the police station and eliminate the SEALs. Eliminate 90% of defenders within 30 minutes after a 2 minute setup."\
     ""\
     "Keeping the HVT alive is preferable but our priority is elimination of the SEALs."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{4E8F0960C6712678}" {
     m_iOrder 8
     m_sTitle "IV. Mission"
     m_sContent "Hold out against the insurgent attack for 30 minutes after a 2 minute setup, or eliminate 90% of attackers."\
     ""\
     "Keeping our HVT alive is preferable but our priority is survival. The HVT is currently located in a cell on the ground floor of the police station."\
     ""\
     "The police station is fortified and 2 storeys high plus roof access. The compound itself is also fortified with HESCO walls and multiple bunkers."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{81E121C7FF7F1E63}" {
     m_iOrder 9
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     "- 90% US casualties and HVT extracted: Major Insurgent Victory"\
     "- 90% US casualties and HVT dead: Minor Insurgent Victory"\
     "- 90% Insurgent casualties or 30 minutes pass, and HVT extracted or dead: Minor US Victory"\
     "- 90% Insurgent casualties or 30 minutes pass, and HVT still captive: Major US Victory"\
     ""\
     "1 insurgent respawn, 30 minute time limit after 2 minute setup."
    }
