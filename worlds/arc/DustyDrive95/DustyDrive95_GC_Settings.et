GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "D4E11F4DB36DB320"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{BAFB2DA2CB8736B7}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "Motorized US Army Rangers with AH-6M CAS search a couple of desert "\
     "towns to destroy anti-aircraft weaponry."
    }
    GC_Briefing "{6B3E51EF3D80313C}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Our Ranger platoon has been working to support local security forces based out of Landay Airfield."\
     ""\
     "Over the past week there have been a string of anti-air attacks on aircraft operating out of the airfield. The platoon has now been tasked with searching the nearby towns of Zaranj and Tebbi to locate and destroy anti-aircraft weaponry and clear the skies for friendlies once more."
    }
    GC_Briefing "{145C69F98EE55355}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "Reduced platoon of US Army Rangers, consisting of a Platoon HQ, 2 Rifle Squads and a Weapons Squad."\
     ""\
     "6x Humvees armed with M2 Browning machine guns are available for transport and combat, each seating 5 people including driver and gunner."\
     ""\
     "2x AH-6M helicopters are also available for CAS."
    }
    GC_Briefing "{C17DD20F40E1958E}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Unknown strength Insurgent forces."\
     ""\
     "Armed with a mixture of weaponry, largely old USSR equipment. Wearing mostly civilian clothing, likely covered faces. No armored capabilities but may be fielding technicals."\
     ""\
     "Approach each area with caution, the insurgents may have taken the opportunity of our reduced air cover to move more of their forces in to the local area."
    }
    GC_Briefing "{D85AE3836564BE52}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Search the towns of Zaranj and Tebbi for anti-aircraft weapons. Intelligence suggests they are being kept in Ural ammo trucks."\
     ""\
     "Locate and destroy a truck at each town and then return to base."
    }
    GC_Briefing "{186A3C05972F91B7}" {
     m_iOrder 5
     m_sTitle "V. Service & Support"
     m_sContent "Repair, Refuel & Rearm:"\
     ""\
     "AH-6s can be serviced at the airfield on the helipads they started on."\
     ""\
     "Several M112 demolition blocks and M34 Firing devices are available near the humvees for destroying the objectives."
    }
    GC_Briefing "{072362EB4480E8CF}" {
     m_iOrder 6
     m_sTitle "VI. Command & Signal"
     m_sContent "Ground net: 48.0 Mhz"\
     "Air net: 50.0 Mhz"\
     ""\
     "HQ: 1-6"\
     "1st Squad: 1-1"\
     "2nd Squad: 1-2"\
     "Weapons: 1-4"\
     ""\
     "JTAC: 1-6J"\
     "1st Littlebird: Assassin-61"\
     "2nd Littlebird: Assassin-62"
    }
    GC_Briefing "{9AB9B1B68C87B92D}" {
     m_iOrder 7
     m_sTitle "Mission notes"
     m_sContent "Mission by arc"\
     ""\
     "AH-6s can be rearmed at the helipads they started on"\
     ""\
     "End conditions:"\
     "2x Ural Ammo Trucks destroyed and 75% US forces extract back to Landay airfield - Victory"\
     "80% US Casualties or 75 minutes pass - Defeat"
    }
   }
  }
 }
}
