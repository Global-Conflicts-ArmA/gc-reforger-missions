GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "F1E96865AC41233E"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{B5A58B3DE32AFD62}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "A US Army Rifle squad + reduced weapons squad conduct a hasty defense to delay attacking Russian motor rifles before regrouping with the rest of their platoon."
    }
    GC_Briefing "{8F48600713534149}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Our infantry platoon is stationed as a forward defense for NATO forces attempting to hold the town of Zarichne."\
     ""\
     "Artillery just targeted our Platoon HQ causing casualties in 2nd and 3rd Squad, and we believe Russian motor rifles will now be advancing on our position down the MSR and dismounted through the nearby woods."
    }
    GC_Briefing "{141617FB40B9DF0B}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x US Army Rifle Squad + half strength weapons squad, located in the center of the map (you)."\
     ""\
     "1x US Army Rifle Squad defending the Platoon HQ location, located in the south-west of the map."\
     ""\
     "Platoon HQ and multiple wounded are still inside the Platoon HQ compound."
    }
    GC_Briefing "{AE6238D74189B476}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "At least 1 platoon of Russian motor rifles inbound. A K-17 IFV as well as a GAZ Tigr has been spotted approaching down the nearby MSR and will likely be making contact with us within the next 3 minutes. Dismounted follow ups are expected through the woods on the north of the MSR."
    }
    GC_Briefing "{FD261C45D6B5CEA3}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Intercept and delay attacking forces for 20 minutes, buying time for wounded to be stabilized, then extract to the Platoon HQ's location."
    }
    GC_Briefing "{2069A1B40EA92B4E}" {
     m_iOrder 5
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc"\
     ""\
     "AO limit in effect, don't expect to go more than 250m further east of the construction site in front of you"\
     ""\
     "End conditions:"\
     ""\
     "20 Minutes pass, and 80% of surviving US players regrouped with rest of platoon: Victory"\
     ""\
     "80% US player causalties or Platoon HQ overrun by AFRF: Defeat"
    }
   }
  }
 }
}
