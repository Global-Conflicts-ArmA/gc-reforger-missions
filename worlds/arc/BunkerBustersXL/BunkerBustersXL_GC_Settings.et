GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "544FA690EACE01EC"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{6CF3E2747EB68C60}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "2.5:1 US:SEPARATIST"\
     ""\
     "US Special Forces raid a bunker housing nuclear material which has been overrun by separatists."\
     ""\
     "Air is optional, ground insert is available. "\
     ""\
     "Heli crew may be pilots depending on insertion option chosen by CO."\
     ""\
     "5 minute setup, 60 minute TL."
    }
    GC_Briefing "{7CA8007B0FFD6128}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Civil war in the Zarichne region has been greatly reduced following a NATO led intervention, now carrying on as a low level insurgency."\
     ""\
     "Several hours ago, separatists overran security forces at a secret compound housing nuclear material used in the previous government's research programs."\
     ""\
     "Your unit has been tasked with securing the bunker inside this compound and the material before the separatists can extract it."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{DAA68F3F5D88FCD2}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "US SF platoon with the following options for air or ground insertion:"\
     ""\
     "- 6x Humvees armed with M2 machine guns"\
     "- 4x Unarmed Littlebirds"\
     "- 2x Blackhawks"\
     ""\
     "A crate at our current position also has various short-range optics which may be helpful inside the bunker."\
     ""
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{3F5802E29FCF7A4E}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Approximately 15 pax Zarichne separatists."\
     ""\
     "Wearing a mixture of civilian clothing and camouflage patterns, equipped with mostly old Soviet weaponry but sporting modern plate carriers."\
     ""\
     "Expect a mixture of defenders outside and inside the bunker complex."\
     ""\
     "The separatists assaulted the compound using technicals, so be cautious of these still being operational."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{ADFA9B5818162F00}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Assault the marked bunker."\
     ""\
     "We believe the separatists will be gathering the nuclear material at a service tunnel accessible somewhere on the south side of the bunker. Reach and secure that point within 60 minutes after setup."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{377044759D7233E8}" {
     m_iOrder 5
     m_sTitle "V. Command & Signal"
     m_sContent "Air net: 47.0 Mhz"\
     "Ground net: 48.0 Mhz"\
     "1st Platoon net: 49.0 Mhz"\
     "2nd Platoon net: 50.0 Mhz"
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{BBF46F555560004E}" {
     m_iOrder 6
     m_sTitle "I. Situation"
     m_sContent "Civil war in the Zarichne region has been greatly reduced following a NATO led intervention, now carrying on as a low level insurgency."\
     ""\
     "Several hours ago, we overran security forces at a secret compound housing nuclear material used in the previous government's research programs."\
     ""\
     "A US SF team is on their way to assault the bunker and prevent us escaping with the nuclear material."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{BC1862781C6B2BB7}" {
     m_iOrder 7
     m_sTitle "II. Friendly Forces"
     m_sContent "Approximately 15 pax Zarichne separatists."\
     ""\
     "Wearing a mixture of civilian clothing and camouflage patterns, equipped with mostly old Soviet weaponry but sporting modern plate carriers."\
     ""\
     "We also have 1x UAZ armed with a PKM available for use outside of the bunker."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{7E34D459A9B5B3E2}" {
     m_iOrder 8
     m_sTitle "III. Enemy Forces"
     m_sContent "US SF platoon."\
     ""\
     "Wearing multicam and equipped with modern rifles, plate carriers, and night vision."\
     ""\
     "They may opt for either a ground or air insertion, so be cautious of the enemy taking either or both approaches at once."\
     ""
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{861D5EED011AC88C}" {
     m_iOrder 9
     m_sTitle "IV. Mission"
     m_sContent "Defend the marked bunker. We must remain inside the fence of the compound, the checkpoint entrance of the compound is also permitted."\
     ""\
     "We are currently gathering the nuclear material into a stack of crates on the lowest accessible floor of the bunker. Defend this position for the next 60 minutes after setup, eliminating all attackers."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{B6A285953DD726D8}" {
     m_iOrder 10
     m_sTitle "Mission notes"
     m_sContent "Mission by arc"\
     ""\
     "Separatists AO limited to within fence of compound, entrance checkpoint is allowed"\
     ""\
     "End conditions:"\
     ""\
     "To secure nuclear material, hold the action on the truck for 30 seconds."\
     ""\
     "Both rucks in service tunnel secured by USAF, or 95% Separatist casualties: US Victory"\
     "90% USAF casualties or 60 minutes pass: Separatist Victory"
    }
   }
  }
 }
