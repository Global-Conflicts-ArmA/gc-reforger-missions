GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "8C8EBEDAE6BC4D19"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{1B39808C260FF590}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "US Light Infantry conduct a patrol around several areas north of their FOB in Anizay. Civilians may be present."
    }
    GC_Briefing "{C3BBF2C6D84673DC}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Insurgent activity has increased in Anizay in recent weeks, with multiple attempted anti-air attacks and mortar attacks on NATO bases throughout the region."\
     ""\
     "Your unit has been tasked with a morning patrol around the area north of your FOB to enforce our presence in the area."
    }
    GC_Briefing "{22CBEC44B6A31F4C}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "2x Rifle Squads + HQ Element of US Light infantry."\
     ""\
     "Wearing DCU with woodland PASGT vests."\
     ""\
     "1x M1025 Humvee armed with an M2 is available as a base of fire platform and for transporting small numbers of infantry."
    }
    GC_Briefing "{E5BD04BF0B35E1F3}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Unknown number Anizay insurgents."\
     ""\
     "Likely wearing a mixture of civilian clothes, equipped with old Soviet equipment such as AKs, PKMs and RPGs."
    }
    GC_Briefing "{11EC0B682A7855D1}" {
     m_iOrder 4
     m_sTitle "IV. Civilian Presence"
     m_sContent "Civilians may be present throughout your patrol route, so check your fire and use explosives with caution."
    }
    GC_Briefing "{8BBE97E6B9D6F0F0}" {
     m_iOrder 5
     m_sTitle "V. Mission"
     m_sContent "Patrol the area by visiting the marked objectives on the map and ensuring they are clear of insurgent presence. You will be notified when an area is considered clear."\
     ""\
     "Return to base safely afterwards. Withdrawing after hitting 4 objectives will still be considered acceptable for a minor victory."\
     ""\
     "Complete this within 120 minutes."
    }
    GC_Briefing "{87A1AB6B1B5E2CDA}" {
     m_iOrder 6
     m_sTitle "VI. Rules of Engagement"
     m_sContent "Due to civilian presence in the area, rules of engagement are as follows."\
     ""\
     "Only fire if:"\
     "- Fired upon."\
     "- Enemy is confirmed to be armed and a team leader or above has given the order to engage."\
     ""\
     "Exercise extreme caution using explosives in urban areas."
    }
    GC_Briefing "{61A5B94688A4C5E7}" {
     m_iOrder 7
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc"\
     ""\
     "End conditions:"\
     "6 Objectives patrolled and 75% of surviving US forces return to base: Major Victory"\
     "4 Objectives patrolled and 75% of surviving US forces return to base: Minor Victory"\
     "90% US Casualties or 120 minutes pass: Defeat"
    }
    GC_Briefing "{75BB770F1A75AF16}" {
     m_iOrder 8
     m_sTitle "Game Mastering"
     m_sContent "By default, this is designed to be a straightforward and relatively easy WAC/Patrol mission. If this is not what your players are currently after, then some light game mastering is encouraged to adjust the difficulty accordingly."\
     ""\
     "There is some light randomization so not every objective will neccessarily be occupied or have civs."\
     ""\
     "GC Insurgent groups should be accessible in the resource browser in GM, look for groups with an orange flag - these will either be separatists or insurgents (I intend to sort out their GM appearance at some point)."\
     ""\
     "ROE is not enforced by any mission making means, so feel free to implement this as a GM in an immersive way."\
     ""\
     "Resupply is not available by any mission making means, so feel free to implement this as a GM in an immersive way."\
     ""\
     "Respawns are not implemented, but feel free to make some available as needed and transport them in an immersive way."
    }
   }
  }
 }
}
