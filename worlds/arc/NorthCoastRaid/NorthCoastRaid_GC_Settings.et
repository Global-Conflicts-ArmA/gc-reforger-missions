GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "09A2668B4EE0F953"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{228C16F60E4711C6}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "A Royal Marine Commando company conducts an amphibious assault to eliminate Russian air defenses and isolate enemies further along the coast."\
     ""\
     "75 minute TL"
    }
    GC_Briefing "{319ED8DF779BA48F}" {
     m_iOrder 1
     m_sTitle "I. Mission"
     m_sContent "American forces on the island of Kolguyev are soon to conduct an attack on a significant Russian element occupying the industrial harbour town of Mineraly."\
     ""\
     "Your Royal Marine company has been tasked with objectives in aid of this assault: capturing a position being used by Russian anti-air teams, and securing the two major road routes west of Mineraly. This will allow for safer deployment of CAS for the assault, and cut off the main escape routes for the Russian elements in Mineraly."
    }
    GC_Briefing "{EDB33D83E6A5C97F}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x Royal Marine Commando company."\
     ""\
     "Wearing multicam, equipped with modern British weaponry."\
     ""\
     "12x RHIBs are available, 3x armed with M134 miniguns and 9x available in transport configuration."\
     ""\
     "Armed RHIBs carry 7, unarmed RHIBs carry 8."
    }
    GC_Briefing "{25EDC410434E5B53}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "2x Russian Light Motor Rifle companies."\
     ""\
     "Wearing EMR, equipped with modern Russian weaponry. Operating Gaz TIGRs, some of which may be armed with LMGs."
    }
    GC_Briefing "{01547907F5F222BD}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "1. Secure the main multi-storey building at Zenit Mine, which is currently being used by Russian MANPADS operators."\
     ""\
     "2. Proceed east and secure the two marked bridges west of Mineraly."\
     ""\
     "End state is company set up on objective 2 prepared to intercept any forces that retreat from Mineraly."
    }
    GC_Briefing "{CA3BC2FBFD1FB7C2}" {
     m_iOrder 5
     m_sTitle "V. Command & Signal"
     m_sContent "Company Net: 48.0 Mhz"\
     "1st Platoon Net: 47.0 Mhz"\
     "2nd Platoon Net: 46.0 Mhz"\
     "3rd Platoon Net: 45.0 Mhz"
    }
    GC_Briefing "{90020A8DA94055AF}" {
     m_iOrder 6
     m_sTitle "VI. Default Load Order"
     m_sContent "1. RHIB M134: 11A First Fireteam + 10 Medic"\
     "2. RHIB Transport: 11A Second Fireteam + 11HQ"\
     "3. RHIB Transport: 11B"\
     "4. RHIB Transport: 11C"\
     ""\
     "5. RHIB M134: 12A First Fireteam + 10 CO + 10 Signaller"\
     "6. RHIB Transport: 12A Second Fireteam + 12HQ"\
     "7. RHIB Transport: 12B"\
     "8. RHIB Transport: 12C"\
     ""\
     "9. RHIB M134: 13A First Fireteam + 10 2IC + 10 Medic"\
     "10. RHIB Transport: 13A Second Fireteam + 13HQ"\
     "11. RHIB Transport: 13B"\
     "12. RHIB Transport: 13C"
    }
    GC_Briefing "{3C2B9B14C05B59C8}" {
     m_iOrder 7
     m_sTitle "Mission Notes"
     m_sContent "End Conditions:"\
     ""\
     "All 3 marked objectives secured: Victory"\
     "80% UK casualties or 75 minutes pass: Defeat"
    }
