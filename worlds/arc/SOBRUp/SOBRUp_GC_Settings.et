GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "8762C51D3933139A"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{F5FDDEF23E65B02A}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "4:1 AFRF:Separatists"\
     ""\
     "After a major terrorist attack in Zarichne, a SOBR unit searches separatist hideouts for evidence."\
     ""\
     "45 minute TL including 5 minute setup"
    }
    GC_Briefing "{D3A12065F48EF6C6}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Yesterday, we executed a significant attack in Zarichne for our cause."\
     ""\
     "We still have safehouses on the outskirts of Zarichne housing weapons and insurgents which we have yet to extract from the region."\
     ""\
     "An informant in the local police has informed us a SOBR unit has assembled and is likely moving to raid our positions before we can evacuate."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{8D24F7A391C47DEF}" {
     m_iOrder 2
     m_sTitle "I. Situation"
     m_sContent "Yesterday, a significant terror attack occured in Zarichne."\
     ""\
     "The FSB has provided intelligence that the perpetrators are part of a border region separatist faction, and may still have safehouses on the outskirts of Zarichne housing weapons and insurgents."\
     ""\
     "Your SOBR unit has been tasked with raiding these positions to eliminate any terrorists and secure evidence."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{8B0CAC4AEFFC579F}" {
     m_iOrder 3
     m_sTitle "II. Friendly Forces"
     m_sContent "30-40 pax border region separatists."\
     ""\
     "Wearing a mixture of equipment, camouflage patterns and civilian clothing, armed with old Soviet equipment."\
     ""\
     "We have a group of 10 separatists defending each compound. Our group has been tasked as a maneuver element to roam between objectives and ambush the attackers, or provide additional defense at each location."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{70629D632576322C}" {
     m_iOrder 4
     m_sTitle "II. Friendly Forces"
     m_sContent "Maximum 28 pax of the Special Rapid Response Unit of the Russian Federation."\
     ""\
     "Wearing multicam fatigues with black body armor and helmets."\
     ""\
     "5x Tigrs have been made available for transport (1 per team), including 2 armed with PKMs."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{EDD9FBBADB6FF862}" {
     m_iOrder 5
     m_sTitle "III. Enemy Forces"
     m_sContent "Maximum 28 pax of the Special Rapid Response Unit of the Russian Federation."\
     ""\
     "Wearing multicam fatigues with black body armor and helmets."\
     ""\
     "Expect motorized capabilities as Tigrs have been made available to the unit."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{DFA893E733C150F7}" {
     m_iOrder 6
     m_sTitle "III. Enemy Forces"
     m_sContent "30-40 pax border region separatists."\
     ""\
     "Likely wearing a mixture of equipment, camouflage patterns and civilian clothing, armed with old Soviet equipment."\
     ""\
     "We can expect the separatists to be inhabiting each compound, but be wary of roaming groups preparing ambushes."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{1B0D03F0BD8B2D70}" {
     m_iOrder 7
     m_sTitle "IV. Mission"
     m_sContent "Defend the 3 caches (marked by green flags on the map) from the SOBR raid by eliminating 90% of attackers or holding out for 45 minutes."\
     ""\
     "Decide if you are going to go firm and reinforce certain objectives or roam to set up ambushes on the SOBR."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{D469A85B2AF13165}" {
     m_iOrder 8
     m_sTitle "IV. Mission"
     m_sContent "Raid the 3 marked separatist compounds and locate 1x weapons cache at each location."\
     ""\
     "Look for ammo crates draped in camouflage cloth, and mark them as evidence."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{32241B0230075FBA}" {
     m_iOrder 9
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc"\
     ""\
     "End conditions:"\
     "All 3 caches marked as evidence - AFRF Victory"\
     "90% AFRF casualties or 45 minutes pass - Separatist Victory"\
     ""\
     "45 minute time limit includes 5 minute setup timer"\
     ""\
     "During setup: "\
     "AFRF restricted to their spawn"\
     "Separatists restricted to immediate area around and between objectives"\
     ""\
     "AFRF can mark caches as evidence with an action that appears on hover, hold for 5 seconds to complete."
    }
   }
  }
 }
