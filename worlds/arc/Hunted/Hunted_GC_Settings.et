 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{1D1A1CA341F586B1}" {
     m_iOrder 0
     m_sTitle "Situation"
     m_sContent "Your Ranger platoon has been operating in the northern region of Chernarus, helping the CDF deal with an emergent separatist force."\
     ""\
     "While part of your platoon was deployed to the west, the separatists launched a suprise assault overwhelming CDF defenders in the previously contested town of Zarichne and cutting off your element from friendlies."\
     ""\
     "Currently known positions of separatist elements are marked on the map."
    }
    GC_Briefing "{0B27DB51F435B974}" {
     m_iOrder 1
     m_sTitle "Mission"
     m_sContent "Find a way to cross the Zherebets river and reach the marked extraction point on the east of the AO."\
     ""\
     "Consider dealing with the following optional objectives if strength and time permits:"\
     ""\
     "Eliminate 1x BTR guarding the northern bridge of Zarichne, at the OPFOR motorized marker."\
     ""\
     "Destroy 2x Separatist Ural supply trucks at the eastern power plant marked by the OPFOR supply marker."
    }
    GC_Briefing "{FC7856EAC9D2FFFF}" {
     m_iOrder 2
     m_sTitle "Service & Support"
     m_sContent "Some extra magazines are on top of a crate at our current location, as well as 4x demolition blocks to take if attempting optional objectives."
    }
    GC_Briefing "{68E1E5ED6A422693}" {
     m_iOrder 3
     m_sTitle "Mission notes"
     m_sContent "Mission by arc"\
     ""\
     "End conditions:"\
     "90% of alive Rangers at the extraction site - Victory"\
     "100% Ranger casualties or 75 minutes pass - Defeat"\
     ""\
     "AO limit roughly in effect around the marked area of the map."\
     ""\
     "GMs feel free to override weather and time, US players have NVGs."
    }
   }
  }
 }
