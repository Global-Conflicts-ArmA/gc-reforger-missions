 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{4B47EBD23D81179E}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "US Army Rangers raid separatist hideouts for weapons caches between Montignac and Villeneuf."
    }
    GC_Briefing "{F00AB0962EA368D0}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "A splinter faction of the long-disbanded FIA has caused renewed violence in Everon over the past few months. Your ranger platoon has been deployed to the island to increase security."\
     ""\
     "Intelligence suggests a weapons cache is present between Montignac and Villeneuf, and may be in one of the three red circled houses. We are unsure which house exactly it's located in."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{24227ED0D2339718}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x Ranger platoon with reduced weapons squad folded into HQ."\
     ""\
     "2x unarmed Littlebirds available for air insert, 2x armed littlebirds available for CAS, 4x humvees armed with M2 machine guns seating 5 each available for ground insert."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{523A28BC70CB95A9}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Approximately 40 pax FIA separatists, located somewhere around the caches."\
     ""\
     "Wearing a mixture of civilian clothes and military equipment, equipped with Russian weapons. Not expected to be NVG capable."\
     ""\
     "They are expected to be on high alert, be cautious of ambushes and traps."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{67DE81019683AE30}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Locate and secure the weapons cache in one of the three circled houses, or eliminate all separatist defenders."\
     ""\
     "Complete this within 75 minutes after setup."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{CE3F069D865A9E85}" {
     m_iOrder 5
     m_sTitle "V. Command & Signal"
     m_sContent "Ground net: 48.0 Mhz"\
     "Air net: 47.0 Mhz"\
     ""\
     "CO: 1-6A"\
     "2IC: 1-6B"\
     "JTAC: 1-6J"\
     ""\
     "1st Littlebird: Super 6-1"\
     "2nd Littlebird: Super 6-2"\
     "3rd Littlebird: Super 6-3"\
     "4th Littlebird: Super 6-4"
