GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "066731FA204DF88B"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{9A44BDBE9C2354C3}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "A VDV company performs a wide area clearance of separatist forces occupying Kolguyev's north-eastern peninsula."\
     ""\
     "75 minute TL, no hard AO limit. Random daytime and weather."
    }
    GC_Briefing "{EF84659B08E9EDC4}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Chernarussian extremists affiliated with the ChDKZ have infiltrated and launched a series of attacks across Kolguyev, a remote former Soviet mining colony that today hosts AFRF military installations."\
     ""\
     "Your VDV company has been tasked with sweeping an area on Kolguyev's north-eastern peninsula, in order to secure movement in and out of the port at Kamensk. This area has been designated as AO Mars."
    }
    GC_Briefing "{58E1E6BF4128DA7B}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x VDV airborne company with attached helicopter element."\
     ""\
     "Wearing a mixture of EMR and ATACS camo, equipped with modern Russian military equipment such as AK-12s and PKP Pechenegs."\
     ""\
     "1x Mi-24 and 3x Mi-8s available for transport and CAS."
    }
    GC_Briefing "{F33EABBA68A581C6}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Assumed company+ strength ChDKZ separatist fighters, occupying the forests, hills, and ruined villages west of Kamensk."\
     ""\
     "Believed to have commandeered a small number of BTR-70s stolen from a nearby vehicle depot."\
     ""\
     "Wearing a mixture of camouflage patterns and civilian clothing, equipped mostly with Soviet-era weaponry such as AK-74s and PKMs."
    }
    GC_Briefing "{0323C523538D00B1}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Identify and eliminate at least 80% of the separatist forces occupying AO Mars, which is marked by a red outline on the map. Complete this within 75 minutes."
    }
    GC_Briefing "{FE04E7F88CFFDC8D}" {
     m_iOrder 5
     m_sTitle "V. Service & Support"
     m_sContent "Repair and Refuel is available for helos at our current position."
    }
    GC_Briefing "{4397EDBF80BBF04C}" {
     m_iOrder 6
     m_sTitle "VI. Command & Signal"
     m_sContent "1st Platoon Net: 39.0 Mhz"\
     "2nd Platoon Net: 40.0 Mhz"\
     "3rd Platoon Net: 41.0 Mhz"\
     ""\
     "Company Net: 42.0 Mhz"\
     "Air Net: 43.0 Mhz"\
     ""\
     "Air callsigns:"\
     "FAC: Bishop"\
     ""\
     "1st Mi-24: Paladin-11"\
     ""\
     "1st Mi-8: Crusader-11"\
     "2nd Mi-8: Crusader-12"\
     "3rd Mi-8: Crusader-13"
    }
    GC_Briefing "{6332D387841923DF}" {
     m_iOrder 7
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     "80% Separatist casualties: Victory"\
     "80% AFRF casualties or 75 minutes pass: Defeat"\
     ""\
     "No hard AO limit."
    }
   }
  }
 }
