GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "D3095FD0FD6F0AD4"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{FF1D8F3FFD084DDC}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "A US Army airmobile platoon combs Erquy island for Spetznaz trapped after an Mi-8 crash."\
     ""\
     "US HQ Combat Signaller is the FAC."\
     ""\
     "Extraction zones will activate 35 minutes in."
    }
    GC_Briefing "{7E578354B2CED75A}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "Everon has been reclaimed from Soviet forces, with NATO digging in and establishing control of the island."\
     ""\
     "Earlier in the day, a Spetznaz group that had remained on Everon conducting sabotage destroyed a radar installation and was subsequently picked up by an Mi-8. They narrowly escaped, but took a shot to the fuselage and leaked fuel causing them to make an emergency landing on Erquy island."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{FD40DE2B67A25D29}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "Locate and eliminate all Spetznaz trapped on Erquy island, or prevent their escape."\
     ""\
     "In 35 minutes boat extract will arrive for them at the 3 marked spots. Preventing their extraction for 25 minutes after this (60 minutes total from mission start) will force their surrender."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{BCDE048F5FC2AF17}" {
     m_iOrder 3
     m_sTitle "Service & Support"
     m_sContent "3x Black Hawk helicopters armed with miniguns available for transportation, searching, and fire support."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{750AAD1E8A5714B6}" {
     m_iOrder 4
     m_sTitle "Situation"
     m_sContent "Everon has been reclaimed from Soviet forces, with NATO digging in and establishing control of the island."\
     ""\
     "Earlier in the day, our Spetznaz group that had remained on Everon conducting sabotage destroyed a radar installation and was subsequently picked up by an Mi-8. We narrowly escaped, but took a shot to the fuselage and leaked fuel causing us to make an emergency landing on Erquy island."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{7ABF01B6EDFF3DED}" {
     m_iOrder 5
     m_sTitle "Mission"
     m_sContent "We believe an airmobile platoon is inbound to comb the island for us."\
     ""\
     "Repel this attack, or evade the US forces for 35 minutes at which point alternate transportation will arrive for extraction."\
     ""\
     "Once extraction has arrived, move to one of the 3 extraction points and hold it for 2 minutes with 80% of surviving forces to extract."\
     ""\
     "Extraction will be available for 25 minutes, so if 60 minutes pass from mission start we will be forced to surrender."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{499D837988225159}" {
     m_iOrder 6
     m_sTitle "Service & Support"
     m_sContent "We only have the gear available to us, and whatever equipment is in the Mi-8."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{02AFF71F5ABFF499}" {
     m_iOrder 7
     m_sTitle "Command & Signal"
     m_sContent "HQ: 1-6"\
     "1st Squad: 1-1"\
     "2nd Squad: 1-2"\
     "3rd Squad: 1-3"\
     ""\
     "1st Blackhawk: Longbow-61"\
     "2nd Blackhawk: Longbow-62"\
     "3rd Blackhawk: Longbow-63"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{6A662E65DC8DDDE3}" {
     m_iOrder 8
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc"\
     ""\
     "All Soviet forces eliminated or 60 minutes pass - US Victory"\
     "All US forces eliminated or 80% of living Soviets extract to 1 of 3 extraction zones for 2 minutes - Soviet victory"\
     ""\
     "Extraction areas will become active after 35 minutes have passed, you require 80% of surviving Soviets to cap it for 2 minutes to extract."\
     ""\
     "GMs should apply common sense to end early, no point letting the mission drag on to locate 1-2 Soviet survivors or if all US ground forces are eliminated."\
     ""\
     "Inspired by Spitfiretornado's mission Skalitsky on ArmA 3."
    }
   }
  }
 }
