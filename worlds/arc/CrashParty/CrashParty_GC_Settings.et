     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{38B5BCD425BB5CFC}" {
     m_iOrder 8
     m_sTitle "IV. Mission"
     m_sContent "Attack and secure the crash site by eliminating 90% of defenders or capturing and holding the crash site for 3 minutes."\
     ""\
