    GC_Briefing "{AC48217FC92D0405}" {
     m_iOrder 6
     m_sTitle "II. Friendly Forces"
     m_sContent "Approximately 50 pax insurgents with two technicals, 4 Ural trucks, and an extra civilian car for transport."\
     ""\
     "Wearing mostly civilian clothes, equipped with old Soviet weapons such as AKs, PKMs and RPGs."
     m_aFactionKeys {
      "GC_INSURGENT"
