    GC_Briefing "{2EDD477EBB64110B}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "1:2 US:INSURGENT"\
     ""\
     "US infantry defend a Black Hawk crash site (marked by the red X) from a sizeable Insurgent attack."\
     ""\
     "5 minute setup, 45 minute TL"\
     ""\
     "US AO limited to roughly the town of Salam, including the buildings just south of the 064 northing."
    }
    GC_Briefing "{4F73910FCC44193A}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "A Black Hawk returning to Landay Airfield was shot down by insurgent AA and crashed in the town of Salam earlier today."\
     ""\
     "Our unit was nearby and has moved to secure the crash site. A convoy is inbound to extract survivors and ourselves but is approximately 45 minutes away."\
     ""\
     "Insurgents have been spotted massing in the town of Khas to the north of our position."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{E02CEEAFBE6190C3}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "2 Rifle Squads and a HQ element including MG team of US light infantry."\
     ""\
     "Wearing DCU with woodland vests."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{872565C2E14953EA}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Approximately 50 pax insurgents approaching from the north, with at least two technicals and multiple civilian trucks for transport."\
     ""\
     "Wearing mostly civilian clothes, equipped with old Soviet weapons such as AKs, PKMs and RPGs."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{787968716BCBF038}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Defend the crash site by eliminating 90% of the attacking force or holding the insurgents off for 45 minutes after setup."\
     ""\
     "Ensure the insurgents do not capture and hold the crash site for 3 minutes."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{3027B7E1DA30FD7D}" {
     m_iOrder 5
     m_sTitle "I. Situation"
     m_sContent "A Black Hawk returning to Landay Airfield was shot down by our AA and crashed in the town of Salam earlier today."\
     ""\
     "An American unit was nearby and has moved to secure the crash site. A convoy is inbound to extract survivors and the defenders but is approximately 45 minutes away."\
     ""\
     "We have begun gathering massing in the town of Khas to the north of the crash site."
     m_aFactionKeys {
