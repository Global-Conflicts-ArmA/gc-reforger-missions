GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "007E3882C1CEC509"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{A99389FAA60D6B1F}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "1.5:1 US:INSURGENT"\
     ""\
     "US Navy SEALs raid a familiar compound occupied by insurgent forces loyal to the infamous warlord Abu Bergers."\
     ""\
     "<h2>Notes</h2>"\
     "• Entrenching/building in doorways is forbidden."
     m_eAudience 1
    }
    GC_Briefing "{0B9AA20128B27B15}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "A local warlord going by the pseudonym Abu Bergers has been wreaking havoc on local security forces in the Anizay region. CIA analysts have been able to track his location to a compound in the north west of the region, and DEVGRU Red Squadron have been tasked with raiding this compound to kill or capture the target and secure any intelligence on site."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{8CC5FB5C28073C1B}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "Assault the marked compound and either eliminate all insurgents or secure the multi-storey building in the compound, holding it for 3 minutes."\
     ""\
     "Complete this within the next 45 minutes."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{95D28F3418DA7E4D}" {
     m_iOrder 3
     m_sTitle "Service & Support"
     m_sContent "Two unarmed Black Hawks are available for transport and overwatch, crewed by the 160th SOAR."\
     ""\
     "A crate next to our heilcopters has:"\
     "• 4x wirecutters"\
     "• 6x ladders"
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{3F63E31BA40E5C62}" {
     m_iOrder 4
     m_sTitle "Command & Signal"
     m_sContent "Ground net: 48.0 Mhz"\
     "Air net: 50.0 Mhz"
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{A6B62EB41888AC36}" {
     m_iOrder 5
     m_sTitle "Situation"
     m_sContent "Our faction of insurgents, led by the warlord Abu Bergers, has been working to liberate the Anizay region from western influence, based out of our compound marked on the map."\
     ""\
     "An informant in the local security forces has advised us that an American special forces team has arrived at the NATO controlled airfield. We should be cautious of a potential raid on our compound tonight."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{565408DDF3BA2513}" {
     m_iOrder 6
     m_sTitle "Mission"
     m_sContent "Repel any incoming attack by eliminating 80% of attackers. Ensure the multi-storey building in the compound isn't captured by US forces."\
     ""\
     "We must stay within the compound though may cross over to the 2 storey building to our south-east."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{0A1B266A175AC0A7}" {
     m_iOrder 7
     m_sTitle "Mission notes"
     m_sContent "<h2>End conditions:</h2>"\
     "<b>US VICTORY</b>"\
     "• 100% Insurgent casualties or hold the target building within the compound for 3mins."\
     ""\
     "<b>INSURGENT VICTORY</b>"\
     "• Repel the assault by causing 80% US casualties."\
     ""\
     "<h2>Notes:</h2>"\
     "• Entrenching/building in doorways is forbidden."\
     "• Insurgents AO limited to compound and the 2 storey across the road from it."\
     "• If using wirecutters to cut barbed wire on the walls you may need to look straight ahead instead of up at the wire for the prompt to appear, it's a bit jank."\
     ""\
     "Mission by arc"
    }
   }
  }
 }
}
