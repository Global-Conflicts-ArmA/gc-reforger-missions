GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "ED66A9B13597C05E"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{61D7C2F66FE450D6}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "1:4 US:RU"\
     ""\
     "A CIA Special Activities Division team attempts to infiltrate and sabotage a Russian research base on a remote island."\
     ""\
     "US teleports to any of their insertion points after setup by using flagpoles at their spawn."\
     ""\
     "DO NOT SWAP FROM US TO RU AFTER ENTERING BRIEFING"\
     ""\
     "5 minute setup, 75 minute TL."
    }
    GC_Briefing "{1ABE91F61D531241}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "We are stationed at a remote Russian Federation research base on the island of Arland."\
     ""\
     "Recently, a pair of American spies were identified on the island, but were extracted before they could be apprehended."\
     ""\
     "It's unknown what information they relayed to the Americans, but we are on high alert for some form of further action. Our platoon is being called up for tonight's patrol and guard duty."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{437FB11629020942}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "Approximately 50 Russian base guards available to patrol and guard the premises."\
     ""\
     "Wearing VSR '93 camo, equipped with AK74s, PKMs and SVDs. Not night vision capable, but equipped with flashlights and flares."\
     ""\
     "2x Dog Handlers"\
     "1x Mi-8"\
     "2x Trucks"\
     "2x Vans"\
     "4x UAZ"
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{B2AABF6327855254}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Unknown."\
     ""\
     "There is high probality the enemy may disguise as us. "\
     "Create a Challenge–Pass."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{C05BD16C5EC6D7E9}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Patrol the base, looking for any suspicious individuals or signs of incursion."\
     ""\
     "Pay particular mind to the points marked on the Map."\
     "Other High vaule tagerts such as the Base Commander, Politcal Officer, and Scientist may be targeted."\
     ""\
     ""\
     "Our shift ends 75 minutes after setup."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{187D12ED6BFA0A69}" {
     m_iOrder 5
     m_sTitle "I. Situation"
     m_sContent "The CIA have identified a Russian research base on the previously abandoned island of Arland."\
     ""\
     "Spies have identified several targets to be sabotaged, assassinated or stolen in this base. Two teams from the Special Activities Division have been tasked with achieving this."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{B4A170BB6E7D5C0C}" {
     m_iOrder 6
     m_sTitle "II. Friendly Forces"
     m_sContent "Max 12 CIA SAD agents."\
     ""\
     "Equipped with suppressed M4s, NVGs and GPS/Compass watches."\
     ""\
     "Wearing black."\
     ""\
     "Supplies, including MP5s, SMAWs and other tactical gear in crates at sapwn."\
     ""\
     "5x Enemy kits available at spawn for disguise."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{63FB22D013419774}" {
     m_iOrder 7
     m_sTitle "III. Enemy Forces"
     m_sContent "Approximately 50 Russian base guards patrolling the premises."\
     ""\
     "Wearing VSR '93 camo, equipped with AK74s, PKMs and SVDs. Not expected to be night vision capable, but will be equipped with flashlights and flares."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{F692A39E3204BCF4}" {
     m_iOrder 8
     m_sTitle "IV. Mission"
     m_sContent "Insert via one of the 4 marked insertion points on the map, complete your assigned objectives(In briefing)."\
     ""\
     "Achieve this within 75 minutes after setup."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{BFC82FEB65B3916F}" {
     m_iOrder 9
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc, inspired by the original by Krause and the remake by Weapon X"\
     ""\
     "End conditions:"\
     "All Objectives: US Victory"\
     "90% US casualties or 75 minutes pass after setup: RU Victory"\
     ""\
     "Objective selection is randomized for US, you must perform the objectives you're given for it to count."\
     ""\
     "US are permitted to switch Uniforms for disguise."\
     ""\
     "Both teams are permitted to take Radios from the dead."\
     ""\
     "Dogs can smell you, be careful!"\
     "Dogs can left click to bark and melee to kill. Please only do dog things."\
     ""\
     "Defectors exist, becareful who you're with. Who knows what their objective is?"\
     "(Cannot be the Political Officer, Base Commander, or Dog/Handler)"\
     ""\
     "Do NOT metagame or set up based on knowledge of the US insertion points from a previous playthrough."
    }
   }
  }
 }
}
