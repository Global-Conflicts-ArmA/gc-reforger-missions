GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "F9B8086B8A938440"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{F27060E9877FCF83}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "A British rifle company has been tasked with interdicting a VDV force and dislodging Motor rifles from Le Moule."\
     ""\
     "Attached HAT section available at the bottom of the slotting list."\
     ""
    }
    GC_Briefing "{E4212FE9A46F339F}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "A VDV company performed a surprise overnight air assault on Le Moule, overwhelming outnumbered NATO defenders. An AFRF Motor Rifle platoon has followed on and is beginning digging in to the town, with more potentially on the way."\
     ""\
     "Early morning recce suggests the VDV are now forming up to advance towards Morton, we believe they will be interested in establishing a presence at Wolf Hill to survey the town's defenses and support a Motor Rifle push towards Morton."
    }
    GC_Briefing "{35AD7DDF902B10B1}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x British Rifle Company with attached HAT section currently located at the farm house east of Wolf Hill."\
     ""\
     "3 Platoon has been tasked with remaining garrisoned in Morton itself today, though 10 of their men are in reserve to provide us reinforcements."
    }
    GC_Briefing "{E8AA072F8994DBA2}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "1x VDV company. Expected to be advancing towards Wolf Hill, though an unknown number of their force appears to be remaining at the Sawmill east of Le Moule as a sentry."\
     ""\
     "1x Over-strength platoon of Motor Rifles currently garrisoning and digging in at Le Moule, with potentially more on the way or standing by for QRF. At least 3 BTRs are believed to be present in the town currently."
    }
    GC_Briefing "{EAA2430AE76D1510}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Prevent the approaching VDV from establishing a presence at Wolf Hill. After they are eliminated, move to seize Le Moule and hold it for 10 minutes."\
     ""\
     "Complete this within 90 minutes."
    }
    GC_Briefing "{5F657A2C52DB13EB}" {
     m_iOrder 5
     m_sTitle "V. Service & Support"
     m_sContent "10x Respawns available at our current location, as well as a crate containing:"\
     "210x 30rnd Magazines"\
     "20x 200rnd GPMG belts"\
     "60x Frag grenades"\
     "60x Smoke grenades"\
     "6x 84mm Rockets"\
     "4x LAWs"\
     ""\
     "Distribution of extra supplies and assignment of reinforcements to be handled by Company Sergeant Major."\
     ""\
     "2x US Trucks and 1x US Ambulance have been provided for our use. Ambulance should be used at discretion of Company medics. Trucks should be used at discretion of Company Sergeant Major to handle transporting resupply and reinforcements."
    }
    GC_Briefing "{892681FDC6879DE6}" {
     m_iOrder 6
     m_sTitle "VI. Command & Signal"
     m_sContent "LR Channels:"\
     "1 Platoon Net: 44.0 Mhz"\
     "2 Platoon Net: 45.0 Mhz"\
     "Company Net: 46.0 Mhz"\
     ""\
     "Essential Personnel:"\
     "Coy Commander: 10A"\
     "Coy 2IC: 10B"\
     "CSM: 10C"
    }
    GC_Briefing "{1A4EC2127E8D032E}" {
     m_iOrder 7
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     "VDV fail to capture Wolf Hill, and British forces control Le Moule for 10 minutes: Victory"\
     "VDV capture Wolf Hill, 90% British casualties, or 90 minutes pass: Defeat"
    }
   }
  }
 }
}
