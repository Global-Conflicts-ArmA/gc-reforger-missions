 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{9013D2AE2A7775EA}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "Royal Marines Commandos deployed as part of the Joint Expeditionary Force clear out Russian forces blockading a key railway line."\
     ""\
     "75 minute TL."
    }
    GC_Briefing "{5043E56DF1383D8D}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Unmarked forces in modern Russian military equipment have invaded and seized parts of Finland. No war has been formally declared and the details of the situation are still unclear."\
     ""\
     "Your Royal Marine Commando platoon is in the country deployed as part of the Joint Expeditionary Force, and has been authorized to take action against the occupying force."
    }
    GC_Briefing "{CCC9256A0F0DD099}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x Platoon of Royal Marine Commandos at the marked location on the map."\
     ""\
     "Wearing multicam, equipped with suppressed KS-1 rifles, GPMGs."
    }
    GC_Briefing "{339D57DEFCAF4418}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Approx 2x Platoons of Russian light motor rifles located to our north-west, around the marked positions."\
     ""\
     "Wearing EMR, equipped with modern Russian weaponry such as AK-74s, PKPs, etc."\
     ""\
     "This is a light motorized element primarily transported in trucks though believed to be reinforced by at least 2x BRDM scout cars."
    }
    GC_Briefing "{96B1E46923019E19}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Eliminate Russian forces occupying and blocking the railway, at and around the marked positions."\
     ""\
     "Complete this within 75 minutes."
    }
    GC_Briefing "{CD9CCBC118800D0C}" {
     m_iOrder 5
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     ""\
     "90% of Russian forces KIA: Victory"\
     "90% of players KIA or 75 minutes pass: Defeat"\
     ""\
     "Game masters are free to add or remove AI groups at the start of the mission to adjust the mission difficulty based on player count."\
     ""\
     "No hard AO limit."
    }
   }
  }
 }
