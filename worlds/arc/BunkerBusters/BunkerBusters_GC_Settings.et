GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "1E0612C76B92D458"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{E3B09E1F78F2BD70}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "US Special Forces raid a bunker housing nuclear material which has been overrun by separatists."\
     ""\
     "Air is optional, ground insert is available. 60 minute TL."
    }
    GC_Briefing "{B97E5A177D03F445}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Civil war in the Zarichne region has been greatly reduced following a NATO led intervention, now carrying on as a low level insurgency."\
     ""\
     "Several hours ago, separatists overran security forces at a secret compound housing nuclear material used in the previous government's research programs."\
     ""\
     "Your unit has been tasked with securing the bunker inside this compound and the material before the separatists can extract it."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{0328E0793623C070}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "US SF platoon with the following options for air or ground insertion:"\
     ""\
     "- 6x Humvees armed with M2 machine guns"\
     "- 3x Unarmed Littlebirds"\
     "- 2x Blackhawks"\
     ""\
     "A crate at our current position also has various short-range optics which may be helpful inside the bunker, and wire cutters for breaching the fences."\
     ""
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{BADC2369ABA39ED4}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Approximately 40 pax Zarichne separatists."\
     ""\
     "Wearing a mixture of civilian clothing and camouflage patterns, equipped with mostly old Soviet weaponry but sporting modern plate carriers."\
     ""\
     "Expect a mixture of defenders outside and inside the bunker complex."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{ABBFAC5AC4E47DC5}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Assault the marked bunker."\
     ""\
     "We believe the separatists will be gathering the nuclear material into a crate on the lowest accessible floor of the bunker. Reach and secure that point within 60 minutes."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{0D67632BE5154336}" {
     m_iOrder 5
     m_sTitle "V. Command & Signal"
     m_sContent "Ground net: 48.0 Mhz"\
     "Air net: 50.0 Mhz"
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{243140501426AAE0}" {
     m_iOrder 6
     m_sTitle "Mission notes"
     m_sContent "Mission by arc"\
     ""\
     "End conditions:"\
     ""\
     "To secure nuclear material, hold the action on the crate for 30 seconds."\
     ""\
     "Crate secured by USAF: Victory"\
     "80% USAF casualties or 60 minutes pass: Defeat"
    }
   }
  }
 }
}
