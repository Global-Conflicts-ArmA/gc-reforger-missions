GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "79F7F2DAA4C537E8"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{6E3F62E3467A49B9}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "After the evacuation of the last US troops from Everon, a USSR motorized infantry platoon is dispatched to eliminate the FIA at their headquarters of Montfort Castle."
    }
    GC_Briefing "{146EBC8AC23EEE59}" {
     m_iOrder 1
     m_sTitle "Situation"
     m_sContent "After the US invasion of Everon, our forces have rallied and driven them largely off the island."\
     ""\
     "We believe the local insurgent group known as the FIA helped US troops escape capture, and we have now located their main stronghold at Montfort Castle."\
     ""\
     "Our platoon has been tasked with assaulting this castle and eliminating the last bastion of the FIA before they can scatter and go to ground."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{50275D2DB734FC18}" {
     m_iOrder 2
     m_sTitle "Mission"
     m_sContent "Assault Montfort castle, and either eliminate all FIA resistance or capture the castle for 3 minutes."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{1067F90E8A51CE16}" {
     m_iOrder 3
     m_sTitle "Service & Support"
     m_sContent "We have motorized capability - a UAZ armed with a PKM, and 3x Ural trucks are available to us. This should allow us to quickly attack the castle from any angle we choose."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{51FDFD4EF00B5922}" {
     m_iOrder 4
     m_sTitle "Situation"
     m_sContent "After assisting US survivors in escaping Everon, our FIA cell is gathered at our headquarters of Montfort castle."\
     ""\
     "We believe the Soviets followed us here and are preparing a significant attack. Scouts spotted a motorized platoon amassing north-west of the castle, and are likely inbound shortly."\
     ""\
     "We need to prepare a defense and hold off this attack so that we can subsequently scatter and go to ground."
     m_aFactionKeys {
      "FIA"
     }
    }
    GC_Briefing "{DFC43E35465BBC1D}" {
     m_iOrder 5
     m_sTitle "Mission"
     m_sContent "Eliminate the attacking Soviet force, or prevent them from capturing Montfort castle for 45 minutes."
     m_aFactionKeys {
      "FIA"
     }
    }
    GC_Briefing "{0B376DC34F6C9D14}" {
     m_iOrder 6
     m_sTitle "Service & Support"
     m_sContent "We have some civilian vehicles available to us - a 5 seater car and 8 seater minibus. This will allow us to position troops forward as sentries or ambushers, or quickly relocate when we locate the angle the enemy is approaching from."
     m_aFactionKeys {
      "FIA"
     }
    }
    GC_Briefing "{0337CDF6591EC252}" {
     m_iOrder 7
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc"\
     ""\
     "End conditions:"\
     ""\
     "100% FIA Casualties or Montfort Castle held for 3 minutes - USSR victory"\
     "100% USSR Casualties or 45 minutes pass - FIA victory"\
     ""\
     "Inspired by the OFP CWC campaign"\
     ""\
     "There is no setup timer. You are already loaded into the mission, don't fuck around"
    }
   }
  }
 }
