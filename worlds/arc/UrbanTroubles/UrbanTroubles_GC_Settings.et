GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "D79C307414605398"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{5677420B920CADBB}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "3:2:1 UK:CIV:IRA"\
     ""\
     "British forces sweep St Phillipe for IRA weapons caches."\
     ""\
     "Civ can be over or under ratio as long as 3:1 UK:IRA is maintained."\
     ""\
     "60 minute TL, 5 minute setup. Random weather, always daytime."
    }
    GC_Briefing "{ABB0ABE66C96A17A}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "We woke up this morning to find British forces setting up a curfew around our town of St Phillipe, not letting us exit."\
     ""\
     "Whispers around the town suggest the IRA cell hiding out here are preparing for a fight."
     m_aFactionKeys {
      "CIV"
     }
    }
    GC_Briefing "{A3C118565DF953F0}" {
     m_iOrder 2
     m_sTitle "II. Mission"
     m_sContent "Decide where your individual loyalties lie, if you're a protestant supporting the crown or a catholic sympathetic to the IRA."\
     ""\
     "Help or hinder whichever faction you decide, and adjust your behaviour based on the actions of the British or the IRA."\
     ""\
     "You could borrow an IRA radio and binoculars and act as a spotter for them, or seek out the Brits and feed them either accurate or false information about the IRA depending what mood strikes you."\
     ""\
     "If you pick up a weapon or take hostile action against a faction don't be surprised if you are then gunned down."\
     ""\
     "Lean into the roleplay, have fun and make it fun for the UK/IRA players as well, and don't get too salty."
     m_aFactionKeys {
      "CIV"
     }
    }
    GC_Briefing "{952B5270F5520819}" {
     m_iOrder 3
     m_sTitle "I. Situation"
     m_sContent "An adjacent IRA cell recently executed an ambush on British forces in Le Moule, inflicting significant casualties."\
     ""\
     "We have been storing and smuggling weapons via St Phillipe. These weapons were used in the ambush which has resulted in a lot of heat coming our way."\
     ""\
     "British forces have set up a cordon around the town and we believe they may shortly be pushing in to sweep the town for our safehouses."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{707D0426EAFF5168}" {
     m_iOrder 4
     m_sTitle "II. Friendly Forces"
     m_sContent "10 pax maximum IRA cell."\
     ""\
     "Wearing a mixture of civilian and paramilitary clothing, equipped with a variety of weapons such as AKs, M16s and SLRs."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{3E5698C90D2FE422}" {
     m_iOrder 5
     m_sTitle "III. Enemy Forces"
     m_sContent "1x British Rifle Platoon located at the farm south-east of St Phillipe."\
     ""\
     "2x Fire teams are manning checkpoints on the roads south and east of the town."\
     ""\
     "Wearing DPM, equipped with L85s."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{81159C95046477F2}" {
     m_iOrder 6
     m_sTitle "IV. Civilian Presence"
     m_sContent "Civilians are present in St Phillipe, and may have a friendly disposition to us based on being curfewed in the town."\
     ""\
     ""
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{79A2C9955C742CC5}" {
     m_iOrder 7
     m_sTitle "V. Mission"
     m_sContent "Defend the 3 marked safehouses from British forces."\
     ""\
     "Eliminating 80% of attackers or delaying their search by 60 minutes after setup will warrant victory."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{EBC65BE52FA3A4AB}" {
     m_iOrder 8
     m_sTitle "I. Situation"
     m_sContent "A British patrol was recently ambushed in the town of Le Moule, resulting in high casualties."\
     ""\
     "Undercover police have identified 6 possible IRA safehouses in St Phillipe that may have been used to store weapons used in the attack."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{959667527EE6F565}" {
     m_iOrder 9
     m_sTitle "II. Friendly Forces"
     m_sContent "1x British Rifle Platoon located at the farm south-east of St Phillipe."\
     ""\
     "2x Fire teams are manning checkpoints on the roads south and east of the town to prevent IRA escapees."\
     ""\
     "Wearing DPM, equipped with L85s."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{DC647445D45F26D2}" {
     m_iOrder 10
     m_sTitle "III. Enemy Forces"
     m_sContent "Unknown size IRA cell, reportedly 10 pax maximum based on undercover police reports."\
     ""\
     "Wearing a mixture of civilian and paramilitary clothing, equipped with a variety of weapons such as AKs, M16s and SLRs."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{A03650D0E0659602}" {
     m_iOrder 11
     m_sTitle "IV. Civilian Presence"
     m_sContent "Civilians are present in St Phillipe, and may have a hostile disposition to us based on being curfewed in the town for the duration of this operation. Check your fire and be extremely restrained in use of explosives."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{709F8AFD16D485B3}" {
     m_iOrder 12
     m_sTitle "V. Mission"
     m_sContent "Sweep the 6 identified IRA safehouses in order to locate and secure 3x weapon caches."\
     ""\
     "Complete this within 60 minutes after setup."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{EA5656C6E418CC6C}" {
     m_iOrder 13
     m_sTitle "VI. Rules of Engagement"
     m_sContent "Do not engage anyone unless they are clearly armed or taking hostile action which could endager the lives of British service members."\
     ""\
     "Use of force is permitted on civilians who block entry to target safehouses."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{9A7E0738D4F89608}" {
     m_iOrder 14
     m_sTitle "VII. Service & Support"
     m_sContent "20x Stun Grenades for a non-lethal option have been made available to us on a crate at our current location."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{2FBCEAD6010D3EF4}" {
     m_iOrder 15
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc"\
     ""\
     "60 minute TL, 5 minute Setup"\
     ""\
     "IRA and Civ AO limited to St Phillipe per markers visible to them"\
     ""\
     "End conditions:"\
     "3 Caches secured: UK Victory"\
     "80% UK Casualties or 60 minutes pass after setup: IRA Victory"
    }
   }
  }
 }
}
