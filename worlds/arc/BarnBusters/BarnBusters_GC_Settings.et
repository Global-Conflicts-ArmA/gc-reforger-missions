GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "61BD95707351F7FD"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{681FBEA3383BD645}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "1.5:1 US:SEPARATIST"\
     ""\
     "US Army Rangers raid separatist hideouts for a weapons cache that may be located on any one of the three red circled buildings between Montignac and Villeneuf."\
     ""\
     "5 minute setup, 75 minute TL"\
     ""\
     "DO NOT SWITCH FROM SEPARATIST TO US ONCE IN BRIEFING"
    }
    GC_Briefing "{52AF147D09A15ADA}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "A splinter faction of the long-disbanded FIA has caused renewed violence in Everon over the past few months. Your ranger platoon has been deployed to the island to increase security."\
     ""\
     "Intelligence suggests a weapons cache is present between Montignac and Villeneuf, and may be in one of the three red circled houses. We are unsure which house exactly it's located in."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{B678C098DBAC7FC9}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x Ranger platoon with reduced weapons squad folded into HQ."\
     ""\
     "4x unarmed Littlebirds available for air insert, 8x humvees armed with M2 machine guns seating 5 each available for ground insert."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{F8E95DDA76B4D096}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Approximately 20 pax FIA separatists, located somewhere around the caches. They are believed to be in possession of 1x Gaz TIGR armed with a KORD HMG, which was used in a recent checkpoint assault."\
     ""\
     "Wearing a mixture of civilian clothes and military equipment, equipped with Russian weapons. Not expected to be NVG capable."\
     ""\
     "They are expected to be on high alert, be cautious of ambushes and traps."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{D6C50EF98FDE7D6C}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Locate and secure the weapons cache in one of the three circled houses, or eliminate all separatist defenders."\
     ""\
     "Complete this within 75 minutes after setup."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{82421A4C4E8C9DED}" {
     m_iOrder 5
     m_sTitle "V. Command & Signal"
     m_sContent "Ground net: 48.0 Mhz"\
     "Air net: 47.0 Mhz"\
     ""\
     "CO: 1-6A"\
     "2IC: 1-6B"\
     "JTAC: 1-6J"\
     ""\
     "1st Littlebird: Super 6-1"\
     "2nd Littlebird: Super 6-2"\
     "3rd Littlebird: Super 6-3"\
     "4th Littlebird: Super 6-4"
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{C6DEDA9195707C64}" {
     m_iOrder 6
     m_sTitle "I. Situation"
     m_sContent "Our splinter faction of the long-disbanded FIA has caused taken up arms in Everon over the past few months. Our cell is defending and distributing arms from a weapons cache located at the red marked building between Montignac and Villeneuf."\
     ""\
     "A US Army Ranger platoon has recently arrived in Everon, and we suspect they are gearing up to raid our cache."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{7ECB2FA5ECCC892C}" {
     m_iOrder 7
     m_sTitle "II. Friendly Forces"
     m_sContent "Approximately 20 pax FIA separatists, located at the marker west of the caches."\
     ""\
     "We have 1x Gaz TIGR armed with a KORD HMG and 2x Ural civilian trucks for transport to and between the objectives."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{FBA2A01BA34D7F5F}" {
     m_iOrder 8
     m_sTitle "III. Enemy Forces"
     m_sContent "1x Ranger platoon. Wearing multicam, equipped with latest US equipment, NVG capable."\
     ""\
     "May opt for an air insert via Littlebirds or a ground insert via Humvee."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{1A883C4B84A1D9D4}" {
     m_iOrder 9
     m_sTitle "IV. Mission"
     m_sContent "Defend our cache from inbound US forces. Either eliminate 85% of attackers, or hold them off for 75 minutes."\
     ""\
     "Consider using misdirection, ambushes and other unconventional tactics to gain the upper hand over the enemy as they are higher in number and better equipped than us."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{0C6E78DE0A71AC11}" {
     m_iOrder 10
     m_sTitle "V. Cache Location"
     m_sContent "The cache is located at the SOUTH safehouse (038 063)."
     m_eAudience 3
    }
    GC_Briefing "{58B66543B74EC2ED}" {
     m_iOrder 11
     m_sTitle "V. Cache Location"
     m_sContent "The cache is located at the WEST safehouse (035 064)."
     m_eAudience 3
    }
    GC_Briefing "{5A0F9CE357F783B6}" {
     m_iOrder 12
     m_sTitle "V. Cache Location"
     m_sContent "The cache is located at the NORTH safehouse (037 066)."
     m_eAudience 3
    }
    GC_Briefing "{50115A3B38664845}" {
     m_iOrder 13
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc"\
     ""\
     "5 minute setup, 75 minute TL. Separatists AO limited to roughly their covermap."\
     ""\
     "Objective randomized between the 3 options, Separatists will know which one it is in briefing."\
     ""\
     "To secure the cache, hold the interaction that pops up for 30 seconds."\
     ""\
     "End conditions:"\
     "100% Separatist casualties or cache secured: US Victory"\
     "85% US casualties or 75 minutes pass after setup: Separatist victory"
    }
   }
  }
 }
}
