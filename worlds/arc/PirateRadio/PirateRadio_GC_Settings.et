    GC_Briefing "{5286D96F72A160E5}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "The Chernarussian Intelligence Directorate has identified a neo-ChDKZ propaganda post in rural north-west Chernarus, likely guarded by multiple separatist fighters."\
     ""\
     "We have reason to believe Russian SSO operatives may also be operating in the area directly supporting the ChDKZ."\
     ""\
     "Our element has been tasked with securing this station to take it off the air, and capture any intelligence at the site."
     m_aFactionKeys {
      "GC_CDF"
     }
    }
