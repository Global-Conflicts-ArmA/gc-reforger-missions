GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "6B1A9A8C948B4AD2"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{5A2C5711D6A3E8A7}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "A US mechanized platoon with attached recon team pushes down an occupied MSR to relieve a besieged FOB."\
     ""\
     "For slotting remember there's no AI Drivers."
    }
    GC_Briefing "{8F494924A82D4E26}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Following the dissolution of the USSR, Soviet Army elements stationed in Anizay have gone rogue and attempted an armed coup to take control of the country, attacking NATO peacekeepers in the area."\
     ""\
     "A small US Army element is holding out at FOB Nauzad surrounded by a Soviet Motor Rifle force, with other Soviet elements advancing along the MSR south-east to isolate the FOB further."
    }
    GC_Briefing "{D6F892F6FF4FFDDF}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x Platoon of M113 Mechanized Infantry located at the Mechanized Infantry marker, with an attached 4-man recon element."\
     ""\
     "4x M113s are available for use, with an additional unarmed 4-seater humvee for the recon team."\
     ""\
     "In addition 2x Squads of US infantry are still holding out at FOB Nauzad, though it is unknown how long they have until Soviet elements attempt to breach the compound."
    }
    GC_Briefing "{5D02CB56D5ED7C43}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Rogue Soviet motor rifle elements."\
     ""\
     "A platoon each is expected at both of the markers along the MSR, while an additional platoon+ is currently surrounding FOB Nauzad. Advance elements are expected to be lightly motorized by UAZs and Urals, while the main force at the FOB consists of infantry with multiple BTR-70s."
    }
    GC_Briefing "{FAD9D75CC185B923}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Push along the MSR, clearing Soviet forces out at both marked positions along the way. These areas must be cleared to enable the flow of reinforcements back in to the region. You will receive a notification when an area is secure."\
     ""\
     "Following this, push to FOB Nauzad and eliminate any Soviet forces besieging and attempting to breach the compound. Ensure you secure the surrounding area including the buildings along the road south of the FOB."
    }
    GC_Briefing "{47351BB4BD6BEE4D}" {
     m_iOrder 5
     m_sTitle "V. Command & Signal"
     m_sContent "Main net: 48.0 Mhz"\
     "Recon net: 47.0 Mhz (optional, usage up to CO)"\
     ""\
     "1-6: HQ"\
     "1-6V: HQ M113"\
     ""\
     "1-1: 1st Squad"\
     "1-1V: 1st Squad M113"\
     "1-2: 2nd Squad"\
     "1-2V: 2nd Squad M113"\
     "1-3: 3rd Squad"\
     "1-3V: 3rd Squad M113"\
     ""\
     "1-8: Recon"
    }
    GC_Briefing "{88F79287EFBA6F48}" {
     m_iOrder 6
     m_sTitle "M113 Notes"
     m_sContent "Drivers:"\
     ""\
     "Get in by going through the back with an open ramp, or via the gunner seat."\
     ""\
     "You can turn out by using the 'Open' interaction to your right, it's a scrollable action so you can adjust how turned out you are."\
     ""\
     "Periscopes shouldn't get stuck like they do on the BTRs."\
     ""\
     "If you are stationary you may get awkward traction and roll, hold space to use your handbrake."\
     ""\
     "Gunners:"\
     ""\
     "It's basically the same controls as a Humvee M2, you can enter the gunner seat either from the top or going through the back with an open ramp."
    }
    GC_Briefing "{018B5A748642E290}" {
     m_iOrder 7
     m_sTitle "Mission notes"
     m_sContent "Mission by arc"\
     ""\
     "End conditions:"\
     "Both marked objectives along the MSR, and the area around FOB Nauzad secured: Victory"\
     "90% casualties or 90 minutes pass: Defeat"
    }
   }
  }
 }
}
