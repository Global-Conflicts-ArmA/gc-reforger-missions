GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "C9144E7C55DBFE69"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{70C3498AE5F65261}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "During the first chechen war, the VDV 45th Guards Spetsnaz Brigade move to seize several Chechen militant safehouses after an ambush on a Russian convoy."\
     ""\
     "75 minute TL, no hard AO limit."
    }
    GC_Briefing "{FD055AE549CE28FB}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Earlier today a logistics convoy was ambushed by Chechen fighters while moving south down a nearby MSR."\
     ""\
     "We have identified several nearby potential safehouses for the fighters. Given the ambush may have been conducted to seize equipment and vehicles, it is critical that we conduct a raid to capture these safehouses before any stolen equipment temporarily stored at them is transported further away."\
     ""\
     "We have been tasked with securing these safehouses and the ambush site."
    }
    GC_Briefing "{07A718586BB8EF33}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x Company of the VDV's 45th Guards Spetsnaz Brigade."\
     ""\
     "If we are further under-strength, the CO can consider consolidating platoons."\
     ""\
     "Wearing VSR-93 camo, equipped with modern Russian weaponry."\
     ""\
     "3x Mi-8s armed with rocket pods are available for transport and CAS. Plan for multiple drops."
    }
    GC_Briefing "{B7F3265983E1C4DC}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Assumed Company+ strength Chechen insurgent fighters."\
     ""\
     "Wearing a mixture of camouflage patterns and civilian clothing, equipped with soviet-era weapons and equipment."
    }
    GC_Briefing "{89B68459B29BB358}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Conduct an air assault to secure the ambush site and the 3 marked potential safehouses."\
     ""\
     "Complete this within 75 minutes."
    }
    GC_Briefing "{CB517E54141F8417}" {
     m_iOrder 5
     m_sTitle "V. Command & Signal"
     m_sContent "1st Platoon Net: 39.0 Mhz"\
     "2nd Platoon Net: 40.0 Mhz"\
     "3rd Platoon Net: 41.0 Mhz"\
     ""\
     "Company Net: 42.0 Mhz"\
     "Air Net: 43.0 Mhz"\
     ""\
     "Air callsigns:"\
     "FAC: Bishop"\
     "1st Mi-8: Crusader 1"\
     "2nd Mi-8: Crusader 2"\
     "3rd Mi-8: Crusader 3"
    }
    GC_Briefing "{4474A8D84CE619CD}" {
     m_iOrder 6
     m_sTitle "VI. Air ROE"
     m_sContent "It is unknown if surviving captives or recoverable equipment are located at the safehouses. As such, CAS should not directly strike the safehouses."
    }
    GC_Briefing "{062A71F6559C66DC}" {
     m_iOrder 7
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     "All 4 objectives secured: Victory"\
     "80% casualties or 75 minutes pass: Defeat"\
     ""\
     "No hard AO limit."
    }
   }
  }
 }
