    GC_Briefing "{FD510E7FBFD93149}" {
     m_iOrder 10
     m_sTitle "Mission notes"
     m_sContent "Mission by arc"\
     ""\
     "Random time and weather, GMs can elect to override in-game if it's going to result in a miserable playthrough."\
     ""\
     "Both teams restricted to their spawns during setup."\
     ""\
     "NVGs available in TIGRs and Urals for RU players."\
     ""\
     "End conditions:"\
     "90% surviving US extract to marked area or 90% RU casualties: US Victory"\
     "80% US casualties or 90 minutes pass: RU Victory"
    }
