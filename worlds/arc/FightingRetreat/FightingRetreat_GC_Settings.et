GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "DB9B64DF9C1290D5"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{CDB7B0525C30997D}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "1:1 US:RU"\
     ""\
     "A US Army infantry platoon attemps to reach an extraction point, while Russian motor rifles move to intercept them."\
     ""\
     "2 minute setup, 90 minute TL. Both teams restricted to their spawns during setup."\
     ""\
     "Random time and weather. NVGs are available in the TIGRs and Urals for RU if it's night."
    }
    GC_Briefing "{DB0F388C00454CF2}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Our platoon is at risk of being cut off from friendlies, so we are moving north-west to regroup with the rest of the company."\
     ""\
     "A Russian motor rifle force has been spotted inbound from the west and may move to cut off our retreat."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{9B98BE3E55CC9FEB}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "US Army infantry platoon with under-strength weapons team (no HAT capability)."\
     ""\
     "Wearing multicam, equipped with M4s, M249s etc."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{0E19024A0C9751AE}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Platoon-strength Russian motor rifles."\
     ""\
     "Spotted travelling in 2x armed Gaz TIGRs and 2x Ural trucks."\
     ""\
     "Wearing EMR, equipped with AKs, PKMs, etc."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{0E77F9FFAE35704C}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Fall back north-west and reach the extraction point, fighting through enemy contact if neccessary."\
     ""\
     "Complete this within 90 minutes after setup."
     m_aFactionKeys {
      "RHS_USAF"
     }
    }
    GC_Briefing "{B51AAEBC89DD4A3A}" {
     m_iOrder 5
     m_sTitle "I. Situation"
     m_sContent "An enemy platoon is at risk of being cut off their company to the east of our position."\
     ""\
     "We have been tasked with interdicting and eliminating this unit before they can regroup with the rest of their forces."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{1B696A28D704D107}" {
     m_iOrder 6
     m_sTitle "II. Friendly Forces"
     m_sContent "2 half-strength Motor rifle platoons."\
     ""\
     "2x armed Gaz TIGRs and 2x Ural trucks available for transport."\
     ""\
     "Wearing EMR, equipped with AKs, PKMs, etc."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{7C1E53D94B702FF7}" {
     m_iOrder 7
     m_sTitle "III. Enemy Forces"
     m_sContent "US Army infantry platoon with under-strength weapons team (no HAT capability)."\
     ""\
     "Wearing multicam, equipped with M4s, M249s etc."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{6EE11A3346A0EA4E}" {
     m_iOrder 8
     m_sTitle "IV. Mission"
     m_sContent "Intercept and eliminate 80% of the retreating US Army platoon, or delay their withdrawal for 90 minutes."
     m_aFactionKeys {
      "RHS_AFRF"
     }
    }
    GC_Briefing "{854EC556606AC024}" {
     m_iOrder 9
     m_sTitle "V. Command & Signal"
     m_sContent "110 Platoon Net: 42.0 Mhz"\
     "120 Platoon Net: 43.0 Mhz (optional, up to CO)"\
     ""\
     "Chain of command:"\
     "110 -> 120 -> 111 -> 112 -> 121 -> 122"
     m_aFactionKeys {
      "RHS_AFRF"
     }
