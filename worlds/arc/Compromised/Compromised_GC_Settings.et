 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{18E76258DD2A6CB4}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "6:2:1 US:UK:USSR"\
     ""\
     "Can be played without USSR as a straight CO. Especially do this under 56 players."\
     ""\
     "After an SBS team's extraction is botched on a sabotage mission, a motorized US Army platoon with air support perform CSAR to extract them back to Levie before they are hunted down by motor rifles and Spetznaz."
    }
    GC_Briefing "{091ECCCCFAB956FD}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Last night, a British Special Boat Service team performed an amphibious raid on a Soviet training facility and ammo dump. Their raid was successful, but their boats were destroyed in the process causing their extraction to fail."\
     ""\
     "A Soviet motor rifle company has moved to intercept them, taking up blocking and patrolling positions between us and the SBS, while we believe a motorized Spetznaz detachment may depart Montignac to hunt them down as well."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{75F62DFF634BDBAA}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces: US Army"
     m_sContent "1x Motorized US Rifle platoon, with 2x AH-6s for CAS and air recon, currently located at Levie."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{0547357E9608369F}" {
     m_iOrder 3
     m_sTitle "III. Friendly Forces: SBS"
     m_sContent "2x Teams of British Special Boat Service, currently located near their target at Schooner's End."\
     ""\
     "Likely to be escaping and evading Soviet forces while independently making their way back to us."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{6DFC7C2CA8258D40}" {
     m_iOrder 4
     m_sTitle "IV. Enemy Forces"
     m_sContent "1x Soviet Motor Rifle company (BTR-70s) set up in blocking positions and patrolling the area south of the SBS' target. Expect contact anywhere north of Chotain."\
     ""\
     "1x motorized Spetznaz team is known to be operating out of Montignac and may be despatched to hunt the SBS down."\
     ""\
     "An additional Soviet facility located south of the SBS' target houses several ZU-23 Anti-Aircraft guns, this area should be approached with caution if going nearby."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{5030E3DF78F0886D}" {
     m_iOrder 5
     m_sTitle "V. Mission"
     m_sContent "Push through Soviet contact to locate the SBS teams and extract survivors back to Levie."\
     ""\
     "Complete this within 75 minutes after setup."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{03ABA62850A56E3A}" {
     m_iOrder 6
     m_sTitle "VI. Service & Support"
     m_sContent "2x AH6M Littlebirds armed with rocket and minigun pods for CAS and air recon. Repair, refuel and rearm for the Littlebirds is available at the helipads in Levie."\
     ""\
     "6x M1025 Humvees armed with M2 machine guns available for rifle squads."\
     ""\
     "1x unarmed M1025 Humvee available for Platoon HQ."\
     ""\
     "1x M997 ambulance available for Platoon Medics."\
     ""\
     "2x M923A1 transport trucks available for extracting the SBS, or picking up any infantry whose humvees are disabled."\
     ""
     m_aFactionKeys {
      "US"
     }
    }
