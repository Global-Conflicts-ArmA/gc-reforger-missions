GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "D2A7FA95BA6D916B"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{E51A8B89FF29BA65}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "Royal Marine Commandos raid an Atlantic island being used as part of a weapons smuggling network between the US and Ireland."\
     ""\
     "5:1 UK:IRA. 3 minute setup, 45 minute TL."\
     ""\
     "Can be run as a straight coop at low numbers at GM's discretion, though you may find it very easy."
    }
    GC_Briefing "{8D55969F1716DE55}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "The island of Saules, off the coast of Everon, is being used by the New IRA as a key part of a smuggling network transporting arms from the US to ireland."\
     ""\
     "One of our informants on Everon has provided intelligence that a Royal Marine troop has been mobilized and is believed to be forming up for a raid on Saules."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{081EB8456817F112}" {
     m_iOrder 2
     m_sTitle "I. Situation"
     m_sContent "SRR operatives have identified that the island of Saules, off the coast of Everon, is being used by the New IRA as a key part of a smuggling network transporting arms from the US to ireland."\
     ""\
     "Our Royal Marine troop has been tasked with raiding the island to secure two safehouses, to capture contraband, intelligence, and deny the island's further usage to the smugglers."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{BB78E7CBEA148FB6}" {
     m_iOrder 3
     m_sTitle "II. Friendly Forces"
     m_sContent "38 New IRA militants on the island, acting as guards and handling smuggling operations."\
     ""\
     "Wearing a mixture of civilian and military surplus clothing, equipped primarily with cold war weapons such as AK-74s, AR-15s."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{B2574383FB7C5FF7}" {
     m_iOrder 4
     m_sTitle "II. Friendly Forces"
     m_sContent "Reduced Royal Marine Commando troop located on Everon, north of the target island."\
     ""\
     "Wearing multicam, equipped with KS-1s and GPMGs."\
     ""\
     "3x RHIBs are available for insertion. One is armed with an M2 machine gun while the others are configured for transportation."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{78BDFE2C300F0CF6}" {
     m_iOrder 5
     m_sTitle "III. Enemy Forces"
     m_sContent "Reduced Royal Marine Commando troop located on Everon, north of the target island."\
     ""\
     "Wearing multicam, equipped with KS-1s and GPMGs. Likely operating RHIB boats which may be armed to provide suppression for their insertion."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{52B1C1E1F9D3E69A}" {
     m_iOrder 6
     m_sTitle "III. Enemy Forces"
     m_sContent "Estimated 30-40 New IRA militants on the island, acting as guards and handling smuggling operations."\
     ""\
     "Wearing a mixture of civilian and military surplus clothing, equipped primarily with cold war weapons such as AK-74s, AR-15s."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{83EE9FA1C4CD1BAF}" {
     m_iOrder 7
     m_sTitle "IV. Mission"
     m_sContent "Defend the two marked safehouses and prevent their capture by British forces."\
     ""\
     "Each safehouse is protected by ~16 guards, our team has been tasked with maneuvering between the two for the defense."\
     ""\
     "Eliminate 90% of British attackers or hold out for 45 minutes after setup."
     m_aFactionKeys {
      "GC_IRA"
     }
    }
    GC_Briefing "{E42615FC39168B00}" {
     m_iOrder 8
     m_sTitle "IV. Mission"
     m_sContent "Assault the island and secure the two marked safehouses (3 minutes to cap each), or eliminate all defenders."\
     ""\
     "Complete this within 45 minutes after setup."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{70080788D94AD452}" {
     m_iOrder 9
     m_sTitle "Mission Notes"
     m_sContent "5:1 UK:IRA. 3 minute setup, 45 minute TL."\
     ""\
     "End conditions:"\
     ""\
     "100% IRA Casualties or both safehouses capped for 3 minutes: UK Victory"\
     "80% UK Casualties or 45 minutes pass: IRA Victory"
    }
   }
  }
 }
}
