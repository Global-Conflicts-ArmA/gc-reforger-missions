GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "4179677180A9B9A8"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aMissionEvents + {
    GC_Event "{DBE6D402501AFCC0}" {
     m_sName "Time Limit (event 2, 3000s)"
     m_Advanced GC_EventOptions "{5B03E48E7604BB6A}" {
      m_fDelay 3000
     }
     m_aActions {
      GC_MessageAction "{0657E541626F8191}" {
       m_sTitle "Time Limit Warning!"
       m_sMessage "Only 10 minutes left in the mission."
      }
     }
    }
    GC_Event "{1AA9754229A2F13E}" {
     m_sName "Time Limit (event 2, 3600s)"
     m_Advanced GC_EventOptions "{5831592E5DD91B4B}" {
      m_fDelay 3600
     }
     m_aActions {
      GC_MessageAction "{E41893CA21580BD7}" {
       m_sTitle "BLUFOR Defeat: Time Limit Reached"
       m_sMessage "The 60 minute time limit has been reached"
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{C2E78DDB381FD55A}" {
     m_iOrder 0
     m_sTitle "Execution Briefing Skeleton"
     m_sContent "The majority of what needs to be briefed is the execution portion of the OPORD, you can use this skeleton as a template to hit all major points."\
     ""\
     "Phase 1: Movement to objective"\
     "Starts when:"\
     "Ends When:"\
     "A Team: Location, Task, Purpose"\
     "B Team: Location, Task, Purpose"\
     "Gun Team: Location, Task, Purpose"\
     ""\
     "Location of command"\
     "Location of medics"\
     ""\
     "Route: Waypoints in descending order, with direction, distance, and identifying feature for each."\
     ""\
     "Phase 2: Actions on objective"\
     "Starts when:"\
     "Ends When:"\
     "A Team: Location, Task, Purpose"\
     "B Team: Location, Task, Purpose"\
     "Gun Team: Location, Task, Purpose"\
     ""\
     "Location of command"\
     "Location of medics"\
     ""\
     "Key tasks on objective: Who will do them, and how. Backup plan if primary won’t work."\
     ""\
     "Phase 3: Movement from objective"\
     "Starts when:"\
     "Ends When:"\
     "A Team: Location, Task, Purpose"\
     "B Team: Location, Task, Purpose"\
     "Gun Team: Location, Task, Purpose"\
     ""\
     "Location of command"\
     "Location of medics"\
     ""\
     "Route: Waypoints in descending order, with direction, distance, and identifying feature for each."\
     ""
     m_eAudience 2
    }
    GC_Briefing "{659EACAC4243669A}" {
     m_iOrder 1
     m_sTitle "Reconnaissance Report"
     m_sContent "24 Hours of surveillance of the truck’s location was conducted by a town local for us, photos and pattern of life are based off what he observed."\
     ""\
     "The target truck is located in the camo net covered courtyard of Gravette’s hotel. Soviet forces occupy the Hotel itself and utility building on it’s southeast face. The first room of the utility building has clearly blacked out windows, and I suspect this is where the process the signals collection for intelligence, it is marked on the photo I took from the south."\
     "14 soviet soldiers observed occupying both the hotel and utility building."\
     "At all times there was a 2-man security element, either patrolling the roads or static at the main door depending on time of day. This security element was rotated out every hour. Overall security posture is relaxed, but soldiers maintain a weapon on them at all times."\
     "An officer has been in and out of the blacked-out room. A second soldier with non-standard camouflage was briefly seen inside during the observation, but never left the room."\
     ""\
     "24 Hour Timeline"\
     "2130: 2-Man Security leaves static position at main door, begins roving patrol of main roads in Gravette."\
     "2200: All lights in building out"\
     "0600: Lights on in kitchen, breakfast prepared"\
     "0630: Lights on upstairs, heavy activity in building, breakfast begins"\
     "0730: 2-Man Security element stops roving patrol, occupies static security at main door"\
     "0800: Moderate activity in Main building and back courtyard"\
     "0900: Officer observed moving to blacked out room"\
     "1130: Lunch Begins, soldiers eat on first floor indoor and outdoor seating"\
     "1730: Dinner begins"\
     "1800: Officer departs blacked out room"\
     ""
     m_eAudience 2
    }
    GC_Briefing "{1AA685F662121C4F}" {
     m_iOrder 2
     m_sTitle "OPORD"
     m_sContent "1.	Situation"\
     "a.	Weather and Light: Current time 0445, the moon has set and visibility is about 200m. First Light 0505. Weather is clear."\
     "b.	Obstacles: A single-strand wire obstacle surrounds our objective, REF RECONNAISSANCE REPORT for details."\
     "c.	Enemy: 14 Soldiers occupying the hotel and patrolling Gravette. REF RECONNAISSANCE REPORT for details. Closest known adjacent enemy unit is a company sized element about a 15 minute drive to the east."\
     "d.	Friendly: Raid element as slotted. Can insert from the North, East, or South via teleport options at spawn. We have a local up in the town of Montignac who will be able to provide early warning of any enemy troop movements to our east."\
     ""\
     "2.	Mission: DESTROY the Soviet signals intercept vehicle adjacent to target building at 0416 0779 to support follow on detachment operations NLT 0545 today. Recover any sensitive information and documents from the site for further exploitation."\
     ""\
     "3.	Execution: This is a RAID, executed per the Raid Leader to achieve these fundamentals"\
     "a.	Speed and Surprise"\
     "b.	Coordinated Fires"\
     "c.	Violence of Action"\
     "d.	Planned Withdrawal"\
     ""\
     "4.	Sustainment:	"\
     "a.	All soldiers have a UBL and 1x white flare"\
     "b.	SL and TLs have radios, demo blocks, green and red/orange flares"\
     "c.	M60 has 1600rnds between the gun team and leadership"\
     ""\
     "5.	Command and Signal:"\
     "a.	Raid comms on 38.0 mHz"\
     "b.	Recommended Flares: Green – Initiate Actions on Objective, Red/Orange – Initiate Withdraw from Objective"\
     ""
     m_eAudience 2
    }
    GC_Briefing "{6DF8DFC1899BE1D9}" {
     m_iOrder 3
     m_sTitle "Mission Notes"
     m_sContent "BLUFOR Victory: Target truck destroyed and BLUFOR moved at least 500m off objective"\
     "BLUFOR Defeat: 60min timelimit. Over 90% BLUFOR Casualties"\
     ""\
     "BLUFOR can choose to teleport to their insert of choice from one of the flagpoles where they spawn, direction is relative to insert, so North flag will teleport you to the North insert etc…"\
     ""\
     "By AC 337. My first mission, using this as a testbed to learn how to make Reforger Missions."\
     "Special thanks to HotMic for going out of his way to help me learn the basics of making everything here."\
     ""
    }
    GC_Briefing "{77D8FB2F7D9E98B7}" {
     m_iOrder 5
     m_sTitle "Mission Overview"
     m_sContent "1989 US Green Berets and Partner force conduct a early morning raid to destroy Soviet Signals Interception equipment."
     m_eAudience 1
    }
   }
  }
 }
}
