    GC_Briefing "{D79B7D049A75DE1F}" {
     m_iOrder 5
     m_sTitle "End Conditions/Notes"
     m_sContent "7 minute setup timer"\
     ""\
     "AFRF 85% casualty rate: Rebel major victory"\
     ""\
     "70 mins pass with no conclusion: Rebel minor victory"\
     ""\
     "AFRF takes control of both objectives: AFRF victory"\
     ""\
