GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "68ABF93A28C72FE9"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aMissionEvents + {
    GC_Event "{1250C5FBA72989B8}" {
     m_sName "Time Limit (event 3, 3750s)"
     m_Advanced GC_EventOptions "{F2FE34A9FCBF9A99}" {
      m_fDelay 3750
     }
     m_aActions {
      GC_MessageAction "{AC73E2E5DE66D25B}" {
       m_sTitle "Time Limit Reached!"
       m_sMessage ""
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{88D978F7A6780983}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "Summer of 2012: Reduced strength US Army platoon engages 5x insurgent cells in the outskirts of Zavarak, Takistan. Both teams fight to capture an area for a designated amount of time."\
     ""\
     "Mission AO/concept based on the legacy UO ArmA 2 mission of the same name by Synxe"\
     ""\
     "Mission created by Gabe"\
     ""\
     ""
     m_eAudience 1
    }
    GC_Briefing "{E5DA374085C85BF8}" {
     m_iOrder 1
     m_sTitle "Situation Enemy"
     m_sContent "Location marked by red marker on map. Up to 5x cells of up to 5 men each. Soviet-era small arms. RPGs, RPDs, PKMs, other AK variants, bolt-action marksmen with mid-long range optics, and a medic. Largely equipped with 7.62x39mm ammunition."\
     ""\
     "Postured to move into the objective area from the southeast. No night-vision capabilities but access to limited amounts of flares."\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{E016247958E6BA7C}" {
     m_iOrder 2
     m_sTitle "Situation Enemy"
     m_sContent "Location marked by blue marker on the map. Up to 2x U.S. Army squads of up to 9 men each. LAWs, M249s, M4s equipped with M203s and close-range optics with limited access to ACOGs, 1x Carl Gustaf (no optic) with an assistant, an M240 MG with an assistant, and a platoon medic. Largely equipped with 5.62x45mm ammunition."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{B771406896F7E56D}" {
     m_iOrder 3
     m_sTitle "Situation Friendly"
     m_sContent "Location marked by blue marker on map. We are south/southwest of the objective area. We are a reduced-strength U.S. Army platoon with a MG team and an AT team."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{8CFFFC95743E32CA}" {
     m_iOrder 4
     m_sTitle "Situation Friendly"
     m_sContent "Location marked by red marker on map. We are southeast of the objective area. We are a combination of insurgent cells with high-caliber ammunition. We also have a couple highly-trained* designated marksmen."\
     ""\
     "We have no night vision capabilities except for limited amounts of hand-launched flares."\
     ""\
     "* = not really"
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{A7D5F2111930E864}" {
     m_iOrder 5
     m_sTitle "Mission"
     m_sContent "Occupy the marked objective area for 10 mins before your opponent can do the same. If you stop capturing, you will start losing capture time. You must make up a simple majority of the objective capture zone to be considered in control and acquire capture time."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{B0C1DC996049AFF0}" {
     m_iOrder 6
     m_sTitle "Mission"
     m_sContent "Occupy the marked objective area for 10 mins before your opponent can do the same. If you stop capturing, you will start losing capture time. You must make up a simple majority of the objective capture zone to be considered in control and acquire capture time."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{3B580A41D4B82B39}" {
     m_iOrder 7
     m_sTitle "Execution"
     m_sContent "Maneuver north, moving from cover to cover, compound to compound. Utilize marksmen and MG team to cover advance. Secure objective before the enemy can. Alternatively, kill enough of the opposing force to render them neutralized (90% casualties)."\
     ""\
     "Do so within 60 minutes (time starts after initial 2.5 minute freeze-timer)."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{1F814584017254C7}" {
     m_iOrder 8
     m_sTitle "Execution"
     m_sContent "Maneuver northwest, moving from cover to cover, compound to compound. Utilize marksmen and PKMs to cover advance. Secure objective before the enemy can. Alternatively, kill enough of the opposing force to render them neutralized (90% casualties)."\
     ""\
     "Do so within 60 minutes (time starts after initial 2.5 minute freeze-timer)."\
     ""\
     ""\
     ""\
     ""
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{BCA0E98EDC395355}" {
     m_iOrder 9
     m_sTitle "Command and Signals"
     m_sContent "Platoon HQ - Bravo 1'6"\
     "Platoon Sgt. - Bravo 1'5"\
     "1st Squad - Bravo 1'1"\
     "2nd Squad - Bravo 1'2"\
     ""\
     "Platoon Net - 48.00"\
     ""\
     "Squad Nets Pre-Assigned (check player list with \"P key\" in-game to see other squad nets)"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{66AA00AF65D2D588}" {
     m_iOrder 10
     m_sTitle "Command and Signals"
     m_sContent "Command - Cell HQ"\
     "1st cell - Cell 1"\
     "2nd cell - Cell 2"\
     "3rd cell - Cell 3"\
     "4th cell - Cell 4"\
     ""\
     "Intercell communication - 42.00"
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{87EA66DF0DE0D2DD}" {
     m_iOrder 11
     m_sTitle "Service and Support"
     m_sContent "Up to 2x U.S. Army squads of up to 9 men each. LAWs, M249s, M4s equipped with M203s and close-range optics with limited access to ACOGs, 1x Carl Gustaf (no optic) with an assistant, an M240 MG with an assistant, and a platoon medic. Largely equipped with 5.62x45mm ammunition."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{BC3997CB6D952B20}" {
     m_iOrder 12
     m_sTitle "Service and Support"
     m_sContent "Up to 5x cells of up to 5 men each. Soviet-era small arms. RPGs, RPDs, PKMs, other AK variants, marksmen with mid-long range optics, and a medic. Largely equipped with 7.62x39mm ammunition."
     m_aFactionKeys {
      "GC_INSURGENT"
     }
    }
    GC_Briefing "{4DB4E2A6F51D9C2F}" {
     m_iOrder 13
     m_sTitle "End Conditions"
     m_sContent "Occupy the marked objective area for 10 mins before your opponent can do the same. If you stop capturing, you will start losing capture time. You must make up a simple majority of the objective capture zone to be considered in control and acquire capture time."\
     ""\
     "Either side takes 90% casualties"\
     ""\
     "Time limit is reached (60 minutes)"
    }
   }
  }
 }
}
