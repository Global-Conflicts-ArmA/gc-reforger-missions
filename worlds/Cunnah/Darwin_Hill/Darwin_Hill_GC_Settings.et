   m_aBriefings {
    GC_Briefing "{BC2511077A899DAC}" {
     m_iOrder 0
     m_sTitle "SITUATION"
     m_sContent "SITUATION ENEMY:"\
     ""\
     "	Argentinian forces have set up defences on DARWIN HILL which we were unaware of until being ambushed by their 50 cal. MGs. They are armed with light arms, AT, and emplaced 50 cal. MGs. They have trenches and bunkers as part of their fortifications with an intermittent perimeter of barbed wire."\
     ""\
     ""\
     "SITUATION FRIENDLY:"\
     ""\
     "	We are A Coy, 2 Para. We are currently holding GORSE GORGE north of DARWIN HILL. We have GPMGs, AT, and attached Mortars."\
     ""\
     ""\
     "SITUATION TERRAIN:"\
     ""\
     "	The surrounding terrain is flat and devoid of cover but the approach to DARWIN HILL is across a ditch and swampy terrain. There is light bush cover, hedgerows, and rocky outcrops. It is early morning and still dark. The weather is wet and foggy."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{4BDBFA11406846AF}" {
     m_iOrder 1
     m_sTitle "SITUATION"
     m_sContent "SITUATION ENEMY:"\
     "	"\
     "A British company has taken positions north of DARWIN HILL at GORSE GORGE. They are armed with AT and GPMGs and have mortar support. Since ambushing them earlier this morning they have dug in but we expect a counter attack any moment now."\
     ""\
     ""\
     "SITUATION FRIENDLY:"\
     "	"\
     "We are 1st Platoon, B Company, 12th Infantry. We are currently holding fortifications (Marked in blue) on DARWIN HILL south of GORSE GORGE. We have AT and emplaced 50 Cal. MG positions."\
     ""\
     ""\
     "SITUATION TERRAIN:"\
     "	"\
     "The surrounding terrain is flat and devoid of cover but the approach to DARWIN HILL is across a ditch and swampy terrain. There is light bush cover, hedgerows, and rocky outcrops. It is early morning and still dark. The weather is wet and foggy."
     m_aFactionKeys {
      "GC_ARG"
     }
    }
    GC_Briefing "{9615D6BBF0A804FD}" {
     m_iOrder 2
     m_sTitle "MISSION"
     m_sContent "A Company will take and hold DARWIN HILL no later than 1 HOUR from now."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{8C882C073E685E5D}" {
     m_iOrder 3
     m_sTitle "MISSION"
     m_sContent "1st Platoon will hold DARWIN HILL until relieved in 1 HOUR."
     m_aFactionKeys {
      "GC_ARG"
     }
    }
    GC_Briefing "{5A946D506F68E360}" {
