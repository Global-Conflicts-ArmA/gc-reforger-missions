     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{A7DA71CD6A213692}" {
     m_iOrder 6
     m_sTitle "EXECUTION (PLEASE READ)"
     m_sContent "As per COs brief."\
     ""\
     "NOTE: There is only 1 transport helicopter (read sustainment notes). This is intentional to simulate a hasty deployment. There is a 10 minute setup timer, transport time from spawn to REGINA is ~2 minutes. "\
     ""\
     "PLAN ACCORDINGLY."
     m_aFactionKeys {
      "UK"
