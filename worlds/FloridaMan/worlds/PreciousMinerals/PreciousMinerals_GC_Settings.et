    }
    GC_Briefing "{01409A154EEE27DE}" {
     m_iOrder 9
     m_sTitle "Mission Notes"
     m_sContent "End conditions:"\
     "Either side passes 90% casualties, said side looses."\
     "CAF captures the mine and pushes the separatists outside the bounds of the mine for 5 minutes, CAF victory."\
     ""\
     "<b>GM Notes</b>"\
     "Fix things, but don't change the concept of the mission."\
     ""\
