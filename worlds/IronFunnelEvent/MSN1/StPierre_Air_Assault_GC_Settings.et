GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "7910C448DF5BD7C8"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{BB7A7495CE14B20B}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "BARBARIC Company (FORECON) under the 22nd MAU conduct a raid on rear line and logistical troops under the 876th Independent Naval (Air Landing) Infantry Battalion."\
     ""\
     "First mission of the IRON FUNNEL series."
     m_eAudience 1
    }
    GC_Briefing "{D95690634A3D64D2}" {
     m_iOrder 1
     m_sTitle "COY ORBAT"
     m_sContent "We are BARBARIC COY:"\
     "Consisting of "\
     ""\
     "RED PLT - 1x FORECON Platoon"\
     "WHITE PLT - 1x FORECON Platoon"\
     "BLUE PLT - 1x FORECON Weapons Platoon"\
     ""\
     "MUSTANG Flight are attached to provide airlift."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{6FF3337FADAA628D}" {
     m_iOrder 2
     m_sTitle "1. SITUATION"
     m_sContent "a. Enemy Forces:"\
     "Enemy forces are support elements and rear line troops of the 876th Independent Naval (Air Landing) Infantry Battalion. Currently offloading and organising equipment for the battalion in St. Pierre."\
     ""\
     "b. Friendly Forces:"\
     "Adjacent units:"\
     "DOG and ATTACK companies are currently staging to the North of the Green Valley, awaiting our disruption of the enemy."\
     ""\
     "c. Terrain and Weather:"\
     "Terrain: A Large MSR bisects St. Pierre, it allows fast travel for any potential enemy forces returning from the frontline to counter our actions."\
     ""\
     "St. Pierre is a small but dense urban area. it provides limited visibility and mobility for vehicles."\
     "Weather: Light cloud and morning fog with good visibility."\
     ""\
     "d. Obstacles"\
     "N/A"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{75C239ABC6BCD679}" {
     m_iOrder 3
     m_sTitle "CURRENT SITUATION"
     m_sContent "Motor Rifle Platoon:"\
     "We are 311, a Motor Rifle Platoon, currently sat in reserve for 310 company in an old Everon military base at 075 042. "\
     ""\
     "We are also acting as the battalion QRF, in case of any unexpected enemy actions."\
     ""\
     ""\
     "Service & Support Squad:"\
     "Our group is currently off duty, resting in the tents next to the St. Pierre Church."\
     "Nothing is going to happen so we can just hang out."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{1F7F31B8CA6545B8}" {
     m_iOrder 4
     m_sTitle "2. MISSION"
     m_sContent "BARBARIC Company conducts an air assault into St. Pierre, targetting enemy logistical and support assets being unloaded/processed in the town. The company will RAID the objective and EXFILTRATE to their initial staging area NLT 0700."\
     ""\
     "The objectives to destroy are:"\
     "Obj HORSE (101 015):"\
     "6x 2S1 Gvozdika SPGs."\
     ""\
     "Obj ZEBRA (098 015):"\
     "3x Ural4320 FUEL TRUCKS"\
     ""\
     "Obj MULE (098 013):"\
     "3x Ural4320 AMMUNITION TRUCKS."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{C4CD0995CD3C93FA}" {
     m_iOrder 5
     m_sTitle "ENEMY"
     m_sContent "Enemy forces to the North are known to be units from the USMCs 22nd MAU."\
     ""\
     "Confirmed enemy locations:"\
     "St. Montignac, Provins and Chotain."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{AC93F676ADB392B1}" {
     m_iOrder 6
     m_sTitle "3. EXECUTION"
     m_sContent "As per Commander's Intent."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{D2123DF1674650BD}" {
     m_iOrder 7
     m_sTitle "COMPANY ORDER"
     m_sContent "I order:"\
     "	"\
     "311 PLT is to remain in reserve unless called by our company HQ or any Batallion elements to react to enemy action."\
     "	"\
     "b) Tasks to artillery and other units:"\
     "	"\
     "310 Company mortars currently resupplying, and will not be available. "\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{405D814BA6541A65}" {
     m_iOrder 8
     m_sTitle "4. SUSTAINMENT"
     m_sContent "N/A"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{6BED37FD0AF471B7}" {
     m_iOrder 9
     m_sTitle "SIGNALS"
     m_sContent "311 (You) 42.0 --> Treat as COY Net"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{8EF5B9BA62F847A6}" {
     m_iOrder 10
     m_sTitle "5. COMMAND AND SIGNAL"
     m_sContent "a. Command:"\
     "Succession of Command: CO > XO > BLUE 6 > WHITE 6 > RED 6"\
     ""\
     "b. Signal:"\
     "Company Tac Net – 48.0 Mhz"\
     "AIR Net – 48.5 Mhz"\
     "RED PLT Tac Net – 49.0 Mhz"\
     "WHITE PLT Tac Net – 50.0 Mhz"\
     "BLUE PLT Tac Net – 51.0 Mhz"\
     ""\
     "Call Signs:"\
     "BARBARIC CO – \"BARBARIC 6\""\
     "Red PLT – \"Red 6\""\
     "White PLT – \"White 6\""\
     "Blue PLT – \"Blue 6\""
     m_aFactionKeys {
      "US"
     }
    }
