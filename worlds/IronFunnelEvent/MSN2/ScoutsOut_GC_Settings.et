GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "E4874F56574FA822"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{9CF8CB925BF1068B}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "USMC LAR COY  conducts a movement to contact to identify enemy Soviet Naval Infantry forward recon elements and secures the area around OP EAGLE within Simon’s Wood NLT 60 mins from step off time. In order to enable the Attack Company’s follow-on assault on Levie."\
     ""\
     "MSN Duration: 60 mins"\
     ""\
     ""
     m_eAudience 1
    }
    GC_Briefing "{00EBEF7F57532B0C}" {
     m_iOrder 1
     m_sTitle "COY ORBAT"
     m_sContent "We are DOG COY:"\
     "Consisting of "\
     ""\
     "RED PLT - 4x LAVs (No Dismounts)"\
     "WHITE PLT - 4x LAVs (No Dismounts)"\
     "BLUE PLT - 3x Rifle Squads + HQ  (Trucks provided for Transport)"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{1C1620EFA3A63E27}" {
     m_iOrder 2
     m_sTitle "1. SITUATION"
     m_sContent "a. Enemy Forces:"\
     "Enemy forces are a Motorized infantry PLT with attached Recon PLT of BRDMs. Believed to be holding around Simon's Woods and  forward deployed on KT. Enemy will likely to conduct delaying actions in Simon’s Wood to disrupt friendly advance."\
     ""\
     "b. Friendly Forces:"\
     "Adjacent units:"\
     "Attack Company will conduct an assault on Levie after Dog Company secures Simon’s Wood. Higher headquarters intent is to secure Levie by end of day through phased clearance and consolidation."\
     ""\
     "c. Terrain and Weather:"\
     "Terrain: A Large MSR bisects the AO In half and provide high speed approach avenue."\
     ""\
     "A large hiltop VIC 058 061 dominates the terrain and has good sightliines."\
     ""\
     "Simon’s Wood is dense forest with intermittent clearings and trails; limited visibility and mobility for vehicles."\
     "Weather: Overcast with good visibility."\
     ""\
     "d. Obstacles"\
     "ENY Minefield identified North of Simon's Woods"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{5559D91DDC375E26}" {
     m_iOrder 3
     m_sTitle "CURRENT SITUATION"
     m_sContent "We are 321 a Motorized BTR PLT with an attached BRDM PLT located south of Simon's Wood. "\
     ""\
     "Early this morning US Marines conducted a raid onto our backline depots and in turn our sister COY has been delayed from its task of reinforcing us. We are currently located at Simon's Wood's and digging in. Our Engineers have setup a minefield to force the enemy into our Enagement Area. Further, 7 bunkers and HMG positions have been setup (Makred on Map)."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{C530CF73574BF108}" {
     m_iOrder 4
     m_sTitle "2. MISSION"
     m_sContent "Dog Company conducts an advance to contact to identify ENY forward screening elements and securing the location around OP EAGLE in Simon’s Wood NLT 60 mins from Step off time. IOT enable Attack Company to conduct an assault on Levie later in the day."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{07664CF8A8424462}" {
     m_iOrder 5
     m_sTitle "ENEMY"
     m_sContent "Enemy Forces are a COY of Light Armouned Reconnisance with an estimated 10 LAV25s and about a platoon size of dismounts or infantry."\
     "	"\
     "Confirmed enemy locations:"\
     "St. Montignac"\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{A38835C76F72B6F3}" {
     m_iOrder 6
     m_sTitle "3. EXECUTION"
     m_sContent "As per Commander's Intent."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{3C12302BAEA7DFAD}" {
     m_iOrder 7
     m_sTitle "COMPANY ORDER"
     m_sContent "I order:"\
     "	"\
     "321 PLT and 361 PLT to conduct a hasty defence against enemy recon elements until friendly reinforcements will arive (70 mins after mission start)."\
     "	"\
     "b) Tasks to artillery and other units:"\
     "	"\
     "320 Company mortars currently resupplying, and will not be available. "\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{CB05301CBEFFFB05}" {
     m_iOrder 8
     m_sTitle "4. SUSTAINMENT"
     m_sContent "10x LAV25 with extra Magazines, Medical Supplies and Smokes"
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{EDE35921F91FD846}" {
     m_iOrder 9
     m_sTitle "SIGNALS"
     m_sContent "321 (You) 42.0 --> Treat as COY Net"\
     "361 PLT 43.0"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{C7F60E76C6C89027}" {
     m_iOrder 10
     m_sTitle "5. COMMAND AND SIGNAL"
     m_sContent "a. Command:"\
     "Succession of Command: CO > XO > BLUE 6 > WHITE 6 > RED 6"\
     ""\
     "b. Signal:"\
     "Company Tac Net – 48.0 Mhz"\
     "RED PLT Tac Net – 49.0 Mhz"\
     "WHITE PLT Tac Net – 50.0 Mhz"\
     "BLUE PLT Tac Net – 51.0 Mhz"\
     ""\
     "Call Signs:"\
     "Dog CO – \"Dog 6\""\
     "Red PLT – \"Red 1\""\
     "White PLT – \"White 1\""\
     "Blue PLT – \"Blue 6\""
     m_aFactionKeys {
      "US"
     }
    }
