    GC_Briefing "{A831347B4B14EC54}" {
     m_iOrder 10
     m_sTitle "Mission"
     m_sContent "<h2>MISSION DESCRIPTION</h2>"\
     "FIA forces must conduct ivestigations of the crash sites to recover decryption key parts required to decode the STM’s beacons signal. "\
     ""\
     "When all crash sites are investigated the STM tracker will become visible and FIA must attempt to extract it to their base."\
     ""\
     "<h2>MISSION OBJECTIVES</h2>"\
     ""\
     "<b>Acquire the full decryption code by investigating all of the crash sites.</b>"\
     ""\
     "<b>Locate and extract the STM to our base.</b>"\
     ""\
     "Optional: <b>Eliminate all opposing forces.</b>"\
     ""\
     "<i>To gain a part of the decryption code you must walk up to crashed satellite part and interact with it for 15 seconds.</i>"\
     ""\
     "<i>Please remain at spawn until the freeze timer runs out as it is required for the mission.</i>"
     m_aFactionKeys {
      "FIA"
     }
    }
    GC_Briefing "{342CE60C97B775E0}" {
     m_iOrder 11
     m_sTitle "Mission"
     m_sContent "<h2>MISSION DESCRIPTION</h2>"\
     "ION units have been deployed as a rapid-response element to locate and recover the STM. A rival PMC force is confirmed to be operating within the same AO with similar objectives, though details remain limited. Meanwhile, a local FIA cell has already established a presence inside the city and are actively investigating the debris in an effort to decrypt the STM’s beacon signal."\
     " "\
     "<h2>MISSION OBJECTIVES</h2>"\
     " "\
     "<b>Secure the STM and proceed to extraction before enemy forces can intercept.</b>"\
     " "\
     "Optional: <b>Eliminate all opposing forces.</b>"\
     ""\
     "<i>STM’s beacon updates every 3 minutes.</i>"
     m_aFactionKeys {
      "RHS_ION"
     }
    }
    GC_Briefing "{8412A5A4DA6B230C}" {
