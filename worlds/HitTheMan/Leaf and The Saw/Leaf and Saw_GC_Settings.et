GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "C943C722D5B98D02"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{B7E27C80122352A9}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "First Light at 0630"\
     "Cloudy, Dawn with a light fog"\
     ""\
     "Situation:"\
     "USSR forces are held at the Sawmill and the surrounding area after we secured the Dam while Canadian forces are to sweep the forest and secure the Sawmill."
    }
    GC_Briefing "{0768D7E97F72F4BE}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet."\
     ""\
     "Known Strength:"\
     "1x Rifle Platoon (+)"\
     "1x Recon Platoon (-) "\
     ""\
     "Location: "\
     "Holding the Sawmill and likely spread out in the forest nearby"\
     ""\
     "MLCOA:"\
     "Entrench themselves in the surrounding area to brace for our attack while recon screen"\
     ""\
     "MDCOA:"\
     "Recon units lay in ambush waiting for our forces before enaging, or even ambushing from the rear before falling back to the sawmill."\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{342256ADA85E7FFE}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "CAF are equipped with their standard equipment weaponry, Colt C7, C9 LMG, C6 GPMG, L14A1 85mm MAWs."\
     "Wearing green coloured uniforms with a Canadian patch on their left shoulder."\
     ""\
     "Known Strength:"\
     "1x Platoon (+)"\
     ""\
     "Location: "\
     "Located south at the dam (012 063) at likely their mobilization point before stepping off."\
     ""\
     "MLCOA:"\
     "Move through one of the roads while sweeping the forest before attacking the Sawmil"\
     ""\
     "MDCOA:"\
     "Sweep the west side using the river as a security measure before sweeping in from the west"\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{E629E5BAAB89D59D}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "Disposition:"\
     "Battalion is located East conducting similar operations in the area, with our sister company on our right flank"\
     ""\
     "Mortar unit is located south at 012 058"\
     ""\
     "Higher Units Mission:"\
     "Battalion has been assigned to support the local CDF in their defence and recapture of territory from the USSR forces and providing aid to the civilians."\
     ""\
     "Composition:"\
     "1x Rifle Platoon (+)"\
     ""\
     "Strength:"\
     "Rifle Platoon (+) at 48x man strength"\
     "1x LAVIIs"\
     "2x M252 Mortar"\
     ""\
     "Supporting Fires:"\
     "M252 Mortar support available"\
     ""\
     "Attachments/Detachments:"\
     "1x Mortar Attachment"\
     "1x Mechanized Squad Attachment"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{FA8E752612C35569}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces"
     m_sContent "Disposition:"\
     "Our Platoon is spread out in the surrounding areas with a recon platoon south of us."\
     ""\
     "Higher Units Mission:"\
     "Battalion has been ordered to secure this area, suppress the local population and prepare to fortify our defences against the CDF and CAF."\
     ""\
     "Composition:"\
     "1x Rifle Squad "\
     "1x Recon BRDM Attachment"\
     ""\
     "Strength:"\
     "Squad (+) at 10x man strength"\
     "1x Recon BRDM"\
     ""\
     "Supporting Fires:"\
     "None."\
     ""\
     "Attachments/Detachments:"\
     "1x Recon BRDM Attachment"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{579F75A897572AE8}" {
     m_iOrder 5
     m_sTitle "II. Mission:"
     m_sContent "Our Platoon with attachments has been ordered to clear the forest to the sawmill and capture it intact for future operations and logistical needs, becoming a new supply hub once we push the front forward, and denying its usage to USSR."\
     ""\
     "We've also been ordered to try to minimize any infastructure damage if possible, especially the two objective buildings we are to capture INTACT, anything outside of those two are free-reign like the forests."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{C961EEEB3D4CF6DB}" {
     m_iOrder 6
     m_sTitle "II. Mission:"
     m_sContent "Our squad with an attached BRDM is to help secure and hold the Sawmil, with permission from PL CO to use the surrounding woods and roads if we feel it is better positioning, but being ready to retake the Sawmill should the enemy capture it."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{B01AE7D0002EB03C}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Platoon is to sweep the forest and capture the Sawmill intact."\
     ""\
     "1. Concept of the Operation:"\
     "Platoon Commander's Discretion."\
     "It is advised to not allow the enemy to ambush our LAV while the infantry are still mounted, push the infantry to screen and sweep the forest."\
     ""\
     "2. Maneuver"\
     "Platoon Commander's Discretion."\
     "It is advised to not spread our forces too wide where upon our units cannot support one another incase of attack, ambush or being seperated."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{EBF0DEBC3DB695B5}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Hold the Sawmil to prevent the loss of our logistical hub we just recently captured, not yet fully setup prior to CAF intervention"\
     ""\
     "1. Concept of the Operation:"\
     "Squad Commander's Discretion."\
     "It is advised to spread our forces out and utilize the BRDM Recon capabilities to locate the likely route the enemy may take."\
     ""\
     "2. Maneuver:"\
     "Squad Commander's Discretion."\
     "It is advised to not spread our forces too wide where upon our units cannot support one another incase we lose one or both sides of the dam, allowing us to counter attack if we have enough men."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{E18EC7D66388A415}" {
     m_iOrder 9
     m_sTitle "IV. Sustainment:"
     m_sContent "I. SOP Variations"\
     "None."\
     ""\
     "II. Logistical Support:"\
     "None provided from the Company nor Battalion"\
     "Supplies are already located within the LAV themselves if needed"\
     "80x HE Mortars Available (50x supplies per)"\
     "400x Smoke Mortars Available (10x supplies per)"\
     "800x Illumination Shells Available (5x supplies per)"\
     ""\
     "III. Medical:"\
     "A crate of medical supplies has been provided sorely for the medic to utilized."\
     ""\
     "IV. Vehicles:"\
     "Platoon is equiped with;"\
     "1x LAVIIs"\
     "(60x AP, 150x HE, 200x5 Coax)"\
     ""\
     "No Replacement is provided or accounted for if losses are sustained."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
