     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "Time: 1215"\
     "Cloudy but slight Fog"\
     ""\
     "Situation:"\
     "A Company (-) of NVA Forces are crossing over some poisonous swamp to secure the ruined village while a Platoon (-) of Canadians are holding onto it."
    }
    GC_Briefing "{8272FE8D6E63EC68}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "NVA are equipped with their standard WARSAW Pact weaponry, AK series, RPGs, SVDs, RPK like weaons."\
     "Wearing the standard USSR uniform of Tan with greenish helmet."\
     ""\
     "Known Strength:"\
     "1x MotorRifle Company (-)"\
     "1x BMP-1"\
     ""\
     "Location: "\
     "At the military site marked on map to our south"\
     ""\
     "MLCOA:"\
     "Push through a axis, securing a foothold and move the ruined village"\
     ""\
     "MDCOA:"\
     "Push through a axis, utilize the BMP-1 to recon and pin our forces, securing a foothold and move onto the ruined village"\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
