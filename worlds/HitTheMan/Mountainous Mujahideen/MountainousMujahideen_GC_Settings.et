     m_iOrder 7
     m_sTitle "V. Mission Notes: (Must Read)"
     m_sContent "<h2>V. Mission Notes:</h2>"\
     ""\
     "Mission Intent:"\
     "- Do not send out teams smaller than 2 man strong. Buddy System inplace."\
     ""\
