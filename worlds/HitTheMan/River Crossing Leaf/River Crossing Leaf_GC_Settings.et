GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "4D5DCEF3FB5E9F55"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{DB8E80E77EDC991D}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "Time - 0610"\
     "Cloudy with a light fog"\
     ""\
     "Situation:"\
     "CAF has taken a foothold in Pustoshka while USSR forces are holding Vybor where their COY HQ is located, recon elements from both sides have recently clashed during the late hours day before, resulting in canadian recon units being forced to fall back."
    }
    GC_Briefing "{5C172CC89F302D6C}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet."\
     ""\
     "Known Strength:"\
     "1x Motor Rifle Company (-)"\
     "1x Recon Platoon"\
     ""\
     "Location: "\
     "Holding the town of Vybor and its factory district with likely recon pushed forward screening."\
     ""\
     "MLCOA:"\
     "Entrench themselves in the surrounding area to brace for our attack while recon screen the front."\
     ""\
     "MDCOA:"\
     "Recon units lay in ambush waiting for our forces before enaging, or even ambushing from the rear before falling back to the various entrenched locations conducting a fighting retreat to cause as many casualties as possible before our assault into Vybor."\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{C248C5F4EAAFD956}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "CAF are equipped with their standard equipment weaponry, Colt C7, C9 LMG, C6 GPMG, L14A1 85mm MAWs."\
     "Wearing green coloured uniforms with a Canadian patch on their left shoulder."\
     ""\
     "Known Strength:"\
     "1x Mechanized Platoon (+)"\
     ""\
     "Location: "\
     "Located south at the Pustoshka at likely their mobilization point before stepping off."\
     ""\
     "MLCOA:"\
     "Move through the middle of the road, clearing out our recon screen before assaulting the Vybor town proper, likely to take control of our COY HQ building"\
     ""\
     "MDCOA:"\
     "Push our west flank taking out our recon forces before attacking the town of Vybor itself, utilizing Mortars to smoke their advance before using it to demolish any building that they deem as a threat of is hard for them to clear out."\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{5D1AF6E655E31A68}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "Disposition:"\
     "Company is located to the SE securing our far right flank with our other platoons while our recon forces were recently pushed back into Pustoshka."\
     ""\
     "Higher Units Mission:"\
     "Battalion has been assigned to support the local CDF in their defence and recapture of territory from the USSR forces and providing aid to the civilians."\
     ""\
     "Composition:"\
     "1x Mechanized Platoon (++)"\
     ""\
     "Strength:"\
     "Mechanized Platoon (++) at 62x man strength"\
     "4x M113A2s"\
     "2x LAVIIs"\
     "2x M252 Mortars"\
     ""\
     "Supporting Fires:"\
     "M252 Mortar support available"\
     ""\
     "Attachments/Detachments:"\
     "1x Mortar Attachment"\
     "2x Mechanized LAV Squad Attachments"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{C6928A2CBF751345}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces"
     m_sContent "Disposition:"\
     "Our Company is spread out in the surrounding occupying buildings with BTRs and BRDMs marked on our maps on their locations, with a recon platoon located to our south spread out also marked on our maps."\
     ""\
     "Higher Units Mission:"\
     "Battalion has been ordered to secure this area, suppress the local population and prepare to fortify our defences against the CDF and CAF."\
     ""\
     "Composition:"\
     "1x Motor Rifle Squad Remnants"\
     ""\
     "Strength:"\
     "Squad (-) at 9x man strength"\
     "1x BTR-70"\
     ""\
     "Supporting Fires:"\
     "None."\
     ""\
     "Attachments/Detachments:"\
     "None."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{0DF1063D2F7B9E9C}" {
     m_iOrder 5
     m_sTitle "II. Mission:"
     m_sContent "Our strengthened platoon is tasked with securing the town of Vybor by taking over the COY HQ building in the town, and the factory office building in the factory district, while fighting off any remnant forces of the recons in the area or sweeping the area clear of them."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{AABF87896CC52BC2}" {
     m_iOrder 6
     m_sTitle "II. Mission:"
     m_sContent "With the permission from PLT HQ to find a position in the surrounding town to support the company as a whole in the defence of the town and COY HQ."\
     ""\
     "Strongly encouraged to stay together at a minimum of a 2 man buddy team"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{7C1366D7343A0839}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Platoon is to decide on the attack direction, sweep it of potential recon elements and assault the town of Vybor and the factory district."\
     ""\
     "1. Concept of the Operation:"\
     "Platoon Commander's Discretion."\
     "It is advised to not allow the enemy to ambush our LAVs and M113A2s while the infantry are still mounted, push the infantry to screen and sweep the forest. "\
     ""\
     "Utilize the Mortars to clear our dug in enemy positions or to flush out enemies from a forest if required, worst case use mortars to demolished fortified buildings."\
     ""\
     "2. Maneuver"\
     "Platoon Commander's Discretion."\
     "It is advised to not spread our forces too wide where upon our units cannot support one another incase of attack, ambush or being seperated."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{2976D3FA62D62EF6}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Hold the COY HQ building in Vybor  to defend the town of Vybor itself."\
     ""\
     "1. Concept of the Operation:"\
     "Squad Commander's Discretion."\
     "It is advised to spread our forces out and utilize the BTR capabilities to locate the likely route the enemy may take, or wait for our recon platoon to locate them for us."\
     ""\
     "2. Maneuver:"\
     "Squad Commander's Discretion."\
     "It is advised to not spread our forces too wide where upon our units cannot support one another incase we lose one or both sides of the dam, allowing us to counter attack if we have enough men."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{70BF8E1182FD49E7}" {
     m_iOrder 9
     m_sTitle "IV. Sustainment:"
     m_sContent "I. SOP Variations"\
     "None."\
     ""\
     "II. Logistical Support:"\
     "None provided from the Company nor Battalion"\
     "Supplies are already located within the LAVs or M113A2s themselves if needed"\
     ""\
     "(Mortars have unlimited supplies essentially, but are REQUIRED to be called in for fires. Not always observed but they must be called in to conduct a firemission.)"\
     ""\
     "III. Medical:"\
     "All provided to the medics"\
     ""\
     "IV. Vehicles:"\
     "Platoon is equiped with;"\
     "4x M113A2s"\
     "(  )"\
     "2x LAVIIs"\
     "(60x AP, 150x HE, 200x5 Coax)"\
     ""\
     "No Replacement is provided or accounted for if losses are sustained."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{34248D5B395C7072}" {
     m_iOrder 10
     m_sTitle "IV. Sustainment:"
     m_sContent "I. SOP Variations"\
     "None."\
     ""\
     "II. Logistical Support:"\
     "None provided from the Company nor Battalion."\
     ""\
     "III. Medical:"\
     "None."\
     ""\
     "IV. Vehicles:"\
     "Rifle squad is equiped with;"\
     "1x Recon BRDM attachment"\
     ""\
     "No Replacement is provided or accounted for if losses are sustained."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{39A009393CBF8262}" {
     m_iOrder 11
     m_sTitle "V. Command & Signals:"
     m_sContent "I. Chain of Command:"\
     "21, 21 Alpha, 21 Bravo, etc"\
     ""\
     "II. Callsigns:"\
     "Platoon Leader 	- 21 Sunray"\
     "Platoon Warrant 	- 21 Sunray Minor "\
     ""\
     "1st Section 		- 21 Alpha"\
     "2nd Section 		- 21 Bravo"\
     "3rd Section		- 21 Charlie"\
     ""\
     "4th Section Attachment	- 22 Echo"\
     "5th Section Attachment 	- 22 Foxtrot"\
     "Mortar Attachment 	- 25"\
     ""\
     "- - - Vehicle Callsigns when Inf dismounted:"\
     "Z29 or Zulu 29"\
     "Z21"\
     "Z21A"\
     "Etc."\
     ""\
     "III. Frequencies:"\
     "1st Platoon Net 	- 48.00"\
     "Mortar Net		- 49.00"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{0F19E5C102912C3B}" {
     m_iOrder 12
     m_sTitle "V. Command & Signals:"
     m_sContent "I. Chain of Command:"\
     "233, 454 Vic"\
     ""\
     "II. Callsigns:"\
     "1st Squad - 233"\
     "BRDM - 454 Vic"\
     ""\
     "III. Frequencies:"\
     "Platoon Net - 48.00"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{BD75B2BEC27D138C}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes:"
     m_sContent "This is both a COOP and COTVT, I.E COTVT is optional if we got the numbers OR it's of interests. Max size for COOP is 60 while for COTVT its 70"\
     ""\
     "You must be within 10m of the building(s) to be counted as capturing it or defending it."\
     ""\
     "Timelimit: 90m"\
     ""\
     "Canadian Victory is achieved once both buildings are secured."\
     ""\
     "USSR Victory is achived by causing 85% casualties to CAF, before or after the buildings have been secured or recaptured."\
     ""\
     "Mortars have unlimited supplies, but are REQUIRED to be called in via Radio for fires. Not always observed but they must be called in to conduct a firemission. No random firing."\
     ""
    }
    GC_Briefing "{811E70DC8D3A5ADD}" {
     m_iOrder 14
     m_sTitle "Game Mastering"
     m_sContent "This mission is not designed for game mastering and should only be manipulated for technical, administrative or diagnostic purposes."
    }
    GC_Briefing "{3A6A2D458C93C8B3}" {
     m_iOrder 15
     m_sTitle "Medical Information"
     m_sContent "Phenylephrine Injector is used to slow bleeding and increase BP"\
     ""\
     "Useful to stabilize wounded players before medics gets to them"\
     ""\
     "Section CO & 2iC has been issued 3x of them, use them on any downed players to help stabilize them until Medics gets to them."
    }
   }
  }
 }
}
