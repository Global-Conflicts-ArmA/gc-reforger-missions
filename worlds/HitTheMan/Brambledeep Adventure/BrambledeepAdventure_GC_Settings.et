   m_aBriefings {
    GC_Briefing "{0009980FDB38AEF6}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "<h2>I. Situation:</h2>"\
     "<b>Time & Weather:</b>"\
     "Time - Attackers Choose"\
     "Weather - Defenders Choose"\
     ""\
     "<b>Situation:</b>"\
     "A East Germany Company (-) has been tasked with moving in to destroy British Ammo Dumps used by the Royal Marines in the operation theatre, A Recon Team has already moved into position to observe while the British conduct a hasty defence to protect their ammunitions."
    }
    GC_Briefing "{BB0E0F0ECF747E11}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "Royal Marines are equipped with their standard NATO weaponry. etc"\
     "Wearing woodland coloured camo uniforms & helmets."\
     ""\
     "<b>Known Strength:</b>"\
     "1x UK Royal Marines Platoon"\
     ""\
     "<b>Location:</b>"\
     "Royal Marines located near the Brambledeep Lake"\
     ""\
     "<b>Capabilities:</b>"\
     "Royal Marines Acces to FAL, GPMG, MAWs, etc"\
     ""\
     "<b>MLCOA:</b>"\
     "Engage us before we establish a solid foothold in their forest before pulling back"\
     ""\
     "<b>MDCOA:</b>"\
     "Prepare killzones to destimate a platoon before pulling back into harder defences."\
     ""\
     "<b>Defensive Fires:</b>"\
     "No known in-direct threat at this time."\
     ""\
     "<b>Airthreat:</b>"\
     "No known Air support."\
     ""\
     "<b>Morale:</b>"\
     "Very High."\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{46A92064C1E03D82}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "NVA are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PRKs."\
     "Wearing the standard NVA uniform of Dark green with greenish helmet."\
     ""\
     "<b>Known Strength:</b>"\
     "1x Company (-)"\
     "1x Recon Team"\
     ""\
     "<b>Location:</b>"\
     "Company located E-NE of Brambledeep Lake"\
     "Recon Team located closer but we suspect they've moved to either of 3 marked locations."\
     ""\
     "<b>Capabilities:</b>"\
     "Access to RPGs, RPKs"\
     "Vehicles include are BTR-70s, Urals and UAZs"\
     ""\
     "<b>MLCOA:</b>"\
     "Locate a good attack vector before shoving their whole company through it"\
     ""\
     "<b>MDCOA:</b>"\
     "Utilize their Recon Team to locate easy attack vector, utilize their BTR-70s to push us off the treeline before shoving their company through."\
     ""\
     "<b>Defensive Fires:</b>"\
     "No known in-direct threat at this time."\
     ""\
     "<b>Airthreat:</b>"\
     "No known Air support."\
     ""\
     "<b>Morale:</b>"\
     "Alright."\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{9B12C0DD838DA1A1}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "East German Company (-) is located NE of Brambledeep Lake."\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Company has been tasked with securing the Brambledeep Lake and destroy the British's Ammodumps in the area."\
     ""\
     "<b>c. Composition:</b>"\
     "1x Company HQ"\
     "1x BTR Platoon"\
     "1x Rifle Platoon (Urals)"\
     "1x Recon Team."\
     ""\
     "<b>d. Strength:</b>"\
     "Company HQ - At 1x Soldiers Strong"\
     "1st BTR Platoon - At 29x Soldiers Strong"\
     "2nd Ural Platoon - At 24x Soldiers Strong"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "None as of this time."\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "No air support available"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "Additional Ammunition in the BTR-70s & Urals."
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{168377F3BC134D1D}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "Royal Marines Platoon is located around Brambledeep Lake."\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Royal Marines has been tasked with making sure to not loose their Ammunition dumps near the lake."\
     ""\
     "<b>c. Composition:</b>"\
     "1x Royal Marines Platoon"\
     ""\
     "<b>d. Strength:</b>"\
     "1st Plt - At 27x Man Strength"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "None as of this time."\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "No air support available"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "None."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{E72346C550372477}" {
     m_iOrder 5
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "Locate the enemy Ammo Dumps marked on map and destroy them."\
     ""\
     "Utilize the Recon Team to locate defenses and easy attack vectors (They can move during Freeze/Setup Timer.)"\
     ""\
     ""\
     "Recon can teleport to 3 different locations from the start. HOWEVER!"\
     "YOU HAVE TO TELEPORT TOGETHER."\
     ""\
     "If the two members of the Recon Team are seperate or TP to different locations. That is Ramboing and against Mission Maker Intent."
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{4481288756E9D30C}" {
     m_iOrder 6
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "Defend the ammodump while making the East German Company Combat Ineffective."\
     ""\
     "Recommended to locate and destroy OR hinder the recon team to scout out defences being made. (They can move ahead of Freeze/Setup Timer.. So beware of them)"
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{9BC6AE5DF25805BF}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Move up and destroy the Ammo Caches."\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "Company Commander's Discretion."\
     "It is adviced to utilize the FO to locate good attack vectors before pushing the Company in, while also utilize the BTRs to push any forces away from the treeline."\
     ""\
     "<b>2. Maneuver</b>"\
     "Company Commander's Discretion."\
     "It is adviced to not spread the Platoons far from eachother so they can mutually support one another."\
     ""
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{B07AB549DEEE7494}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Defend the Ammo Dumps and our foothold around Brambledeep Lake."\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "Company Commander's Discretion."\
     "It is adviced to the Platoon to setup killzones on likely attack routes, find and destroy the enemy FO and prepare fallback positions."\
     ""\
     "<b>2. Maneuver</b>"\
     "Company Commander's Discretion."\
     "It is adviced to NOT split up the sections too far so they can mutually support one another or be able to quickly support as needed."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{49314C621B9CA30C}" {
     m_iOrder 9
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "Dress: Standard Soviet Uniform"\
     "Equipment: Standard Soviet Loadout"\
     ""\
     "<b>b. Logistical Support:</b>"\
     "Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition."\
     "IPE: Helmets and body armour are to be worn at all times."\
     ""\
     "BTRs & Urals contains:"\
     "- 10x Bandages"\
     "- 10x Tourniquets"\
     "- 10x Morphines"\
     "- 40x NVA AK Mags"\
     "- 16x NVA RPK Mags"\
     "- 12x Grenades"\
     "- 8x Smoke Grenades"\
     "- 2x RPG-22s"\
     "- 40x TSh-400g Explosives"\
     "- 10x KPM 3U1 Blasting Machine"\
     "- 50x Handheld White Flares"\
     "- 50x Handheld Orange Flares"\
     "- 50x Handheld Green Flares"\
     ""\
     "<b>c. Medical:</b>"\
     "Location: Platoon Aid Post is to be setup by Platoon medics."\
     "CASEVAC: By foot or with company asset like the BTRs if there are any."\
     "Plan: Set up a casualty collection point and extract casualties to this point."\
     "Stretchers: None"\
     "Med Packs: Platoon medpack carried by Platoon medic."\
     "Morphine: Every soldier carries 1+ stick of morphine."\
     ""\
     "<b>d. Vehicles:</b>"\
     "4x BTR-70s"\
     "3x Urals"\
     "1x UAZ"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{DA4A1A3621C75D61}" {
     m_iOrder 10
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "Dress: Standard Royal Marine Uniform"\
     "Equipment: Standard Royal Marine Loadout"\
     ""\
     "<b>b. Logistical Support:</b>"\
     "Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition."\
     "IPE: Helmets and body armour are to be worn at all times."\
     ""\
     "Each Platoon has a Crate that contains:"\
     "- 1000x Sandbags"\
     "- 10x Backpacks"\
     ""\
     "<b>c. Medical:</b>"\
     "Location: Platoon Aid Post is to be setup by Platoon medics."\
     "CASEVAC: By foot or with company asset like the HMMWV or LAVIIs if there are any."\
     "Plan: Set up a casualty collection point and extract casualties to this point."\
     "Stretchers: None"\
     "Med Packs: Platoon medpack carried by Platoon medic."\
     "Morphine: Every soldier carries 1+ stick of morphine."\
     ""\
     "<b>d. Vehicles:</b>"\
     "None."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{F0688D23712613C3}" {
     m_iOrder 11
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "210, 211 (Radio), 214 (Radio), 211, etc"\
     ""\
     "<b>II. Callsigns:</b>"\
     "Company HQ -------------------------- 210"\
     "Recon Team  --------------------------- 152"\
     ""\
     "Platoon HQ ---------------------------- 211 (HQ)"\
     "1st Squad ------------------------------ 211"\
     "2nd Squad ----------------------------- 212"\
     "3rd Squad ------------------------------ 213"\
     ""\
     "Platoon HQ ---------------------------- 214 (HQ)"\
     "1st Squad ------------------------------ 214"\
     "2nd Squad ----------------------------- 215"\
     "3rd Squad ------------------------------ 216"\
     ""\
     "<b>- - - Vehicle/LAV Callsigns when Inf dismounted:</b>"\
     "210 Victor or 210V"\
     "211 Victor"\
     "212 Victor"\
     "etc."\
     ""\
     "III. Frequencies:</b>"\
     "Company Net ------------------------- 42.00MHz"\
     ""\
     "(DO NOT SPLIT UP NETS.. STAY ON ONE NET. MISSION INTENT.)"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{D97AADE4AB488EA6}" {
     m_iOrder 12
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "21, 21A, 21B, etc."\
     ""\
     "<b>II. Callsigns:</b>"\
     "Troop HQ ------------------------------ 21"\
     "- Troop Leader ---------------------- 21 Sunray "\
     "1st Section --------------------------- 21A - Alpha"\
     "2nd Section -------------------------- 21B - Bravo"\
     "2nd Section -------------------------- 21C - Charlie"\
     ""\
     "<b>III. Frequencies:</b>"\
     "1st Platoon Net ----------------- 48.00Mhz"
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{2C98C9A24D35774D}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes:"
     m_sContent "<h2>Mission Notes:</h2>"\
     "<b>Timelimit:</b>"\
     "60m (Can be increased by GM's Discretion) "\
     ""\
     "<h2>Victory/Defeat Conditions:</h2>"\
     "<b>- East German Defeat; </b>"\
     "- Suffering 85% Casualties OR Time Limit reached."\
     ""\
     "<b>- NATO Defeat</b>"\
     " - Suffering 90% Casualties OR All Ammodumps destroyed."\
     ""\
     "<b>GM Discretion as usual.</b>"
    }
    GC_Briefing "{942D526B050E78FE}" {
     m_iOrder 14
     m_sTitle "Game Mastering (READ BEFORE LOBBY)"
     m_sContent "<h2>Game Mastering</h2>"\
     "This mission is designed for game mastering from the lobby, but besides that should only be manipulated for technical, administrative or diagnostic purposes."\
     ""\
     "USE EXACT TIME AS WRITTEN GMs... DO NOT BE A MINUTE OFF OTHERWISE ITS NOT INTENDED."\
     ""\
     "<b>ATTACKER CO. CHOOSES::</b>"\
     "Time of Day: "\
     "- 0730 / Morning"\
     "- 1200 / Day"\
     "- 1715 / Dusk"\
     "- 1800 / \"\"Early Night\"\" (BRIGHT AS FUUUUUUCK) "\
     ""\
     "<b>DEFENDER CO. CHOOSES::</b>"\
     "Weather: "\
     "- Clear"\
     "- Cloudy"\
     "- Overcast"\
     "- Rain"
    }
   }
  }
 }
