    GC_Briefing "{D198547EFDEF5F60}" {
     m_iOrder 10
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Secure the Coal Mines and destroy the Ammo Depot."\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to the Platoon to setup the RTO to reach the Royal Marines, coordinate and attack the Coal Mine."\
     ""\
     "<b>2. Maneuver</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to NOT split up the sections so they can MUTUALLY support one another as needed in the assault."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{C480C7D506EBD86C}" {
     m_iOrder 11
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Setup defensive lines to prevent the fall of the ammo depot."\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "Company Commander's Discretion."\
     "It is adviced to setup hard and difficult Sandbag positions to make any attacker's advance hard to push through, while giving cover to the defenders."\
     ""\
     "<b>2. Maneuver</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to not spread the squad to far away, the coal mine sits on a hill."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{04EDE1EAE054575F}" {
