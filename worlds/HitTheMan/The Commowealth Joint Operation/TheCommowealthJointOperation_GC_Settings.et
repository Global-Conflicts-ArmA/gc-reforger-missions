     }
    }
    GC_Briefing "{EA5412A3A2601F2A}" {
     m_iOrder 9
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "Move in, secure the Coal Mines and destroy the Ammo Dump with the Aid of the Canadians from the opposite direction."\
