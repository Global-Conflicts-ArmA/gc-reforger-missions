     m_iOrder 19
     m_sTitle "VI. Mission Notes:"
     m_sContent "<h2>Mission Notes:</h2>"\
     "<b>Timelimit:</b>"\
     "45m (Can be increased by GM's Discretion)"\
     ""\
     "<h2>Victory/Defeat Conditions:</h2>"\
     "<b>- Soviet Defeat; </b>"\
     "- Suffering 95% Casualties or Ammo Depot is destroyed."\
     "(Major British Victory if British destroy it)"\
     "(Major Canadian Victory if Canadians destroy it)"\
     ""\
     "<b>- NATO Defeat</b>"\
     " - Suffering 85% Casualties FOR BOTH Canadians & British or Timelimit is reached"\
     ""\
     "<b>GM Discretion as usual.</b>"
    }
