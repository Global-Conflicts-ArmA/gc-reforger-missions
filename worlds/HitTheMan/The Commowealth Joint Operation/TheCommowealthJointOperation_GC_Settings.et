    GC_Briefing "{3A1515918C8A3767}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "<h2>I. Situation:</h2>"\
     "<b>Time & Weather:</b>"\
     "<i>Time - 17:45"\
     "Weather - Clear</i>"\
     ""\
     "<b>Situation:</b>"\
     "A Royal Marines Platoon is moving in to secure the Pasastejn Coal Mine being defended by a Soviet Platoon, to destroy a hidden ammo depot located in its depth. While a Canadian Rifle Platoon has been sent from another theatre to conduct its own operation against the Coal Mine, in support for the Royal Marines."
    }
    GC_Briefing "{714D4F3ACB3611F5}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet."\
     ""\
     "<b>Known Strength:</b>"\
     "1x Rifle Platoon"\
     ""\
     "<b>Location:</b>"\
     "Held up at the Pasastejn Coal Mine"\
     ""\
     "<b>Capabilities:</b>"\
     "Access to RPGs, PKMs, VOGs, Sandbags."\
     ""\
     "<b>MLCOA:</b>"\
     "Locate our axis of movement before concentrating their forces to repel us or pull back after a short engagement, if the Royal Marines hasnt been engaged."\
     ""\
     "<b>MDCOA:</b>"\
     "Utilize the Coal Mine to make a fighting withdrawl into fortified positions."\
     ""\
     "<b>Defensive Fires:</b>"\
     "No known in-direct threat at this time."\
     ""\
     "<b>Airthreat:</b>"\
     "No known Air support."\
     ""\
     "<b>Morale:</b>"\
     "High."\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{73E7CE58D69AC310}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "Royal Marines are equipped with their standard NATO weaponry. etc"\
     "Wearing woodland coloured camo uniforms & helmets."\
     ""\
