    GC_Briefing "{0B481FB44A7C58B1}" {
     m_iOrder 7
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "Move in, secure the Coal Mines and destroy the Ammo Dump.."\
     ""\
     "Doesnt hurt to work together though with the Royal Marines.."\
     ""\
     "Use Demo Blocks to blow up any sandbags blocking our advance"
     m_aFactionKeys {
