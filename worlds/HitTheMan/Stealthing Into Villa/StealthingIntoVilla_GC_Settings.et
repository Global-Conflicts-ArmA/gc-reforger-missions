   m_aBriefings {
    GC_Briefing "{2CEDCE819174653B}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "Time: 23:45"\
     "Light Rain"\
     ""\
     "Situation:"\
     "Soviet forces are continuing their patrols and preparing defences for the inevitable US invasion.. US have already sent in Green Berets to conduct a sabotage mission ontop of killing their Supreme Commander on the island."
    }
    GC_Briefing "{2EB78A0DA1E9C264}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "<i>USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet.</i>"\
     ""\
     "<b>Known Strength:</b>"\
     "<i>1x Motor Rifle Company (-)"\
     "1x Relief Convoy with BRDM Escorts"\
     "1x Mi-24s</i>"\
     ""\
     "<b>Location:</b>"\
     "<i>Garrison Company located at the Villa"\
     "Relief Convoy is coming in on one of the roads marked on map</i>"\
     ""\
     "<b>Capabilities:</b>"\
     "<i>Access to RPGs, PKMs, VOGs, Flares."\
     "Vehicles include, BRDMs, ZSU-23-2, potential MI-24 if refueled.</i>"\
     ""\
     "<b>MLCOA:</b>"\
     "<i>Setup their Platoons to screen the forests in an attempt to stop our advance.</i>"\
     ""\
     "<b>MDCOA:</b>"\
     "<i>Setup their Platoons to screen the forests in an attempt to stop our advance and utilize the Mi-24 to deny us staying together.</i>"\
     ""\
     "<b>Defensive Fires:</b>"\
     "<i>No known in-direct threat at this time.</i>"\
     ""\
     "<b>Airthreat:</b>"\
     "<i>Mi-24 in the area.</i>"\
     ""\
     "<b>Morale:</b>"\
     "<i>Not so great</i>"\
     ""\
     "<b>CBRN Threat:</b>"\
     "<i>The enemy pose no CBRN Threat as of now.</i>"\
     ""
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{20DD12741000A4FB}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "<i>US are equipped with their standard NATO weaponry, M16A1s series with silencers, LAWs/M67s, Silenced. etc"\
     "Wearing woodland coloured camo uniforms & helmets.</i>"\
     ""\
     "<b>Known Strength:</b>"\
