   m_aBriefings {
    GC_Briefing "{64E92CE93DAEC673}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "<h2>I. Situation</h2>"\
     ""\
     "<b>Time & Weather:</b>"\
     "<i>Time: 02:10"\
     "Weather: Cloudy, very light fog</i>"\
     ""\
     "<b>Situation:</b>"\
     "<i>East German Army is sending a Rifle Company (-) with T-72A support to clear out the town of Zarichne, while the Seperatists Unit are tasked with defending the town with a Rifle Platoon and a LAV Section provided by their US Backers.</i>"
    }
    GC_Briefing "{98EC1AEAE9F9255C}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "<i>Seperatists are equipped with mismatch of Pact weaponry, AK series, RPG7s, PKMs, RPKs."\
     "Wearing the mismatch of uniforms.</i>"\
     ""\
     "<b>Known Strength:</b>"\
     "<i>1x Rifle Platoon</i>"\
     ""\
     "<b>Location:</b>"\
     "<i>Holding out at the town of Zarichne</i>"\
     ""\
     "<b>Capabilities:</b>"\
     "<i>Access to RPGs, PKMs, VOGs, AT Mines."\
     "Vehicles include LAVs provided by the Americans.</i>"\
     ""\
     "<b>MLCOA:</b>"\
     "<i>Continue to fortify and place down mines, utilizing the urban area to deny our usage of the vehicles.</i>"\
     ""\
     "<b>MDCOA:</b>"\
     "<i>Mine all the roads, funnel our infantry into kill zones and evading our attempt to pin and destroy them.</i>"\
     ""\
     "<b>Defensive Fires:</b>"\
     "<i>No known in-direct threat at this time.</i>"\
     ""\
     "<b>Airthreat:</b>"\
     "<i>No access to air assets thankfully..</i>"\
     ""\
     "<b>Morale:</b>"\
     "<i>Very High.</i>"\
     ""\
     "<b>CBRN Threat:</b>"\
     "<i>The enemy pose no CBRN Threat as of now.</i>"\
     ""
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{CB39E61C256E9008}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "<i>NVA are equipped with their standard WARSAW Pact weaponry, AK series, RPKs, etc"\
     "Wearing tan coloured uniform & green/tan helmets.</i>"\
     ""\
     "<b>Known Strength:</b>"\
     "<i>1x Light Infantry Company (-)"\
     "1x T-72A Section</i>"\
     ""\
     "<b>Location:</b>"\
     "<i>South of Zarichne as marked on map</i>"\
     ""\
     "<b>Capabilities:</b>"\
     "<i>Access to RPGs, PKMs, VOGs, Flares."\
     "Vehicles include T-72A with UAZ.</i>"\
     ""\
     "<b>MLCOA:</b>"\
     "<i>South of Zarichne</i>"\
     ""\
     "<b>MDCOA:</b>"\
     "<i>Utilize their T-72s to lock down roads, and have infantry sweep the buildings slowly but steadily</i>"\
     ""\
     "<b>Defensive Fires:</b>"\
     "<i>No known in-direct threat at this time.</i>"\
     ""\
     "<b>Airthreat:</b>"\
     "<i>No known air units in the area at this time.</i>"\
     ""\
     "<b>Morale:</b>"\
     "<i>Alright</i>"\
     ""\
     "<b>CBRN Threat:</b>"\
     "<i>The enemy pose no CBRN Threat as of now.</i>"
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{88781FAC423E9117}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "<i>All NVA Forces in the area (YOU) are marked on the map south of Zarichne</i>"\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "<i>Our unit is assigned to secure the town of Zarichne and push the Seperatists out</i>"\
     ""\
     "<b>c. Composition:</b>"\
     "<i>1x Rifle Company (-)"\
     "1x T-72A Section.</i>"\
     ""\
     "<b>d. Strength:</b>"\
     "<i>Company HQ - At 4x Man Strength"\
     "1st Platoon - At 23x Man Strength."\
     "2nd Platoon - At 23x Man Strength."\
     "T-72 Section - 2x Tank Strength, 6x Man Strength.</i>"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "<i>Mortar Barrage will commence once we start moving towards Zarichne</i>"\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "<i>1x T-72 Section</i>"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "<i>Some additional supplies at the UAZs</i>"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{E09DAAAFA8240F71}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "<i>Our fighting group is located at the town of Zarichne itself.</i>"\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "<i>Our unit is assigned to fight the East German Army in this region to liberate it from their iron claws, but are being counter attacked hard.</i>"\
     ""\
     "<b>c. Composition:</b>"\
     "<i>1x Rifle Platoon (-)"\
     "1x LAV Section (AI)</i>"\
     ""\
     "<b>d. Strength:</b>"\
     "<i>24x man strong Platoon</i>"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "<i>We have none.</i>"\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "<i>2x LAVs provided by our US Backers</i>"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "<i>Provided in the LAVIIs.</i>"
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{0E2A2816DFAAE0AA}" {
     m_iOrder 5
     m_sTitle "II. Mission:"
     m_sContent "<h2>II: Mission</h2>"\
     "<i>NOTE: Mortar Barrage of Zarichne will commence once you step off towards the town itself."\
     ""\
     "Secure the town of Zarichne from the Seperatists fortified there, destroying the LAV Section and establish your own defences there facing North."\
     ""\
     "We've located Three AT Minefield (Marked on map), however there may be more, Wrenches as needed to clear the path for the T-72As as needed"\
     ""\
     "No Civilians in the area</i>"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{7162DF9020DFA972}" {
     m_iOrder 6
     m_sTitle "II. Mission:"
     m_sContent "<h2>II: Mission</h2>"\
     "<i>Defend the town of Zarichne from the NVA Attack from the south, utilize the Pre-placed AT Mines and Dense urban area to deny their usage of the vehicles while conducting hit & run tactics on the infantry</i>"
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{B61CEB923E621688}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "<i>Secure the town of Zarichne and push the Seperatists out!</i>"\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to utilize the T-72s to lock down roads so the Platoons can clear our sections of buildings together, and to prevent the enemy from running across the roads into new buildings or trying to support the locked in units.</i>"\
     ""\
     "<b>2. Maneuver</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to keep the platoons together so they can mutually support one another alongside the T-72s</i>"\
     ""
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{71F25C0577166FE5}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "<i>"\
     "Amphibious land at Mineraly to secure vital infastructure and eliminating the soviet presence in the area. "\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to setup smaller fireteams into various positions around the town to hit the enemy as they enter the enclosed roads, before pulling back to do it again. Standard hit & run tactics</i>"\
     ""\
     "<b>2. Maneuver</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to not have units be too seperated as to be decisively destroyed but not too close either, but able to mutually support one another.</i>"\
     ""
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{6C968764B4B419CB}" {
     m_iOrder 9
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "<i>Dress: Standard NVA Uniform"\
     "Equipment: Standard NVA Loadout</i>"\
     ""\
     "<b>b. Logistical Support:</b>"\
     "<i>Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition."\
     "IPE: Helmets and body armour are to be worn at all times."\
     "No Rearm available for the T-72s</i>"\
     ""\
     "<b>c. Medical:</b>"\
     "<i>Location: Company Aid Post is to be setup by company medics."\
     "CASEVAC: By foot or with company asset like the Ambulance."\
     "Plan: Set up a casualty collection point and extract casualties to this point."\
     "Stretchers: None"\
     "Med Packs: Company medpack carried by company medic."\
     "Morphine: Every soldier carries 1+ stick of morphine.</i>"\
     ""\
     "<b>d. Vehicles:</b>"\
     "<i>2x T-72As"\
     "2x UAZ452s"\
     "1x UAZ452 Ambulance"\
     ""\
     "In each UAZ452:"\
     "4x Bandages"\
     "24x Wrenches</i>"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{28BF829ED9AF582B}" {
     m_iOrder 10
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "<i>Uniform: Strict adherence to friendly seperatist clothing. DO NOT put on enemy uniforms.. you'll be shot at sight"\
     "Equipment: Battlefield scavenging is authorized (weapons, ammo, vests).</i>"\
     ""\
     "<b>b. Logistical Support:</b>"\
     "<i>Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition."\
     "IPE: Helmets and body armour are to be worn at all times if you have them.</i>"\
     ""\
     "<b>c. Medical:</b>"\
     "<i>Location: Platoon Aid Post is to be setup by Platoon medics."\
     "CASEVAC: We have no such luxury"\
     "Plan: .. We have no plan"\
     "Stretchers: None"\
     "Med Packs: Platoon medpack carried by the Platoon medic."\
     "Morphine: Every soldier carries 1+ stick of morphine.</i>"\
     ""\
     "<b>d. Vehicles:</b>"\
     "<i>We have none, our personal vehicles were destroyed in a mortar barrage a yesterday</i>"
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{A555785FCE03707D}" {
     m_iOrder 11
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "<i>230, 231 (Radio), 234 (Radio), 231, etc</i>"\
     ""\
     "<b>II. Callsigns:</b>"\
     "<i>Company Commander --------- 230"\
     ""\
     "1st Platoon HQ ------------------- 231 (Radio)"\
     "1st Squad --------------------------- 231"\
     "2nd Squad -------------------------- 232"\
     "3rd Squad --------------------------- 233"\
     ""\
     "2nd Platoon HQ ------------------ 234 (Radio)"\
     "1st Squad --------------------------- 234"\
     "2nd Squad -------------------------- 235"\
     "3rd Squad --------------------------- 236"\
     ""\
     "1st T-72A ---------------------------- 271v"\
     "2nd T-72A --------------------------- 272v"\
     ""\
     "<b>III. Frequencies:</b>"\
     "<i>Company + Platoons Net ----------- 42.00Mhz"\
     "Tank Net ----------------------------- 43.00Mhz</i>"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{A226F371E7B1FD50}" {
     m_iOrder 12
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "<i>Datel-31, Datel-32, Datel-33</i>"\
     ""\
     "<b>II. Callsigns:</b>"\
     "<i>Platoon HQ ------------------------- Datel-31"\
     "1st Squad --------------------------- Datel-32"\
     "2nd Squad -------------------------- Datel-33</i>"\
     ""\
     "<b>III. Frequencies:</b>"\
     "<i>Platoon Net ------------------------ 48.00Mhz</i>"
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{45B5542E548C5CDD}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes:"
     m_sContent "<h2>Mission Notes:</h2>"\
     ""\
     "<i>Map is not accurate, use the given IMAGE of the AO to plan out the assault.</i>"\
     ""\
     "<i>Timelimit: 90m"\
     "Setup Timer: 3min (To allow Defenders to get to Positions)</i>"\
     ""\
     "<b>Seperatists Victory</b>"\
     "<i>Timelimit is Reached or by Killing 85%</i>"\
     ""\
     "<b>East German Victory</b>"\
     "<i>Securing all 4 Objectives or by Killing 90% NVA  (GM Descretion)</i>"
    }
    GC_Briefing "{189499B339FB06BB}" {
     m_iOrder 14
     m_sTitle "Game Mastering"
     m_sContent "<h2>Gamemastering:</h2>"\
     ""\
     "<i>This mission is not designed for game mastering and should only be manipulated for technical, administrative or diagnostic purposes.</i>"
    }
   }
  }
 }
