    GC_Briefing "{8E1EFF1CABC5B1D9}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes:"
     m_sContent "You must be within 25m of the building(s) to be counted as capturing it or defending it."\
     ""\
     "Timelimit: 70m"\
     ""\
     "Canadian Victory is achieved once both buildings are secured."\
     ""\
     "USSR Victory is achived by causing 83% casualties to CAF (39.84 / 48), before or after the buildings have been secured or recaptured."\
     ""\
     "Mortars have unlimited supplies, but are REQUIRED to be called in via Radio for fires. Not always observed but they must be called in to conduct a firemission. No random firing."\
     ""
    }
    GC_Briefing "{6674CC958CFEF852}" {
     m_iOrder 14
     m_sTitle "Game Mastering"
     m_sContent "This mission is not designed for game mastering and should only be manipulated for technical, administrative or diagnostic purposes."
    }
    GC_Briefing "{6690C743B37435DF}" {
     m_iOrder 15
     m_sTitle "Medical Information"
     m_sContent "Phenylephrine Injector is used to slow bleeding and increase BP"\
     ""\
     "Useful to stabilize wounded players before medics gets to them"\
     ""\
     "Section CO & 2iC has been issued 3x of them, use them on any downed players to help stabilize them until Medics gets to them."
    }
