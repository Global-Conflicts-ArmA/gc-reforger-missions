GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "5B89C511692FD5DF"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{114C99694F63A09B}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "Time - 0620"\
     "Rainy with light fog.. "\
     ""\
     "Situation:"\
     "USSR forces have been pushed back and are attempting to hold the railroad bridges west of Bogatyrka, while CAF have consolidated and are attempting to sweep the forests to secure both bridges."
    }
    GC_Briefing "{EC00B4471BE6608E}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet."\
     ""\
     "Known Strength:"\
     "1x Motor Rifle Platoon (+)"\
     "1x Recon Platoon"\
     ""\
     "Location: "\
     "Holding the bridges and likely spread out in the forest nearby to recon and ambush"\
     ""\
     "MLCOA:"\
     "Entrench themselves in the surrounding area to brace for our attack while recon screen"\
     ""\
     "MDCOA:"\
     "Recon units lay in ambush waiting for our forces before enaging, or even ambushing from the rear before falling back to the various bridges, conducting a fighting retreat to cause as many casualties as possible."\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{23E756D9AB63290F}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "CAF are equipped with their standard equipment weaponry, Colt C7, C9 LMG, C6 GPMG, L14A1 85mm MAWs."\
     "Wearing green coloured uniforms with a Canadian patch on their left shoulder."\
     ""\
     "Known Strength:"\
     "1x Platoon (+)"\
     ""\
     "Location: "\
     "Located south at the sawmill at likely their mobilization point before stepping off."\
     ""\
     "MLCOA:"\
     "Move through one of the roads while sweeping the forest before attacking the southern bridge, then moving onto the next"\
     ""\
     "MDCOA:"\
     "Utilize their mortars to sweep their push forward from SW to NE, flushing us out before moving into the space."\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{F24CFD4992553775}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "Disposition:"\
     "3rd Platoon is located East conducting similar operations in the area, to conduct an assault to secure Bogatyrka and later conduct a attack north-east."\
     ""\
     "Higher Units Mission:"\
     "Battalion has been assigned to support the local CDF in their defence and recapture of territory from the USSR forces and providing aid to the civilians."\
     ""\
     "Composition:"\
     "1x Rifle Platoon (+)"\
     ""\
     "Strength:"\
     "Rifle Platoon (+) at 48x man strength"\
     "1x LAVIIs"\
     "2x M252 Mortar"\
     ""\
     "Supporting Fires:"\
     "M252 Mortar support available"\
     ""\
     "Attachments/Detachments:"\
     "1x Mortar Attachment"\
     "1x Mechanized Squad Attachment"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{A74389D80C543A6A}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces"
     m_sContent "Disposition:"\
     "Our Platoon is spread out in the surrounding areas with a recon platoon south of us."\
     ""\
     "Higher Units Mission:"\
     "Battalion has been ordered to secure this area, suppress the local population and prepare to fortify our defences against the CDF and CAF."\
     ""\
     "Composition:"\
     "1x Rifle Squad Remnants"\
     "1x BTR Attchment"\
     ""\
     "Strength:"\
     "Squad (+) at 8x man strength"\
     "1x BTR-70"\
     ""\
     "Supporting Fires:"\
     "None."\
     ""\
     "Attachments/Detachments:"\
     "1x Recon BRDM Attachment"\
     "1x BTR-70"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{0628A1A947ACFFE8}" {
     m_iOrder 5
     m_sTitle "II. Mission:"
     m_sContent "Our Platoon with attachments has been ordered to clear the forest to the bridges to make sure they're intact or within our control to repair as needed, while also clearing out the left flank for 3rd Platoon to assault Bogatyrka"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{9A3ED90D3346CFED}" {
     m_iOrder 6
     m_sTitle "II. Mission:"
     m_sContent "Platoon has ordered us to maneuver and patrol the area as we see fit, with a BTR attached to us for transport. Seeing as we're remnants from the platoon that were assaulted at the sawmil, best we do what we can to support our new platoon."\
     ""\
     "We got a recon Platoon patroling the south side in the forest."\
     ""\
     "Also been ordered to try to stay together to minimize potential friendly fire incidents as its very dark outside."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{94C2DF2FEA59E915}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Platoon is to sweep the forest and capture the bridges intact if possible"\
     ""\
     "1. Concept of the Operation:"\
     "Platoon Commander's Discretion."\
     "It is advised to not allow the enemy to ambush our LAV while the infantry are still mounted, push the infantry to screen and sweep the forest. "\
     ""\
     "Utilize the Mortars to clear our dug in enemy positions or to flush out enemies from a forest if required."\
     ""\
     "2. Maneuver"\
     "Platoon Commander's Discretion."\
     "It is advised to not spread our forces too wide where upon our units cannot support one another incase of attack, ambush or being seperated."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{08C663D924E4885D}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Hold both bridges while patrolling the nearby area, preventing the approach and loss of the bridges to the CAF"\
     ""\
     "1. Concept of the Operation:"\
     "Squad Commander's Discretion."\
     "It is advised to spread our forces out and utilize the BTR70 capabilities to locate the likely route the enemy may take, or wait for our recon platoon to locate them for us."\
     ""\
     "2. Maneuver:"\
     "Squad Commander's Discretion."\
     "It is advised to not spread our forces too wide where upon our units cannot support one another incase we lose one or both sides of the dam, allowing us to counter attack if we have enough men."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{0D9C483AD49BC150}" {
     m_iOrder 9
     m_sTitle "IV. Sustainment:"
     m_sContent "I. SOP Variations"\
     "None."\
     ""\
     "II. Logistical Support:"\
     "None provided from the Company nor Battalion"\
     "Supplies are already located within the LAV themselves if needed"\
     "(Mortars have unlimited supplies, but are REQUIRED to be called in for fires. Not always observed but they must be called in to conduct a firemission.)"\
     ""\
     "III. Medical:"\
     "A crate of medical supplies has been provided sorely for the medic to utilized."\
     ""\
     "IV. Vehicles:"\
     "Platoon is equiped with;"\
     "1x LAVIIs"\
     "(60x AP, 150x HE, 200x5 Coax)"\
     ""\
     "No Replacement is provided or accounted for if losses are sustained."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{DFC44043D2212603}" {
     m_iOrder 10
     m_sTitle "IV. Sustainment:"
     m_sContent "I. SOP Variations"\
     "None."\
     ""\
     "II. Logistical Support:"\
     "None provided from the Company nor Battalion."\
     ""\
     "III. Medical:"\
     "A crate of medical supplies has been provided sorely for the medic to utilized."\
     ""\
     "IV. Vehicles:"\
     "Rifle squad is equiped with;"\
     "1x BTR70"\
     ""\
     "No Replacement is provided or accounted for if losses are sustained."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{DC52EC853658B83F}" {
     m_iOrder 11
     m_sTitle "V. Command & Signals:"
     m_sContent "I. Chain of Command:"\
     "21, 21 Alpha, 21 Bravo, etc"\
     ""\
     "II. Callsigns:"\
     "Platoon Leader 	- 21 Sunray"\
     "Platoon Warrant 	- 21 Sunray Minor "\
     ""\
