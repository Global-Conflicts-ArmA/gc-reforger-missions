     m_sTitle "V. Command & Signals:"
     m_sContent "I. Chain of Command:"\
     "233, 454 Vic, 455 Vic"\
     ""\
     "II. Callsigns:"\
     "1st Squad - 233"\
     "BRDM - 454 Vic"\
     "BTR - 455 Vic"\
     ""\
