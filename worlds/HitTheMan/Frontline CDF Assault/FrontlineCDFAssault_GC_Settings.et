 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{A346E90B5582EBF5}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "<h2>I. Situation</h2>"\
     ""\
     "<b>Time & Weather:</b>"\
     "Time: 16:45"\
     "Weather: Cloudy"\
     ""\
     "<b>Situation:</b>"\
     "Seperatists and the Chernarussian Defence Force have been battling over this village for months, with the CDF continuing to try and retake it while the Seperatists are steadfast. This is just another attempt by the CDF."
    }
    GC_Briefing "{8FC2259156EF2429}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "Seperatists are equipped with mismatch of Pact weaponry, AK series, RPG7s, PKMs, RPKs."\
     "Wearing the mismatch of uniforms."\
     ""\
     "<b>Known Strength:</b>"\
     "1x Rifle Platoon (-)"\
     ""\
     "<b>Location:</b>"\
     "Holding out at the village south of Zarichne"\
     ""\
     "<b>Capabilities:</b>"\
     "Access to RPGs, PKMs, VOGs, NSVs, etc."\
     ""\
     "<b>MLCOA:</b>"\
     "Locate our main attack axis and hurt us badly before pulling back"\
     ""\
     "<b>MDCOA:</b>"\
     "Spot out recon, hit them hard before likely reinforcing our attack axis."\
     ""\
     "<b>Defensive Fires:</b>"\
     "No known in-direct threat at this time."\
     ""\
     "<b>Airthreat:</b>"\
     "No access to air assets thankfully.."\
     ""\
     "<b>Morale:</b>"\
     "Very High."\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{57BB7DE35CA52570}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "CDF are equipped with their standard WARSAW Pact weaponry, AK series, RPKs, etc"\
     "Wearing Tan ish coloured uniform & green/tan helmets."\
     ""\
     "<b>Known Strength:</b>"\
     "<i>1x Light Infantry Platoon"\
     "1x Ural ZSU-23-2"\
     ""\
     "<b>Location:</b>"\
     "South of Zarichne as marked on map"\
     ""\
     "<b>Capabilities:</b>"\
     "Access to RPGs, PKMs, VOGs, Flares."\
     "Vehicles include Ural ZSU-23-2"\
     ""\
     "<b>MLCOA:</b>"\
     "Push their recon through to locate our position before sending the whole platoon through a single axis."\
     ""\
     "<b>MDCOA:</b>"\
     "Utilize the recon to locate and disrupte any defence building, sending in the platoon through the eastern woods."\
     ""\
     "<b>Defensive Fires:</b>"\
     "Likely open up with a mortar bombardment of the town"\
     ""\
     "<b>Airthreat:</b>"\
     "No known air units in the area at this time."\
     ""\
     "<b>Morale:</b>"\
     "Alright"\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{0E2BE684DAEA9D1A}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "All CDF Forces in the area (YOU) are marked on the map south of Zarichne"\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Our unit's task has been to secure a foothold in the village south of Zarichne."\
     ""\
     "<b>c. Composition:</b>"\
     "1x Rifle Platoon (+)"\
     "- 1x Ural ZSU-23-2"\
     ""\
     "<b>d. Strength:</b>"\
     "Platoon at 35x man strong including the Ural ZSU-23-2"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "Mortar Barrage will commence once we start moving towards the village (After 5min setup timer)"\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "1x Ural ZSU-23-2"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "None."
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{E134EAF943A663D1}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "Our fighting group is located south of Zarichne spread out as marked on map."\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Our unit is assigned to fight the Chernarussian Defence Force in this region to liberate it from their iron claws, but are being counter attacked hard."\
     ""\
     "<b>c. Composition:</b>"\
     "1x Rifle Platoon (-)"\
     "2x NSV MGs Positions (with MG Team)"\
     ""\
     "<b>d. Strength:</b>"\
     "19x man strong Platoon"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "We have none."\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "None."\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "None."
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{82E08533B6BAF44F}" {
     m_iOrder 5
     m_sTitle "II. Mission: (Must Read)"
     m_sContent "<h2>II: Mission</h2>"\
     "Push up and secure the marked compound in the village."\
     ""\
     "RECON unit can move during setup timer, use this to locate hostile forces, skirmish with them or simply observe."\
     ""\
     "The enemy likely have heavily trenches areas and setup MG Nests, try and locate them before comitting to a attack axis."
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{912D2E3344549096}" {
     m_iOrder 6
     m_sTitle "II. Mission: (Must Read)"
     m_sContent "<h2>II: Mission</h2>"\
     "Defend the compound that is acting as our HQ Location."\
     ""\
     "Our squads are spread out, 1st Squad is at 019 006 in the trench"\
     "2nd squad is at 011 010 in the trench"\
     "MG Team is at 014 010 at the Trenches with MGs"\
     ""\
     "Their recon team CAN MOVE during setup timer, so be prepared especially 1st squad as they could move through that forest near 019 006"\
     ""\
     "MG Team has good line of sight to support 1st Squad and kind of 2nd Squad."\
     ""\
     "Be mindful of their Ural ZSU-23-2"
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{F17974D60D33BD4D}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Secure a foothold in the village"\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "Platoon Commander's Discretion."\
     "It is adviced to utilize the Ural ZSU-23-2 to supress any fortifications or building windows to allow for squads to maneuver (It has plenty of Ammo), while utilizing the Recon units to find and locate hostile units to better allow for your Situational Awareness."\
     ""\
     "<b>2. Maneuver</b>"\
     "Company Commander's Discretion."\
     "It is advised NOT TO split the platoon up, supportive fire and allow squads to mutually support one another is VITAL."\
     ""
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{5CDEC195B67B86CF}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Prevent CDF from establishing a foothold in the village."\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "1st Squad Commander's Discretion."\
     ""\
     "<b>2. Maneuver</b>"\
     "1st Squad Commander's Discretion."\
     ""
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{3A6EA1E2A9C95E52}" {
     m_iOrder 9
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "Dress: Standard CDF Uniform"\
     "Equipment: Standard CDF Loadout"\
     ""\
     "<b>b. Logistical Support:</b>"\
     "Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition."\
     "IPE: Helmets and body armour are to be worn at all times."\
     ""\
     "<b>c. Medical:</b>"\
     "Location: Company Aid Post is to be setup by company medics."\
     "CASEVAC: By foot or with company asset like the Ambulance IF there are any."\
     "Plan: Set up a casualty collection point and extract casualties to this point."\
     "Stretchers: None"\
     "Med Packs: Company medpack carried by company medic."\
     "Morphine: Every soldier carries 1+ stick of morphine."\
     ""\
     "<b>d. Vehicles:</b>"\
     "1x Ural ZSU-23-2"
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{01EE4127F2B11B05}" {
     m_iOrder 10
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "Uniform: Strict adherence to friendly seperatist clothing. DO NOT put on enemy uniforms.. you'll be shot at sight"\
     "Equipment: Battlefield scavenging is authorized (weapons, ammo, vests)."\
     ""\
     "<b>b. Logistical Support:</b>"\
     "Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition."\
     "IPE: Helmets and body armour are to be worn at all times if you have them.</i>"\
     ""\
     "<b>c. Medical:</b>"\
     "Location: Platoon Aid Post is to be setup by Platoon medics."\
     "CASEVAC: We have no such luxury"\
     "Plan: .. We have no plan"\
     "Stretchers: None"\
     "Med Packs: Platoon medpack carried by the Platoon medic."\
     "Morphine: Every soldier carries 1+ stick of morphine.</i>"\
     ""\
     "<b>d. Vehicles:</b>"\
