 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{292EE0C6B1B8941C}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "Time: 05:15"\
     "Cloudy"\
     ""\
     "Situation:"\
     "CAF has made progress pushing back the Soviet Army, in their promise to aid the US Forces in securing & \"Liberating\" this island. However the Soviet Army is reorganizing in preperation to counter attack."
    }
    GC_Briefing "{419C32A5D38BBC96}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet."\
     ""\
     "Known Strength:"\
     "1x Motor Rifle Platoon"\
     ""\
     "Location: "\
     "Holding the military site NE of Green Hill"\
     ""\
     "MLCOA:"\
     "Entrench themselves in the surrounding area to brace for our attack while recon screen the front."\
     ""\
     "MDCOA:"\
     "Recon units lay in ambush waiting for our forces before enaging, or even ambushing from the rear before falling back to the various entrenched locations conducting a fighting retreat to cause as many casualties as possible before our assault into the Military Site."\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{F9A0F0C7CFD57EB7}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "CAF are equipped with their standard NATO weaponry, M16A1s series, LAWs/M67s, M249s, M60s. etc"\
     "Wearing woodland coloured camo uniforms & helmets."\
     ""\
     "Known Strength:"\
     "1x Motorized Rifle Platoon (+)"\
     ""\
     "Location: "\
     "North East of our position"\
     ""\
     "MLCOA:"\
     "Maneuver around to strike us with their full force at a unsuspecting side"\
     ""\
     "MDCOA:"\
     "Utilize their LAVs to surpress the military site while their other forces manevuer in to strike us"\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{168C248FA4B79D63}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "Disposition:"\
     "Company is split located to the NW & SE securing our far right flank with our other platoons"\
     ""\
     "Higher Units Mission:"\
     "Battalion has been assigned to support the US forces securing and \"Liberating\" this island from the Soviet Union."\
     ""\
     "Composition:"\
     "1x Mechanized Platoon (+)"\
     ""\
     "Strength:"\
     "Mechanized Platoon (++) at 42x man strength"\
     "4x M113A2s"\
     "1x LAVIIs"\
     ""\
     "Supporting Fires:"\
     "None."\
     ""\
     "Attachments/Detachments:"\
     "1x Mechanized LAV Squad Attachments"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{0B0365200316D3B1}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces:"
     m_sContent "Disposition:"\
     "Battalion is located south-west reorganizing themselves to attempt a counter-attack while we delay the enemy forces"\
     ""\
     "Higher Units Mission:"\
     "Reorganize and push these foreigners out of our land!"\
     ""\
     "Composition:"\
