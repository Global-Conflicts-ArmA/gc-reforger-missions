    GC_Briefing "{B41EE2E86C6C1971}" {
     m_iOrder 5
     m_sTitle "II. Mission:"
     m_sContent "Move SW and secure the military site from USSR Forces, slowly pushing our away deeper into the island."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{4A5A502439C7A5AB}" {
     m_iOrder 6
     m_sTitle "II. Mission:"
     m_sContent "Prevent the fall of the Military Site or delay them until our main unit is reorganized and preparing for a counter attack."\
     ""\
     "We have AP & AT Mines, read Sustainment for more info regarding what each BTR Contains"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{DFAEB803C75E7A1A}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Platoon is to decide on the attack direction, sweep it of potential recon elements and assault the Military Site, securing it."\
     ""\
     "1. Concept of the Operation:"\
     "Platoon Commander's Discretion."\
     "It is advised to not allow the enemy to ambush our LAVs and M113s while the infantry are still mounted, push the infantry to screen and sweep the forest. "\
     ""\
     "2. Maneuver"\
     "Platoon Commander's Discretion."\
     "It is advised to not spread our forces too wide where upon our units cannot support one another incase of attack, ambush or being seperated."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{390EFF0AFFA1ECEE}" {
