 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{BEA6F6C8AC2F249D}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "Time: 04:45"\
     "First Light at 05:00"\
     "Cloudy, Dawn with a light low-level fog"\
     ""\
     "Situation:"\
     "Soviet Forces are attacking Bad Orb with the support of NVA (Nationale Volksarmee), while Bad Orb is being defended by a Canadian Mechanized Battalion, with a company+ holding western Bad Orb."
    }
    GC_Briefing "{8DBF844F3D05A514}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "CAF are equipped with their standard equipment weaponry, Colt C7, C9 LMG, C6 GPMG, L14A1, LATs and FIM92 Stingers"\
     "Wearing green coloured uniforms with a Canadian patch on their left shoulder."\
     ""\
     "Known Strength:"\
     "1x Mechanized LAV Company(+)"\
     ""\
     "Location: "\
     "Located at Western Bad Orb, taking up defensive positions with a screening element to their south and south-west"\
     ""\
     "MLCOA:"\
     "Have a platoon screening the defence of the town before pulling back to prepare for urban warfare"\
     ""\
     "MDCOA:"\
     "Pull back their forces, turn the town into a bloodbath delaying our advance until their QRF arrives"\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{DDBB4B79678FA329}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "CAF are equipped with their standard equipment weaponry, Colt C7, C9 LMG, C6 GPMG, L14A1, LATs and FIM92 Stingers"\
     "Wearing green coloured uniforms with a Canadian patch on their left shoulder."\
     ""\
     "Known Strength:"\
     "1x Mechanized LAV Company(+) at Western Bad Orb"\
     "1x Mechanized Battalion at Bad Orb itself"\
     "1x Mechanized Company (+) at the Crossroad further west"\
     ""\
     "Location: "\
     "Located at Western Bad Orb, taking up defensive positions with a screening element to their south and south-west, At Bab Orb itself and at the Crossroad"\
     ""\
     "MLCOA:"\
     "Unknown"\
