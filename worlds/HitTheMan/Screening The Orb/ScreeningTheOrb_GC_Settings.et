    }
    GC_Briefing "{50BB5AD3E7BA1853}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes (ALL READ):"
     m_sContent "- It's intended that 1st Squad SL has no radio, PL HQ is meant to stay close to 1st squad but also voice range from 2nd and 3rd since you're sharing net with Company."\
     ""\
     "- SL, DO NOT TAKE RADIOS FROM YOUR CREWMEN. Not Intended, they are intercom radios and for COY Net, nothing more."\
     ""\
     "---------------------------------------------------------"\
     ""\
     "- Mi-24s cannot freely engage targets without being called in or given permission by ground forces (FACs or CO)"\
     "-- Be it Type 1, Type 2 or Type 3"\
     ""\
     "---------------------------------------------------------"\
     ""\
     "- You must be within 10m-25m of the Objective(s) to be counted as capturing it."\
     ""\
     "- Hard AO for NVA (Infantry/Ground)"\
     "Soft AO for Soviet Airforce (Helicopters/Air)"\
     ""\
     "---------------------------------------------------------"\
     ""\
     "SOFT END CONDITIONS:"\
     ""\
     "- Timelimit: 60m"\
     ""\
     "- NVA Victory is achieved once all 3 buildings are secured & defended against any potential QRF"\
     ""\
     "- Canadian Victory is achieved by causing 85% casualties to the NVA, before or after the buildings have been secured."
    }
    GC_Briefing "{4107A444BF0E0698}" {
     m_iOrder 14
     m_sTitle "Game Mastering"
     m_sContent "This mission is not designed for game mastering and should only be manipulated for technical, administrative or diagnostic purposes."
    }
   }
  }
 }
