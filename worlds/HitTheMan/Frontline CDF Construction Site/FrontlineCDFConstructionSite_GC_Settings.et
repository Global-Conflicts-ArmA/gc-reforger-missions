   m_aBriefings {
    GC_Briefing "{FA8D9EE571893B15}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "<h2>I. Situation</h2>"\
     ""\
     "<b>Time & Weather:</b>"\
     "Time: 16:30"\
     "Weather: Clear"\
     ""\
     "<b>Situation:</b>"\
     "Seperatists and the Chernarussian Defence Force have been battling over this construction site for months, with the CDF continuing to try and retake it while the Seperatists are steadfast. This is just another attempt by the CDF."
    }
    GC_Briefing "{2BC04031794A9B52}" {
     m_iOrder 1
     m_sTitle "II. Mission: (Must Read)"
     m_sContent "<h2>II: Mission</h2>"\
     "(Do Not Fire Mortars During The Setup Timer)"\
     ""\
     "Push up and secure the marked construction site."\
     ""\
     "RECON unit can move during setup timer, use this to locate hostile forces, skirmish with them or simply observe."\
     ""\
     "The enemy likely have heavily trenches areas and setup MG Nests, try and locate them before comitting to a attack axis."\
     ""\
     "Highly recommended to use the mortar to lay down a smoke mission, use the BMP-1ZDs to laydown heavy supresssion as well, before committing the main force body."
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{2423BC8CF71B54A0}" {
     m_iOrder 2
     m_sTitle "II. Mission: (Must Read)"
     m_sContent "<h2>II: Mission</h2>"\
     "Defend the construction site that is acting as our HQ Location."\
     ""\
     "We dug a trench at 035 025"\
     ""\
     "Their recon team CAN MOVE during setup timer, so be prepared to be likely engaged or fired at during setup timer."\
     ""\
     "Be mindful of their BMP-1ZDs"
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{1F1B67DD6F07F526}" {
     m_iOrder 3
     m_sTitle "III. Sustainment:"
     m_sContent "<h2>III: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "Dress: Standard CDF Uniform"\
     "Equipment: Standard CDF Loadout"\
     ""\
     "<b>b. Logistical Support:</b>"\
     "Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition."\
     "IPE: Helmets and body armour are to be worn at all times."\
     ""\
     "Each M113 carries:"\
     "- 20x Bandages"\
     "- 60x AK 30rnd Magazines"\
     "- 10x 100rnd PKM Boxes"\
     ""\
     "<b>c. Medical:</b>"\
     "Location: Company Aid Post is to be setup by company medics."\
     "CASEVAC: By foot or with company asset like the Ambulance IF there are any."\
     "Plan: Set up a casualty collection point and extract casualties to this point."\
     "Stretchers: None"\
     "Med Packs: Company medpack carried by company medic."\
     "Morphine: Every soldier carries 1+ stick of morphine."\
     ""\
     "<b>d. Vehicles:</b>"\
     "2x BMP-1ZDs"\
     "4x M113s"
     m_aFactionKeys {
      "GC_CDF"
     }
    }
    GC_Briefing "{315FA2439BF8A49D}" {
     m_iOrder 4
     m_sTitle "III. Sustainment:"
     m_sContent "<h2>III: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "Uniform: Strict adherence to friendly seperatist clothing. DO NOT put on enemy uniforms.. you'll be shot at sight"\
     "Equipment: Battlefield scavenging is authorized (weapons, ammo, vests)."\
     ""\
     "<b>b. Logistical Support:</b>"\
     "Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition."\
     "IPE: Helmets and body armour are to be worn at all times if you have them.</i>"\
     ""\
     "<b>c. Medical:</b>"\
     "Location: Platoon Aid Post is to be setup by Platoon medics."\
     "CASEVAC: We have no such luxury"\
     "Plan: .. We have no plan"\
     "Stretchers: None"\
     "Med Packs: Platoon medpack carried by the Platoon medic."\
     "Morphine: Every soldier carries 1+ stick of morphine.</i>"\
     ""\
     "<b>d. Vehicles:</b>"\
     "We have none, our personal vehicles were destroyed in a mortar barrage a yesterday"
     m_aFactionKeys {
      "GC_SEPARATIST"
     }
    }
    GC_Briefing "{A6328E746C8F7E82}" {
     m_iOrder 5
     m_sTitle "IV. Command & Signals:"
     m_sContent "<h2>IV. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "240, 241, 242, etc."\
     ""\
     "<b>II. Callsigns:</b>"\
     "1st Platoon HQ ------------------- 240"\
     "1st Squad --------------------------- 241"\
     "2nd Squad -------------------------- 242"\
     "3rd Squad --------------------------- 243"\
     "4th Squad --------------------------- 244"\
     ""\
     "1st Recon Team ------------------ 251"\
     "2nd Recon Team ------------------ 252"\
     ""\
     "1st BMP-1ZD ---------------------------- 321v"\
     "2nd BMP-1ZD ---------------------------- 322v"\
     ""\
     "Mortar Crew --------------------------- 512"\
     ""\
