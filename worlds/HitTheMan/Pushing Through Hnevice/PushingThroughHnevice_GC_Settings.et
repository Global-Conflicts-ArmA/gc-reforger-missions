 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{59355F21ADFB78F6}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "<h2>I. Situation:</h2>"\
     "<b>Time & Weather:</b>"\
     "<i>Time - 17:45"\
     "Weather - Clear</i>"\
     ""\
     "<b>Situation:</b>"\
     "<i>A Canadian Company (-) has been tasked with destroying a Soviet Ammo Depot behind the village of Hnevice, while the stationed Soviet Platoon acting as security makes a hasty defence</i>"
    }
    GC_Briefing "{8947D628089AB8E9}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "<i>USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet..</i>"\
     ""\
     "<b>Known Strength:</b>"\
     "<i>1x Rifle Platoon</i>"\
     ""\
     "<b>Location:</b>"\
     "<i>Held up at the village of Hnevice</i>"\
     ""\
     "<b>Capabilities:</b>"\
     "<i>Access to RPGs, PKMs, VOGs."\
     "Vehicles include UAZ452s and UAZ469.</i>"\
     ""\
     "<b>MLCOA:</b>"\
     "<i>Locate our axis of movement before concentrating their forces to repel us or pull back after a short engagement</i>"\
     ""\
     "<b>MDCOA:</b>"\
     "<i>Utilize their NSVs to decimate our approach axis, hit us with all they got before falling back to do it gain.</i>"\
     ""\
     "<b>Defensive Fires:</b>"\
     "<i>No known in-direct threat at this time.</i>"\
     ""\
     "<b>Airthreat:</b>"\
     "<i>No known Air support.</i>"\
     ""\
     "<b>Morale:</b>"\
     "<i>Alright.</i>"\
     ""\
     "<b>CBRN Threat:</b>"\
     "<i>The enemy pose no CBRN Threat as of now.</i>"\
     ""
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{5751CB247ED07F02}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "<i>Canadians are equipped with their standard NATO weaponry. etc"\
     "Wearing woodland coloured camo uniforms & helmets.</i>"\
     ""\
     "<b>Known Strength:</b>"\
     "<i>1x Rifle Company (-)"\
     "1x LAV-ii</i>"\
     ""\
     "<b>Location:</b>"\
     "<i>West of the village of Hnevice</i>"\
     ""\
     "<b>Capabilities:</b>"\
     "<i>Access to M16A1s series, LAWs/M67s, M60, etc."\
     "Vehicles include LAV-II</i>"\
     ""\
     "<b>MLCOA:</b>"\
     "<i>Split their platoons up before pushing up towards our defences</i>"\
     ""\
     "<b>MDCOA:</b>"\
     "<i>Move their whole company down a gap in our defences before going to the depot.</i>"\
     ""\
     "<b>Defensive Fires:</b>"\
     "<i>No known in-direct threat at this time.</i>"\
     ""\
     "<b>Airthreat:</b>"\
     "<i>No known Air support.</i>"\
     ""\
     "<b>Morale:</b>"\
     "<i>Very High.</i>"\
     ""\
     "<b>CBRN Threat:</b>"\
     "<i>The enemy pose no CBRN Threat as of now.</i>"\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{055D87772B8C3589}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "<i>Canadian Rifle Company (-) with an attached LAV II is located South of Hnevice</i>"\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "<i>Company has been tasked with securing a enemy supply depot & the village of Hnevice itself</i>"\
     ""\
     "<b>c. Composition:</b>"\
     "<i>1x Rifle Canadian Company (-)"\
     "1x LAVII</i>"\
     ""\
     "<b>d. Strength:</b>"\
     "<i>29 COY HQ - At 56 Man Strength."\
     "1st Plt - At 23x Man Strength"\
     "2nd Plt - At 23x Man Strength"\
     "xxx - At 3x Man Strength + 1x LAVII</i>"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "<i>None as of this time.</i>"\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "<i>No air support available</i>"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "<i>Provided in the LAVII"\
     "Detonators & Satchels located in each PLT Crate.</i>"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{D2EAF45EA789F27D}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "<i>Soviet Platoon is spread around the farm that contains the ammo depot.</i>"\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "<i>Soviet Platoon is acting as security for the Ammo Depot for the Battalion</i>"\
     ""\
     "<b>c. Composition:</b>"\
     "<i>1x Rifle Platoon</i>"\
     ""\
     "<b>d. Strength:</b>"\
     "<i>Platoon - At 25 Man Strength.</i>"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "<i>None as of this time.</i>"\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "<i>No air support available</i>"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "<i>Some extra bandages in the vehicles + tripod weapons.</i>"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{CA9BB504A338C71B}" {
     m_iOrder 5
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "<i>Move in & Destroy the enemy Ammo Depots (2x Locations) located arouned Hnevice as marked on map.</i>"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{E407A09BBA2F2FB5}" {
     m_iOrder 6
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "<i>Prevent the destruction of both the Ammo Depots or render the enemy combat ineffective.</i>"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{DD720810A7A245D0}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "<i>Push through an gaps in their defences and destroy the Ammo Dump.</i>"\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to the Platoons to locate any heavily fortified positions before calling up the LAV to destroy it, prior to continuing movement.</i>"\
     ""\
     "<b>2. Maneuver</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to NOT split up the platoons but have them work together to mutually support one another during movement, while utilizing the LAV to break up any heavily fortified positions that the platoons encounter."\
     "</i>"\
     ""
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{5758D34881E2C38F}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "<i>Setup defensive lines to prevent the fall of the ammo depot.</i>"\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to utilize the NSV Tripods located in each UAZ to setup a fortified position to better defend the area.</i>"\
     ""\
     "<b>2. Maneuver</b>"\
     "<i>Company Commander's Discretion."\
     "It is adviced to setup fields of fire for the squads & NSVs to better hurt the enemy before pulling back to a fallback defence point.</i>"\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{719288CC2D0D9A3D}" {
     m_iOrder 9
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "<i>Dress: Standard Canadian Uniform"\
     "Equipment: Standard Canadian Loadout</i>"\
     ""\
     "<b>b. Logistical Support:</b>"\
     "<i>Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition & LAVIIs carry additional ammunition."\
     "IPE: Helmets and body armour are to be worn at all times."\
     ""\
     "Each Platoon has a Crate that contains:"\
     "- 50x Demoblock M112"\
     "- 10x Blasting Machine M34</i>"\
     ""\
     "<b>c. Medical:</b>"\
     "<i>Location: Platoon Aid Post is to be setup by Platoon medics."\
     "CASEVAC: By foot or with company asset like the HMMWV or LAVIIs"\
     "Plan: Set up a casualty collection point and extract casualties to this point."\
     "Stretchers: None"\
     "Med Packs: Platoon medpack carried by Platoon medic."\
     "Morphine: Every soldier carries 1+ stick of morphine.</i>"\
     ""\
     "<b>d. Vehicles:</b>"\
     "<i>1x LAVIIs"\
     "- LAVs has Smoke Launchers"\
     "The LAV-IIs contains;"\
     "- 20x Bandages"\
     "- 20x Tourniquets"\
     "- 10x Morphine"\
     "- 48x Stanag Mags"\
     "- 12x M249 Boxes"\
     "- 12x Grenades"\
     "- 12x Smoke Grenades"\
     "- 8x 40mm Grenade"\
     "- 24x 40mm Flares"\
     "- 2x LAWs"\
     "- 1x ANPRC77"\
     "- 30x Demoblock M112"\
     "- 6x Blasting Machine M34</i>"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{7BFF3631762CB39D}" {
     m_iOrder 10
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "<i>Dress: Standard Soviet Uniform"\
     "Equipment: Standard Soviet Loadout</i>"\
