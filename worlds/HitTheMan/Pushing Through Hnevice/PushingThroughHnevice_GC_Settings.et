    }
    GC_Briefing "{9389EE23834BE391}" {
     m_iOrder 11
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "<i>29, 29A, 21, 22, etc</i>"\
     ""\
     "<b>II. Callsigns:</b>"\
     "<i>Company Commander ----------- 2"\
     ""\
     "Platoon HQ ---------------------------- 21"\
     "- Platoon Leader -------------------- 21 Sunray"\
     "- Platoon Warrant ------------------ 21 Sunray Minor OR 21F - Foctor"\
     "1st Section --------------------------- 21A - Alpha"\
     "2nd Section -------------------------- 21B - Bravo"\
     "Weapons Detachment ---------- 21W - Whisky"\
     ""\
     "Platoon HQ ---------------------------- 22"\
     "- Platoon Leader -------------------- 22 Sunray"\
     "- Platoon Warrant ------------------ 22 Sunray Minor "\
     "1st Section --------------------------- 22A - Alpha"\
     "2nd Section -------------------------- 22B -  Bravo"\
     "Weapons Detachment ---------- 22W - Whisky"\
     ""\
     "LAV-II Attachment ---------------- 23E - Echo</i>"\
     ""\
     "<b>- - - Vehicle/LAV Callsigns when Inf dismounted:</b>"\
     "<i>Z29 or Zulu 29"\
     "Zulu 21 Alpha"\
     "Zulu 21 Bravo"\
     "Etc.</i>"\
     ""\
     "<b>III. Frequencies:</b>"\
     "<i>Company Net ------------ 48.00Mhz"\
     "1st Platoon Net -------- 47.00Mhz"\
     "2nd Platoon Net ------- 49.00Mhz</i>"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{3C1D7C136E41E1F1}" {
     m_iOrder 12
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
