    GC_Briefing "{DD9BF2EDFE7D41D0}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes:"
     m_sContent "<h2>Mission Notes:</h2>"\
     "<b>Timelimit:</b>"\
     "<i>60m (Can be increased by GM's Discretion)</i>"\
     ""\
     "<h2>Victory/Defeat Conditions:</h2>"\
     "<b>- Soviet Defeat; </b>"\
     "- Suffering 90% Casualties or Ammo Depot is destroyed."\
     ""\
     "<b>- Canadian Defeat</b>"\
     " - Suffering 85% Casualties or Timelimit is reached</i>"\
     ""\
     "<b>GM Discretion as usual.</b>"
    }
