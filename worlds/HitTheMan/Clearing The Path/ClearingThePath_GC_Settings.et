   m_aBriefings {
    GC_Briefing "{70B08B7A63910248}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "<h2>I. Situation:</h2>"\
     "<b>Time & Weather:</b>"\
     "Time - Attackers Choose"\
     "Weather - Defenders Choose"\
     ""\
     "<b>Situation:</b>"\
     "A East Germany Company (-) has been tasked with the Kamoryn Military Base from the British Royal Marines, to continue their advance westwards, while the British are setting up forward defences to either deny or destroy the East German Advance."
    }
    GC_Briefing "{A2730821B0010F35}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "Royal Marines are equipped with their standard NATO weaponry. etc"\
     "Wearing woodland coloured camo uniforms & helmets."\
     ""\
     "<b>Known Strength:</b>"\
     "1x UK Royal Marines Platoon"\
     ""\
     "<b>Location:</b>"\
     "Royal Marines located at Kamoryn Military Base"\
     ""\
     "<b>Capabilities:</b>"\
     "Royal Marines Acces to FAL, GPMG, MAWs, etc"\
     ""\
     "<b>MLCOA:</b>"\
     "Engage us before we establish a solid foothold in their forest before pulling back"\
     ""\
     "<b>MDCOA:</b>"\
     "Prepare killzones to destimate a platoon before pulling back into harder defences."\
     ""\
     "<b>Defensive Fires:</b>"\
     "No known in-direct threat at this time."\
     ""\
     "<b>Airthreat:</b>"\
     "No known Air support."\
     ""\
     "<b>Morale:</b>"\
     "Very Low."\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{07773846252A33EC}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "NVA are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PRKs."\
     "Wearing the standard NVA uniform of Dark green with greenish helmet."\
     ""\
     "<b>Known Strength:</b>"\
     "1x Company (-)"\
     ""\
     "<b>Location:</b>"\
     "Company is located East of the Military Base."\
     ""\
     "<b>Capabilities:</b>"\
     "Access to RPGs, RPKs"\
     "Vehicles include are BRDMs."\
     ""\
     "<b>MLCOA:</b>"\
     "Locate a good attack vector before shoving their whole company through it"\
     ""\
     "<b>MDCOA:</b>"\
     "Utilize their BRDMs to push us off treeline before shoving their company through."\
     ""\
     "<b>Defensive Fires:</b>"\
     "No known in-direct threat at this time."\
     ""\
     "<b>Airthreat:</b>"\
     "No known Air support."\
     ""\
     "<b>Morale:</b>"\
     "Alright."\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{142B417D886E283C}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "East German Company (-) is located East of Kamoryn Military Base."\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Company has been tasked with securing the Kamoryn Military Base to allow our higher units behind us to continue their advance forward."\
     ""\
     "<b>c. Composition:</b>"\
     "1x Company HQ"\
     "2x Rifle Platoons"\
     "1x BRDM Section."\
     ""\
     "<b>d. Strength:</b>"\
     "Company HQ - At 1x Soldiers Strong"\
     "1st Platoon - At 24x Soldiers Strong"\
     "2nd Platoon - At 24x Soldiers Strong"\
     "BRDMs - At 6x Soldiers Strong."\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "None as of this time."\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "1x BRDM Section."\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "Additional Ammunition in the BRDMs"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{CA065791214707E2}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "Royal Marines Platoon is located at Kamoryn Military Base."\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Royal Marines has been tasked with making sure to not loose the Kamoryn Military Base."\
     ""\
     "<b>c. Composition:</b>"\
     "1x Royal Marines Platoon"\
     ""\
     "<b>d. Strength:</b>"\
