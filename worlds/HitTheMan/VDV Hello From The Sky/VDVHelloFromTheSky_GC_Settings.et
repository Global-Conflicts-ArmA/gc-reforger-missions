     "- 6x HEDP Rocket Pods."\
     ""\
     "<b>No Helicopter Rearming Available.</b>"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{D71F7E5F34C61C75}" {
     m_iOrder 11
     m_sTitle "V. Command & Signals:"
     m_sContent "<b>I. Chain of Command:</b>"\
     "21, 21 Alpha, 21 Bravo"\
