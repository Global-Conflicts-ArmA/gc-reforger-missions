    GC_Briefing "{E223E1CEA9EBD094}" {
     m_iOrder 12
     m_sTitle "V. Command & Signals:"
     m_sContent "<b>I. Chain of Command:</b>"\
     "340 -> 341 HQ -> 344 HQ -> 347 (HQ) -> 341 -> etc"\
     ""\
     "<b>II. Callsigns:</b>"\
     "Company HQ ------------------------------ 340 (Radio)"\
     "Forward Air Support Liaisons ----- KAMENKA"\
     ""\
     "1st Platoon HQ --------------------------- 341 (HQ)"\
     "1st Rifle Squad --------------------------- 341"\
     "2nd Rifle Squad -------------------------- 342"\
     "3rd Rifle Squad --------------------------- 343"\
     ""\
     "2nd Platoon HQ -------------------------- 344 (HQ)"\
     "1st Rifle Squad --------------------------- 344"\
     "2nd Rifle Squad -------------------------- 345"\
     "3rd Rifle Squad --------------------------- 346"\
     ""\
