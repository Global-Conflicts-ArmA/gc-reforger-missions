GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "5FE41D1B6BDD418A"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{362DD01CE13CC03A}" {
     m_iOrder 1
     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "Time: 05:30"\
     "First Light at 05:10"\
     "Clear, Dawn with a light low-level fog"\
     ""\
     "Situation:"\
     "NVA Battalion is conducting an all out offensive against a dug-in US Force, to dislocate them from their defensive fortifications and push towards the river before conducting a crossing assault."
    }
    GC_Briefing "{3199200A2D4DBE7F}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "US are equipped with their standard NATO equipment weaponry, M4 M249, M240, LAW, etc"\
     "Wearing green camo coloured uniforms"\
     ""\
     "Known Strength:"\
     "1x Rifle Company (+)"\
     "1x Bradley Platoon"\
     ""\
     "Location: "\
     "Located East of Zarichne town, dug in around the ruins and making trench fortifications and checkpoints."\
     ""\
     "MLCOA:"\
     "Dug into the trenchline with killzones infront of their defences, wait out and hold"\
     ""\
     "MDCOA:"\
     "Pull back their forces, turning their trenches into grenade traps before pushing us back out"\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
    }
    GC_Briefing "{64675DD2DEB0105F}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "Disposition:"\
     "Sister company located North of us conducting similar offensives forward"\
     ""\
     "Higher Units Mission:"\
     "Push forward to secure the trenchlines, defences and secure our side of the river before conducting a crossing assault into Zarichne itself."\
     ""\
     "Composition:"\
     "1x Motorifle Company"\
     "- 2x BTR Platoons"\
     "- 1x T-72 Platoon"\
     ""\
     "Strength:"\
     "Rifle Platoon (+) at 78x man strength"\
     "7x BTR-70s"\
     "4x T-72s"\
     "1x Ambulance Van"\
     ""\
     "Supporting Fires:"\
     "None."\
     ""\
     "Attachments/Detachments:"\
     "None."
    }
    GC_Briefing "{B545EC768020EF9E}" {
     m_iOrder 4
     m_sTitle "II. Mission:"
     m_sContent "Our Motor Rifle Company has been tasked with securing out sector, pushing the US back across the river and digging in before conducting a river crossing assault into Zarichne."\
     ""\
     "We are to Secure 4 key points before reaching the river."
    }
    GC_Briefing "{99ED0CF06260ADA5}" {
     m_iOrder 5
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Company is to push west towards the river, dislocating the enemy Company (+), securing our side of the river and dig in."\
     ""\
     "1. Concept of the Operation:"\
     "Platoon Commander's Discretion."\
     "It is advised to keep in mind the urban dense area to not isolate squads or BTRs"\
     ""\
     "2. Maneuver"\
     "Platoon Commander's Discretion."\
     "It is advised to not spread our forces too wide where upon our units cannot support one another incase of attack, ambush or being seperated."
    }
    GC_Briefing "{0EFE71FE9042F5E5}" {
     m_iOrder 6
     m_sTitle "IV. Sustainment:"
     m_sContent "I. SOP Variations"\
     "None."\
     ""\
     "II. Logistical Support:"\
     "BTRs has a lot of supplies and ammo to be utilized by the Platoons for this mission"\
     ""\
     "III. Medical:"\
     "Medics has been provided with the goods and the ambulance van has some spare supplies."\
     ""\
     "IV. Vehicles Loadouts:"\
     ""\
     "BTR-70:"\
     "- 48x AK55 Magazines"\
     "- 10x Smoke"\
     "- 4x Grenades"\
     "- 8x Bandages"\
     "- 6x Tourniquets"\
     "- 8x Morphines"\
     ""\
     "No Replacement is provided or accounted for if losses are sustained."
    }
    GC_Briefing "{F2796DB6A14FB6A2}" {
     m_iOrder 7
     m_sTitle "V. Command & Signals:"
     m_sContent "I. Chain of Command:"\
     "220 -> 221 HQ -> 224 HQ -> etc"\
     ""\
     "BTR Crew Has Radios, Squad Leaders Does Not"\
     "Squad Leader talks through the BTR to reach PLT Leader"\
     ""\
     "II. Callsigns:"\
     "Company Co.		- 220 HQ"\
     "COY BTR		- 220"\
     ""\
     "1st Platoon Leader 	- 221 HQ"\
     "1st BTR / Squad	- 221"\
     "2nd BTR / Squad	- 222"\
     "3rd BTR / Squad	- 223"\
     ""\
     "2nd Platoon Leader	- 224 HQ"\
