     ""\
     "III. Frequencies:"\
     "Company Net		- 42.00 MHz"
    }
    GC_Briefing "{CEB2ABDA8214785D}" {
     m_iOrder 8
     m_sTitle "VI. Mission Notes:"
     m_sContent "You must be within 27m-100m of the building(s) or locations to be counted as capturing it."\
     ""\
     "SOFT END CONDITIONS:"\
     ""\
     "- Timelimit: 90m"\
     ""\
     "- NVA Victory is achieved once all 4 locations are secured & defended against any potential QRF"\
     ""\
     "- US Victory is achieved by causing 90% casualties to the NVA, before or after the buildings have been secured."
    }
    GC_Briefing "{F75ECB71811D966E}" {
     m_iOrder 9
     m_sTitle "VII. Mission Notes for FO:"
     m_sContent "Radio Frequency: 49.00 MHz"\
     "Keybind: Open Radio (G) + Double Tap C key"\
     ""\
     "What you have Available:"\
     "- 240x 82mm Smoke"\
     "- 3x Guns Firing per Firemission (can call in multiple firemissions)"\
     "- 60x Sec Delay"\
     ""\
     "Recommend you fire 3 Firemission one after another in a Grid line to simulate a Line Barrage, to conduct this, you can for an example do this grid for a North-South smokescreen with a 50m Dispersion"\
     ""\
     "04300230"\
     "04300225"\
     "04300220"\
     ""\
     "Dispersion is measured in meters."
    }
    GC_Briefing "{17C7BDFBC1EEB8B1}" {
