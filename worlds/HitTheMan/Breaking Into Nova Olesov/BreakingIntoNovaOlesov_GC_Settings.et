    }
    GC_Briefing "{C762E785C51968A1}" {
     m_iOrder 11
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "21, 21A, 21B, 21W, etc"\
     ""\
     "<b>II. Callsigns:</b>"\
     "Platoon HQ ---------------------------- 21"\
     "- Platoon Leader -------------------- 21 Sunray"\
     "- Platoon Warrant ------------------ 21 Sunray Minor"\
     "1st Section --------------------------- 21A - Alpha"\
     "2nd Section -------------------------- 21B - Bravo"\
     "Weapons Detachment ---------- 21W - Whisky"\
     ""\
     "<b>- - - Vehicle/LAV Callsigns when Inf dismounted:</b>"\
     "Z29 or Zulu 29"\
     "Zulu 21 Alpha"\
     "Zulu 21 Bravo"\
     "Etc."\
     ""\
     "<b>III. Frequencies:</b>"\
     "Platoon Net ------------ 48.00Mhz"
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{96AA8FAAD7F7BC8C}" {
     m_iOrder 12
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "340, 341 (Radio), 344 (Radio), 341, 342, etc"\
     ""\
     "<b>II. Callsigns:</b>"\
     "Company HQ -------------------------- 340"\
     ""\
     "Platoon HQ ---------------------------- 341 (Radio)"\
     "1st Squad ------------------------------ 341"\
