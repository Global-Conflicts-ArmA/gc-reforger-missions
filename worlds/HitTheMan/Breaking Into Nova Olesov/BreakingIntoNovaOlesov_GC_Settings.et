    GC_Briefing "{F70D454B00EA661A}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes:"
     m_sContent "<h2>Mission Notes:</h2>"\
     "<b>Timelimit:</b>"\
     "- 50m (Can be increased by GM's Discretion)"\
     "- 5min Setup Timer."\
     ""\
     "<h2>Victory/Defeat Conditions:</h2>"\
     "<b>- Soviet Defeat; </b>"\
     "- Suffering 85% Infantry Casualties or Timelimit is reached"\
     ""\
     "<b>- Canadian Defeat</b>"\
     "- Suffering 90% Casualties or Lose High Ground (Buildig)"\
     ""\
     "<b>GM Discretion as usual.</b>"
    }
    GC_Briefing "{DC9F9515D2824A33}" {
     m_iOrder 14
     m_sTitle "Game Mastering (READ BEORE SLOTTING)"
     m_sContent "<h2>Game Mastering</h2>"\
     "This mission is designed for game mastering from the lobby, but besides that should only be manipulated for technical, administrative or diagnostic purposes."\
     ""\
     "GMs.. PICK THE TIME EXACTLY AS WRITTEN, NO DEVIATION."\
     ""\
     "<b>ATTACKER CO. CHOOSES::</b>"\
     "Time of Day: "\
     "- 0730 / Morning"\
     "- 1200 / Day"\
     "- 1715 / Dusk"\
     "- 1800 / \"\"Night\"\" (High moonlight, Bright Night)"\
     ""\
     "<b>DEFENDER CO. CHOOSES::</b>"\
     "Weather: "\
     "- Clear"\
     "- Cloudy"\
     "- Overcast"\
     "- Rain"
    }
   }
  }
 }
