GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "3176697117A670EF"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{3EDC81569607C4DB}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "<h2>I. Situation:</h2>"\
     "<b>Time & Weather:</b>"\
     "Time - Custom (Attackers Decides)"\
     "Weather - Custom (Defenders Decides)"\
     ""\
     "<b>Situation:</b>"\
     "A Canadian Platoon has ambushed the Regimental's Combat Reconnaissance Patrol, after letting their Divisional Reconnaissance pass them by unharmed. Now the Soviet Regiment's Forward Security Element is moving in to sweep the town before the Regimental Main Body arrives"
    }
    GC_Briefing "{1D3009D8BEAA9268}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet."\
     ""\
     "<b>Known Strength:</b>"\
     "1x Mechanized Company (-)"\
     "Regimental Main Body (Further behind)"\
     ""\
     "<b>Location:</b>"\
     "Company (-) is located somewhere East of Nova Olesov"\
     "Enemy Divisional Reconnasence pushed through earlier, not expected to be a threat"\
     "Their Regimental Main Body is behind the Company (-), will arrive in about 50min "\
     ""\
     "<b>Capabilities:</b>"\
     "Access to RPGs, RPKs, PKMs, VOGs."\
     "Vehicle Access include T-72s, BMP1s"\
     ""\
     "<b>MLCOA:</b>"\
     "Push their vehicles up to shell the town, while splitting their Company up to approach and attack us from multiple directions."\
     ""\
     "<b>MDCOA:</b>"\
     "Push their vehicles up to shell the town, find a easy avenue of approach, and shove their whole company through it to overwhelm us."\
     ""\
     "<b>Defensive Fires:</b>"\
     "None at this time."\
     ""\
     "<b>Airthreat:</b>"\
     "No known Air support."\
     ""\
     "<b>Morale:</b>"\
     "Very High."\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{B759FE51C6D88B56}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "Canadians are equipped with their standard NATO weaponry. etc"\
     "Wearing woodland coloured camo uniforms & helmets."\
     ""\
     "<b>Known Strength:</b>"\
     "1x Rifle Platoon (-)"\
     ""\
     "<b>Location:</b>"\
     "Holding up at Nova Olesov"\
     ""\
     "<b>Capabilities:</b>"\
     "Access to M16A1s series, LAWs/M67s, M60, M249, Carl Gustavs, etc."\
     ""\
     "<b>MLCOA:</b>"\
     "Split their platoons up to cover their sectors, engage us before pulling back"\
     ""\
     "<b>MDCOA:</b>"\
     "Split up their platoon, stay hidden until we reach their killzones before engaging us, until promptly pulling back."\
     ""\
     "<b>Defensive Fires:</b>"\
     "No known in-direct threat at this time."\
     ""\
     "<b>Airthreat:</b>"\
     "No known Air support."\
     ""\
     "<b>Morale:</b>"\
     "Higher than Average"\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{5F13DAFF628184EC}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "Canadian Rifle Platoon (-) located at the Canadian HQ in Nova Olesov"\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Delay the enemy for as long as possible before pulling back, Company behind us is digging in as fast as they can"\
     ""\
     "<b>c. Composition:</b>"\
     "1x Rifle Canadian Platoon (-)"\
     ""\
     "<b>d. Strength:</b>"\
     "Platoon - At 24x Man Strength"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "None as of this time."\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "No air support available"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "None."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{F30635545D498A73}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "Soviet Forward Security Element Company (-) is located East of Nova Olesov"\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Our Combat Reconnaissance Patrol were ambushed after the Divisional Reconnaissance passed this town by, we are to move, eliminate the hostile threat for the Regimental Main Body and secure the High Ground (Building)"\
     ""\
     "<b>c. Composition:</b>"\
     "1x Mechanized Company (-)"\
     ""\
     "<b>d. Strength:</b>"\
     "COY HQ - At 3x Man Strength."\
     "1st Platoon - At 24x Man Strength."\
     "2nd Platoon - At 24x Man Strength"\
     "Mortar Support - At 5x Man Strength"\
     ""\
     "7x BMPs (AI)"\
     "3x T-72s (AI)"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "No In-Direct firesupport available."\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "No air support available"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "None."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{238363111094D8EA}" {
     m_iOrder 5
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "We ambushed the Combat Reconnaissance Patrol earlier with success (Though we suspect there may be some infantry survivors), now the main mission is to delay the Forward Security Element for as long as possible to give our Company behind us enough time to dig without losing the High Ground (Building) before pulling out."\
     ""\
     "We suspect them to utilize their vehicles (BMPs & T-72s) to start shelling the town itself once the infantry start making their move towards the town. Not recommended to look at the T-72 front on, as they may use HE Shells to blow us apart."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{5BE3D1A91C4F3706}" {
     m_iOrder 6
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "THIS is a time critical mission, 45-50min total from the moment we step off (TLDR, We're Soviets)"\
     ""\
     "Combat Reconnaissance Patrol were ambushed in the town of Nova Olesov after the Divisional Reconnaissance passed by, although there are some infantry survivors from that Patrol at the T-Junction."\
     ""\
     "Our task is to push in & eliminate the hostile threat to the Regimental Main Body that is 50min behind us, by securing the High Ground (Building) so the large convoy can pass by without being ambushed or attacked."\
     ""\
     "Mounted Elements (BMPs, T-72s) Will start moving up once we're about 500m from the high ground, and commence shelling of the town while the T-72 starts moving in. Once we're about 50m from the buildings behind shelled the Mounted Elements will Cease Fire."\
     ""\
     "Should we fail or lack in strength, then the Regiment will unfold and push through this town in force."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{383999329392A104}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Prevent the loss of the High Ground (Building) while maintaining Combat Effectiveness until we pull out."\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "Company Commander's Discretion."\
     "It is adviced to split the platoon up to setup Kill Zones in the most likely Avenues of Approaches, engage the vehicles and infantry and pull back to fallback positions."\
     ""\
     "<b>2. Maneuver</b>"\
     "Company Commander's Discretion."\
     "It is adviced to allow the squad to be flexible in their maneuver depending on the battlefield conditions."\
     ""
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{CAA5C5AA24125C0C}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Push into Nova Olesov and secure the High Ground (Building)"\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "Company Commander's Discretion."\
     "It is adviced to pick an avenure of approach, one that gives you the advantage in the attack on the town while the mounted up units (BMPs, T-72s) push up to start shelling the town"\
     ""\
     "<b>2. Maneuver</b>"\
     "Company Commander's Discretion."\
     "It is adviced to NOT split our company up, but to approach from a chosen avenue while allowing platoons to mutually support one another."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{010454040DE7FAF3}" {
     m_iOrder 9
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "Dress: Standard Canadian Uniform"\
     "Equipment: Standard Canadian Loadout"\
     ""\
     "<b>b. Logistical Support:</b>"\
     "Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition & LAVIIs carry additional ammunition."\
     "IPE: Helmets and body armour are to be worn at all times."\
     ""\
     "Platoon has a Crate that contains:"\
     "- 500x Sandbags"\
     "- 84mm MAW Carrier Rucksacks, contains 2x HEAT each."\
     "- 50x Flares Green"\
     "- 50x Flares Orange"\
     "- 50x Flares White"\
     ""\
     "<b>c. Medical:</b>"\
     "Location: Platoon Aid Post is to be setup by Platoon medics."\
     "CASEVAC: By foot or with company asset like the HMMWV or LAVIIs"\
     "Plan: Set up a casualty collection point and extract casualties to this point."\
     "Stretchers: None"\
     "Med Packs: Platoon medpack carried by Platoon medic."\
     "Morphine: Every soldier carries 1+ stick of morphine."\
     ""\
     "<b>d. Vehicles:</b>"\
     "None."
     m_aFactionKeys {
      "GC_CAF"
     }
    }
    GC_Briefing "{2D9A0721794D5FD0}" {
     m_iOrder 10
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
