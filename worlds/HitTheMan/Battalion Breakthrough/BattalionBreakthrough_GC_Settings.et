GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "D61A230527F057B7"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{D14DEEEB581EB814}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "<h2>I. Situation:</h2>"\
     "<b>Time & Weather:</b>"\
     "Time - Attackers Choose"\
     "Weather - Defenders Choose"\
     ""\
     "<b>Situation:</b>"\
     "An East German Battalion has broken through the British forward defences, a Company (-) ahead of said Battalion has been tasked with securing the British Battalion HQ while also securing the town of Kamoryn itself, to continue their breakthrough. The British Battalion HQ is preparing hasty defences after having destroyed a PLT of Recon BRDMs."
    }
    GC_Briefing "{FAD9A2E588BF6BA1}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "Royal Marines are equipped with their standard NATO weaponry. etc"\
     "Wearing woodland coloured camo uniforms & helmets."\
     ""\
     "<b>Known Strength:</b>"\
     "1x UK Royal Marines Platoon"\
     "1x Mortar Team"\
     ""\
     "<b>Location:</b>"\
     "Royal Marines located around Kamoryn"\
     ""\
     "<b>Capabilities:</b>"\
     "Royal Marines Acces to FAL, GPMG, MAWs, 50.Cals, etc"\
     ""\
     "<b>MLCOA:</b>"\
     "Engage us before we establish a solid foothold in their town before pulling back to fortified positions"\
     ""\
     "<b>MDCOA:</b>"\
     "Prepare killzones to destimate a platoon before pulling back into harder defences."\
     ""\
     "<b>Defensive Fires:</b>"\
     "2x Tubes of Mortars."\
     ""\
     "<b>Airthreat:</b>"\
     "No known Air support."\
     ""\
     "<b>Morale:</b>"\
     "Very High."\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{5BAAB39E16DDBA1A}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "<h2>A. Enemy Forces:</h2>"\
     "<b>Equipment:</b>"\
     "NVA are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PRKs."\
     "Wearing the standard NVA uniform of Dark green with greenish helmet."\
     ""\
     "<b>Known Strength:</b>"\
     "1x BTR Company (-)"\
     "1x Mortar Team"\
     ""\
     "<b>Location:</b>"\
     "Company located south of Kamoryn"\
     "Mortar team located behind the Company"\
     ""\
     "<b>Capabilities:</b>"\
     "Access to RPGs, RPKs"\
     "Vehicles include BTR-70s"\
     ""\
     "<b>MLCOA:</b>"\
     "Locate a good attack vector before shoving their whole company through it"\
     ""\
     "<b>MDCOA:</b>"\
     "Utilize their Mortar Team to establish a solid smoke cover, utilize their BTR-70s to push us off the town edge before shoving their company through."\
     ""\
     "<b>Offensive Fires:</b>"\
     "2x Mortar Tubes for in-direct fires."\
     "Suspect HE, Smoke & Illum."\
     ""\
     "<b>Airthreat:</b>"\
     "No known Air support."\
     ""\
     "<b>Morale:</b>"\
     "Alright."\
     ""\
     "<b>CBRN Threat:</b>"\
     "The enemy pose no CBRN Threat as of now."\
     ""
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{C65C2F7E4B06001A}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "East German Company (-) is located South of Kamoryn"\
     "Mortar Team is located further south at 029 065"\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Company has been tasked with securing the town of Kamoryn and the enemy's Battalion HQ. Before the rest of our unit pushes up to exploit the pushthrough."\
     ""\
     "<b>c. Composition:</b>"\
     "1x Company HQ"\
     "2x BTR Platoon"\
     "1x Mortar Team."\
     ""\
     "<b>d. Strength:</b>"\
     "Company HQ - At 6x Soldiers Strong"\
     "1st BTR Platoon - At 27x Soldiers Strong"\
     "2nd BTR Platoon - At 27x Soldiers Strong"\
     "Mortar Team - At 5x Soldiers Strong"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "2x Mortar Tubes"\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "No air support available"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "Additional Ammunition in the BTR-70s."
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{E8C6AB95AEB1F5BC}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces:"
     m_sContent "<h2>B. Friendly Forces</h2>"\
     "<b>a. Disposition:</b>"\
     "Royal Marines Platoon is located north of Kamoryn"\
     "Tank Traps with AT Mines ahead have been placed around the town of Kamoryn (Marked on map)"\
     "Mortar Team is located further North at 029 094"\
     ""\
     "<b>b. Higher Units Mission:</b>"\
     "Royal Marines has been tasked with making sure to protect their Btn HQ and the town of Kamoryn"\
     ""\
     "<b>c. Composition:</b>"\
     "1x Royal Marines Platoon"\
     ""\
     "<b>d. Strength:</b>"\
     "1st Plt - At 27x Man Strength"\
     ""\
     "<b>e. Supporting Fires:</b>"\
     "None as of this time."\
     ""\
     "<b>f. Attachments/Detachments:</b>"\
     "No air support available"\
     ""\
     "<b>g. Additional Ammunition</b>"\
     "None."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{768629F8D255C189}" {
     m_iOrder 5
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "Secure the enemy Btn HQ located at 034 083 north of the town."\
     ""\
     "Mortar team is located at 029 065"\
     ""\
     "Enemy has Tank Traps and likely AT mines alongside them setup around the town. Be wary"\
     ""\
     "Utilize the mortar to establish smoke cover for movement or deny area of movement with HE."\
     ""\
     ""\
     "Mortars:"\
     "DO NOT PRE-FIRE UNTIL SAFEZONE IS OVER NOR INTO THEIR SPAWN OR BE DEALT WITH BY GMS"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{BD75340A17B79C27}" {
     m_iOrder 6
     m_sTitle "II. Mission (Must Read):"
     m_sContent "<h2>II: Mission</h2>"\
     "Defend the town of Kamoryn and do not lose the Btn HQ compound"\
     ""\
     "Mortar team is located at 029 094"\
     ""\
     "Be wary that the enemy has a lot of BTRs, any long range engagement will result in our losses. Focus on luring the enemy into kill zones Very Close or Within the town itself, rendering the usage of their BTRs to be less effective."\
     ""\
     "Place our 2x HMGs on positions to better support this endeavour, and setup the Mortar to his likely ingress points."\
     ""\
     ""\
     "TLDR: Fight within the city with CQB or hit and run, not in a long range fight."\
     ""\
     "Mortars:"\
     "DO NOT PRE-FIRE UNTIL SAFEZONE IS OVER NOR INTO THEIR SPAWN OR BE DEALT WITH BY GMS"
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{5E7FDD4CE5C06D8B}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Get into town, secure the Btn HQ and establish control over Kamoryn"\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "Company Commander's Discretion."\
     "It is adviced to utilize the Mortars to lay down smoke cover for either mounted or dismounted movement to gain lodgement into town."\
     ""\
     "<b>2. Maneuver</b>"\
     "Company Commander's Discretion."\
     "It is adviced to not spread the Platoons far from eachother so they can mutually support one another."\
     ""
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{831AAE954B8E0367}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "<h2>III: Execution</h2>"\
     "<b>Intent:</b>"\
     "Defend the town of Kamoryn and not lose the Btn HQ Compound."\
     ""\
     "<b>1. Concept of the Operation:</b>"\
     "Company Commander's Discretion."\
     "It is advised for the Platoon to setup killzones on likely attack routes, find and prepare fallback positions."\
     ""\
     "<b>2. Maneuver</b>"\
     "Company Commander's Discretion."\
     "It is advised to NOT split up the sections too far so they can mutually support one another or be able to quickly support as needed."
     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{DB7896797D875EC5}" {
     m_iOrder 9
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "Dress: Standard Soviet Uniform"\
     "Equipment: Standard Soviet Loadout"\
     ""\
     "<b>b. Logistical Support:</b>"\
     "Replen Plan: None for 24h."\
     "Ammunition: Each man carries his own ammunition."\
     "IPE: Helmets and body armour are to be worn at all times."\
     ""\
     "BTRs Each contains:"\
     "- 10x Bandages"\
     "- 10x Tourniquets"\
     "- 10x Morphines"\
     "- 40x NVA AK Mags"\
     "- 16x NVA RPK Mags"\
     "- 12x Grenades"\
     "- 8x Smoke Grenades"\
     "- 2x RPG-22s"\
     "- 40x TSh-400g Explosives"\
     "- 10x KPM 3U1 Blasting Machine"\
     "- 50x Handheld White Flares"\
     "- 50x Handheld Orange Flares"\
     "- 50x Handheld Green Flares"\
     ""\
     "<b>c. Medical:</b>"\
     "Location: Platoon Aid Post is to be setup by Platoon medics."\
     "CASEVAC: By foot or with company asset like the BTRs if there are any."\
     "Plan: Set up a casualty collection point and extract casualties to this point."\
     "Stretchers: None"\
     "Med Packs: Platoon medpack carried by Platoon medic."\
     "Morphine: Every soldier carries 1+ stick of morphine."\
     ""\
     "<b>d. Vehicles:</b>"\
     "7x BTR-70s"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{1DDF9E531F7D2A42}" {
     m_iOrder 10
     m_sTitle "IV. Sustainment:"
     m_sContent "<h2>IV: Sustainment</h2>"\
     "<b>a. SOP Variations</b>"\
     "Dress: Standard Royal Marine Uniform"\
     "Equipment: Standard Royal Marine Loadout"\
     ""\
     "<b>b. Logistical Support:</b>"\
