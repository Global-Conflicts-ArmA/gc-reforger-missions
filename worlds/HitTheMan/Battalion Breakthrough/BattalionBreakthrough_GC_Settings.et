     m_aFactionKeys {
      "UK"
     }
    }
    GC_Briefing "{7E850CE55AFFA131}" {
     m_iOrder 11
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "5210, 5211 (HQ), 5214 (HQ), 5211, etc"\
     ""\
     "<b>II. Callsigns:</b>"\
     "Company HQ -------------------------- 5210"\
     "Recon Team  --------------------------- 5152"\
     ""\
     "Platoon HQ ---------------------------- 5211 (HQ)"\
     "1st Squad ------------------------------ 5211"\
     "2nd Squad ----------------------------- 5212"\
     "3rd Squad ------------------------------ 5213"\
     ""\
     "Platoon HQ ---------------------------- 5214 (HQ)"\
     "1st Squad ------------------------------ 5214"\
     "2nd Squad ----------------------------- 5215"\
     "3rd Squad ------------------------------ 5216"\
     ""\
     "<b>- - - Vehicle Callsigns when Inf dismounted:</b>"\
     "5210 Victor or 5210V"\
     "5211 Victor"\
     "5212 Victor"\
     "etc."\
     ""\
     "III. Frequencies:</b>"\
     "Company Net ------------------------- 42.00MHz"\
     "Mortar Net ---------------------------- 43.00MHz"\
     ""\
     "(DO NOT SPLIT UP NETS.. STAY ON ONE NET. MISSION INTENT.)"
     m_aFactionKeys {
      "GC_NVA"
     }
    }
    GC_Briefing "{86E8ED55464DFDD0}" {
     m_iOrder 12
     m_sTitle "V. Command & Signals:"
     m_sContent "<h2>V. Command & Signal:</h2>"\
     "<b>I. Chain of Command:</b>"\
     "0, 21A, 21B, etc."\
     ""\
     "<b>II. Callsigns:</b>"\
     "Battalion HQ ------------------------ 0"\
     "- Battalion Commander -------- 0A"\
