    GC_Briefing "{97E1865D0D9B8BC0}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes:"
     m_sContent "<h2>Mission Notes:</h2>"\
     "<b>Timelimit:</b>"\
     "- 60m (Can be increased by GM's Discretion) "\
     "- 6min Setup Timer."\
     ""\
     "<h2>Victory/Defeat Conditions:</h2>"\
     "<b>- East German Defeat; </b>"\
     "- Suffering 85% Casualties OR Time Limit reached."\
     ""\
     "<b>- NATO Defeat</b>"\
     " - Suffering 85% Casualties OR Battalion HQ Secured."\
     ""\
     "<b>GM Discretion as usual.</b>"
    }
    GC_Briefing "{C2B0D858736341EF}" {
     m_iOrder 14
     m_sTitle "Game Mastering (READ BEFORE LOBBY)"
     m_sContent "<h2>Game Mastering</h2>"\
     "This mission is designed for game mastering from the lobby, but besides that should only be manipulated for technical, administrative or diagnostic purposes."\
     ""\
     "USE EXACT TIME AS WRITTEN GMs... DO NOT BE A MINUTE OFF OTHERWISE ITS NOT INTENDED."\
     ""\
     "<b>ATTACKER CO. CHOOSES:</b>"\
     "Time of Day: "\
     "- 0730 / Morning"\
     "- 1200 / Day"\
     "- 1715 / Dusk"\
     "- 1800 / \"\"Early Night\"\" (BRIGHT AS FUUUUUUCK) "\
     ""\
     "<b>DEFENDER CO. CHOOSES:</b>"\
     "Weather: "\
     "- Clear"\
     "- Cloudy"\
     "- Overcast"\
     "- Rain"
    }
    GC_Briefing "{AA1F95AC51471ECF}" {
     m_iOrder 15
     m_sTitle "Mortar Teams (MUST READ THIS("
     m_sContent "<h2>Mortar Teams</h2>"\
     "<b>Do Not:</b>"\
     "- Fire onto the player's spawn BEFORE nor AFTER Safestart"\
     "- Fire onto the other's Mortar Team"\
     "  - This is not a Mortar Duel, focus on the town/AO"\
     ""\
     "Be mindful that WIND will affect your rounds and calculations"\
     "You have unlimited rounds, utilize them especially Smoke and Illum"
    }
   }
  }
 }
