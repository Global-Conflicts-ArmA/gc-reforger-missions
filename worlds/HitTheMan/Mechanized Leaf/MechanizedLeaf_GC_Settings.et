GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "9628C3A6A09EC8B8"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aMissionEvents + {
    GC_Event "{79678E01EEDAC900}" {
     m_sName "Time Limit (event 2, 5100s)"
     m_Advanced GC_EventOptions "{1E77600EE13D4966}" {
      m_fDelay 5100
     }
     m_aActions {
      GC_MessageAction "{D26B531D122E50AC}" {
       m_sTitle "Time Limit"
       m_sMessage "The Mission will end in 5 minutes"
      }
     }
    }
    GC_Event "{3A056D756D9F8216}" {
     m_sName "Time Limit (event 2, 5400s)"
     m_Advanced GC_EventOptions "{923B33CCE6AF23F5}" {
      m_fDelay 5400
     }
     m_aActions {
      GC_MessageAction "{EE04B3D4F80E90DB}" {
       m_sTitle "USSR Victory"
       m_sMessage "USSR Forces held the town long enough forcing the CAF to fall back... GM Discretion when to end the mission"
      }
     }
    }
   }
   m_aBriefings {
    GC_Briefing "{A910136C4D116BBC}" {
     m_iOrder 1
     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "First Light at 0630"\
     "Cloudy, Dawn with a light fog"\
     ""\
     "Situation:"\
     "USSR forces are occupying and fortifying the town of Novy Sobor, CAF Mechanzied Company has been ordered to secure & liberate the town while slowly pushing the soviet influence out of Chernarus"
    }
    GC_Briefing "{FF669D85D3AE5353}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG7s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet."\
     ""\
     "Known Strength:"\
     "1x Motor Rifle Company"\
     "1x Recon Platoon (+) "\
     "Suspected QRF in the surrounding area"\
     ""\
     "Location: "\
     "Holding the town of Novy Sobor starting to fortify it, with a suspected recon screen north"\
     ""\
     "MLCOA:"\
     "Entrench themselves in the surrounding area to brace for our attack while recon screen"\
     ""\
     "MDCOA:"\
     "Recon units lay in ambush waiting for our forces before enaging, or even ambushing from the rear before falling back to town."\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
    }
    GC_Briefing "{524CDF35CC658DAD}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "Disposition:"\
     "Battalion is located West conducting similar operations in the area, with our sister company on our right flank"\
     ""\
     "Higher Units Mission:"\
     "Battalion has been assigned to support the local CDF in their defence and recapture of territory from the USSR forces and providing aid to the civilians."\
     ""\
     "Composition:"\
     "1x LAVII Mechanized Company"\
     ""\
     "Strength:"\
     "Mechanized Company at 62x man strength"\
     "7x LAVIIs"\
     ""\
     "Supporting Fires:"\
     "None."\
     ""\
     "Attachments/Detachments:"\
     "None."
    }
    GC_Briefing "{DEA4902B9784C5B2}" {
     m_iOrder 4
     m_sTitle "II. Mission:"
     m_sContent "Our Mechanized Company has been tasked with securing the town of Novy Sobor from the USSR units who are likely starting to entrench themselves in the area. After we're to prevent the USSR forces from retaking the town"\
     ""\
     "We've also ordered to also try to minimize any infastructure damage if possible."
    }
    GC_Briefing "{1B046B818FCC9A0B}" {
     m_iOrder 5
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Company is to sweep the recon screen before conducting an assault into Novy Sobor securing it and preventing any counter attacks."\
     ""\
     "1. Concept of the Operation:"\
     "Mech. Company Commander's Discretion."\
     "It is advised to not allow the enemy to ambush our LAVs while the infantry are still mounted, push the infantry to screen and sweep the forest."\
     ""\
     "2. Maneuver"\
     "Mech. Company Commander's Discretion."\
     "It is advised to not spread our forces too wide where upon our units cannot support one another incase of attack, ambush or being seperated."
    }
    GC_Briefing "{DC33A8C8A5CDA780}" {
     m_iOrder 6
     m_sTitle "IV. Sustainment:"
     m_sContent "I. SOP Variations"\
     "None."\
     ""\
     "II. Logistical Support:"\
     "None provided from the Company nor Battalion"\
     "Supplies are already located within the LAVs themselves"\
     ""\
     "III. Medical:"\
     "A crate of medical supplies has been provided sorely for the medic to utilized."\
     ""\
     "IV. Vehicles:"\
     "Mechanized Platoon is equiped with;"\
     "7x LAVIIs"\
     ""\
     "No Replacement is provided or accounted for if losses are sustained."
    }
    GC_Briefing "{9847659EA199D00B}" {
     m_iOrder 7
     m_sTitle "V. Command & Signals:"
     m_sContent "I. Chain of Command:"\
     "29, 29A, 21, 22"\
     ""\
     "II. Callsigns:"\
     "Company Commander 	- 29"\
     "Company 2iC	 	- 29A"\
     "Platoon Leader 	- 21 Sunray"\
     "Platoon Warrant 	- 21 Sunray Minor "\
     "1st Section 		- 21 Alpha"\
     "2nd Section 		- 21 Bravo"\
     "Weapons Detachment	- 21 Whisky"\
     "2nd Platoon Leader 	- 22 Sunray"\
     "2nd Platoon Warrant 	- 22 Sunray Minor "\
     "1st Section 		- 22 Alpha"\
     "2nd Section 		- 22 Bravo"\
     "Weapons Detachment 	- 22 Whisky"\
     "- - - Vehicle Callsigns when Inf dismounted:"\
     "Z29 or Zulu 29"\
     "Z21"\
     "Z21A"\
     "Etc."\
     ""\
     "III. Frequencies:"\
     "Company Net 		- 50.00"\
     "1st Platoon Net 	- 49.00"\
     "2nd Platoon Net 	- 48.00"
    }
    GC_Briefing "{0335A6DB925AFCA0}" {
     m_iOrder 8
     m_sTitle "VI. Mission Notes:"
     m_sContent "You must be within 30m of the south side of town to be counted as capturing/defending it."\
     ""\
     "Timelimit: 90m"\
     ""\
     "Canadian Victory is achived once the town is secure and held for 15min"\
     ""\
     "USSR Victory is achived by causing 85% casualties to CAF, before or after the town is secured."
    }
    GC_Briefing "{438FE3C4F7838B6D}" {
     m_iOrder 9
     m_sTitle "Game Mastering"
     m_sContent "This mission is not designed for game mastering and should only be manipulated for technical, administrative or diagnostic purposes."
    }
   }
  }
 }
}
