    GC_Briefing "{7222BC08A09235CB}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes:"
     m_sContent "<h2>Mission Notes:</h2>"\
     "<b>Timelimit:</b>"\
     "- 60m (Can be increased by GM's Discretion) "\
