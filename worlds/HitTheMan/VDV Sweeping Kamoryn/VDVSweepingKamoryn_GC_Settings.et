    GC_Briefing "{6A466EB8EDB0F794}" {
     m_iOrder 14
     m_sTitle "Game Mastering (READ BEFORE LOBBY)"
     m_sContent "<h2>Game Mastering</h2>"\
     "This mission is designed for game mastering from the lobby, but besides that should only be manipulated for technical, administrative or diagnostic purposes."\
     ""\
