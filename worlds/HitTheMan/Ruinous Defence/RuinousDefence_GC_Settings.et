    GC_Briefing "{F1EC3BA82EEC0C1C}" {
     m_iOrder 12
     m_sTitle "V. Command & Signals:"
     m_sContent "I. Chain of Command:"\
     "340, 341 (Radio), 344 (Radio), 341, 342....."\
     ""\
     "II. Callsigns:"\
     "Company HQ ---------------------- 340 (Radio)"\
     ""\
     "1st Platoon HQ ------------------- 341 (Radio)"\
     "1st Rifle Squad ------------------- 341"\
     "2nd Rifle Squad ------------------ 342"\
     "3rd Rifle Squad ------------------- 343"\
     ""\
