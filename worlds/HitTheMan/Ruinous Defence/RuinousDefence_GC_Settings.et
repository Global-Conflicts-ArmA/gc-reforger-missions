     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{135A33A095FBCF79}" {
     m_iOrder 13
     m_sTitle "VI. Mission Notes:"
     m_sContent "Timelimit: 60m (Can be increased by GM's Discretion)"\
     "Start time: 5min (To let the defenders get into positions)"\
     ""\
     "- USSR Army Victory by destroying the Ammo dump or killing 95% of USSR Forces."\
     ""\
     "- US Victory by killing 85% or Time Limit is reached."\
     ""\
     "GM Discretion as usual."\
     ""
    }
    GC_Briefing "{D6BCBE41D4C47225}" {
     m_iOrder 14
     m_sTitle "VII. How to use Sandbags (MUST READ)"
     m_sContent "To deploy sandbags;"\
     ""\
     "- Pull out your entrenchment tool"\
     "- Press R for placement mode"\
     "- Select which Sandbag type you want to build"\
     "- Press LMB"\
     "- When you try to build it'll tell at the bottom of the screen near the Squad Radar how many X Sandbags are needed"\
     "- Drop off the remaining sandbags on the ground near the placed sandbag to be able to build it"\
     ""\
     "Congratulation, you can now build sandbags"\
     ""
     m_aFactionKeys {
      "US"
     }
     m_eAudience 1
    }
    GC_Briefing "{63AF70B633BAFC75}" {
     m_iOrder 15
     m_sTitle "VIII. How to deploy M2HB (MUST READ)"
     m_sContent "First for Tripod;"\
     ""\
     "- Pull out your Entrenchment tool"\
     "- Press R for Placement Mode"\
     "- Move around until satisfied, then press LMB"\
     ""\
     "For M2HB Barrel;"\
     ""\
     "- Move up to the placed Tripod"\
     "- Drop the M2HB from your backpack onto the ground"\
     "- Pull out your Entrenchment Tool"\
     "- Look at the Tripod, scroll until you can assemble the M2HB"\
     "- Move around until the placement direction is to your satisfaction"\
     "- Hold LMG"\
     ""\
     "For Ammunition;"\
     ""\
     "- Move up to the M2HB deployed gun"\
     "- Scroll until you can select Inventory"\
     "- Open up the inventory and drop off your ammunition"\
     ""\
     "The M2HB Weapon is now ready for usage (RECOMMEND TO BE PLACED ONTOP OF SANDBAGS)"\
     ""\
     "WORDS OF NOTE;"\
     "PLACING THE TRIPOD ON SANDBAGS IS FUCKY, BUT IT WORKS."
     m_aFactionKeys {
      "US"
     }
     m_eAudience 1
    }
    GC_Briefing "{3A4DAF1ED5FB8BB3}" {
     m_iOrder 16
     m_sTitle "Game Mastering"
     m_sContent "This mission is not designed for game mastering and should only be manipulated for technical, administrative or diagnostic purposes."
