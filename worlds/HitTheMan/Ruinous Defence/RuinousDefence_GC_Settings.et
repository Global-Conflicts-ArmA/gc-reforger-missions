     "48x man strong Unit."\
     ""\
     "Supporting Fires:"\
     "None."\
     ""\
     "Attachments/Detachments:"\
     "2x BRDMs"
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{30822685D3381042}" {
     m_iOrder 5
     m_sTitle "II. Mission (Must Read):"
     m_sContent "Prevent the enemy from destroying our Ammo dump or render us combat ineffective."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{D4264FA07C779504}" {
     m_iOrder 6
     m_sTitle "II. Mission:"
     m_sContent "Push through whatever defensive line and destroy the Ammo Dump."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{E4416E3478194EBD}" {
     m_iOrder 7
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Setup our forces and prevent the loss of the Ammo Dump."\
     ""\
     "Powerlines are potentially a good spot for a M2HB position."\
     ""\
     "Limit of the forward defence is highlighted by the blue line on your map, commander."\
     ""\
     "1. Concept of the Operation:"\
     "Platoon Commander's Discretion."\
     ""\
     "2. Maneuver"\
     "Platoon Commander's Discretion."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{B4F84339ACDE1D15}" {
     m_iOrder 8
     m_sTitle "III. Execution:"
     m_sContent "Intent:"\
     "Push through and destroy the Ammo Dump, while utilizing the BRDMs"\
     ""\
     "Not recommended to split squads up.. they dont have radios."\
     ""\
     "1. Concept of the Operation:"\
     "Company Commander's Discretion."\
     ""\
     "2. Maneuver"\
     "Company Commander's Discretion."\
     ""
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{A2CFA2CA15A3F61E}" {
