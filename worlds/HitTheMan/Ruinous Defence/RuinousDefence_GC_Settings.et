   m_aBriefings {
    GC_Briefing "{D3F344CB3D4F39D8}" {
     m_iOrder 0
     m_sTitle "I. Situation:"
     m_sContent "Time & Weather:"\
     "Time: 06:00"\
     "Clear but slight Fog"\
     ""\
     "Situation:"\
     "Soviet forces are moving in to destroy a US Ammo Dump recently setup, while US are hastily establishing defences to prevent that from happening."
    }
    GC_Briefing "{395F01C6EB9488EE}" {
     m_iOrder 1
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "USSR are equipped with their standard WARSAW Pact weaponry, AK series, RPG22s, PKMs."\
     "Wearing the standard USSR uniform of Tan with greenish helmet."\
     ""\
     "Known Strength:"\
     "1x MotorRifle Company (-)"\
     ""\
     "Location: "\
     "At the military site marked on map to our south"\
     ""\
     "MLCOA:"\
     "Push through a axis, securing a foothold and move onto the ammo dump"\
     ""\
     "MDCOA:"\
     "Push through a axis, utilize the BRDM to recon and pin our forces, securing a foothold and move onto the ammo dump"\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{09FD80A55D0328AE}" {
     m_iOrder 2
     m_sTitle "A. Enemy Forces:"
     m_sContent "Equipment:"\
     "US are equipped with their standard NATO weaponry, M16A1s series, LAWs/M67s, M60, some AP Mines. etc"\
     "Wearing woodland coloured camo uniforms & helmets."\
     ""\
     "Known Strength:"\
     "1x Rifle Platoon (-)"\
     ""\
     "Location: "\
     "North at a ruined village."\
     ""\
     "MLCOA:"\
     "Setup M2HB into kill zones, before pulling back"\
     ""\
     "MDCOA:"\
     "Setup M2HB into kill zones, before pulling back while setting up more indepth defensive lines with AP mines."\
     ""\
     "CBRN Threat:"\
     "No known threat at this time."
     m_aFactionKeys {
      "USSR"
     }
    }
    GC_Briefing "{69094A4998C39776}" {
     m_iOrder 3
     m_sTitle "B. Friendly Forces:"
     m_sContent "Disposition:"\
     "Reinforcements with our remaining company is inbound."\
     ""\
     "Higher Units Mission:"\
     "Our Battalion is set to establish control of the north side of the island before continuing south, our sister companies will make landfall eventually."\
     ""\
     "Composition:"\
     "1x Platoon (-)"\
     ""\
     "Strength:"\
     "24x Soldiers"\
     ""\
     "Supporting Fires:"\
     "None."\
     ""\
     "Attachments/Detachments:"\
     "None."
     m_aFactionKeys {
      "US"
     }
    }
    GC_Briefing "{901A8E6742ADCA01}" {
     m_iOrder 4
     m_sTitle "B. Friendly Forces:"
     m_sContent "Disposition:"\
     "Battalion is located south-west reorganizing themselves to attempt a counter-attack while we delay the enemy forces"\
     ""\
     "Higher Units Mission:"\
     "Reorganize and push these foreigners out of our land!"\
     ""\
     "Composition:"\
