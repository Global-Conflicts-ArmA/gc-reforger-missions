GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "8E3C50EA723A91F3"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{F4630AD11B8DD15F}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "Rifle platoon CO is the IC."\
     ""\
     "Wait 1min in the mission preview page for stability reasons."\
     ""\
     "A USMC Rifle platoon + CAAT team and ACE conduct a hasty defense to delay attacking Russian motor rifles before regrouping with friendlies."
    }
    GC_Briefing "{34CCFEABB3406401}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "Russian forces have been aggressivly pushing down this MSR our Company has taken heavy casulties and is setting up a MASCAS CCP at the bus station."\
     ""\
     "We are to delay the RF to enable EVAC. "
    }
    GC_Briefing "{CBB6525C33EB1280}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "1x USMC Rifle Platoon (you)."\
     ""\
     "1x USMC CAAT with MK19, M2HB, and an Unarmed with x6 Javs for the JAV team JLTVs co-located with the Rifles"\
     ""\
     "2 Platoon providing local security at the bus station."\
     ""\
     "The ACE assets are located at a FARP to the North."
    }
    GC_Briefing "{81318C7F8CE2B8D1}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "At least 1 company of Russian motor rifles inbound. K-17 IFVs as well as  GAZ Tigrs have been spotted approaching down the nearby MSR and will likely be making contact with us within the next 3 minutes. Dismounted follow ups are expected through the desert on the South of the MSR."
    }
    GC_Briefing "{72A7DAE310977F33}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Block and delay RF for 30 minutes, buying time for wounded to be stabilized, then extract to the bus station."
    }
    GC_Briefing "{56A7F0FA9F886D72}" {
     m_iOrder 5
     m_sTitle "V. Sustainment"
     m_sContent "None"
    }
    GC_Briefing "{6EE58105CCB26C0A}" {
     m_iOrder 6
     m_sTitle "VI. Comsig"
     m_sContent "Gound Element stay on default FREQ"\
     "Air net: +0.1MHz"\
     ""\
     "Callsigns: per the lobby for the ground."\
     "Air can create their own"
    }
    GC_Briefing "{3D383734F5948228}" {
     m_iOrder 7
     m_sTitle "JAV Note"
     m_sContent "There is a bug where you must drop the JAV and pick it back up prior to firing."\
     ""\
     "The javs are located inside the unarmed JLTV."\
     ""\
     "The Jav was added by WCS_Armaments."\
     ""\
     "It's use is exactly like the stinger."\
     ""\
     "Get line of sight of a target, hold left ctrl until you hear a tone, then fire."\
     ""\
     "It is F&F and doesn't have a reload."\
     ""\
     "It will fire without a target lock so don't ND."
    }
    GC_Briefing "{9BC34E83BD5CE33A}" {
     m_iOrder 8
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc... er.. jubxxxjub"\
     ""\
     "AO limit in effect, don't expect to go more than 250m further east of the construction site in front of you"\
     ""\
     "End conditions:"\
     ""\
     "30 Minutes pass, and  75% of surviving US players regrouped at bus station: Victory"\
     ""\
     "80% US player causalties or Bus station overrun by AFRF: Defeat"
    }
   }
  }
 }
