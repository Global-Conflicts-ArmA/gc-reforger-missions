GC_LobbyGameMode : "{A79C4E0A43DEB821}Prefabs/MP/Modes/GC_LobbyGameMode.et" {
 ID "E30C4E7C000A6E24"
 components {
  GC_LobbyManager "{6A137A39106A4973}" {
   m_aBriefings {
    GC_Briefing "{F22FF4B83EB6B0DC}" {
     m_iOrder 0
     m_sTitle "Overview"
     m_sContent "Two US Army M113 platoons attempt to remove entrenched USSR infantry from the eastern side of Zarichne."\
     ""\
     "10x Respawn tickets made available upon securing each objective, so you may return from spectator to the game."
    }
    GC_Briefing "{5A186D8CDF7D92BB}" {
     m_iOrder 1
     m_sTitle "I. Situation"
     m_sContent "NATO forces have broken through Warsaw Pact lines in east Germany, but are now getting bogged down in heavily fortified areas in eastern Europe."\
     ""\
     "Your unit has been tasked with driving Motor Rifles occupying the eastern part of Zarichne back across the Zherebets river."
    }
    GC_Briefing "{8265DE3CDEEC5563}" {
     m_iOrder 2
     m_sTitle "II. Friendly Forces"
     m_sContent "2x US M113 Platoons plus company command element."\
     ""\
     "8x M113s available, as well as an unarmed M1025 Humvee for Coy HQ use, an M997 Ambulance for Coy Medic use, and an M923A1 truck for CSM usage."\
     ""\
     "10x Respawns will be made available after each objective is secured."
    }
    GC_Briefing "{7830EAA98F520762}" {
     m_iOrder 3
     m_sTitle "III. Enemy Forces"
     m_sContent "Company-strength dismounted Soviet Motor Rifles occupying trench lines to our west."\
     ""\
     "Heavily dug in along trenches and bunkers, with several static MGs watching the lines."\
     ""\
     "BTR70s have not been spotted near the front but could be in reserve as a QRF."
    }
    GC_Briefing "{E07484E614E68892}" {
     m_iOrder 4
     m_sTitle "IV. Mission"
     m_sContent "Assault the enemy trench lines, seizing the 4 marked objectives (these are key buildings and bunkers to control the area) as you go."\
     ""\
     "10x Respawns will be made available as each objective is secured."
    }
    GC_Briefing "{07BA2F3D42A7C6A7}" {
     m_iOrder 5
     m_sTitle "V. Service & Support"
     m_sContent "Supply Sergeant to handle transportation of respawns as they are made available."\
     ""\
     "Additional ammunition for both infantry and vehicles available in tent near our current location. Distribution and resupply to be handled by Supply Sergeant."\
     ""\
     "Additional medical supplies available in medical tent near our current location, to be handled by Company medics."\
     ""\
     "Repair and refuel not available, so protect the vehicles."
    }
    GC_Briefing "{8D3175A0882CC30E}" {
     m_iOrder 6
     m_sTitle "VI. Command & Signal"
     m_sContent "Radio Frequencies:"\
     "1st Platoon Net: 46.0 Mhz"\
     "2nd Platoon Net: 47.0 Mhz"\
     "Company Net: 48.0 Mhz"\
     ""\
     "Company HQ Callsigns:"\
     "Company Commander: 0-6-A"\
     "Company XO: 0-6-B"\
     "Company Supply Sergeant: 0-6-C"\
     "Company Medics: 0-6-M"\
     ""\
     "Vehicle callsigns:"\
     "Unit callsign suffixed with V."\
     "Example: 1st Platoon 1st Squad M113: 1-1-V"
    }
    GC_Briefing "{E65BCFF5A58010A9}" {
     m_iOrder 7
     m_sTitle "Mission Notes"
     m_sContent "Mission by arc"\
     ""\
     "AO limit in effect roughly around covermap."\
     ""\
     "10x Respawns will be made available after securing each objective, players should respawn in from spectator consuming these tickets."\
     ""\
     "End conditions:"\
     "All 4 objectives secured: Victory"\
     "90% US casualties or 120 minutes pass: Defeat"\
     ""\
     "Dumbass AI sometimes fall through the floor of the church cellar so you may need to GM delete them to end the mission."
    }
   }
  }
 }
}
